{
  "name": "miamedical",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @mia/website build",
    "preview": "turbo run preview",
    "start:api": "pnpm --filter @mia/server run start",
    "start:web": "node --env-file-if-exists=.env scripts/start-web.mjs",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,astro,svelte,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,astro,svelte,css,yaml,yml}\"",
    "db:generate": "pnpm --filter @mia/db run generate",
    "db:migrate": "pnpm --filter @mia/db run migrate",
    "db:push": "pnpm --filter @mia/db run push",
    "db:studio": "pnpm --filter @mia/db run studio",
    "db:seed": "pnpm --filter @mia/server run seed",
    "admin:seed": "pnpm --filter @mia/server run admin:seed"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "turbo": "^2.10.11",
      "typescript": "^6.0.3",
      "vite": "^8.2.0",
      "@types/node": "^26.1.2",
      "tsx": "^4.23.9",
      "prettier": "^3.9.6",
      "prettier-plugin-astro": "^0.14.1",
      "prettier-plugin-svelte": "^4.1.1",
      "prettier-plugin-tailwindcss": "^0.8.1",
      "vitest": "^4.1.10",
      "eslint": "^10.8.1",
      "@eslint/js": "^10.0.1",
      "typescript-eslint": "^8.66.0",
      "eslint-plugin-svelte": "^3.22.0",
      "eslint-config-prettier": "^10.1.8",
      "globals": "^17.9.0",
      "astro": "^7.2.0",
      "embla-carousel": "^8.6.0",
      "@astrojs/node": "^11.1.0",
      "@astrojs/svelte": "^9.0.1",
      "@astrojs/check": "^0.9.10",
      "@astrojs/sitemap": "^3.6.0",
      "svelte": "^5.56.8",
      "@sveltejs/kit": "^2.70.2",
      "@sveltejs/adapter-static": "^3.0.10",
      "@sveltejs/vite-plugin-svelte": "^7.2.0",
      "svelte-check": "^4.7.4",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "cnfast": "^0.1.0",
      "shadcn-svelte": "^1.5.0",
      "bits-ui": "^2.18.1",
      "tailwind-variants": "^3.3.1",
      "tw-animate-css": "^1.4.0",
      "@lucide/svelte": "^1.29.0",
      "@fontsource-variable/geist": "^5.3.0",
      "@internationalized/date": "^3.12.3",
      "mode-watcher": "^1.1.0",
      "svelte-sonner": "^1.1.0",
      "rolldown": "^1.2.3",
      "hono": "^4.13.0",
      "@hono/node-server": "^2.1.0",
      "@hono/valibot-validator": "^0.6.1",
      "drizzle-orm": "^0.45.2",
      "drizzle-kit": "^0.31.10",
      "drizzle-valibot": "^0.4.2",
      "postgres": "^3.4.9",
      "mysql2": "^3.23.2",
      "valibot": "^1.4.2",
      "@node-rs/argon2": "^2.0.2",
      "@aws-sdk/client-s3": "^3.700.0",
      "@aws-sdk/client-sesv2": "^3.700.0",
      "sharp": "^0.35.3"
    }
  }
}
