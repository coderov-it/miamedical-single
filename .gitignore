# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
.output/
.astro/
.svelte-kit/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
.turbo/
.cache/
.eslintcache
.rolldown/

# ---------------------------------------------------------------------------
# Secrets and local environment
#
# .env.example IS committed — it is the template. Nothing else is.
# These patterns have no leading slash, so they match at any depth
# (apps/server/.env is covered too).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
secrets.json

# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
logs/

# ---------------------------------------------------------------------------
# Agent / assistant tooling (local, not project source)
# Delete these two lines if you want the team to share them.
# ---------------------------------------------------------------------------
.agents/skills
.claude/settings.local.json
# Symlink into .agents/ — would dangle for anyone who clones.
.claude/skills/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Database and legacy migration exports
# ---------------------------------------------------------------------------
*.dump.sql
*.dump
miamedical_database.sql
/docs/migration/wp/

# ---------------------------------------------------------------------------
# Catalogue
#
# docs/catalog/ is COMMITTED: its source JSON and media manifest are the
# catalogue's source of record. packages/catalog/src/data/ and its scripts are
# also project source, consumed by `pnpm catalog:sync`.
#
# docs/assets/catalog/ holds the photos those files name. Not committed: after
# an import they live in R2 as WebP, which is the copy the storefront serves.
# ---------------------------------------------------------------------------
/docs/assets/catalog/

# ---------------------------------------------------------------------------
# NOT ignored, on purpose:
#   docs/catalog/                  — catalogue records and media manifest
#   packages/catalog/src/data/     — application catalogue data
#   packages/catalog/src/script/   — catalogue tooling
#   packages/db/drizzle/           — DB migrations are source of truth
#   pnpm-lock.yaml                 — reproducible installs
#   .env.example                   — environment template
# ---------------------------------------------------------------------------
