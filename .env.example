# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miamedical"

# Hono API
API_PORT=8787
API_HOST="0.0.0.0"
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS="http://localhost:4321,http://localhost:5173"

# Session / auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# How long a back-office session lasts without re-authenticating
SESSION_TTL_DAYS=7
# Set only when the admin panel and the API are on different subdomains
# AUTH_COOKIE_DOMAIN=".miamedical.com"
# lax | strict | none — "none" is required for cross-site setups and needs HTTPS
AUTH_COOKIE_SAMESITE="lax"
# Enable only behind a proxy that overwrites X-Forwarded-For (login rate limiting)
TRUST_PROXY="false"

# Cloudflare R2 object storage (S3 API). Optional in local dev — media upload
# endpoints fail with a clear error until these are set. Size/mime limits are
# code, not env: see MEDIA_PROFILES in packages/validators/src/media.ts.
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="miamedical-media"
# WebP quality for server-side image conversion (1-100, visually lossless ~92)
MEDIA_WEBP_QUALITY=92
# Staging uploads older than this are deleted by the orphan sweep
MEDIA_STAGING_TTL_HOURS=24
# ISO 4217 — the catalog's default currency
DEFAULT_CURRENCY="EUR"

# HERE Geocoding & Search, for the checkout's address suggestions. Server-side
# only: the browser asks GET /api/address/suggest and never sees this key.
# Without it the endpoint answers 503 and the address is typed by hand — the
# checkout still works, it is just slower to fill in.
# Get one at https://platform.here.com (Freemium tier).
# HERE_API_KEY=""

# Public (exposed to the browser)
# The API origin. Both the website and the admin SPA call it absolutely — there
# is no dev proxy and no same-origin assumption — so in production this must be
# the API's *public* origin and must appear in CORS_ORIGINS above.
PUBLIC_API_URL="http://localhost:8787"
PUBLIC_SITE_URL="http://localhost:4321"
# Origin of the admin SPA. Internal alert emails deep-link into it.
PUBLIC_ADMIN_URL="http://localhost:5173"
# Prepended by the website/admin to every stored media path
PUBLIC_MEDIA_BASE_URL="https://media.miamedical.com"

# ---------------------------------------------------------------------------
# Storefront customer sessions.
#
# Longer than the back office and sliding, unlike it: an operator asked to sign
# in weekly is fine, a customer who rents twice a year and meets a login form
# instead of their order history is a support call. The refresh window is what
# keeps the slide to one write per customer per day rather than one per request.
# ---------------------------------------------------------------------------
CUSTOMER_SESSION_TTL_DAYS="30"
CUSTOMER_SESSION_REFRESH_HOURS="24"

# ---------------------------------------------------------------------------
# Outbound email. See docs/code/notifications-and-mail.md.
#
# One of four transports: "console", "plunk", "cloudflare" or "ses". Exactly one is
# live and there is no failover between them, so switching provider is this one line
# plus that provider's block below.
#
# `console` prints the message — including the activation and magic links — to
# the log instead of sending it. That is the only way to click one of those links
# in local development, so it is the default here. The server REFUSES TO BOOT in
# production on the console transport, or with the chosen provider's credentials
# missing: a link nobody receives is a silent failure with no error anywhere to
# show it.
#
# Both provider groups are optional, like the R2 block: the server starts without
# credentials and the adapter fails on first send, naming what is missing.
# ---------------------------------------------------------------------------
MAIL_TRANSPORT="console"

# Shared by both providers. Must be a no-reply mailbox and must LOOK like one: no
# Reply-To is ever sent, so a reply goes nowhere. Every customer email carries a
# WhatsApp button and the free-phone number instead. The domain has to be verified
# with whichever provider is live — Plunk and SES each verify separately.
# MAIL_FROM_ADDRESS="M.i.a. Medical Italia <no-reply@miamedicalitalia.com>"

# --- MAIL_TRANSPORT="plunk" -------------------------------------------------
# The secret key from the Plunk project's API settings. Plunk sends transactional
# mail regardless of subscribe state, but it does create a contact per recipient
# and that cannot be turned off; we never send `subscribed`, so those contacts stay
# unsubscribed and no order can enrol anyone in a campaign. Its API host lives in
# apps/server/src/config/external-apis.ts, not here — it is not a secret.
# PLUNK_API_KEY="sk_..."

# --- MAIL_TRANSPORT="cloudflare" --------------------------------------------
# Cloudflare Email Sending, over its REST API (not the Workers binding). The token
# needs the "Email Sending: Edit" permission, and the sending domain must be onboarded
# under Compute > Email Service > Email Sending on this same account. Sending to
# arbitrary recipients is beta and needs a Workers Paid plan — an account without the
# entitlement fails every send with `not_entitled`, which no boot check can predict.
# Usually the same account as R2_ACCOUNT_ID, kept separate so either can move alone.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_EMAIL_API_TOKEN=""

# --- MAIL_TRANSPORT="ses" ---------------------------------------------------
# Omit the two access keys to fall back on the AWS default credential chain, so an
# instance role works with no secret in the environment at all.
# AWS_SES_REGION="eu-south-1"
# AWS_SES_ACCESS_KEY_ID=""
# AWS_SES_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# One-off WordPress/WooCommerce migration (apps/server/script/wp-migrate).
# Read-only, and read straight from process.env rather than the app's env
# schema — nothing in the running server touches MySQL. See
# docs/code/wp-migration.md.
# ---------------------------------------------------------------------------
# WP_MYSQL_HOST="127.0.0.1"
# WP_MYSQL_PORT="3306"
# WP_MYSQL_USER="root"
# WP_MYSQL_PASSWORD=""
# WP_MYSQL_DATABASE="default"
# WP_TABLE_PREFIX="wp_"
# Where the old site still serves wp-content/uploads, for the media download
# WP_MEDIA_BASE_URL="https://www.miamedicalitalia.it"
