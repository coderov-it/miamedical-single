# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miamedical"

# Hono API
API_PORT=8787
API_HOST="0.0.0.0"
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS="http://localhost:4321,http://localhost:5173"

# Session / auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# How long a back-office session lasts without re-authenticating
SESSION_TTL_DAYS=7
# Set only when the admin panel and the API are on different subdomains
# AUTH_COOKIE_DOMAIN=".miamedical.com"
# lax | strict | none — "none" is required for cross-site setups and needs HTTPS
AUTH_COOKIE_SAMESITE="lax"
# Enable only behind a proxy that overwrites X-Forwarded-For (login rate limiting)
TRUST_PROXY="false"

# Public (exposed to the browser)
PUBLIC_API_URL="http://localhost:8787"
PUBLIC_SITE_URL="http://localhost:4321"
