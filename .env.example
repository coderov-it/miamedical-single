# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miamedical"

# Hono API
API_PORT=8787
API_HOST="0.0.0.0"
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS="http://localhost:4321,http://localhost:5173"

# Session / auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# How long a back-office session lasts without re-authenticating
SESSION_TTL_DAYS=7
# Set only when the admin panel and the API are on different subdomains
# AUTH_COOKIE_DOMAIN=".miamedical.com"
# lax | strict | none — "none" is required for cross-site setups and needs HTTPS
AUTH_COOKIE_SAMESITE="lax"
# Enable only behind a proxy that overwrites X-Forwarded-For (login rate limiting)
TRUST_PROXY="false"

# Cloudflare R2 object storage (S3 API). Optional in local dev — media upload
# endpoints fail with a clear error until these are set. Size/mime limits are
# code, not env: see MEDIA_PROFILES in packages/validators/src/media.ts.
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="miamedical-media"
# WebP quality for server-side image conversion (1-100, visually lossless ~92)
MEDIA_WEBP_QUALITY=92
# Staging uploads older than this are deleted by the orphan sweep
MEDIA_STAGING_TTL_HOURS=24
# ISO 4217 — the catalog's default currency
DEFAULT_CURRENCY="EUR"

# Public (exposed to the browser)
PUBLIC_API_URL="http://localhost:8787"
PUBLIC_SITE_URL="http://localhost:4321"
# Prepended by the website/admin to every stored media path
PUBLIC_MEDIA_BASE_URL="https://media.miamedical.com"
# Base URL the admin SPA calls. Leave unset: /api then stays same-origin (the
# dev proxy, or nginx in production) and the lax session cookie is sent.
# Set it only if the admin is on a different origin than the API — which also
# requires AUTH_COOKIE_SAMESITE="none" and this origin in CORS_ORIGINS.
# PUBLIC_ADMIN_API_URL="https://api.miamedical.com"

# ---------------------------------------------------------------------------
# One-off WordPress/WooCommerce migration (apps/server/script/wp-migrate).
# Read-only, and read straight from process.env rather than the app's env
# schema — nothing in the running server touches MySQL. See
# docs/code/wp-migration.md.
# ---------------------------------------------------------------------------
# WP_MYSQL_HOST="127.0.0.1"
# WP_MYSQL_PORT="3306"
# WP_MYSQL_USER="root"
# WP_MYSQL_PASSWORD=""
# WP_MYSQL_DATABASE="default"
# WP_TABLE_PREFIX="wp_"
# Where the old site still serves wp-content/uploads, for the media download
# WP_MEDIA_BASE_URL="https://www.miamedicalitalia.it"
