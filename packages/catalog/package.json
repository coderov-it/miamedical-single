{
  "name": "@mia/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "sync": "tsx --env-file-if-exists=../../.env src/script/sync/index.ts",
    "media": "tsx --env-file-if-exists=../../.env src/script/media.ts",
    "preview:html": "tsx src/script/preview/index.ts",
    "check": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules"
  },
  "devDependencies": {
    "@mia/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@mia/db": "workspace:*",
    "@mia/media": "workspace:*",
    "@mia/validators": "workspace:*",
    "valibot": "catalog:"
  }
}
