{
  "name": "@mia/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "rolldown -c rolldown.config.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "check": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "seed": "tsx --env-file-if-exists=../../.env script/seed.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env script/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/valibot-validator": "catalog:",
    "@mia/db": "workspace:*",
    "@mia/permissions": "workspace:*",
    "@mia/validators": "workspace:*",
    "@node-rs/argon2": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "postgres": "catalog:",
    "sharp": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@mia/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
