---
/**
 * The "I più noleggiati" rail, on a tinted band.
 *
 * Same figure/ground game as the category tiles, but inverted: here the band is
 * tinted and the card is the white object on top of it. The rule holds across
 * the whole site — on white the fills are tinted, on tint they are white.
 *
 * The API has no popularity signal yet, so the parent supplies the selection
 * from `home-content.ts` — editorially featured products first. Cards are the
 * shared `ProductCard`, so the rail and the catalogue can never drift apart.
 */
import ProductCard from '~/components/catalog/ProductCard.astro';
import SectionHeading from '~/components/primitives/SectionHeading.astro';
import type { ProductSummary } from '~/lib/catalog';
import { routes } from '~/lib/routes';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;
---

{
  products.length > 0 && (
    <section
      class="mt-section-sm bg-tint py-section-sm mid:mt-section mid:py-section"
      aria-labelledby="home-products-title"
    >
      <div class="max-w-page mid:px-8 mx-auto w-full px-5">
        <SectionHeading
          id="home-products"
          heading="I più noleggiati"
          lede="Prezzi chiari, tutto incluso."
          linkHref={routes.catalog}
          linkLabel="Vedi tutto il catalogo →"
        />

        <ul class="mid:grid-cols-2 wide:grid-cols-3 grid gap-6">
          {products.map((product) => (
            <li class="flex">
              <ProductCard product={product} headingLevel={3} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
