---
/**
 * "I più noleggiati" — white cards on the whisper-gray band, ported 1:1 from
 * docs/blueprint/home.html with Tailwind utilities.
 *
 * An Embla core carousel (the project-wide engine): the slides are plain
 * server-rendered HTML and the script below only attaches scrolling behavior,
 * so nothing here blocks SSR. The last slide is never a product — it is the
 * invitation into the full catalogue.
 *
 * The API has no popularity signal yet, so the parent supplies the selection
 * from `home-content.ts` — editorially featured products first.
 */
import { mediaUrl } from '~/lib/api';
import type { ProductSummary } from '~/lib/catalog';
import { productOffer } from '~/lib/home-content';
import { localeForRequest, translate } from '~/lib/i18n';
import { productPath, routePath } from '~/lib/routes';
import {
  EDITORIAL_CONTAINER,
  EDITORIAL_THEME,
  INVISIBLE_48,
  SECTION_TITLE,
} from '~/styles/editorial';

interface Props {
  products: ProductSummary[];
  /** Whole-catalogue size, for the browse tile's count line. */
  total: number;
}

const { products, total } = Astro.props;
const locale = localeForRequest();
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

/* "Oltre 60 ausili a noleggio" — rounded DOWN so the claim is never a lie.
   Below ten products a rounded figure would read as zero, so the tile says
   the exact count instead. */
const roundedTotal = Math.floor(total / 10) * 10;
const browseCount =
  total > 10
    ? text('home.rail.countOver', { count: roundedTotal })
    : text(total === 1 ? 'home.rail.countOne' : 'home.rail.countMany', { count: total });

const arrowClass =
  `${INVISIBLE_48} grid size-11 min-h-0 min-w-0 place-items-center rounded-full border ` +
  'border-[var(--color-line)] bg-white text-[var(--color-ink)] ' +
  'hover:not-disabled:border-[var(--color-accent)] hover:not-disabled:text-[var(--color-accent)] ' +
  'disabled:cursor-default disabled:opacity-35';
---

{
  products.length > 0 && (
    <section
      class:list={[
        EDITORIAL_THEME,
        'border-t border-[var(--color-line)] bg-[#f6f7f9] pt-[var(--band-1)] pb-[var(--band-3)]',
      ]}
      aria-labelledby="trending-title"
    >
      <div class={EDITORIAL_CONTAINER}>
        <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
          <h2 class={SECTION_TITLE} id="trending-title">
            {text('home.rail.title')}
            <svg
              width="44"
              height="16"
              viewBox="0 0 44 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M1 8h41M35 1.5 42.5 8 35 14.5" />
            </svg>
          </h2>
          <div class="flex items-center gap-6">
            <a
              class="border-b border-[var(--color-line)] pb-0.5 text-[1.0625rem] font-semibold whitespace-nowrap text-[var(--color-ink)] no-underline hover:border-current hover:text-[var(--color-accent)]"
              href={routePath(locale, 'catalog')}
            >
              {text('home.rail.seeAll')}
            </a>
            <div class="flex gap-2">
              <button
                class={arrowClass}
                type="button"
                data-carousel-prev="trending"
                aria-label={text('home.rail.previous')}
                disabled
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m14 6-6 6 6 6" />
                </svg>
              </button>
              <button
                class={arrowClass}
                type="button"
                data-carousel-next="trending"
                aria-label={text('home.rail.next')}
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m10 6 6 6-6 6" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div
          class="wide:[--slide-size:25%] mt-7.5 [--slide-size:78%] [--slide-spacing:14px] min-[900px]:[--slide-size:33.3333%] sm:[--slide-size:50%]"
          data-carousel="trending"
        >
          <div class="trend-viewport overflow-hidden">
            <ul class="-ms-[var(--slide-spacing)] flex touch-pan-y touch-pinch-zoom">
              {products.map((product) => {
                const offer = productOffer(product, locale);
                const href = productPath(product.slug, {}, locale);
                return (
                  <li class="flex min-w-0 flex-[0_0_var(--slide-size)] ps-[var(--slide-spacing)]">
                    <article class="group/product flex w-full flex-col rounded-[20px] border border-[var(--color-line)] bg-white px-3 pt-3 pb-4 hover:border-[#ccd2e2]">
                      <a class="block no-underline" href={href}>
                        <span class="mb-4 block h-44.5 rounded-xl bg-[var(--color-surface-2)] p-3.5">
                          {product.thumbnail && (
                            <img
                              class="block size-full object-contain mix-blend-multiply"
                              src={mediaUrl(product.thumbnail.path)}
                              alt=""
                              loading="lazy"
                            />
                          )}
                        </span>
                        <h3 class="line-clamp-2 min-h-[calc(2*1.35em)] px-2 text-[1.0625rem] leading-[1.35] font-[650] group-hover/product:text-[var(--color-accent)]">
                          {product.title}
                        </h3>
                      </a>
                      {offer && (
                        <p class="mt-3 mb-4 px-2 text-[0.9375rem] text-[var(--color-ink-soft)]">
                          <strong class="me-1.25 text-[1.375rem] font-[750] tracking-[-0.01em] text-[var(--color-ink)] tabular-nums">
                            {offer.money}
                          </strong>
                          {offer.unit}
                        </p>
                      )}
                      <a
                        class="mt-auto inline-flex min-h-12 items-center justify-center rounded-xl border-0 bg-[#eef0fb] text-base font-semibold text-[var(--color-accent)] no-underline hover:bg-[var(--color-accent)] hover:text-white"
                        href={href}
                      >
                        {text(product.pricing.mode === 'rental' ? 'card.rent' : 'card.buy')}
                      </a>
                    </article>
                  </li>
                );
              })}
              <li class="flex min-w-0 flex-[0_0_var(--slide-size)] ps-[var(--slide-spacing)]">
                <a
                  class="group/browse flex w-full flex-col items-center justify-center gap-4.5 rounded-[20px] border border-[#d5dcf0] bg-[#e7ebf8] p-6 text-center text-[var(--color-ink)] no-underline hover:border-[#b9c3e4]"
                  href={routePath(locale, 'catalog')}
                >
                  <span class="grid size-14 place-items-center rounded-full border border-[#d5dcf0] bg-white text-[var(--color-ink)] group-hover/browse:border-[var(--color-accent)] group-hover/browse:bg-[var(--color-accent)] group-hover/browse:text-white">
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 12h16" />
                      <path d="m14 6 6 6-6 6" />
                    </svg>
                  </span>
                  <span>
                    <span class="block text-[1.0625rem] leading-[1.35] font-[650]">
                      {text('home.rail.browseTitle')}
                    </span>
                    <span class="mt-1 block text-[0.9375rem] text-[var(--color-ink-soft)]">
                      {browseCount}
                    </span>
                  </span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  // Embla core — the slides are server-rendered above; this only attaches
  // scrolling behavior. Guarded: the section does not render when the
  // catalogue read failed.
  import EmblaCarousel from 'embla-carousel';

  const trendingRoot = document.querySelector<HTMLElement>('[data-carousel="trending"]');
  const viewport = trendingRoot?.querySelector<HTMLElement>('.trend-viewport');
  const prevButton = document.querySelector<HTMLButtonElement>('[data-carousel-prev="trending"]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-carousel-next="trending"]');

  if (viewport && prevButton && nextButton) {
    const embla = EmblaCarousel(viewport, {
      align: 'start',
      containScroll: 'trimSnaps',
    });

    const syncArrows = () => {
      prevButton.toggleAttribute('disabled', !embla.canScrollPrev());
      nextButton.toggleAttribute('disabled', !embla.canScrollNext());
    };

    prevButton.addEventListener('click', () => embla.scrollPrev());
    nextButton.addEventListener('click', () => embla.scrollNext());
    embla.on('select', syncArrows);
    embla.on('reInit', syncArrows);
    // On a window resize embla re-inits itself but emits only 'resize' — not
    // 'reInit' — and emits it BEFORE the internal re-init: sync a frame later
    // or the arrows go stale when the breakpoint changes.
    embla.on('resize', () => requestAnimationFrame(syncArrows));
    syncArrows();
  }
</script>
