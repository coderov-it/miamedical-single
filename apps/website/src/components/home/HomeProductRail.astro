---
/**
 * The "I più noleggiati" rail.
 *
 * The API has no popularity signal yet, so the parent supplies the selection
 * from `home-content.ts` — editorially featured products first. Cards are the
 * shared `ProductCard`, so the rail and the catalogue can never drift apart.
 */
import ProductCard from '~/components/catalog/ProductCard.astro';
import type { ProductSummary } from '~/lib/catalog';
import { routes } from '~/lib/routes';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;
---

{
  products.length > 0 && (
    <section class="products" aria-labelledby="home-products-title">
      <div class="products__inner">
        <div class="products__head">
          <div>
            <h2 id="home-products-title">I più noleggiati</h2>
            <p>Prezzi chiari, tutto incluso.</p>
          </div>
          <a href={routes.catalog}>Vedi tutto il catalogo →</a>
        </div>

        <ul class="products__grid">
          {products.map((product) => (
            <li>
              <ProductCard product={product} headingLevel={3} />
            </li>
          ))}
        </ul>

        <a class="products__mobile-all" href={routes.catalog}>
          Vedi tutto il catalogo
        </a>
      </div>
    </section>
  )
}

<style>
  .products {
    padding-top: var(--sp-13);
  }

  .products__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .products__head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }

  .products__head > div {
    flex: 1;
  }

  .products__head p {
    display: none;
    color: var(--c-ink-secondary);
  }

  .products__head > a {
    display: inline-flex;
    min-height: var(--target-min);
    align-items: center;
    color: var(--c-primary);
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 700;
    text-decoration: none;
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-4);
    list-style: none;
  }

  .products__grid > li {
    display: flex;
  }

  .products__mobile-all {
    display: none;
  }

  @media (max-width: 900px) {
    .products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .products {
      padding-top: 30px;
    }

    .products__inner {
      padding-inline: var(--sp-5);
      padding-bottom: var(--sp-2);
    }

    .products__head {
      display: block;
      margin-bottom: var(--sp-4);
    }

    .products__head h2 {
      font-size: var(--fs-h2);
    }

    .products__head p {
      display: block;
      margin-top: var(--sp-1);
      font-size: var(--fs-ui-strong);
    }

    .products__head > a {
      display: none;
    }

    .products__grid {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }

    .products__mobile-all {
      display: flex;
      min-height: 56px;
      align-items: center;
      justify-content: center;
      margin-top: var(--sp-3);
      border: 2px solid var(--c-border-accent);
      border-radius: 14px;
      background: var(--c-surface);
      color: var(--c-primary);
      font-family: var(--font-heading);
      font-size: var(--fs-ui-strong);
      font-weight: 700;
      text-decoration: none;
    }
  }
</style>
