---
/**
 * A product rail section — "I più noleggiati" and "In vendita" are the same
 * component instantiated twice, matched to the reference sections
 * (miamedicalitalia.it, 2026-08-31): plain 30px title with the see-all link on
 * its right and four cards across at full width.
 *
 * The card is `components/catalog/ProductCard` — the same one the listings use,
 * minus the blurb, exactly as on the reference site. The rail owns the rhythm
 * and the scrolling; it says nothing about what a product card looks like.
 *
 * An Embla core carousel (the project-wide engine): the slides are plain
 * server-rendered HTML and the script below only attaches scrolling behavior,
 * so nothing here blocks SSR. When `total` is given the last slide is not a
 * product — it is the invitation into the full catalogue.
 *
 * BELOW `mid` THERE IS NO CAROUSEL. The reference site lists its phone rails
 * vertically — four rows, then a full-width outlined "Vedi tutto il catalogo"
 * (miamedicalitalia.it at 390px, measured 2026-08-31) — and it is the better
 * pattern for the audience: a swipe deck hides two thirds of what it holds
 * behind a gesture, and `ProductCard`'s phone row is short enough that four of
 * them cost less height than one slide used to.
 *
 * Which means the Embla instance must not exist on a phone, and the script
 * below gates on the same 45rem the `mid` variant uses. Nothing is duplicated
 * to get there: the same `<ul>` is a flex track above the breakpoint and a
 * column below it, and the browse tile is the same `<a>` painted as a slide or
 * as a full-width button.
 *
 * FOUR ROWS ON A PHONE, NOT EIGHT — the reference's own count. A deck of eight
 * costs nothing to swipe past and a column of eight costs 1000px of scrolling,
 * so below `mid` the rail shows four and hands the rest to the button under
 * them, which is the whole point of the button being there.
 *
 * They are HIDDEN, not dropped: rows five to eight render on the server and CSS
 * takes them out of the phone's paint. The mobile page is the indexed page, so
 * cutting them from the markup would cut four product links out of the home
 * page's link graph to save height that `display:none` already saves.
 *
 * The API has no popularity signal yet, so the parent supplies the selection
 * from `home-content.ts` — editorially featured products first.
 */
import ProductCard from '~/components/catalog/ProductCard.astro';
import type { ProductSummary } from '~/lib/catalog';
import { localeForRequest, translate } from '~/lib/i18n';
import {
  EDITORIAL_CONTAINER,
  EDITORIAL_THEME,
  HOME_BAND,
  HOME_SEE_ALL,
  HOME_TITLE,
  INVISIBLE_48,
} from '~/styles/editorial';

interface Props {
  /** Distinguishes the page's rails — also the carousel's wiring key. */
  id: string;
  title: string;
  seeAllLabel: string;
  seeAllHref: string;
  products: ProductSummary[];
  /** Whole-catalogue size; when given, the rail closes with the browse tile. */
  total?: number | undefined;
}

const { id, title, seeAllLabel, seeAllHref, products, total } = Astro.props;
const locale = localeForRequest();
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

/* "Oltre 60 ausili a noleggio" — rounded DOWN so the claim is never a lie.
   Below ten products a rounded figure would read as zero, so the tile says
   the exact count instead. */
const roundedTotal = total === undefined ? 0 : Math.floor(total / 10) * 10;
const browseCount =
  total !== undefined && total > 10
    ? text('home.rail.countOver', { count: roundedTotal })
    : text(total === 1 ? 'home.rail.countOne' : 'home.rail.countMany', { count: total ?? 0 });

const arrowClass =
  `${INVISIBLE_48} grid size-11 min-h-0 min-w-0 place-items-center rounded-full border ` +
  'border-[var(--color-line)] bg-white text-[var(--color-ink)] ' +
  'hover:not-disabled:border-[var(--color-accent)] hover:not-disabled:text-[var(--color-accent)] ' +
  'disabled:cursor-default disabled:opacity-35';
---

{
  products.length > 0 && (
    <section class:list={[EDITORIAL_THEME, HOME_BAND]} aria-labelledby={`${id}-title`}>
      <div class={EDITORIAL_CONTAINER}>
        <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
          <h2 class={HOME_TITLE} id={`${id}-title`}>
            {title}
          </h2>
          <div class="flex items-center gap-6">
            <a class={HOME_SEE_ALL} href={seeAllHref}>
              {seeAllLabel}
            </a>
            {/* Phones swipe the rail; the arrows would overflow the header row. */}
            <div class="mid:flex hidden gap-2">
              <button
                class={arrowClass}
                type="button"
                data-carousel-prev={id}
                aria-label={text('home.rail.previous')}
                disabled
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m14 6-6 6 6 6" />
                </svg>
              </button>
              <button
                class={arrowClass}
                type="button"
                data-carousel-next={id}
                aria-label={text('home.rail.next')}
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m10 6 6 6-6 6" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div
          class="wide:[--slide-size:25%] max-mid:mt-4 mt-6 [--slide-size:78%] [--slide-spacing:16px] min-[900px]:[--slide-size:33.3333%] sm:[--slide-size:50%]"
          data-carousel-rail={id}
        >
          <div class="rail-viewport mid:overflow-hidden">
            <ul class="mid:-ms-(--slide-spacing) mid:flex mid:flex-row max-mid:flex-col max-mid:gap-3 max-mid:[&>li:nth-child(n+5):not(:last-child)]:hidden flex touch-pan-y touch-pinch-zoom">
              {products.map((product) => (
                <li class="mid:flex-[0_0_var(--slide-size)] mid:ps-[var(--slide-spacing)] flex min-w-0 flex-none">
                  <ProductCard {product} headingLevel={3} />
                </li>
              ))}
              {total !== undefined && (
                <li class="mid:flex-[0_0_var(--slide-size)] mid:ps-[var(--slide-spacing)] flex min-w-0 flex-none">
                  {/* A slide in the deck above `mid`; the reference's
                      full-width outlined button below it. */}
                  <a
                    class="group/browse rounded-card mid:flex-col mid:gap-4.5 mid:bg-[#e7ebf8] mid:p-6 max-mid:min-h-14 max-mid:gap-2.5 max-mid:rounded-[14px] max-mid:bg-white flex w-full flex-row items-center justify-center gap-4.5 border border-[#d5dcf0] p-6 text-center text-[var(--color-ink)] no-underline hover:border-[#b9c3e4]"
                    href={seeAllHref}
                  >
                    <span class="mid:size-14 mid:border mid:bg-white max-mid:order-2 max-mid:size-6 max-mid:border-0 grid size-14 place-items-center rounded-full border border-[#d5dcf0] text-[var(--color-ink)] group-hover/browse:border-[var(--color-accent)] group-hover/browse:bg-[var(--color-accent)] group-hover/browse:text-white">
                      <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M4 12h16" />
                        <path d="m14 6 6 6-6 6" />
                      </svg>
                    </span>
                    <span class="max-mid:order-1">
                      <span class="max-mid:text-accent block text-[1.0625rem] leading-[1.35] font-[650]">
                        {text('home.rail.browseTitle')}
                      </span>
                      <span class="max-mid:hidden mt-1 block text-[0.9375rem] text-[var(--color-ink-soft)]">
                        {browseCount}
                      </span>
                    </span>
                  </a>
                </li>
              )}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  /*
   * Embla core — the slides are server-rendered above; this only attaches
   * scrolling behavior, once per rail on the page. Guarded: a rail does not
   * render at all when its selection is empty.
   *
   * DESKTOP ONLY. Below `mid` the rail is a plain vertical list (see the
   * component doc), and Embla would fight it: it transforms the track and
   * pins each slide's width, which is exactly what the phone layout undoes.
   * So the instance is created when the query matches and DESTROYED when it
   * stops matching — the same thing Astro's `client:media` does for an island,
   * done by hand because these slides are markup, not a component.
   *
   * `45rem` is `--breakpoint-mid`. If that token moves, this moves with it.
   */
  import EmblaCarousel from 'embla-carousel';
  import type { EmblaCarouselType } from 'embla-carousel';

  const desktop = matchMedia('(min-width: 45rem)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel-rail]')) {
    const id = root.dataset.carouselRail ?? '';
    const viewport = root.querySelector<HTMLElement>('.rail-viewport');
    const prevButton = document.querySelector<HTMLButtonElement>(`[data-carousel-prev="${id}"]`);
    const nextButton = document.querySelector<HTMLButtonElement>(`[data-carousel-next="${id}"]`);
    if (!viewport || !prevButton || !nextButton) continue;

    let embla: EmblaCarouselType | null = null;

    const syncArrows = () => {
      if (!embla) return;
      prevButton.toggleAttribute('disabled', !embla.canScrollPrev());
      nextButton.toggleAttribute('disabled', !embla.canScrollNext());
    };

    prevButton.addEventListener('click', () => embla?.scrollPrev());
    nextButton.addEventListener('click', () => embla?.scrollNext());

    const apply = () => {
      if (!desktop.matches) {
        embla?.destroy();
        embla = null;
        return;
      }
      if (embla) return;
      embla = EmblaCarousel(viewport, { align: 'start', containScroll: 'trimSnaps' });
      embla.on('select', syncArrows);
      embla.on('reInit', syncArrows);
      // On a window resize embla re-inits itself but emits only 'resize' — not
      // 'reInit' — and emits it BEFORE the internal re-init: sync a frame later
      // or the arrows go stale when the breakpoint changes.
      embla.on('resize', () => requestAnimationFrame(syncArrows));
      syncArrows();
    };

    apply();
    desktop.addEventListener('change', apply);
  }
</script>
