---
/**
 * The booking card — the hero's one action: a white card straddling the pale
 * band's bottom edge, holding its own question and the search bar. It carries
 * the page's only resting shadow.
 *
 * The question has no sub-line under it. It used to say where we deliver, which
 * the hero kicker and the trust strip below already say twice — 30px of card
 * height for a third telling (owner, 2026-08-27).
 *
 * Rendered by `HomeHero`, not by the page: the overlap is part of the hero's
 * composition, and there is exactly one search bar on the site.
 *
 * A native GET form landing on the SEARCH page, not the catalogue (owner,
 * 2026-08-30): the customer has typed a query and picked a date, and search is
 * the one surface that answers a typed query — it owns the sort, the category
 * filter and the result count. `area` and `from` are carried, not filters: they
 * are echoed back and the product page prefills from them (see routes.ts §
 * BrowseContext).
 *
 * The zone and date use the storefront's reusable progressive-enhancement
 * primitives. Both render native form controls first; the dropdown behavior
 * and Cally calendar replace only their paint after JavaScript is ready, while
 * every choice continues to write through the native control.
 *
 * The zone is NOT `required`. It used to be, and it cannot stay: a hidden
 * `required` control is unfocusable, so Chrome would refuse the submit with no
 * message anywhere on screen — the silent block CLAUDE.md forbids. The zone is
 * carried context, not a filter, and the catalogue is complete without it.
 */
import DatePicker from '~/components/primitives/DatePicker.astro';
import Dropdown from '~/components/primitives/Dropdown.astro';
import { localeForRequest, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { SERVICE_AREAS } from '~/lib/site';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

/* The zone options: `value` is the wire key, the label is UI copy — so the
   label is translated and the value never is. */
const areaOptions = SERVICE_AREAS.map((area) => ({
  value: area.value,
  label: text(`area.${area.value}`),
}));
---

<section
  class="relative rounded-[var(--radius-bar)] border border-[var(--color-line)] bg-white px-6 pt-5.5 pb-6 shadow-[var(--shadow-whisper)]"
  aria-labelledby="booking-title"
>
  <h2 class="text-[clamp(1.25rem,2vw,1.5rem)] font-bold tracking-[-0.02em]" id="booking-title">
    {text('home.booking.title')}
  </h2>

  <form
    class="mt-4.5 grid gap-3 text-left min-[1020px]:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)_minmax(0,1fr)_auto] min-[1020px]:items-end min-[1020px]:gap-3.5"
    method="get"
    action={routePath(locale, 'search')}
    role="search"
    aria-label={text('home.booking.formLabel')}
  >
    <label class="grid min-w-0 content-start gap-1.75" for="booking-product">
      <span class="text-xs font-[650] tracking-[0.07em] text-[var(--color-ink-soft)] uppercase"
        >{text('home.booking.query')}</span
      >
      <span
        class="flex min-h-13.5 w-full cursor-text items-center gap-2.5 rounded-[var(--radius-control)] border-0 bg-[var(--color-surface)] px-3.5 text-left text-[var(--color-ink)] hover:bg-[var(--color-surface-2)] has-focus-visible:bg-white has-focus-visible:shadow-[0_0_0_2px_#fff] has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-[var(--color-accent)]"
      >
        <svg
          class="size-4.5 flex-none text-[var(--color-ink-soft)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
          ></path>
        </svg>
        <input
          class="font-ui min-h-0 min-w-0 flex-1 overflow-hidden border-0 bg-transparent p-0 text-[1.0625rem] font-semibold text-ellipsis whitespace-nowrap placeholder:font-medium placeholder:text-[var(--color-ink-soft)] placeholder:opacity-100 focus-visible:shadow-none focus-visible:outline-none"
          data-focus-owner
          id="booking-product"
          name="q"
          type="search"
          autocomplete="off"
          placeholder={text('home.booking.queryPlaceholder')}
        />
      </span>
    </label>

    <Dropdown
      id="booking-area"
      name="area"
      label={text('home.booking.area')}
      options={areaOptions}
      placeholder={text('home.booking.areaPlaceholder')}
      variant="hero"
      class="grid min-w-0 content-start gap-1.75"
    >
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
        <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
        ></path>
      </svg>
    </Dropdown>

    <DatePicker
      id="booking-start"
      name="from"
      label={text('home.booking.startDate')}
      min="today"
      variant="hero"
      class="grid min-w-0 content-start gap-1.75"
    >
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="16" rx="2.5"></rect>
        <path d="M3 10h18M8 3v4M16 3v4"></path>
      </svg>
    </DatePicker>

    <button
      class="inline-flex min-h-13.5 items-center justify-center gap-2.5 rounded-[var(--radius-control)] border-0 bg-[var(--color-accent)] px-7.5 text-[1.0625rem] font-semibold text-white hover:bg-[var(--color-accent-deep)] min-[1020px]:ms-1"
      type="submit"
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        ></path>
      </svg>
      {text('home.booking.submit')}
    </button>
  </form>
</section>
