---
/**
 * The booking card — the white bar straddling the hero's bottom edge, restyled
 * to the owner's hero reference (2026-08-31): a title with a reassurance note
 * on its right, then four grey SEGMENTS — each a box carrying its own label —
 * and the search button closing the row.
 *
 * Rendered by `HomeHero`, not by the page: the overlap is part of the hero's
 * composition, and there is exactly one search bar on the site.
 *
 * A native GET form landing on the SEARCH page, not the catalogue (owner,
 * 2026-08-30): the customer has typed a query and picked a date, and search is
 * the one surface that answers a typed query — it owns the sort, the category
 * filter and the result count. `area`, `from` and `for` are carried, not
 * filters: they ride the query string so the funnel remembers them (see
 * routes.ts § BrowseContext). `for` is a fuzzy duration bucket, never a package.
 *
 * The zone and date use the storefront's reusable progressive-enhancement
 * primitives. Both render native form controls first; the dropdown behavior
 * and Cally calendar replace only their paint after JavaScript is ready, while
 * every choice continues to write through the native control.
 *
 * No segment is `required`. The zone used to be, and it cannot be: a hidden
 * `required` control is unfocusable, so Chrome would refuse the submit with no
 * message anywhere on screen — the silent block CLAUDE.md forbids. Everything
 * here is carried context, and the catalogue is complete without it.
 *
 * ------------------------------------------------------------------ mobile ---
 *
 * BELOW `mid` THIS IS ONE FIELD. The reference site opens its phone home page
 * with a labelled search box and nothing else (miamedicalitalia.it at 390px,
 * measured 2026-08-31) — no zone, no date, no duration — and it is right to:
 * four stacked 95px segments cost 474px of a 844px screen to collect three
 * things the customer has not been asked to think about yet, and the product
 * page collects the dates properly anyway.
 *
 * So the three context segments stand down and the query segment becomes the
 * field. Standing down is safe precisely because nothing here is `required`:
 * they are carried context, and a search with none of it set is a complete
 * search. The submit does NOT stand down with them — it becomes the round icon
 * button inside the field's right end. A search box whose only way forward is
 * the keyboard's own Go key is the silent block again, in a new costume.
 *
 * The card's frame goes too: on a phone this is a white band ruled off the
 * hero below it, not a card floating on a grey field.
 */
import DatePicker from '~/components/primitives/DatePicker.astro';
import Dropdown from '~/components/primitives/Dropdown.astro';
import { localeForRequest, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { SERVICE_AREAS } from '~/lib/site';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

/* Option `value`s are the wire keys, the labels are UI copy — so the label is
   translated and the value never is. */
const areaOptions = SERVICE_AREAS.map((area) => ({
  value: area.value,
  label: text(`area.${area.value}`),
}));
const durationOptions = ['1w', '2w', '1m', '2m', 'unsure'].map((value) => ({
  value,
  label: text(`home.booking.for.${value}`),
}));

/* One grey segment of the bar: the box carries the label INSIDE it, and the
   primitives' `hero` variant renders a transparent control to sit in it. */
const segmentClass =
  'grid min-w-0 content-center rounded-[var(--radius-control)] bg-[var(--color-surface)] ' +
  'px-3.5 py-2.5 hover:bg-[var(--color-surface-2)]';
---

<section
  class="mid:rounded-[var(--radius-bar)] mid:border mid:border-[var(--color-line)] mid:px-6 mid:pt-5.5 mid:pb-6 mid:shadow-[var(--shadow-whisper)] max-mid:border-b max-mid:border-[var(--color-line)] max-mid:px-gutter max-mid:pt-4 max-mid:pb-4.5 relative bg-white"
  aria-labelledby="booking-title"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    {/* The phone heading IS the field's label — 16px bold, sitting on it. */}
    <h2
      class="mid:text-[clamp(1.25rem,2vw,1.5rem)] mid:tracking-[-0.02em] max-mid:text-base max-mid:mb-2 font-bold"
      id="booking-title"
    >
      {text('home.booking.title')}
    </h2>
    <p class="max-mid:hidden text-sm text-[var(--color-ink-soft)]">
      {text('home.booking.note')}
    </p>
  </div>

  <form
    class="mid:mt-4 mid:grid mid:gap-3 max-mid:relative max-mid:block text-left min-[1020px]:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_auto] min-[1020px]:items-stretch"
    method="get"
    action={routePath(locale, 'search')}
    role="search"
    aria-label={text('home.booking.formLabel')}
  >
    <label
      class:list={[
        segmentClass,
        'cursor-text has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-[var(--color-accent)]',
        'max-mid:min-h-14 max-mid:rounded-[14px] max-mid:pe-14 max-mid:ps-3.5',
      ]}
      for="booking-product"
    >
      {
        /* The segment's own caption is the desktop bar's; on a phone the
          section heading above already labels this field, so a second label
          inside it would say the same thing twice. */
      }
      <span
        class="max-mid:sr-only mb-0.5 text-[0.6875rem] font-[650] tracking-[0.08em] text-[var(--color-ink-soft)] uppercase"
        >{text('home.booking.query')}</span
      >
      <input
        class="placeholder:text-ink-placeholder max-mid:text-[1.0625rem] min-h-7 w-full min-w-0 overflow-hidden border-0 bg-transparent p-0 text-[1rem] font-semibold text-ellipsis whitespace-nowrap text-[var(--color-ink)] placeholder:font-normal placeholder:opacity-100 focus-visible:shadow-none focus-visible:outline-none"
        data-focus-owner
        id="booking-product"
        name="q"
        type="search"
        autocomplete="off"
        placeholder={text('home.booking.queryPlaceholder')}
      />
    </label>

    <Dropdown
      id="booking-area"
      name="area"
      label={text('home.booking.area')}
      options={areaOptions}
      placeholder={text('home.booking.areaPlaceholder')}
      variant="hero"
      class={`${segmentClass} max-mid:hidden`}
    />

    <DatePicker
      id="booking-start"
      name="from"
      label={text('home.booking.startDate')}
      min="today"
      variant="hero"
      class={`${segmentClass} max-mid:hidden`}
    >
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="16" rx="2.5"></rect>
        <path d="M3 10h18M8 3v4M16 3v4"></path>
      </svg>
    </DatePicker>

    <Dropdown
      id="booking-for"
      name="for"
      label={text('home.booking.for')}
      options={durationOptions}
      placeholder={text('home.booking.forPlaceholder')}
      variant="hero"
      class={`${segmentClass} max-mid:hidden`}
    />

    {/* Inside the field's right end on a phone, its own row on desktop. */}
    <button
      class="mid:min-h-15 mid:gap-2.5 mid:rounded-[var(--radius-control)] mid:px-7 max-mid:absolute max-mid:end-2 max-mid:bottom-2 max-mid:size-11 max-mid:min-h-11 max-mid:min-w-11 max-mid:rounded-field max-mid:px-0 inline-flex items-center justify-center border-0 bg-[var(--color-accent)] text-[1.0625rem] font-semibold text-white hover:bg-[var(--color-accent-deep)]"
      type="submit"
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        ></path>
      </svg>
      <span class="max-mid:sr-only">{text('home.booking.submit')}</span>
    </button>
  </form>
</section>
