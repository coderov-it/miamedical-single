---
/**
 * The booking card — the hero's one action: a white card straddling the pale
 * band's bottom edge, holding its own question and the search bar. It carries
 * the page's only resting shadow.
 *
 * The question has no sub-line under it. It used to say where we deliver, which
 * the hero kicker and the trust strip below already say twice — 30px of card
 * height for a third telling (owner, 2026-08-27).
 *
 * Rendered by `HomeHero`, not by the page: the overlap is part of the hero's
 * composition, and there is exactly one search bar on the site.
 *
 * A native GET form: the chosen criteria land in the catalogue URL. `area` and
 * `from` are carried, not filters — the catalogue echoes them back and the
 * product page prefills from them (see routes.ts § BrowseContext).
 *
 * The zone and date use the storefront's reusable progressive-enhancement
 * primitives. Both render native form controls first; the dropdown behavior
 * and Cally calendar replace only their paint after JavaScript is ready, while
 * every choice continues to write through the native control.
 *
 * The zone is NOT `required`. It used to be, and it cannot stay: a hidden
 * `required` control is unfocusable, so Chrome would refuse the submit with no
 * message anywhere on screen — the silent block CLAUDE.md forbids. The zone is
 * carried context, not a filter, and the catalogue is complete without it.
 */
import DatePicker from '~/components/primitives/DatePicker.astro';
import Dropdown from '~/components/primitives/Dropdown.astro';
import { routes } from '~/lib/routes';
import { SERVICE_AREAS } from '~/lib/site';
---

<section class="booking-card" aria-labelledby="booking-title">
  <h2 class="booking-title" id="booking-title">Dove ti serve l’ausilio?</h2>

  <form
    class="search-bar"
    method="get"
    action={routes.catalog}
    role="search"
    aria-label="Cerca disponibilità per un ausilio a noleggio"
  >
    <label class="bar-cell" for="booking-product">
      <span class="bar-label">Cerca per nome</span>
      <span class="bar-field">
        <svg
          class="bar-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
          ></path>
        </svg>
        <input
          id="booking-product"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="es. Carrozzina"
        />
      </span>
    </label>

    <Dropdown
      id="booking-area"
      name="area"
      label="Zona"
      options={SERVICE_AREAS}
      placeholder="Scegli la zona"
      variant="hero"
      class="bar-cell"
    >
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
        <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
        ></path>
      </svg>
    </Dropdown>

    <DatePicker
      id="booking-start"
      name="from"
      label="Data di inizio"
      min="today"
      placeholder="Scegli la data"
      variant="hero"
      class="bar-cell"
    >
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="16" rx="2.5"></rect>
        <path d="M3 10h18M8 3v4M16 3v4"></path>
      </svg>
    </DatePicker>

    <button class="bar-submit" type="submit">
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        ></path>
      </svg>
      Prenota ora
    </button>
  </form>
</section>
