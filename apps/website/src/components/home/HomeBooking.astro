---
/**
 * The booking card — the white bar straddling the hero's bottom edge, restyled
 * to the owner's hero reference (2026-08-31): a title with a reassurance note
 * on its right, then four grey SEGMENTS — each a box carrying its own label —
 * and the search button closing the row.
 *
 * Rendered by `HomeHero`, not by the page: the overlap is part of the hero's
 * composition, and there is exactly one search bar on the site.
 *
 * A native GET form landing on the SEARCH page, not the catalogue (owner,
 * 2026-08-30): the customer has typed a query and picked a date, and search is
 * the one surface that answers a typed query — it owns the sort, the category
 * filter and the result count. `area`, `from` and `for` are carried, not
 * filters: they ride the query string so the funnel remembers them (see
 * routes.ts § BrowseContext). `for` is a fuzzy duration bucket, never a package.
 *
 * The zone and date use the storefront's reusable progressive-enhancement
 * primitives. Both render native form controls first; the dropdown behavior
 * and Cally calendar replace only their paint after JavaScript is ready, while
 * every choice continues to write through the native control.
 *
 * No segment is `required`. The zone used to be, and it cannot be: a hidden
 * `required` control is unfocusable, so Chrome would refuse the submit with no
 * message anywhere on screen — the silent block CLAUDE.md forbids. Everything
 * here is carried context, and the catalogue is complete without it.
 */
import DatePicker from '~/components/primitives/DatePicker.astro';
import Dropdown from '~/components/primitives/Dropdown.astro';
import { localeForRequest, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { SERVICE_AREAS } from '~/lib/site';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

/* Option `value`s are the wire keys, the labels are UI copy — so the label is
   translated and the value never is. */
const areaOptions = SERVICE_AREAS.map((area) => ({
  value: area.value,
  label: text(`area.${area.value}`),
}));
const durationOptions = ['1w', '2w', '1m', '2m', 'unsure'].map((value) => ({
  value,
  label: text(`home.booking.for.${value}`),
}));

/* One grey segment of the bar: the box carries the label INSIDE it, and the
   primitives' `hero` variant renders a transparent control to sit in it. */
const segmentClass =
  'grid min-w-0 content-center rounded-[var(--radius-control)] bg-[var(--color-surface)] ' +
  'px-3.5 py-2.5 hover:bg-[var(--color-surface-2)]';
---

<section
  class="relative rounded-[var(--radius-bar)] border border-[var(--color-line)] bg-white px-6 pt-5.5 pb-6 shadow-[var(--shadow-whisper)]"
  aria-labelledby="booking-title"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h2 class="text-[clamp(1.25rem,2vw,1.5rem)] font-bold tracking-[-0.02em]" id="booking-title">
      {text('home.booking.title')}
    </h2>
    <p class="text-sm text-[var(--color-ink-soft)] max-mid:hidden">
      {text('home.booking.note')}
    </p>
  </div>

  <form
    class="mt-4 grid gap-3 text-left min-[1020px]:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_auto] min-[1020px]:items-stretch"
    method="get"
    action={routePath(locale, 'search')}
    role="search"
    aria-label={text('home.booking.formLabel')}
  >
    <label
      class:list={[
        segmentClass,
        'cursor-text has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-[var(--color-accent)]',
      ]}
      for="booking-product"
    >
      <span
        class="mb-0.5 text-[0.6875rem] font-[650] tracking-[0.08em] text-[var(--color-ink-soft)] uppercase"
        >{text('home.booking.query')}</span
      >
      <input
        class="placeholder:text-ink-placeholder min-h-7 w-full min-w-0 overflow-hidden border-0 bg-transparent p-0 text-[1rem] font-semibold text-[var(--color-ink)] text-ellipsis whitespace-nowrap placeholder:font-normal placeholder:opacity-100 focus-visible:shadow-none focus-visible:outline-none"
        data-focus-owner
        id="booking-product"
        name="q"
        type="search"
        autocomplete="off"
        placeholder={text('home.booking.queryPlaceholder')}
      />
    </label>

    <Dropdown
      id="booking-area"
      name="area"
      label={text('home.booking.area')}
      options={areaOptions}
      placeholder={text('home.booking.areaPlaceholder')}
      variant="hero"
      class={segmentClass}
    />

    <DatePicker
      id="booking-start"
      name="from"
      label={text('home.booking.startDate')}
      min="today"
      variant="hero"
      class={segmentClass}
    >
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="16" rx="2.5"></rect>
        <path d="M3 10h18M8 3v4M16 3v4"></path>
      </svg>
    </DatePicker>

    <Dropdown
      id="booking-for"
      name="for"
      label={text('home.booking.for')}
      options={durationOptions}
      placeholder={text('home.booking.forPlaceholder')}
      variant="hero"
      class={segmentClass}
    />

    <button
      class="inline-flex min-h-15 items-center justify-center gap-2.5 rounded-[var(--radius-control)] border-0 bg-[var(--color-accent)] px-7 text-[1.0625rem] font-semibold text-white hover:bg-[var(--color-accent-deep)]"
      type="submit"
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        ></path>
      </svg>
      {text('home.booking.submit')}
    </button>
  </form>
</section>
