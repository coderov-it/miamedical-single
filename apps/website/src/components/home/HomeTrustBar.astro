---
/**
 * The hero's closing strip: five facts in one row under the booking card, the
 * last thing the hero says before the page starts selling.
 *
 * Every line is a claim the business can stand behind — the aggregate rating
 * comes from `REVIEW_AGGREGATE`, whose label must stay source-neutral (the
 * reviews are hand-aggregated from three platforms, not Google-verified), and
 * the other four restate what the FAQ and the delivery section already
 * promise.
 *
 * ------------------------------------------------------------------ mobile ---
 *
 * Below `mid` this is the reference's phone strip: a white band ruled off top
 * and bottom, carrying the claims in ONE row that scrolls sideways rather than
 * stacking into five (miamedicalitalia.it at 390px, measured 2026-08-31).
 *
 * The reference fits three across by setting them at 13px. This project has no
 * token below 16px, so the row scrolls instead of shrinking — two and a bit are
 * visible at rest, the rest are a swipe away, and every claim survives. The
 * The strip carries its OWN gutter (`px-gutter`) and its wrapper carries none,
 * so the row is exactly viewport-wide and the last claim clips at the screen
 * edge rather than at a margin. That clip is the whole of the affordance: a
 * strip that ends flush with the viewport does not look like it continues.
 * Do NOT add a negative margin here to "bleed" it — the wrapper already gave
 * its padding up, and the two together overflow the document by 40px.
 */
import { REVIEW_AGGREGATE } from '~/lib/home-content';
import { localeForRequest, translate } from '~/lib/i18n';

const locale = localeForRequest();
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);
---

<ul
  class:list={[
    'wide:flex-nowrap wide:justify-between wide:gap-4.5 mid:mt-8.5 mid:flex-wrap mid:gap-x-6 mid:gap-y-3.5 mid:overflow-visible mid:border-0 mid:py-0 flex list-none',
    /* The phone strip: one scrolling row on its own white band, bleeding to
       both screen edges so the overflow is visible rather than implied. */
    'max-mid:px-gutter max-mid:flex-nowrap max-mid:gap-x-5 max-mid:overflow-x-auto max-mid:[scrollbar-width:none] max-mid:[&::-webkit-scrollbar]:hidden max-mid:border-y max-mid:border-[var(--color-line)] max-mid:bg-white max-mid:py-3.5',
    '[&_li]:flex [&_li]:items-center [&_li]:gap-2.25 [&_li]:text-sm [&_li]:text-[var(--color-ink-soft)]',
    'max-mid:[&_li]:flex-none max-mid:[&_li]:text-base',
    '[&_li:first-child_svg]:text-[#f5a623] [&_strong]:font-[650] [&_strong]:text-[var(--color-ink)]',
    '[&_svg]:flex-none [&_svg]:text-[var(--color-accent)]',
  ]}
>
  <li>
    {/* Heroicons' solid star — the same cut the testimonial band uses. */}
    <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
      ></path>
    </svg>
    <span>
      <strong>{REVIEW_AGGREGATE.rating} / 5</strong>{' '}
      {text('home.trust.rating', { count: text(REVIEW_AGGREGATE.countKey) })}
    </span>
  </li>

  <li>
    <svg
      width="19"
      height="19"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
    </svg>
    <span>
      {text('home.trust.deliveryBefore')}{' '}
      <strong>{text('home.trust.deliveryStrong')}</strong>
    </span>
  </li>

  <li>
    <svg
      width="19"
      height="19"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
      ></path>
    </svg>
    <span>
      <strong>{text('home.trust.certifiedStrong')}</strong>{text('home.trust.certifiedAfter')}
    </span>
  </li>

  <li>
    <svg
      width="19"
      height="19"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
      <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
      ></path>
    </svg>
    <span>
      <strong>{text('home.trust.areaStrong')}</strong>{' '}
      {text('home.trust.areaAfter')}
    </span>
  </li>

  <li>
    <svg
      width="19"
      height="19"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z"
      ></path>
    </svg>
    <span>
      {text('home.trust.payBefore')}{' '}
      <strong>{text('home.trust.payStrong')}</strong>
    </span>
  </li>
</ul>
