---
/**
 * Home hero — one pale band carrying the copy on the left and the featured
 * product on the right, with the booking card straddling the band's bottom
 * edge and the trust strip closing underneath.
 *
 * The layout is the owner's reference (2026-08-27): kicker with a rule →
 * display headline → one paragraph → three service facts, and NO button in the
 * copy column. The hero's action is the booking card; a second CTA above it
 * only splits the click.
 *
 * The band's bottom padding and `.hero-foot`'s negative margin are one number
 * seen twice — that overlap is the whole composition, so change them together.
 */
import HomeBooking from '~/components/home/HomeBooking.astro';
import HomeShowcase from '~/components/home/HomeShowcase.astro';
import HomeTrustBar from '~/components/home/HomeTrustBar.astro';
import type { ProductSummary } from '~/lib/catalog';
import { localeForRequest, translate } from '~/lib/i18n';
import { EDITORIAL_CONTAINER, EDITORIAL_THEME } from '~/styles/editorial';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;
const locale = localeForRequest();
const text = (key: string) => translate(locale, key);
---

<section
  class:list={[
    EDITORIAL_THEME,
    '[--hero-overlap:clamp(64px,calc(3.57vw+38.3px),84px)] [--spot-control-size:46px]',
  ]}
  aria-labelledby="home-title"
>
  <div
    class="bg-[var(--color-surface)] pt-[clamp(40px,calc(3.57vw+14.3px),60px)] pb-[calc(var(--hero-overlap)+18px)]"
  >
    <div
      class:list={[
        EDITORIAL_CONTAINER,
        'wide:grid-cols-[minmax(0,1fr)_minmax(440px,1.06fr)] wide:gap-x-11 grid items-center gap-10',
      ]}
    >
      <div class="wide:mb-[var(--spot-control-size)]">
        <p
          class="mb-4.5 flex items-center gap-3.5 text-[0.8125rem] font-[650] tracking-[0.11em] text-[var(--color-ink-soft)] uppercase before:h-0.75 before:w-8.5 before:flex-none before:rounded-[3px] before:bg-[var(--color-accent)] before:content-['']"
        >
          {text('home.hero.kicker')}
        </p>

        <h1
          class="text-[clamp(2.5rem,4.6vw,3.875rem)] leading-[1.04] font-[550] tracking-[-0.032em] text-balance [&_strong]:font-[760]"
          id="home-title"
        >
          {text('home.hero.line1')}<br />
          {text('home.hero.line2')}<br />
          <strong>{text('home.hero.line3')}</strong>
        </h1>

        <p class="mt-5.5 max-w-[52ch] text-[1.0625rem] leading-[1.65] text-[var(--color-ink-soft)]">
          {text('home.hero.sub')}
        </p>

        <ul
          class="mt-7.5 flex list-none flex-wrap gap-x-6 gap-y-3 [&_li]:flex [&_li]:items-center [&_li]:gap-2.25 [&_li]:text-sm [&_li]:font-semibold [&_svg]:flex-none [&_svg]:text-[var(--color-accent)]"
        >
          <li>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
              ></path>
            </svg>
            {text('home.hero.feature.delivery')}
          </li>
          <li>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
              ></path>
            </svg>
            {text('home.hero.feature.phone')}
          </li>
          <li>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
              ></path>
            </svg>
            {text('home.hero.feature.collection')}
          </li>
        </ul>
      </div>

      <HomeShowcase products={products} />
    </div>
  </div>

  <div class:list={[EDITORIAL_CONTAINER, 'relative -mt-[var(--hero-overlap)] pb-9']}>
    <HomeBooking />
    <HomeTrustBar />
  </div>
</section>
