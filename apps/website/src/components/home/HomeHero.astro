---
/**
 * Home-page hero: headline, native search panel and the featured-product
 * spotlight.
 *
 * The spotlight is a CSS carousel driven by native radio state and transforms.
 * That keeps the controls keyboard-operable without fragment navigation (which
 * would scroll the whole page) and without a line of client JavaScript.
 * Product names, images and prices come straight from the API.
 */
import { cardPrice, mediaUrl } from '~/lib/api';
import type { ProductSummary } from '~/lib/catalog';
import { productPath } from '~/lib/routes';
import HomeSearch from './HomeSearch.astro';

interface Props {
  products: ProductSummary[];
  suggestions: ProductSummary[];
}

const { products, suggestions } = Astro.props;

// The CSS transform rules below are written for at most four slides.
const slides = products.slice(0, 4);
---

<section class="hero" aria-labelledby="home-title">
  <div class="hero__inner container">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__location">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"></path>
            <circle cx="12" cy="10" r="2.6"></circle>
          </svg>
          <span class="hero__location-desktop">
            Roma e Firenze · consegna a domicilio in 24–48 ore
          </span>
          <span class="hero__location-mobile"> Roma e Firenze · consegna a domicilio </span>
        </p>

        <h1 id="home-title">Noleggio carrozzine e ausili medicali, consegnati a casa tua.</h1>

        <p class="hero__lead">
          Scegli il prodotto e le date: pensiamo a tutto noi, dalla consegna al ritiro. Prodotti
          sanificati e certificati, assistenza al telefono
          <span class="hero__people"> con persone vere.</span>
        </p>
      </div>

      {
        slides.length > 0 && (
          <div class="spotlight" aria-labelledby="spotlight-label">
            <h2 id="spotlight-label" class="sr-only">
              Prodotti in evidenza
            </h2>
            <p id="spotlight-instructions" class="sr-only">
              Usa i tasti freccia destra e sinistra per cambiare prodotto.
            </p>
            {slides.map((product, index) => (
              <input
                id={`spotlight-state-${index + 1}`}
                class="spotlight__state"
                type="radio"
                name="home-featured-product"
                value={index + 1}
                checked={index === 0}
                aria-label={`Mostra ${product.title}, prodotto ${index + 1} di ${slides.length}`}
                aria-describedby="spotlight-instructions"
              />
            ))}
            <ul class="spotlight__track">
              {slides.map((product, index) => {
                const price = cardPrice(product.pricing);
                const image = product.thumbnail;
                return (
                  <li id={`prodotto-in-evidenza-${index + 1}`} class="spotlight__slide">
                    <div class="spotlight__stage">
                      {image && (
                        <img
                          src={mediaUrl(image.path)}
                          alt={`${image.alt || product.title}, a noleggio con consegna a domicilio`}
                          loading={index === 0 ? 'eager' : 'lazy'}
                          fetchpriority={index === 0 ? 'high' : 'auto'}
                          decoding={index === 0 ? 'sync' : 'async'}
                        />
                      )}

                      {price && (
                        <span class="spotlight__price">
                          {price.prefix && `${price.prefix} `}
                          {price.text}
                        </span>
                      )}

                      <label
                        class="spotlight__arrow spotlight__arrow--previous"
                        for={`spotlight-state-${((index - 1 + slides.length) % slides.length) + 1}`}
                        aria-label="Prodotto in evidenza precedente"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m14 6-6 6 6 6" />
                        </svg>
                      </label>
                      <label
                        class="spotlight__arrow spotlight__arrow--next"
                        for={`spotlight-state-${((index + 1) % slides.length) + 1}`}
                        aria-label="Prodotto in evidenza successivo"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m10 6 6 6-6 6" />
                        </svg>
                      </label>
                    </div>

                    <div class="spotlight__dots" aria-hidden="true">
                      {slides.map((_, dotIndex) => (
                        <span class:list={['spotlight__dot', dotIndex === index && 'is-active']} />
                      ))}
                    </div>

                    <a class="spotlight__product" href={productPath(product.slug)}>
                      <span>{product.title}</span>
                      <span class="spotlight__cta">
                        Vedi e noleggia
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14" />
                          <path d="m13 6 6 6-6 6" />
                        </svg>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }

      <div class="hero__search">
        <HomeSearch suggestions={suggestions} />
      </div>
    </div>
  </div>
</section>

<section class="mobile-trust" aria-label="I vantaggi del noleggio Mia Medical">
  <div>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M1 7h13v9H1z"></path>
      <path d="M14 10h4l3 3v3h-7"></path>
      <circle cx="5.5" cy="18.5" r="1.8"></circle>
      <circle cx="17.5" cy="18.5" r="1.8"></circle>
    </svg>
    <span>Consegna in<br />24–48 ore</span>
  </div>
  <div>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3l7 3v5.5c0 4.4-3 7.9-7 9.5-4-1.6-7-5.1-7-9.5V6z"></path>
      <path d="m9 12 2 2 4-4.5"></path>
    </svg>
    <span>Sanificato e<br />certificato</span>
  </div>
  <div>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 18v-6a8 8 0 0 1 16 0v6"></path>
      <rect x="2" y="13" width="4.5" height="7" rx="2"></rect>
      <rect x="17.5" y="13" width="4.5" height="7" rx="2"></rect>
    </svg>
    <span>Assistenza<br />al telefono</span>
  </div>
</section>

<style>
  .mobile-trust,
  .hero__location-mobile {
    display: none;
  }

  .hero {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid var(--c-border);
    background:
      radial-gradient(circle at 84% 18%, rgb(46 70 153 / 0.12), transparent 30%),
      linear-gradient(180deg, #ffffff 0%, #f8faff 72%, #f4f7fd 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 44px 38px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(400px, 0.92fr);
    align-items: start;
    column-gap: 46px;
    row-gap: 22px;
  }

  .hero__copy {
    padding-top: 2px;
  }

  .hero__search {
    min-width: 0;
    grid-column: 1 / -1;
  }

  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 13px;
    padding: 6px 12px;
    border: 1px solid rgb(46 70 153 / 0.08);
    border-radius: var(--radius-pill);
    background: rgb(237 241 250 / 0.84);
    color: var(--c-primary);
    font-family: var(--font-heading);
    font-size: var(--fs-ui);
    font-weight: 700;
    line-height: 1.25;
  }

  .hero__location svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .hero h1 {
    max-width: 630px;
    margin-bottom: 13px;
    font-size: clamp(2.625rem, 3.25vw, 3rem);
    letter-spacing: -0.032em;
    line-height: 1.1;
  }

  .hero__lead {
    max-width: 560px;
    margin: 0;
    color: var(--c-ink-secondary);
    font-size: var(--fs-body);
    line-height: 1.55;
  }

  .spotlight {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(46 70 153 / 0.16);
    border-radius: 24px;
    background: rgb(255 255 255 / 0.92);
    box-shadow:
      0 22px 54px rgb(33 53 119 / 0.11),
      0 4px 14px rgb(27 36 55 / 0.05);
    backdrop-filter: blur(12px);
  }

  .spotlight__track {
    display: flex;
    list-style: none;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .spotlight__state {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
  }

  .spotlight__state:focus-visible ~ .spotlight__track {
    outline: var(--focus-ring);
    outline-offset: -5px;
    border-radius: 20px;
    box-shadow: inset 0 0 0 6px var(--c-ink);
  }

  #spotlight-state-1:checked ~ .spotlight__track {
    transform: translateX(0);
  }

  #spotlight-state-2:checked ~ .spotlight__track {
    transform: translateX(-100%);
  }

  #spotlight-state-3:checked ~ .spotlight__track {
    transform: translateX(-200%);
  }

  #spotlight-state-4:checked ~ .spotlight__track {
    transform: translateX(-300%);
  }

  .spotlight__slide {
    min-width: 100%;
    padding: 15px 15px 9px;
    visibility: hidden;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  #spotlight-state-1:checked ~ .spotlight__track .spotlight__slide:nth-child(1),
  #spotlight-state-2:checked ~ .spotlight__track .spotlight__slide:nth-child(2),
  #spotlight-state-3:checked ~ .spotlight__track .spotlight__slide:nth-child(3),
  #spotlight-state-4:checked ~ .spotlight__track .spotlight__slide:nth-child(4) {
    visibility: visible;
    opacity: 1;
  }

  .spotlight__stage {
    position: relative;
    height: 285px;
    overflow: hidden;
    border: 1px solid rgb(46 70 153 / 0.08);
    border-radius: 19px;
    background:
      radial-gradient(circle at 52% 44%, rgb(255 255 255 / 0.98), rgb(240 244 252 / 0.9) 70%),
      var(--c-surface-tint);
  }

  .spotlight__stage > img {
    width: 100%;
    height: 100%;
    padding: 20px 28px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .spotlight__price {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 8px 14px;
    border: 1px solid rgb(46 70 153 / 0.12);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 6px 18px rgb(27 36 55 / 0.1);
    color: var(--c-ink);
    font-family: var(--font-heading);
    font-size: var(--fs-ui);
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
  }

  .spotlight__arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    margin: 0;
    border: 1px solid rgb(46 70 153 / 0.16);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    box-shadow: 0 7px 18px rgb(27 36 55 / 0.13);
    color: var(--c-primary);
    cursor: pointer;
    opacity: 0.84;
    transform: translateY(-50%);
    transition:
      border-color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .spotlight__arrow:hover {
    border-color: var(--c-primary);
    opacity: 1;
  }

  .spotlight__arrow svg {
    width: 21px;
    height: 21px;
  }

  .spotlight__arrow--previous {
    left: 12px;
  }

  .spotlight__arrow--next {
    right: 12px;
  }

  .spotlight__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 11px 0 0;
  }

  .spotlight__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-border-accent);
  }

  .spotlight__dot.is-active {
    width: 24px;
    border-radius: var(--radius-pill);
    background: var(--c-primary);
  }

  .spotlight__product {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 7px;
    padding: 10px 5px 2px;
    border-top: 1px solid var(--c-surface-tint-alt);
    color: var(--c-ink);
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .spotlight__cta {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 48px;
    padding-inline: 11px;
    border-radius: 11px;
    background: var(--c-surface-tint);
    color: var(--c-primary);
    font-size: var(--fs-ui);
    white-space: nowrap;
  }

  .spotlight__cta svg {
    width: 17px;
    height: 17px;
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .hero__inner {
      padding-block: 28px 24px;
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 0.9fr);
      column-gap: 32px;
      row-gap: 14px;
    }

    .hero h1 {
      max-width: 570px;
      font-size: 2.625rem;
      line-height: 1.08;
    }

    .hero__lead {
      line-height: 1.5;
    }

    .spotlight__stage {
      height: 175px;
    }

    .spotlight__stage > img {
      padding: 18px 24px;
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .hero__search {
      grid-row: 2;
    }

    .spotlight {
      grid-row: 3;
      width: min(100%, 620px);
      justify-self: center;
    }
  }

  @media (max-width: 720px) {
    .hero__inner {
      padding: 30px 20px 26px;
    }

    .hero__grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .hero__copy {
      order: 1;
    }

    .hero__search {
      width: 100%;
      order: 2;
    }

    .spotlight {
      order: 3;
    }

    .hero__location {
      align-self: flex-start;
      margin: 0;
      gap: 7px;
      padding: 7px 10px;
    }

    .hero__location-desktop {
      display: none;
    }

    .hero__location-mobile {
      display: inline;
    }

    .hero h1 {
      max-width: 380px;
      margin: 16px 0 0;
      font-size: var(--fs-h1);
      letter-spacing: -0.025em;
      line-height: 1.14;
    }

    .hero__lead {
      max-width: 380px;
      margin-top: 13px;
      font-size: var(--fs-body);
      line-height: var(--lh-body);
    }

    .hero__people {
      display: none;
    }

    .spotlight {
      width: 100%;
      border-radius: 22px;
      background: rgb(255 255 255 / 0.88);
      box-shadow:
        0 20px 50px rgb(33 53 119 / 0.12),
        0 3px 12px rgb(27 36 55 / 0.05);
      backdrop-filter: none;
    }

    .spotlight__slide {
      padding: 13px 13px 7px;
    }

    .spotlight__stage {
      height: 230px;
      border-radius: 17px;
    }

    .spotlight__stage > img {
      padding: 17px 25px;
    }

    .spotlight__price {
      top: 10px;
      right: 10px;
      padding: 8px 14px;
      border: 0;
      background: var(--c-ink);
      color: #fff;
      box-shadow: none;
    }

    .spotlight__arrow {
      width: 48px;
      height: 48px;
    }

    .spotlight__arrow--previous {
      left: 8px;
    }

    .spotlight__arrow--next {
      right: 8px;
    }

    .spotlight__dots {
      padding-block: 12px 2px;
    }

    .spotlight__product {
      min-height: 58px;
      justify-content: center;
      margin-top: 7px;
      padding: 9px 4px 2px;
      border-color: var(--c-surface-accent);
      color: var(--c-primary);
      font-size: var(--fs-ui);
      text-align: center;
    }

    .spotlight__product > span:first-child::after {
      content: ' — vedi e noleggia';
    }

    .spotlight__cta {
      display: none;
    }

    .mobile-trust {
      display: flex;
      justify-content: space-between;
      gap: 0;
      padding: 14px 20px;
      border-bottom: 1px solid var(--c-border);
      background: var(--c-surface);
    }

    .mobile-trust > div {
      display: flex;
      flex: 1;
      align-items: center;
      flex-direction: column;
      gap: 6px;
      padding-inline: 5px;
      color: var(--c-primary);
      text-align: center;
    }

    .mobile-trust > div + div {
      border-left: 1px solid var(--c-border);
    }

    .mobile-trust svg {
      width: 24px;
      height: 24px;
    }

    .mobile-trust span {
      color: var(--c-ink);
      font-family: var(--font-heading);
      font-size: var(--fs-ui);
      font-weight: 700;
      line-height: 1.35;
    }
  }

  @media (max-width: 380px) {
    .hero__inner {
      padding-inline: 16px;
    }
  }
</style>
