---
/**
 * Home hero — copy and one accent CTA on the left, the featured-product
 * showcase on the right, ported 1:1 from docs/blueprint/home.html (styles in
 * styles/editorial.css).
 *
 * The showcase is an Embla core carousel (the project-wide engine): the slides,
 * dots and meta deck are all server-rendered HTML, and the script below only
 * attaches scrolling behavior — nothing here blocks SSR. Embla owns the track
 * transform, so the track carries no CSS transition, ever; the meta deck and
 * the dots follow the selected snap by class toggling.
 */
import { mediaUrl } from '~/lib/api';
import type { ProductSummary } from '~/lib/catalog';
import { productOffer } from '~/lib/home-content';
import { productPath, routes } from '~/lib/routes';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;
const slides = products.slice(0, 3);
---

<section class="hero" aria-labelledby="home-title">
  <div class="hero-grid container">
    <div>
      <p class="hero-kicker">Noleggio medicale · Roma e Firenze</p>

      <h1 class="hero-display" id="home-title">
        Noleggia<br />
        l’ausilio giusto,<br />
        <strong>senza pensieri.</strong>
      </h1>

      <p class="hero-sub">
        Carrozzine, letti ortopedici, scooter e molto altro: scegli quando iniziare e al resto
        pensiamo noi. Consegna a domicilio in 24–48 ore, prodotti sanificati e assistenza con
        persone vere.
      </p>

      <p class="hero-cta">
        <a class="btn-accent" href={routes.catalog}>Scopri il catalogo</a>
      </p>
    </div>

    {
      slides.length > 0 && (
        <section class="spot" data-carousel="spot" aria-labelledby="spot-label">
          <h2 class="visually-hidden" id="spot-label">
            Prodotti in evidenza
          </h2>

          <div class="spot-stage">
            <div class="spot-window" data-spot-viewport>
              <ul class="spot-track">
                {slides.map((product, index) => (
                  <li>
                    {product.thumbnail && (
                      <img
                        src={mediaUrl(product.thumbnail.path)}
                        alt={product.thumbnail.alt || product.title}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : 'auto'}
                      />
                    )}
                  </li>
                ))}
              </ul>
            </div>

            {slides.length > 1 && (
              <>
                <button
                  class="spot-arrow"
                  type="button"
                  data-spot-prev
                  aria-label="Prodotto precedente"
                >
                  <svg
                    width="19"
                    height="19"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m14 6-6 6 6 6" />
                  </svg>
                </button>
                <button
                  class="spot-arrow"
                  type="button"
                  data-spot-next
                  aria-label="Prodotto successivo"
                >
                  <svg
                    width="19"
                    height="19"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m10 6 6 6-6 6" />
                  </svg>
                </button>

                <div class="spot-dots" data-spot-dots>
                  {slides.map((_, index) => (
                    <button
                      type="button"
                      class:list={[index === 0 && 'is-active']}
                      aria-label={`Mostra il prodotto ${index + 1} di ${slides.length}`}
                    />
                  ))}
                </div>
              </>
            )}
          </div>

          <div class="meta-deck" data-spot-meta>
            {slides.map((product, index) => {
              const offer = productOffer(product);
              const href = productPath(product.slug);
              const cta = product.pricing.mode === 'rental' ? 'Noleggia ora' : 'Acquista ora';
              return (
                <div class:list={[index === 0 && 'is-active']}>
                  <a class="spot-name" href={href}>
                    {product.title}
                  </a>
                  <div class="spot-offer">
                    {offer && (
                      <p class="spot-price">
                        <strong>{offer.money}</strong>
                        {offer.unit}
                      </p>
                    )}
                    <a class="btn-accent" href={href}>
                      {cta}
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )
    }
  </div>
</section>

<script>
  // Embla core — same engine as the trending rail, loop on. Guarded: the spot
  // section does not render at all when the catalogue read failed.
  import EmblaCarousel from 'embla-carousel';

  const spotRoot = document.querySelector<HTMLElement>('[data-carousel="spot"]');
  const viewport = spotRoot?.querySelector<HTMLElement>('[data-spot-viewport]');

  if (spotRoot && viewport && viewport.querySelectorAll('li').length > 1) {
    const spot = EmblaCarousel(viewport, { loop: true });
    // Jump instead of glide for people who asked the OS for less motion.
    const jump = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const dots = [...spotRoot.querySelectorAll<HTMLButtonElement>('[data-spot-dots] button')];
    const metas = [...spotRoot.querySelectorAll<HTMLElement>('[data-spot-meta] > div')];

    const syncSpot = () => {
      const selected = spot.selectedScrollSnap();
      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === selected));
      metas.forEach((meta, index) => meta.classList.toggle('is-active', index === selected));
    };

    spotRoot
      .querySelector('[data-spot-prev]')
      ?.addEventListener('click', () => spot.scrollPrev(jump));
    spotRoot
      .querySelector('[data-spot-next]')
      ?.addEventListener('click', () => spot.scrollNext(jump));
    dots.forEach((dot, index) => dot.addEventListener('click', () => spot.scrollTo(index, jump)));
    spot.on('select', syncSpot);
    syncSpot();
  }
</script>
