---
/**
 * "Consegna e ritiro" — the mirror of the how-panel: gray cells in one
 * bordered panel, white note strip attached below, ported 1:1 from
 * docs/blueprint/home.html with Tailwind utilities.
 */
import { localeForRequest, translate } from '~/lib/i18n';
import { CONTACT } from '~/lib/site';
import {
  EDITORIAL_CONTAINER,
  EDITORIAL_THEME,
  NOTE_BAR,
  SECTION_LEAD,
  SECTION_TITLE,
} from '~/styles/editorial';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);
---

<section
  class:list={[EDITORIAL_THEME, 'bg-white pt-2 pb-[var(--band-3)]']}
  aria-labelledby="delivery-title"
>
  <div class={EDITORIAL_CONTAINER}>
    <h2 class={SECTION_TITLE} id="delivery-title">
      {text('home.delivery.title')}
      <svg
        width="44"
        height="16"
        viewBox="0 0 44 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M1 8h41M35 1.5 42.5 8 35 14.5"></path>
      </svg>
    </h2>
    <p class={SECTION_LEAD}>{text('home.delivery.lede')}</p>

    <div class="mt-10 overflow-hidden rounded-[20px] border border-[var(--color-line)]">
      <ul
        class="grid list-none grid-cols-1 min-[900px]:grid-cols-3 [&>li+li]:border-t [&>li+li]:border-[var(--color-line)] min-[900px]:[&>li+li]:border-t-0 min-[900px]:[&>li+li]:border-l"
      >
        <li class="bg-[#f6f7f9] px-7 py-6.5">
          <span
            class="grid size-11 place-items-center rounded-xl border border-[var(--color-line)] bg-white text-[var(--color-ink)]"
            aria-hidden="true"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
              ></path>
            </svg>
          </span>
          <h3 class="mt-4 text-[1.0625rem] font-[650]">{text('home.delivery.cell1.name')}</h3>
          <p class="mt-2 text-[0.9688rem] leading-[1.6] text-[var(--color-ink-soft)]">
            {text('home.delivery.cell1.text')}
          </p>
        </li>
        <li class="bg-[#f6f7f9] px-7 py-6.5">
          <span
            class="grid size-11 place-items-center rounded-xl border border-[var(--color-line)] bg-white text-[var(--color-ink)]"
            aria-hidden="true"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z"
              ></path>
            </svg>
          </span>
          <h3 class="mt-4 text-[1.0625rem] font-[650]">{text('home.delivery.cell2.name')}</h3>
          <p class="mt-2 text-[0.9688rem] leading-[1.6] text-[var(--color-ink-soft)]">
            {text('home.delivery.cell2.text')}
          </p>
        </li>
        <li class="bg-[#f6f7f9] px-7 py-6.5">
          <span
            class="grid size-11 place-items-center rounded-xl border border-[var(--color-line)] bg-white text-[var(--color-ink)]"
            aria-hidden="true"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
              ></path>
            </svg>
          </span>
          <h3 class="mt-4 text-[1.0625rem] font-[650]">{text('home.delivery.cell3.name')}</h3>
          <p class="mt-2 text-[0.9688rem] leading-[1.6] text-[var(--color-ink-soft)]">
            {text('home.delivery.cell3.text')}
          </p>
        </li>
      </ul>

      <p class={`${NOTE_BAR} bg-white`}>
        <span>
          <strong>{text('home.delivery.areasStrong')}</strong>{' '}
          {text('home.delivery.areasBefore')}{' '}
          <a href={`tel:${CONTACT.phoneE164}`}>{text('support.callUs')}</a>{
            text('support.deliveryAfter')
          }
        </span>
      </p>
    </div>
  </div>
</section>
