---
/**
 * Delivery and collection promises.
 *
 * Not a second grid of text but a strip: three guarantees side by side, icon
 * beside the heading rather than above it, divided by vertical hairlines. The
 * areas served close the strip as a row of their own.
 *
 * The block's ground is tinted, so the objects inside it are white — the same
 * figure/ground rule as everywhere else.
 */
import SectionHeading from '~/components/primitives/SectionHeading.astro';
import { CONTACT } from '~/lib/site';

const promises = [
  {
    title: 'Consegna in 24–48 ore',
    body: 'A Roma, Firenze e provincia. Anche in appartamento, al piano.',
    icon: 'truck',
  },
  {
    title: 'Montaggio incluso',
    body: 'Installiamo letti e ausili e ti mostriamo come si usano, con calma.',
    icon: 'tool',
  },
  {
    title: 'Ritiro a fine noleggio',
    body: 'Fissiamo insieme il giorno: non devi riconsegnare nulla.',
    icon: 'return',
  },
] as const;
---

<section
  id="consegna-e-ritiro"
  class="pt-section-sm mid:pt-section"
  aria-labelledby="consegna-e-ritiro-title"
>
  <div class="max-w-page mid:px-8 mx-auto w-full px-5">
    <SectionHeading
      id="consegna-e-ritiro"
      heading="Consegna e ritiro"
      lede="Pensiamo a tutto noi, dall'inizio alla fine."
    />

    <div class="rounded-card border-hair-strong bg-tint overflow-hidden border">
      <ul class="wide:grid-cols-3 grid">
        {
          promises.map((promise, index) => (
            <li
              class:list={[
                'mid:px-7 flex items-start gap-4 px-5 pt-6.5 pb-7',
                /*
                  An inset box-shadow, not a border: it draws the divider without
                  adding a pixel to the cell, so the three columns stay equal.
                  It flips from a left edge to a top edge when they stack.
                */
                index > 0 &&
                  'wide:shadow-[inset_1px_0_0_var(--color-hair-strong)] shadow-[inset_0_1px_0_var(--color-hair-strong)]',
              ]}
            >
              <span class="rounded-field border-hair grid size-11.5 flex-none place-items-center border bg-white">
                {promise.icon === 'truck' && (
                  <svg
                    class="size-6 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M1 7h13v9H1z" />
                    <path d="M14 10h4l3 3v3h-7" />
                    <circle cx="5.5" cy="18.5" r="1.8" />
                    <circle cx="17.5" cy="18.5" r="1.8" />
                  </svg>
                )}
                {promise.icon === 'tool' && (
                  <svg
                    class="size-6 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path
                      d="M14.7 6.3a4.5 4.5 0 0 0 5.6 5.6L17 15.2a4.5 4.5 0 0 1-6.4 0l-4.8-4.8a4.5 4.5 0 0 1 0-6.4z"
                      transform="rotate(90 12 12)"
                    />
                    <path d="m3.5 20.5 5-5" />
                  </svg>
                )}
                {promise.icon === 'return' && (
                  <svg
                    class="size-6 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 12a9 9 0 1 0 3-6.7" />
                    <path d="M3 3v5h5" />
                  </svg>
                )}
              </span>
              <div>
                <h3 class="text-body/[1.3]">{promise.title}</h3>
                <p class="text-ui text-ink-2 mt-1.75">{promise.body}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="border-hair-strong text-ui text-ink-2 mid:px-7 border-t bg-white px-5 py-4.5">
        <strong class="text-ink">Zone servite:</strong> Roma e provincia · Firenze e provincia. Sei in
        un'altra zona? <a class="text-accent" href={`tel:${CONTACT.phoneE164}`}>Chiamaci</a>: spesso
        riusciamo a organizzare la consegna.
      </p>
    </div>
  </div>
</section>
