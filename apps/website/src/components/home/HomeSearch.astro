---
/**
 * Primary home-page rental search — the one panel on the page that carries a
 * shadow, and it is wide and almost invisible rather than a hard drop.
 *
 * The label sits outside the field and the field itself is white with a
 * hairline: it stops being a coloured well and becomes a container, so it is
 * obvious where to type and the label stays readable once the field is full.
 *
 * A native GET form keeps every control usable without hydration and represents
 * the chosen criteria in the destination URL. One small inline enhancement
 * copies a selected suggestion into the search field without navigating away.
 *
 * `area`, `from` and `duration` are carried to the catalogue but are not filters
 * yet — see docs/code/storefront-design-system.md.
 */
import type { ProductSummary } from '~/lib/catalog';
import { routes } from '~/lib/routes';
import { SERVICE_AREAS } from '~/lib/site';

interface Props {
  suggestions: ProductSummary[];
}

const { suggestions } = Astro.props;
const suggestedProducts = suggestions.slice(0, 5);

const durations = [
  { value: '7', label: '1 settimana' },
  { value: '15', label: '15 giorni' },
  { value: '30', label: '1 mese' },
  { value: '60', label: '2 mesi o più' },
  { value: '0', label: 'Non lo so ancora' },
] as const;

const inputClass =
  'w-full min-w-0 border-0 bg-transparent p-0 font-display text-body font-semibold text-ellipsis whitespace-nowrap';
---

<section
  class="rounded-panel border-hair shadow-soft mid:px-7.5 mid:pt-7 mid:pb-7.5 border bg-white p-5"
  aria-labelledby="home-search-title"
>
  <header>
    <h2 id="home-search-title" class="text-h3">Dove e quando ti serve l’ausilio?</h2>
    <p id="home-search-description" class="text-ui-strong text-ink-2 mt-1.25">
      Consegniamo a domicilio a Roma e Firenze.
    </p>
  </header>

  <form
    method="get"
    action={routes.catalog}
    role="search"
    aria-label="Cerca disponibilità per un ausilio a noleggio"
    aria-describedby="home-search-description"
  >
    {
      /*
        "Roma e provincia" is the longest option on the row, so its column is
        held wider than the others or the select truncates.
      */
    }
    <div
      class="wide:grid-cols-[minmax(0,1.4fr)_minmax(0,1.32fr)_minmax(0,1fr)_minmax(0,1.08fr)_auto] mid:grid-cols-2 mt-6 grid items-end gap-3.5"
    >
      <div class="relative z-20 flex flex-col gap-2.25" data-search-field>
        <label class="field-label" for="home-product-search">Ausilio</label>
        <div class="field-control">
          <svg
            class="text-ink-2 size-4.75 flex-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m20 20-4.2-4.2"></path>
          </svg>
          <input
            id="home-product-search"
            class={inputClass}
            name="q"
            type="search"
            enterkeyhint="next"
            autocomplete="off"
            placeholder="Es. carrozzina, letto…"
          />
          <button
            type="button"
            class="text-ink-2 -mr-2.5 grid size-12 flex-none place-items-center border-0 bg-transparent"
            aria-label="Mostra gli ausili suggeriti"
            aria-controls="home-product-suggestions"
          >
            <svg
              class="size-4.5 transition-transform"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m7 9.5 5 5 5-5"></path>
            </svg>
          </button>
        </div>

        {
          suggestedProducts.length > 0 && (
            <div
              id="home-product-suggestions"
              class="rounded-card border-hair shadow-soft invisible absolute top-[calc(100%+9px)] left-0 z-20 max-h-62.5 w-[min(460px,calc(100vw-3rem))] -translate-y-1 overflow-y-auto border bg-white p-2.25 opacity-0 transition-[opacity,transform,visibility] duration-150"
              data-search-panel
            >
              <p class="font-display text-ui text-ink-2 px-2.5 pt-2 pb-1.75 font-bold">
                Ausili più richiesti
              </p>
              <ul class="grid gap-0.5" aria-label="Ausili suggeriti">
                {suggestedProducts.map((product) => (
                  <li>
                    <button
                      type="button"
                      class="rounded-field font-display text-ui hover:bg-tint focus-visible:bg-tint grid min-h-12 w-full grid-cols-[minmax(0,1fr)_18px] items-center gap-3 border-0 bg-transparent px-2.75 py-2.25 text-left font-semibold hover:text-accent"
                      data-search-suggestion={product.title}
                    >
                      <span class="truncate">{product.title}</span>
                      <svg
                        class="size-4.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                      </svg>
                    </button>
                  </li>
                ))}
              </ul>
              <a
                class="border-hair font-display text-ui mt-1.75 flex min-h-12 items-center justify-between gap-3 border-t px-2.75 pt-2.25 font-bold text-accent no-underline"
                href={routes.catalog}
              >
                Vedi tutti gli ausili
                <span aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>

      <div class="flex flex-col gap-2.25">
        <label class="field-label" for="home-area-search">Zona</label>
        <div class="field-control">
          <svg
            class="text-ink-2 size-4.75 flex-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
          <select id="home-area-search" class={inputClass} name="area">
            {SERVICE_AREAS.map((area) => <option value={area.value}>{area.label}</option>)}
          </select>
        </div>
      </div>

      <div class="flex flex-col gap-2.25">
        <label class="field-label" for="home-start-search">Da quando</label>
        <div class="field-control">
          <svg
            class="text-ink-2 size-4.75 flex-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M16 3v4M8 3v4M3 10h18"></path>
          </svg>
          <input
            id="home-start-search"
            class={inputClass}
            name="from"
            type="date"
            autocomplete="off"
          />
        </div>
      </div>

      <div class="flex flex-col gap-2.25">
        <label class="field-label" for="home-duration-search">Per quanto</label>
        <div class="field-control">
          <svg
            class="text-ink-2 size-4.75 flex-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <select id="home-duration-search" class={inputClass} name="duration">
            {durations.map((duration) => <option value={duration.value}>{duration.label}</option>)}
          </select>
        </div>
      </div>

      {
        /*
          The submit shares the fields' 12px radius rather than the pill: it is
          the last cell of the row, not a floating call to action.
        */
      }
      <button
        class="rounded-field font-display text-ui-strong hover:bg-accent-deep mid:col-span-2 wide:col-span-1 inline-flex min-h-14.5 items-center justify-center gap-2.5 border-0 bg-accent px-8.5 font-semibold text-white"
        type="submit"
      >
        <svg
          class="size-4.75 flex-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m20 20-4.2-4.2"></path>
        </svg>
        Cerca
      </button>
    </div>
  </form>
</section>

<script>
  const field = document.querySelector<HTMLElement>('[data-search-field]');
  const panel = field?.querySelector<HTMLElement>('[data-search-panel]');

  if (field && panel) {
    const input = field.querySelector<HTMLInputElement>('input');
    const chevron = field.querySelector<HTMLButtonElement>('button[aria-controls]');
    const suggestions = field.querySelectorAll<HTMLButtonElement>('[data-search-suggestion]');

    // The panel's resting state is a Tailwind utility triple; toggling the same
    // three classes keeps the open state in one place rather than in a
    // stylesheet the markup cannot see.
    const HIDDEN = ['invisible', 'opacity-0', '-translate-y-1'];

    const open = () => {
      panel.classList.remove(...HIDDEN);
      chevron?.querySelector('svg')?.classList.add('rotate-180');
    };

    const close = () => {
      panel.classList.add(...HIDDEN);
      chevron?.querySelector('svg')?.classList.remove('rotate-180');
      const active = document.activeElement;
      if (active instanceof HTMLElement && field.contains(active)) active.blur();
    };

    const isOpen = () => !panel.classList.contains('invisible');

    input?.addEventListener('focus', open);

    chevron?.addEventListener('click', (event) => {
      event.stopPropagation();
      if (isOpen()) {
        close();
      } else {
        open();
        input?.focus();
      }
    });

    suggestions.forEach((suggestion) => {
      suggestion.addEventListener('click', () => {
        if (input) input.value = suggestion.dataset.searchSuggestion ?? '';
        close();
      });
    });

    field.addEventListener('focusout', (event) => {
      const nextTarget = event.relatedTarget;
      if (!(nextTarget instanceof Node) || !field.contains(nextTarget)) close();
    });

    document.addEventListener('click', (event) => {
      if (!field.contains(event.target as Node)) close();
    });

    field.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
