---
/**
 * Category tiles. A section on white, so the tiles are white too and the
 * hairline does the separating; the fill inside each tile goes tinted.
 *
 * Each tile is a real link into the catalogue filtered by category **code**, so
 * a category rename cannot orphan the tile — the code is stable, the slug is
 * not.
 */
import SectionHeading from '~/components/primitives/SectionHeading.astro';
import { mediaUrl } from '~/lib/api';
import type { HomeCategoryCard } from '~/lib/home-content';
import { catalogPath } from '~/lib/routes';

interface Props {
  categories: HomeCategoryCard[];
}

const { categories } = Astro.props;
---

{
  categories.length > 0 && (
    <section class="pt-section-sm mid:pt-section" aria-labelledby="home-categories-title">
      <div class="max-w-page mid:px-8 mx-auto w-full px-5">
        <SectionHeading id="home-categories" heading="Categorie" />

        <ul class="mid:grid-cols-2 wide:grid-cols-4 grid gap-4.5">
          {categories.map((category) => (
            <li class="flex">
              <a
                class="rounded-card border-hair hover:border-hair-strong flex min-h-26 w-full items-center gap-4.5 border bg-white px-5.5 py-4.5 no-underline hover:bg-[#fcfdff]"
                href={catalogPath({ categoria: category.code })}
              >
                <span class="rounded-field border-hair bg-tint grid size-15.5 flex-none place-items-center border">
                  {category.imagePath && (
                    <img
                      class="size-10 object-contain mix-blend-multiply"
                      src={mediaUrl(category.imagePath)}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
                <span class="min-w-0">
                  <h3 class="text-body">{category.title}</h3>
                  <p class="text-ui text-ink-2 mt-0.5">{category.detail}</p>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
