---
/**
 * "Esplora per categoria" — quiet white tiles, one hairline each, ported 1:1
 * from docs/blueprint/home.html (styles in styles/editorial.css).
 *
 * Categories without products are already dropped by `buildHomeCategories`,
 * and the section hides itself when nothing is left — a grid of dead tiles
 * would read as a broken shop.
 */
import { mediaUrl } from '~/lib/api';
import type { HomeCategoryCard } from '~/lib/home-content';
import { catalogPath } from '~/lib/routes';

interface Props {
  categories: HomeCategoryCard[];
}

const { categories } = Astro.props;
---

{
  categories.length > 0 && (
    <section class="categories" aria-labelledby="categories-title">
      <div class="container">
        <h2 class="section-title" id="categories-title">
          Esplora per categoria.
          <svg
            width="44"
            height="16"
            viewBox="0 0 44 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M1 8h41M35 1.5 42.5 8 35 14.5" />
          </svg>
        </h2>

        <ul class="category-grid">
          {categories.map((category) => (
            <li>
              <a class="category-tile" href={catalogPath({ category: category.code })}>
                <span class="cat-media">
                  {category.imagePath && (
                    <img src={mediaUrl(category.imagePath)} alt="" loading="lazy" />
                  )}
                </span>
                <h3 class="cat-name">{category.title}</h3>
                <p class="cat-count">{category.detail}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
