---
/**
 * "Esplora per categoria" — quiet white tiles, one hairline each, ported 1:1
 * from docs/blueprint/home.html with Tailwind utilities.
 *
 * The tile itself is `components/catalog/CategoryTile`, shared with the
 * catalogue directory: one component, so the two grids can never say different
 * things about the same category.
 *
 * Categories without products are already dropped by `buildHomeCategories`,
 * and the section hides itself when nothing is left — a grid of dead tiles
 * would read as a broken shop.
 */
import CategoryTile from '~/components/catalog/CategoryTile.astro';
import type { CategoryTile as CategoryTileModel } from '~/lib/catalog-page';
import { localeForRequest, translate } from '~/lib/i18n';
import {
  CATEGORY_GRID,
  EDITORIAL_CONTAINER,
  EDITORIAL_THEME,
  SECTION_TITLE,
} from '~/styles/editorial';

interface Props {
  categories: CategoryTileModel[];
}

const { categories } = Astro.props;
const locale = localeForRequest();
---

{
  categories.length > 0 && (
    <section
      class:list={[
        EDITORIAL_THEME,
        'border-t border-[var(--color-line)] py-[var(--band-2)] pb-[var(--band-3)]',
      ]}
      aria-labelledby="categories-title"
    >
      <div class={EDITORIAL_CONTAINER}>
        <h2 class={SECTION_TITLE} id="categories-title">
          {translate(locale, 'home.categories.title')}
          <svg
            width="44"
            height="16"
            viewBox="0 0 44 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M1 8h41M35 1.5 42.5 8 35 14.5" />
          </svg>
        </h2>

        <ul class={CATEGORY_GRID}>
          {categories.map((tile) => (
            <li>
              <CategoryTile {tile} headingLevel={3} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
