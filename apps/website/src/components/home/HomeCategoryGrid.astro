---
/**
 * Category tiles arranged as in the approved home design.
 *
 * Each tile is a real link into the catalogue filtered by category code, so a
 * category rename cannot orphan the tile — the code is stable, the slug is not.
 */
import { mediaUrl } from '~/lib/api';
import type { HomeCategoryCard } from '~/lib/home-content';
import { catalogPath } from '~/lib/routes';

interface Props {
  categories: HomeCategoryCard[];
}

const { categories } = Astro.props;
---

{
  categories.length > 0 && (
    <section class="categories" aria-labelledby="home-categories-title">
      <div class="categories__inner">
        <h2 id="home-categories-title">Categorie</h2>
        <ul class="categories__grid">
          {categories.map((category) => (
            <li>
              <a class="category" href={catalogPath({ categoria: category.code })}>
                {category.imagePath ? (
                  <img src={mediaUrl(category.imagePath)} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="category__image-empty" aria-hidden="true" />
                )}
                <h3>{category.title}</h3>
                <p>{category.detail}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .categories {
    padding-top: var(--sp-13);
  }

  .categories__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .categories h2 {
    margin-bottom: var(--sp-5);
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-4);
    list-style: none;
  }

  .categories__grid > li {
    display: flex;
  }

  .category {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    flex-direction: column;
    gap: 9px;
    padding: 18px 14px;
    border: 1px solid var(--c-border);
    border-radius: 18px;
    background: var(--c-surface);
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .category:hover {
    border-color: #a9badf;
  }

  .category img,
  .category__image-empty {
    width: 100%;
    height: 104px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .category h3 {
    font-size: var(--fs-ui-strong);
    line-height: 1.35;
  }

  .category p {
    color: var(--c-primary);
    font-size: var(--fs-ui);
    font-weight: 700;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .categories {
      padding-top: 30px;
    }

    .categories__inner {
      padding-inline: var(--sp-5);
      padding-bottom: var(--sp-2);
    }

    .categories h2 {
      margin-bottom: var(--sp-4);
      font-size: var(--fs-h2);
    }

    .categories__grid {
      gap: var(--sp-3);
    }

    .category {
      gap: var(--sp-2);
      padding: 14px 12px;
      border-radius: 16px;
    }

    .category img,
    .category__image-empty {
      height: 84px;
    }

    .category h3 {
      font-size: var(--fs-ui);
    }
  }
</style>
