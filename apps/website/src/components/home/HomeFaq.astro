---
/**
 * Home-page frequently asked questions.
 *
 * Tinted rows, spaced apart: the spacing does most of the work and the hairline
 * only finishes the edge. Native details/summary disclosures give keyboard and
 * screen-reader behaviour without shipping a client-side island.
 */
import SectionHeading from '~/components/primitives/SectionHeading.astro';
import { HOME_FAQ } from '~/lib/home-content';
---

<section
  id="domande-frequenti"
  class="pt-section-sm mid:pt-section"
  aria-labelledby="domande-frequenti-title"
>
  <div class="max-w-page mid:px-8 mx-auto w-full px-5">
    <SectionHeading id="domande-frequenti" heading="Domande frequenti" />

    <ul class="grid gap-2.5">
      {
        HOME_FAQ.map((item, index) => (
          <li>
            <details
              class="group rounded-field border-hair bg-tint mid:px-6 border px-4"
              open={index === 0}
            >
              <summary class="font-display text-h4 flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3.5 font-semibold [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg
                  class="text-ink-2 size-5.5 flex-none transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="text-ui-strong text-ink-2 max-w-[68ch] pb-5.5">{item.answer}</p>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>
