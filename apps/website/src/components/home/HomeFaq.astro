---
/**
 * "Domande frequenti" — intro and quiet gray link-buttons on the left, native
 * `<details>` items on the right, ported 1:1 from docs/blueprint/home.html
 * with Tailwind utilities.
 *
 * The TRIGGER carries the layering (a gray bar); the answer is plain text, so
 * what you press and what you read never blur. First item ships open so the
 * pattern explains itself. Zero JavaScript.
 *
 * ------------------------------------------------------------------ mobile ---
 *
 * Below `mid` the six separate bars become ONE white card with hairline-ruled
 * rows — the settings-list pattern, and the reference site's own phone FAQ
 * (miamedicalitalia.it at 390px, measured 2026-08-31). Six cards each carrying
 * their own border and 10px of air between them read as six things on a phone;
 * one card with five rules in it reads as one list of six questions.
 *
 * Same `<details>` elements, same order, same open state: the card is drawn by
 * moving the border from each item onto their wrapper and turning the gaps into
 * dividers.
 */
import { homeFaq } from '~/lib/home-content';
import { localeForRequest, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { EDITORIAL_CONTAINER, EDITORIAL_THEME, HOME_BAND, HOME_TITLE } from '~/styles/editorial';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);
const faq = homeFaq(locale);
/* White fills since the section moved onto the grey ground (2026-08-31) —
   the pattern's white-on-grey inversion of its old grey-on-white bars. */
const quietLinkClass =
  'inline-flex min-h-12 items-center gap-2.25 rounded-[14px] border border-[var(--color-line)] bg-white px-4.5 ' +
  'text-[0.9688rem] font-[650] whitespace-nowrap text-[var(--color-ink)] no-underline ' +
  'hover:border-[#ccd2e2] hover:text-[var(--color-accent)] [&_svg]:flex-none ' +
  '[&_svg]:text-[var(--color-ink-soft)] hover:[&_svg]:text-current';
---

<section class:list={[EDITORIAL_THEME, HOME_BAND]} aria-labelledby="faq-title">
  <div class={EDITORIAL_CONTAINER}>
    <div
      class="wide:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] wide:gap-22 mid:gap-10 max-mid:gap-6 grid grid-cols-1"
    >
      <div>
        <h2 class={HOME_TITLE} id="faq-title">
          {text('home.faq.title')}
        </h2>
        <p class="mt-4 max-w-[34ch] text-[1.0625rem] leading-[1.65] text-[var(--color-ink-soft)]">
          {text('home.faq.lede')}
        </p>
        <div class="mid:mt-7 max-mid:mt-5 flex flex-wrap gap-2.5">
          {/* /chi-siamo/ does not exist yet — flagged as a pending route. */}
          <a class={quietLinkClass} href="/chi-siamo/">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h1.5c.621 0 1.125.504 1.125 1.125V21m7.5-10.5h1.875c.621 0 1.125.504 1.125 1.125V21"
              ></path>
            </svg>
            {text('home.faq.about')}
          </a>
          <a class={quietLinkClass} href={routePath(locale, 'support')}>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z"
              ></path>
            </svg>
            Contattaci
          </a>
        </div>
      </div>

      <div
        class="mid:border-0 mid:bg-transparent mid:[&>details+details]:mt-2.5 max-mid:rounded-[16px] max-mid:border max-mid:border-[var(--color-line)] max-mid:bg-white"
      >
        {
          faq.map((item, index) => (
            <details class="group/faq" open={index === 0}>
              <summary class="mid:rounded-[14px] mid:border mid:border-[var(--color-line)] mid:bg-white mid:group-open/faq:border-[#ccd2e2] mid:hover:border-[#ccd2e2] max-mid:border-0 max-mid:[details+details>&]:border-t max-mid:[details+details>&]:border-[var(--color-line)] mid:px-5 max-mid:px-4.5 flex min-h-15.5 cursor-pointer list-none items-center justify-between gap-6 py-4 text-[1.0625rem] font-[650] [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg
                  class="flex-none text-[var(--color-ink-soft)] transition-transform duration-200 ease-out group-open/faq:rotate-45"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mid:px-5 mid:pt-4 max-mid:px-4.5 max-mid:pt-1 max-w-[62ch] pb-4 text-[0.9688rem] leading-[1.65] text-[var(--color-ink-soft)]">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
