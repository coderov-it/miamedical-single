---
/**
 * The testimonial band — display heading with source chips on the left, the
 * display-sized rating on the right, staggered no-title review cards below.
 * Ported 1:1 from docs/blueprint/home.html (styles in styles/editorial.css).
 *
 * Card anatomy is the owner's spec: [avatar + name | date] → [stars] → [text]
 * → [source logo, bottom-right]. Never a title.
 */
import { homeTestimonials, TESTIMONIAL_RATING, type TestimonialSource } from '~/lib/home-content';
import { localeForRequest, translate } from '~/lib/i18n';

const rating = TESTIMONIAL_RATING;
const locale = localeForRequest();
const entries = homeTestimonials(locale);
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

/* Heroicons' solid star — the premium cut; a simple polygon reads cheap small. */
const STAR_PATH =
  'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z';

const STARS = [1, 2, 3, 4, 5];

const SOURCE_LABELS: Record<TestimonialSource, string> = {
  google: 'Google',
  trustpilot: 'Trustpilot',
  facebook: 'Facebook',
};
---

<section class="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="hero-kicker kicker-sources">
          <span class="source-stack" aria-hidden="true">
            <span class="source-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M23.5 12.3c0-.9-.1-1.7-.2-2.5H12v4.8h6.5c-.3 1.6-1.2 2.9-2.5 3.8v3.1h4c2.3-2.2 3.5-5.4 3.5-9.2z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-4-3.1c-1.1.7-2.4 1.2-3.9 1.2-3 0-5.6-2-6.5-4.8H1.3v3.2C3.3 21.5 7.3 24 12 24z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.5 14.4c-.5-1.5-.5-3.2 0-4.7V6.5H1.3c-1.7 3.4-1.7 7.5 0 10.9l4.2-3z"></path>
                <path
                  fill="#EA4335"
                  d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.5-3.5C17.9 1.1 15.2 0 12 0 7.3 0 3.3 2.5 1.3 6.5l4.2 3.2c.9-2.9 3.5-4.9 6.5-4.9z"
                ></path>
              </svg>
            </span>
            <span class="source-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#00B67A" aria-hidden="true">
                <path
                  d="m12 1.6 2.9 7 7.5.1-5.9 4.7 2.2 7.2L12 16.3l-6.7 4.3 2.2-7.2L1.6 8.7l7.5-.1z"
                ></path>
              </svg>
            </span>
            <span class="source-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="12" fill="#1877F2"></circle>
                <path
                  fill="#fff"
                  d="M15.9 15.2l.5-3.2h-3.1V9.9c0-.9.4-1.7 1.8-1.7h1.4V5.4s-1.3-.2-2.5-.2c-2.5 0-4.2 1.5-4.2 4.3V12H7v3.2h2.8V23a11.2 11.2 0 0 0 3.5 0v-7.8h2.6z"
                ></path>
              </svg>
            </span>
          </span>
          Recensioni verificate
        </p>
        <h2 class="testimonial-display" id="testimonials-title">
          {text('home.testimonials.line1')}<br />{text('home.testimonials.line2')}{' '}
          <strong>{text('home.testimonials.line3')}</strong>
        </h2>
      </div>
      <div class="rating-hero">
        <p class="rating-score" aria-label={text('home.testimonials.average', { rating })}>
          {rating}
        </p>
        <span
          class="stars stars-lg"
          role="img"
          aria-label={text('home.testimonials.stars', { rating })}
        >
          {
            STARS.map(() => (
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={STAR_PATH} />
              </svg>
            ))
          }
        </span>
        <p class="rating-note">{text('home.reviews.verifiedCount')}</p>
      </div>
    </div>

    <ul class="testimonial-grid">
      {
        entries.map((review) => (
          <li class="testimonial-card">
            <p class="tc-head">
              <span class="tc-person">
                <span class="tc-avatar" aria-hidden="true">
                  {review.initials}
                </span>
                <span class="tc-name">{review.name}</span>
              </span>
              <span class="tc-date">{review.date}</span>
            </p>
            <p class="tc-meta">
              <span class="stars" role="img" aria-label={text('home.testimonials.starsFull')}>
                {STARS.map(() => (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={STAR_PATH} />
                  </svg>
                ))}
              </span>
            </p>
            <p class="tc-text">{review.text}</p>
            <span
              class="tc-source"
              role="img"
              aria-label={text('home.testimonials.source', {
                source: SOURCE_LABELS[review.source],
              })}
            >
              {review.source === 'google' && (
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M23.5 12.3c0-.9-.1-1.7-.2-2.5H12v4.8h6.5c-.3 1.6-1.2 2.9-2.5 3.8v3.1h4c2.3-2.2 3.5-5.4 3.5-9.2z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-4-3.1c-1.1.7-2.4 1.2-3.9 1.2-3 0-5.6-2-6.5-4.8H1.3v3.2C3.3 21.5 7.3 24 12 24z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.5 14.4c-.5-1.5-.5-3.2 0-4.7V6.5H1.3c-1.7 3.4-1.7 7.5 0 10.9l4.2-3z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.5-3.5C17.9 1.1 15.2 0 12 0 7.3 0 3.3 2.5 1.3 6.5l4.2 3.2c.9-2.9 3.5-4.9 6.5-4.9z"
                  />
                </svg>
              )}
              {review.source === 'trustpilot' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#00B67A" aria-hidden="true">
                  <path d="m12 1.6 2.9 7 7.5.1-5.9 4.7 2.2 7.2L12 16.3l-6.7 4.3 2.2-7.2L1.6 8.7l7.5-.1z" />
                </svg>
              )}
              {review.source === 'facebook' && (
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="12" fill="#1877F2" />
                  <path
                    fill="#fff"
                    d="M15.9 15.2l.5-3.2h-3.1V9.9c0-.9.4-1.7 1.8-1.7h1.4V5.4s-1.3-.2-2.5-.2c-2.5 0-4.2 1.5-4.2 4.3V12H7v3.2h2.8V23a11.2 11.2 0 0 0 3.5 0v-7.8h2.6z"
                  />
                </svg>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
