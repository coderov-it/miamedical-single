---
/**
 * Review aggregate and selected customer quotations.
 *
 * The copy comes from the temporary governed-content adapter so the visible
 * reviews and any structured-data consumer can share one source.
 */
import { HOME_REVIEWS, REVIEW_AGGREGATE } from '~/lib/home-content';

const mobileCountLabel = REVIEW_AGGREGATE.countLabel.replace(
  'recensioni Google',
  'recensioni su Google',
);
---

<section id="recensioni" class="reviews" aria-labelledby="recensioni-title">
  <div class="reviews__inner">
    <div class="reviews__head">
      <h2 id="recensioni-title" class="reviews__heading">Chi ci ha scelto</h2>
      <p
        class="reviews__aggregate"
        aria-label={`Valutazione ${REVIEW_AGGREGATE.rating} su 5, ${mobileCountLabel}`}
      >
        <span class="reviews__score">{REVIEW_AGGREGATE.rating}</span>
        <span class="reviews__stars" aria-hidden="true">★★★★★</span>
        <span class="reviews__count reviews__count--desktop">
          {REVIEW_AGGREGATE.countLabel}
        </span>
        <span class="reviews__count reviews__count--mobile">
          {mobileCountLabel}
        </span>
      </p>
    </div>

    <ul class="reviews__list">
      {
        HOME_REVIEWS.map((review) => (
          <li>
            <figure class="review">
              <p class="review__rating">
                <span aria-hidden="true">{'★'.repeat(review.rating)}</span>
                <span class="sr-only">Valutazione {review.rating} su 5.</span>
              </p>
              <blockquote class="review__quote">“{review.text}”</blockquote>
              <figcaption class="review__author">{review.name}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews {
    padding-block-start: var(--sp-13);
  }

  .reviews__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .reviews__head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: var(--sp-5);
  }

  .reviews__heading {
    flex: none;
    font-size: var(--fs-h2);
  }

  .reviews__aggregate {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: var(--sp-2) var(--sp-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
  }

  .reviews__score {
    color: var(--c-ink);
    font-family: var(--font-heading);
    font-size: var(--fs-body-lg);
    font-weight: 800;
  }

  .reviews__stars,
  .review__rating {
    color: #e8a013;
    letter-spacing: 0.12em;
  }

  .reviews__stars {
    font-size: var(--fs-ui);
  }

  .reviews__count {
    color: var(--c-ink-secondary);
    font-size: var(--fs-ui);
    line-height: var(--lh-body);
  }

  .reviews__count--mobile {
    display: none;
  }

  .reviews__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
    list-style: none;
  }

  .review {
    height: 100%;
    padding: 22px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 18px;
  }

  .review__rating {
    font-size: var(--fs-ui);
    line-height: 1;
  }

  .review__quote {
    margin-top: 10px;
    color: var(--c-ink);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .review__author {
    margin-top: var(--sp-3);
    color: var(--c-ink-secondary);
    font-family: var(--font-heading);
    font-size: var(--fs-ui);
    font-weight: 700;
    line-height: var(--lh-body);
  }

  @media (max-width: 720px) {
    .reviews {
      padding-block-start: 30px;
    }

    .reviews__inner {
      padding-inline: var(--sp-5);
      padding-block-end: var(--sp-2);
    }

    .reviews__head {
      display: block;
      margin-bottom: var(--sp-3);
    }

    .reviews__heading {
      font-size: 1.5rem;
    }

    .reviews__aggregate {
      margin-top: 14px;
      padding: var(--sp-4);
      border-radius: 16px;
    }

    .reviews__score {
      font-size: 2.125rem;
    }

    .reviews__stars {
      font-size: var(--fs-body);
    }

    .reviews__count--desktop {
      display: none;
    }

    .reviews__count--mobile {
      display: inline;
    }

    .reviews__list {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }

    .review {
      padding: var(--sp-4);
      border-radius: 16px;
    }
  }
</style>
