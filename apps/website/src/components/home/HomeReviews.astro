---
/**
 * The testimonial band — display heading with source chips on the left, the
 * display-sized rating on the right, staggered no-title review cards below.
 * Ported 1:1 from docs/blueprint/home.html with Tailwind utilities.
 *
 * Card anatomy is the owner's spec: [avatar + name | date] → [stars] → [text]
 * → [source logo, bottom-right]. Never a title.
 *
 * ------------------------------------------------------------------ mobile ---
 *
 * The 78px display rating is a DESKTOP figure. Hung on the right of a phone
 * column it took a third of the screen to say one number, so below `mid` the
 * aggregate becomes the reference's compact summary card instead: the score,
 * its stars and its count on one line, in a white row above the testimonials
 * (miamedicalitalia.it at 390px, measured 2026-08-31). Same three elements,
 * re-laid — the header block turns from a two-column spread into a stack, and
 * the rating block from a right-aligned column into a centred row.
 *
 * THREE TESTIMONIALS ON A PHONE, NOT SIX. Six stacked cards ran to 1833px —
 * two full screens of strangers agreeing with each other, and nobody reads the
 * fourth. Same treatment as the home rails: the rest render on the server and
 * CSS takes them out of the phone's paint, so the mobile page (which is the
 * indexed one) still carries every review.
 */
import { homeTestimonials, TESTIMONIAL_RATING, type TestimonialSource } from '~/lib/home-content';
import { localeForRequest, translate } from '~/lib/i18n';
import { EDITORIAL_CONTAINER, EDITORIAL_THEME, HOME_BAND } from '~/styles/editorial';

const rating = TESTIMONIAL_RATING;
const locale = localeForRequest();
const entries = homeTestimonials(locale);
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

/* Heroicons' solid star — the premium cut; a simple polygon reads cheap small. */
const STAR_PATH =
  'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z';

const STARS = [1, 2, 3, 4, 5];

const SOURCE_LABELS: Record<TestimonialSource, string> = {
  google: 'Google',
  trustpilot: 'Trustpilot',
  facebook: 'Facebook',
};

const sourceChipClass =
  'grid size-7 place-items-center rounded-full border border-[var(--color-line)] bg-white ' +
  '[&+&]:-ms-2.25';
const starsClass = 'inline-flex gap-0.75 text-[#f5a623]';
---

{
  /* Transparent since 2026-08-31: the section sits on the home page's one grey
    ground and its white cards raise off it, like every section around it. */
}
<section class:list={[EDITORIAL_THEME, HOME_BAND]} aria-labelledby="testimonials-title">
  <div class={EDITORIAL_CONTAINER}>
    <div
      class="mid:flex-row mid:flex-wrap mid:items-end mid:justify-between mid:gap-x-8 max-mid:flex-col-reverse max-mid:gap-4 flex gap-y-3"
    >
      <div>
        <p
          class="mb-4.5 flex items-center gap-3 text-[0.8125rem] font-[650] tracking-[0.11em] text-[var(--color-ink-soft)] uppercase"
        >
          <span class="inline-flex" aria-hidden="true">
            <span class={sourceChipClass}>
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M23.5 12.3c0-.9-.1-1.7-.2-2.5H12v4.8h6.5c-.3 1.6-1.2 2.9-2.5 3.8v3.1h4c2.3-2.2 3.5-5.4 3.5-9.2z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-4-3.1c-1.1.7-2.4 1.2-3.9 1.2-3 0-5.6-2-6.5-4.8H1.3v3.2C3.3 21.5 7.3 24 12 24z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.5 14.4c-.5-1.5-.5-3.2 0-4.7V6.5H1.3c-1.7 3.4-1.7 7.5 0 10.9l4.2-3z"></path>
                <path
                  fill="#EA4335"
                  d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.5-3.5C17.9 1.1 15.2 0 12 0 7.3 0 3.3 2.5 1.3 6.5l4.2 3.2c.9-2.9 3.5-4.9 6.5-4.9z"
                ></path>
              </svg>
            </span>
            <span class={sourceChipClass}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#00B67A" aria-hidden="true">
                <path
                  d="m12 1.6 2.9 7 7.5.1-5.9 4.7 2.2 7.2L12 16.3l-6.7 4.3 2.2-7.2L1.6 8.7l7.5-.1z"
                ></path>
              </svg>
            </span>
            <span class={sourceChipClass}>
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="12" fill="#1877F2"></circle>
                <path
                  fill="#fff"
                  d="M15.9 15.2l.5-3.2h-3.1V9.9c0-.9.4-1.7 1.8-1.7h1.4V5.4s-1.3-.2-2.5-.2c-2.5 0-4.2 1.5-4.2 4.3V12H7v3.2h2.8V23a11.2 11.2 0 0 0 3.5 0v-7.8h2.6z"
                ></path>
              </svg>
            </span>
          </span>
          Recensioni verificate
        </p>
        <h2
          class="text-[clamp(2.125rem,3.6vw,3rem)] leading-[1.08] font-[550] tracking-[-0.032em] [&_strong]:font-[760]"
          id="testimonials-title"
        >
          {text('home.testimonials.line1')}<br />{text('home.testimonials.line2')}{' '}
          <strong>{text('home.testimonials.line3')}</strong>
        </h2>
      </div>
      {
        /* A right-aligned column on desktop; the reference's summary row on a
          phone — white card, score and stars and count on one baseline. */
      }
      <div
        class="mid:flex-col mid:items-end mid:gap-1.25 mid:rounded-none mid:border-0 mid:bg-transparent mid:p-0 mid:text-right max-mid:w-full max-mid:flex-row max-mid:flex-wrap max-mid:items-center max-mid:gap-x-3 max-mid:gap-y-1 max-mid:rounded-[16px] max-mid:border max-mid:border-[var(--color-line)] max-mid:bg-white max-mid:px-5 max-mid:py-4 max-mid:text-left flex"
      >
        <p
          class="max-mid:text-[2.25rem] text-[clamp(2.75rem,calc(1.43vw+1.607rem),3.5rem)] leading-[0.9] font-[780] tracking-[-0.03em] tabular-nums"
          aria-label={text('home.testimonials.average', { rating })}
        >
          {rating}
        </p>
        <span
          class={`${starsClass} [&_svg]:size-5.25`}
          role="img"
          aria-label={text('home.testimonials.stars', { rating })}
        >
          {
            STARS.map(() => (
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={STAR_PATH} />
              </svg>
            ))
          }
        </span>
        <p class="max-mid:basis-full text-[0.9375rem] text-[var(--color-ink-soft)]">
          {text('home.reviews.verifiedCount')}
        </p>
      </div>
    </div>

    <ul
      class="wide:grid-cols-3 wide:[&>:nth-child(3n-1)]:translate-y-6.5 mid:mt-11.5 max-mid:mt-4 max-mid:[&>li:nth-child(n+4)]:hidden grid grid-cols-1 gap-3.5 sm:grid-cols-2"
    >
      {
        entries.map((review) => (
          <li class="mid:px-6 mid:pt-6 mid:pb-5.5 max-mid:px-4.5 max-mid:pt-4.5 max-mid:pb-4 flex flex-col rounded-[20px] border border-[var(--color-line)] bg-white">
            <p class="flex items-center justify-between gap-3">
              <span class="flex items-center gap-2.5">
                <span
                  class="grid size-9 place-items-center rounded-full bg-[var(--color-surface)] text-[0.8125rem] font-bold tracking-[0.02em]"
                  aria-hidden="true"
                >
                  {review.initials}
                </span>
                <span class="text-[0.9375rem] font-[650]">{review.name}</span>
              </span>
              <span class="flex-none text-[0.8125rem] text-[var(--color-ink-soft)]">
                {review.date}
              </span>
            </p>
            <p class="mt-3.5 flex items-center">
              <span class={starsClass} role="img" aria-label={text('home.testimonials.starsFull')}>
                {STARS.map(() => (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={STAR_PATH} />
                  </svg>
                ))}
              </span>
            </p>
            <p class="mt-3 text-[0.9375rem] leading-[1.6] text-[var(--color-ink-soft)]">
              {review.text}
            </p>
            <span
              class="mt-auto grid place-items-center self-end pt-3.5"
              role="img"
              aria-label={text('home.testimonials.source', {
                source: SOURCE_LABELS[review.source],
              })}
            >
              {review.source === 'google' && (
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M23.5 12.3c0-.9-.1-1.7-.2-2.5H12v4.8h6.5c-.3 1.6-1.2 2.9-2.5 3.8v3.1h4c2.3-2.2 3.5-5.4 3.5-9.2z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-4-3.1c-1.1.7-2.4 1.2-3.9 1.2-3 0-5.6-2-6.5-4.8H1.3v3.2C3.3 21.5 7.3 24 12 24z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.5 14.4c-.5-1.5-.5-3.2 0-4.7V6.5H1.3c-1.7 3.4-1.7 7.5 0 10.9l4.2-3z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.5-3.5C17.9 1.1 15.2 0 12 0 7.3 0 3.3 2.5 1.3 6.5l4.2 3.2c.9-2.9 3.5-4.9 6.5-4.9z"
                  />
                </svg>
              )}
              {review.source === 'trustpilot' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#00B67A" aria-hidden="true">
                  <path d="m12 1.6 2.9 7 7.5.1-5.9 4.7 2.2 7.2L12 16.3l-6.7 4.3 2.2-7.2L1.6 8.7l7.5-.1z" />
                </svg>
              )}
              {review.source === 'facebook' && (
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="12" fill="#1877F2" />
                  <path
                    fill="#fff"
                    d="M15.9 15.2l.5-3.2h-3.1V9.9c0-.9.4-1.7 1.8-1.7h1.4V5.4s-1.3-.2-2.5-.2c-2.5 0-4.2 1.5-4.2 4.3V12H7v3.2h2.8V23a11.2 11.2 0 0 0 3.5 0v-7.8h2.6z"
                  />
                </svg>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
