---
/**
 * "Come funziona" — three numbered white cards on the grey ground and a green
 * reassurance bar under them, matched to the reference section
 * (miamedicalitalia.it, 2026-08-31): 30px title, soft lede, cards of
 * chip + title + text, then the "you pay nothing today" strip. Static by
 * design: this copy is the offer, not data.
 */
import { localeForRequest, translate } from '~/lib/i18n';
import { EDITORIAL_CONTAINER, EDITORIAL_THEME, HOME_BAND, HOME_LEAD, HOME_TITLE } from '~/styles/editorial';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

const steps = ['step1', 'step2', 'step3'].map((step) => ({
  name: text(`home.how.${step}.name`),
  text: text(`home.how.${step}.text`),
}));
---

<section class:list={[EDITORIAL_THEME, HOME_BAND]} aria-labelledby="how-title">
  <div class={EDITORIAL_CONTAINER}>
    <h2 class={HOME_TITLE} id="how-title">{text('home.how.title')}</h2>
    <p class={HOME_LEAD}>{text('home.how.lede')}</p>

    <ol class="mt-6 grid list-none grid-cols-1 gap-4.5 min-[900px]:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="grid grid-cols-[auto_1fr] content-start items-center gap-x-4 gap-y-1.5 rounded-card border border-[var(--color-line)] bg-white px-5.5 py-5.5">
            <span
              class="bg-accent-tint grid size-11 place-items-center rounded-[12px] text-[1.0625rem] font-bold text-[var(--color-accent)] tabular-nums"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="text-[1.0625rem] font-bold">{step.name}</h3>
            <p class="col-start-2 text-[0.9688rem] leading-[1.6] text-[var(--color-ink-soft)]">
              {step.text}
            </p>
          </li>
        ))
      }
    </ol>

    <p
      class="mt-4.5 flex items-center gap-3 rounded-[14px] bg-[var(--color-phone-tint)] px-5.5 py-4 text-[0.9688rem] leading-[1.6] text-[var(--color-phone-ink)]"
    >
      <svg
        class="flex-none"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
      </svg>
      <span>
        <strong class="font-bold">{text('home.how.noteStrong')}</strong>{' '}
        {text('home.how.noteText')}
      </span>
    </p>
  </div>
</section>
