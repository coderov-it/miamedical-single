---
/**
 * "Come funziona" — three steps in one bordered panel with the payment note as
 * an attached gray footer strip, ported 1:1 from docs/blueprint/home.html
 * (styles in styles/editorial.css). Static by design: this copy is the offer,
 * not data.
 */
import { localeForRequest, translate } from '~/lib/i18n';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

const steps = ['step1', 'step2', 'step3'].map((step) => ({
  name: text(`home.how.${step}.name`),
  text: text(`home.how.${step}.text`),
}));
---

<section class="how" aria-labelledby="how-title">
  <div class="container">
    <h2 class="section-title" id="how-title">
      {text('home.how.title')}
      <svg
        width="44"
        height="16"
        viewBox="0 0 44 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M1 8h41M35 1.5 42.5 8 35 14.5"></path>
      </svg>
    </h2>
    <p class="section-lead">{text('home.how.lede')}</p>

    <div class="how-panel">
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <p class="step-badge-row">
                <span class="step-badge" aria-hidden="true">
                  {index + 1}
                </span>
              </p>
              <h3 class="step-name">{step.name}</h3>
              <p class="step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <p class="note-bar">
        <svg
          class="note-check"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
        </svg>
        <span>
          <strong>{text('home.how.noteStrong')}</strong>
          {text('home.how.noteText')}
        </span>
      </p>
    </div>
  </div>
</section>
