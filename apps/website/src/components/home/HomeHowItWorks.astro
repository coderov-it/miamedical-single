---
/**
 * "Come funziona" — three numbered white cards on the grey ground and a green
 * reassurance bar under them, matched to the reference section
 * (miamedicalitalia.it, 2026-08-31): 30px title, soft lede, cards of
 * chip + title + text, then the "you pay nothing today" strip. Static by
 * design: this copy is the offer, not data.
 *
 * ------------------------------------------------------------------ mobile ---
 *
 * THE CARDS ARE DRAWN AT DESKTOP SIZE BELOW `mid` UNLESS THEY ARE TOLD NOT TO,
 * and this section is where that cost most: 22px of padding around a 17px title
 * over 15.5px/1.6 body made each card 140px and the section 701px — a full
 * phone screen of three sentences (owner, 2026-08-31). Every number below is
 * halved or near it, and the body drops to the phone token:
 *
 *   card padding   22px → 14px      chip     38px → 32px
 *   card title     17px → 16px      gap      10px → 8px
 *   card text      15.5/1.6 → 14/1.45
 *
 * which brings the section to ~500px without dropping a word of the copy. If
 * you add a fourth step, keep it in the same `max-mid:` pairs — a bare
 * `px-5.5` here silently reintroduces the whole 200px.
 */
import { localeForRequest, translate } from '~/lib/i18n';
import {
  EDITORIAL_CONTAINER,
  EDITORIAL_THEME,
  HOME_BAND,
  HOME_LEAD,
  HOME_TITLE,
} from '~/styles/editorial';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

const steps = ['step1', 'step2', 'step3'].map((step) => ({
  name: text(`home.how.${step}.name`),
  text: text(`home.how.${step}.text`),
}));
---

<section class:list={[EDITORIAL_THEME, HOME_BAND]} aria-labelledby="how-title">
  <div class={EDITORIAL_CONTAINER}>
    <h2 class={HOME_TITLE} id="how-title">{text('home.how.title')}</h2>
    <p class={HOME_LEAD}>{text('home.how.lede')}</p>

    <ol
      class="mid:mt-6 mid:gap-4.5 max-mid:mt-3 max-mid:gap-2 grid list-none grid-cols-1 min-[900px]:grid-cols-3"
    >
      {
        steps.map((step, index) => (
          <li class="rounded-card mid:gap-x-4 mid:gap-y-1.5 mid:px-5.5 mid:py-5.5 max-mid:gap-x-3.5 max-mid:gap-y-1 max-mid:px-3.5 max-mid:py-3.5 grid grid-cols-[auto_1fr] content-start items-center border border-[var(--color-line)] bg-white">
            <span
              class="bg-accent-tint mid:size-11 mid:text-[1.0625rem] max-mid:size-8 max-mid:rounded-[10px] max-mid:text-base grid place-items-center rounded-[12px] font-bold text-[var(--color-accent)] tabular-nums"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="mid:text-[1.0625rem] max-mid:text-base font-bold">{step.name}</h3>
            <p class="mid:text-[0.9688rem] mid:leading-[1.6] max-mid:text-(length:--text-phone-body) max-mid:leading-[1.45] col-start-2 text-[var(--color-ink-soft)]">
              {step.text}
            </p>
          </li>
        ))
      }
    </ol>

    <p
      class="mid:mt-4.5 mid:px-5.5 mid:py-4 mid:text-[0.9688rem] mid:leading-[1.6] max-mid:mt-2 max-mid:gap-2.5 max-mid:px-3.5 max-mid:py-3 max-mid:text-(length:--text-phone-body) max-mid:leading-[1.45] flex items-center gap-3 rounded-[14px] bg-[var(--color-phone-tint)] text-[var(--color-phone-ink)]"
    >
      <svg
        class="flex-none"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
      </svg>
      <span>
        <strong class="font-bold">{text('home.how.noteStrong')}</strong>{' '}
        {text('home.how.noteText')}
      </span>
    </p>
  </div>
</section>
