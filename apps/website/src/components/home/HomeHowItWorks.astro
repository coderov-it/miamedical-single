---
/**
 * "Come funziona" — three steps in one bordered panel with the payment note as
 * an attached gray footer strip, ported 1:1 from docs/blueprint/home.html
 * (styles in styles/editorial.css). Static by design: this copy is the offer,
 * not data.
 */
const steps = [
  {
    name: 'Scegli il prodotto',
    text: 'Dal catalogo, oppure chiamaci: ti consigliamo noi quello giusto.',
  },
  {
    name: 'Seleziona le date',
    text: 'Indichi quando ti serve e per quanto tempo. Puoi sempre prolungare.',
  },
  {
    name: 'Lo ricevi a domicilio',
    text: 'Ti chiamiamo per confermare, consegniamo e montiamo. A fine noleggio ritiriamo noi.',
  },
];
---

<section class="how" aria-labelledby="how-title">
  <div class="container">
    <h2 class="section-title" id="how-title">
      Come funziona.
      <svg
        width="44"
        height="16"
        viewBox="0 0 44 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M1 8h41M35 1.5 42.5 8 35 14.5"></path>
      </svg>
    </h2>
    <p class="section-lead">Tre passaggi, senza pagare nulla online.</p>

    <div class="how-panel">
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <p class="step-badge-row">
                <span class="step-badge" aria-hidden="true">
                  {index + 1}
                </span>
              </p>
              <h3 class="step-name">{step.name}</h3>
              <p class="step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <p class="note-bar">
        <svg
          class="note-check"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
        </svg>
        <span>
          <strong>Oggi non paghi nulla.</strong> Paghi solo dopo la nostra telefonata di conferma, con
          un link di pagamento sicuro via SMS o email.
        </span>
      </p>
    </div>
  </div>
</section>
