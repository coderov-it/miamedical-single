---
/**
 * The closing "parla con noi" band: full width, deep blue, a lot of air.
 *
 * This is the first of the page's two closing steps — the footer below it is the
 * darker one. Calling is a successful conversion for this audience, so both
 * actions are ordinary links and require no hydration.
 */
import PhoneCta from '~/components/global/PhoneCta.astro';
import { CONTACT, whatsappUrl } from '~/lib/site';
---

<section
  id="parla-con-noi"
  class="mt-section-sm bg-accent-deep mid:mt-section mid:py-21 py-14 text-white"
  aria-labelledby="parla-con-noi-title"
>
  <div
    class="max-w-page mid:px-8 mx-auto flex w-full flex-wrap items-center justify-between gap-x-12 gap-y-8 px-5"
  >
    <div>
      <h2
        id="parla-con-noi-title"
        class="max-w-[18ch] text-[clamp(1.9rem,3.2vw,2.5rem)]/[1.16] text-white"
      >
        Preferisci parlare con una persona?
      </h2>
      <p class="text-body text-on-deep mt-3 max-w-[44ch]">
        Ti aiutiamo a scegliere e possiamo fare l'ordine per te, al telefono. {CONTACT.hours.it}.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <PhoneCta variant="on-dark" />
      <a
        class="btn btn-soft-on-dark"
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        data-analytics="whatsapp"
      >
        WhatsApp
      </a>
    </div>
  </div>
</section>
