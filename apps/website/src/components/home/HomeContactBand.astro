---
/**
 * High-emphasis assisted-conversion band.
 *
 * Calling is a successful conversion for this audience. Both actions are
 * ordinary links and require no hydration.
 */
import { CONTACT, whatsappUrl } from '~/lib/site';
---

<section id="parla-con-noi" class="contact-band" aria-labelledby="parla-con-noi-title">
  <div class="contact-band__inner">
    <div class="contact-band__panel">
      <div class="contact-band__copy">
        <h2 id="parla-con-noi-title" class="contact-band__heading">
          Preferisci parlare con una persona?
        </h2>
        <p class="contact-band__body">
          Ti aiutiamo a scegliere e possiamo fare l'ordine per te, al telefono.
          {' '}{CONTACT.hours.it}.
        </p>
      </div>

      <div class="contact-band__actions">
        <a
          class="contact-band__action contact-band__action--phone"
          href={`tel:${CONTACT.phoneE164}`}
          data-analytics="phone-call"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3A19.5 19.5 0 0 1 5.2 13 19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2.1z"
            ></path>
          </svg>
          {CONTACT.phoneDisplay} — gratis
        </a>

        <a
          class="contact-band__action contact-band__action--whatsapp"
          href={whatsappUrl()}
          target="_blank"
          rel="noopener"
          data-analytics="whatsapp"
        >
          <span class="contact-band__desktop-label">WhatsApp</span>
          <span class="contact-band__mobile-label">Scrivici su WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-band {
    padding-block: var(--sp-13) 60px;
  }

  .contact-band__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .contact-band__panel {
    display: flex;
    align-items: center;
    gap: var(--sp-10);
    padding: 44px 48px;
    background: var(--c-primary);
    border-radius: 24px;
    color: var(--c-primary-ink);
  }

  .contact-band__copy {
    flex: 1;
  }

  .contact-band__heading {
    color: var(--c-primary-ink);
    font-size: 1.75rem;
  }

  .contact-band__body {
    margin-top: var(--sp-2);
    color: #c9d4ee;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .contact-band__actions {
    display: flex;
    flex: none;
    gap: var(--sp-3);
  }

  .contact-band__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: var(--target-min);
    min-height: 60px;
    padding-inline: 28px;
    border-radius: 14px;
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .contact-band__action--phone {
    background: var(--c-surface);
    color: var(--c-primary);
  }

  .contact-band__action--whatsapp {
    padding-inline: var(--sp-6);
    background: rgb(255 255 255 / 0.12);
    border: 2px solid rgb(255 255 255 / 0.4);
    color: var(--c-primary-ink);
  }

  .contact-band__mobile-label {
    display: none;
  }

  @media (max-width: 720px) {
    .contact-band {
      padding-block: 30px 34px;
    }

    .contact-band__inner {
      padding-inline: var(--sp-5);
    }

    .contact-band__panel {
      display: block;
      padding: var(--sp-6) var(--sp-5);
      border-radius: var(--radius-lg);
    }

    .contact-band__heading {
      font-size: 1.5rem;
    }

    .contact-band__actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: var(--sp-4);
    }

    .contact-band__action {
      width: 100%;
      min-height: 58px;
      padding-inline: var(--sp-4);
      font-size: var(--fs-body);
    }

    .contact-band__action--whatsapp {
      min-height: 56px;
    }

    .contact-band__desktop-label {
      display: none;
    }

    .contact-band__mobile-label {
      display: inline;
    }
  }
</style>
