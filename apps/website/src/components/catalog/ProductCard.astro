---
/**
 * The product card — one component for every grid and rail on the site.
 *
 * FOUR PARTS, in the owner's own design (2026-08-31, chosen over the reference
 * site's card): a full-width 3:2 tint well for the photo, a quiet two-line name, ONE
 * loud dark price, and one soft accent action. Nothing else — no blurb, no spec
 * chips, no divider rule, no availability dot. Those were the five competing
 * blocks that made a grid of these read as cluttered; the shortlist is the
 * design, and the hierarchy is deliberate: the price is the loudest thing on
 * the card and the name sits under it at 650, not bold.
 *
 * The price is the FIGURE, big and in ink — the accent belongs to the action,
 * and two accent elements on a card fight. A rental hangs its unit off the
 * figure in small soft type ("12,00 €" + "al giorno"); a sale price stands
 * alone. No "da" prefix: the packages on the product page are the real price,
 * and the card says so by not pretending to be exact.
 *
 * Out of stock renders as one change, not five: the action becomes a flat grey
 * "Esaurito" plate and the photo dims. The price stays — hiding it makes a
 * customer open the page to learn what they already wanted to know.
 *
 * `min-h-[2.7em]` on the name is two lines of its own type, so a one-line name
 * still reserves two and every price in a row lands on one baseline. Zero
 * JavaScript.
 *
 * Photos never crop: `object-contain` letterboxes anything that is not the
 * house 3:2.
 *
 * ------------------------------------------------------------------ mobile ---
 *
 * BELOW `mid` THIS IS A LIST ROW, NOT A CARD — 84px photo, a column of
 * name/price, a compact action pill. 336px per product becomes ~120px, which is
 * most of what takes a catalogue page from 12286px to 6900px on a phone. The
 * full spec, the measurements it follows and the reasons it differs from the
 * reference are in docs/code/storefront-mobile.md.
 *
 * TWO THINGS TO KNOW BEFORE EDITING THIS FILE:
 *
 * 1. THE FOUR CHILDREN STAY FLAT. The row is drawn by placing them on a grid
 *    with explicit `grid-area` coordinates — CSS can reposition and reorder, it
 *    cannot re-parent. Wrap the name and the price in a shared div and the row
 *    becomes impossible without a second copy of this card for phones.
 *
 * 2. THE ACTION HAS ITS OWN COLUMN. Sharing the price's cell was the first
 *    attempt and they overlapped: a price is `flex-wrap` and takes the cell's
 *    full width, so "15,00 € al giorno" ran under the pill. The name spans
 *    columns two and three so it still gets the width the pill does not need.
 */
import { perUnitLabel } from '@mia/i18n';

import { formatMoney, mediaUrl } from '~/lib/api';
import type { ProductSummary } from '~/lib/catalog';
import { localeForRequest, localeTag, translate } from '~/lib/i18n';
import { type BrowseContext, productPath } from '~/lib/routes';

interface Props {
  product: ProductSummary;
  /** Marks the LCP candidate. Set on the first card of the first grid only. */
  priority?: boolean;
  /** Heading level, so the card fits the host page's outline. */
  headingLevel?: 2 | 3;
  /** Optional shorter label for constrained promotional rails. */
  displayTitle?: string;
  /** Where and when, from the home search — handed on so the funnel remembers. */
  context?: BrowseContext;
  /** Draw the phone row at EVERY width — the catalogue's "Lista" layout. */
  row?: boolean;
}

const {
  product,
  priority = false,
  headingLevel = 3,
  displayTitle,
  context = {},
  row = false,
} = Astro.props;

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = productPath(product.slug, context, locale);
const out = !product.inStock;

/* On a rental the figure is the back office's MARKETING rate and carries its
   unit; with none typed it falls back to the cheapest package's total, which is
   a total and takes no unit. A card never renders with no figure at all. */
const amount = product.pricing.marketingRate ?? product.pricing.fromPrice;
const price =
  amount === null ? null : formatMoney(amount, product.pricing.currency, localeTag(locale));
const unit =
  product.pricing.mode === 'rental' && product.pricing.marketingRate !== null
    ? perUnitLabel(product.pricing.rentalUnit, locale)
    : null;

/**
 * THE SAME TWO SHAPES, CHOSEN TWO DIFFERENT WAYS.
 *
 * `CARD` is a card above `mid` and the row below it, which is the default and
 * what every grid and rail on the site renders. `ROW` is that row at every
 * width, and it is the catalogue's "Lista" layout — the customer asking for the
 * phone treatment on a desktop, which is exactly what a dense list is.
 *
 * Both are written out in full rather than built by adding or dropping a
 * `max-mid:` prefix, and that is not repetition for its own sake: Tailwind
 * generates utilities by SCANNING THIS FILE for literal class names, so a
 * prefix assembled at runtime produces a class that was never compiled. Every
 * string below has to appear as itself.
 *
 * Keep them in step. A change to a row rule belongs in both columns.
 */
const CARD = {
  root: 'p-3.5 mid:flex mid:flex-col max-mid:grid max-mid:content-center max-mid:gap-x-3.5 max-mid:gap-y-1.5 max-mid:p-3.5 max-mid:grid-cols-[var(--spacing-row-photo)_minmax(0,1fr)_auto]',
  photo:
    'mid:aspect-3/2 mid:h-auto mid:min-h-0 mid:w-full mid:self-stretch mid:p-3.5 h-38 self-center p-1.5 max-mid:[grid-area:1/1/3/2] max-mid:size-(--spacing-row-photo)',
  title:
    'mt-4 mb-2.5 line-clamp-2 min-h-[2.7em] text-[1rem]/[1.35] font-[650] max-mid:[grid-area:1/2/2/4] max-mid:mt-0 max-mid:mb-0 max-mid:line-clamp-3 max-mid:min-h-0 max-mid:text-[1.0313rem]/[1.25] max-mid:font-bold',
  price:
    'mb-3.5 flex-wrap gap-x-1.5 max-mid:[grid-area:2/2/3/3] max-mid:mt-0 max-mid:mb-0 max-mid:flex-nowrap max-mid:gap-x-1 max-mid:self-center max-mid:justify-self-start max-mid:whitespace-nowrap',
  figure: 'text-[1.25rem]/[1.15] max-mid:text-[1.0625rem]/[1.2]',
  action:
    'mt-auto min-h-12 rounded-xl max-mid:[grid-area:2/3/3/4] max-mid:mt-0 max-mid:min-h-9 max-mid:w-auto max-mid:justify-self-end max-mid:self-center max-mid:rounded-[10px] max-mid:px-3',
};

const ROW = {
  root: 'grid content-center gap-x-3.5 gap-y-1.5 p-3.5 grid-cols-[var(--spacing-row-photo)_minmax(0,1fr)_auto]',
  photo: 'self-center p-1.5 [grid-area:1/1/3/2] size-(--spacing-row-photo)',
  title: '[grid-area:1/2/2/4] mt-0 mb-0 line-clamp-3 min-h-0 text-[1.0313rem]/[1.25] font-bold',
  price:
    '[grid-area:2/2/3/3] mt-0 mb-0 flex-nowrap gap-x-1 self-center justify-self-start whitespace-nowrap',
  figure: 'text-[1.0625rem]/[1.2]',
  action:
    '[grid-area:2/3/3/4] mt-0 min-h-9 w-auto justify-self-end self-center rounded-[10px] px-3',
};

const shape = row ? ROW : CARD;

/* `mt-auto`, so the action sits on the card's floor and every action in a grid
   lines up even when one product carries no figure to print. The row's pill
   hugs its own label instead: 40px of paint inside a 122px row whose whole
   surface is the same link, so the project's 48px target rule is met by the
   row, not by the pill. */
const actionClass =
  'font-ui inline-flex items-center justify-center text-base font-semibold ' + shape.action;
---

{
  /* The row's `align-content:center` centres the text block against the 92px
     photo when the name runs to one line instead of two. */
}
<a
  class:list={[
    'group/product rounded-card border-hair hover:border-hair-strong h-full w-full min-w-0 border bg-white no-underline',
    shape.root,
  ]}
  href={href}
>
  {
    /* THE WELL IS THE CARD'S FULL WIDTH AT THE HOUSE 3:2, and both halves of
       that matter (owner, 2026-09-05).

       It used to be `h-46 w-auto` under the `self-center` the phone row needs,
       and in a flex column that combination shrink-wraps: the well collapsed to
       whatever the PHOTO measured, so a 500×500 product sat in a 184px tint
       square inside a 383px card and every card in a row had a differently
       sized well. `mid:self-stretch` undoes the phone row's centring and
       `mid:w-full` states the width rather than leaving it to be inferred.

       3:2 is the aspect product photos are shot at and the one HomeShowcase
       uses. Anything that is not 3:2 letterboxes inside it — `object-contain`,
       never `cover`: cropping a wheelchair to fill a box is exactly what the
       media rule forbids.

       `mid:min-h-0` is what makes the aspect stick. The well is a flex item in
       the card's column, so it carries `min-height: auto` — its automatic
       minimum is the photo's own height, and a 500×500 thumbnail at 325px wide
       demanded 325px, overruling the 235px the ratio asked for and making the
       well square again. Without this line `aspect-3/2` computes and then loses
       silently. */
  }
  <span class:list={['bg-tint block flex-none rounded-[14px]', shape.photo]}>
    {
      product.thumbnail && (
        <img
          class:list={['block size-full object-contain mix-blend-multiply', out && 'opacity-55']}
          src={mediaUrl(product.thumbnail.path)}
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding={priority ? 'sync' : 'async'}
        />
      )
    }
  </span>

  {
    /* `text-ink` on the name, not on the link: with `a { color: inherit }` in
       app.css § base a colour utility on the anchor loses to the inherited
       scope colour, and the editorial home sections set their own. */
  }
  <Heading class:list={['font-ui text-ink group-hover/product:text-accent', shape.title]}>
    {displayTitle ?? product.title}
  </Heading>

  {
    price && (
      <p class:list={['text-ink-2 flex items-baseline text-[0.8438rem]', shape.price]}>
        <b
          class:list={['font-ui text-ink font-bold tracking-[-0.01em] tabular-nums', shape.figure]}
        >
          {price}
        </b>
        {unit}
      </p>
    )
  }

  {
    out ? (
      <span class:list={[actionClass, 'bg-tint-2 text-ink-2']}>{text('card.outOfStock')}</span>
    ) : (
      <span
        class:list={[
          actionClass,
          'bg-accent-tint text-accent group-hover/product:bg-accent group-hover/product:text-white',
        ]}
      >
        {text(product.pricing.mode === 'rental' ? 'card.rent' : 'card.buy')}
      </span>
    )
  }
</a>
