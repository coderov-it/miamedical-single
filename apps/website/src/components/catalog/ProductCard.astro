---
/**
 * The product card — one component for every grid and rail on the site.
 *
 * FOUR PARTS, in the owner's own design (2026-08-31, chosen over the reference
 * site's card): an inset tint well for the photo, a quiet two-line name, ONE
 * loud dark price, and one soft accent action. Nothing else — no blurb, no spec
 * chips, no divider rule, no availability dot. Those were the five competing
 * blocks that made a grid of these read as cluttered; the shortlist is the
 * design, and the hierarchy is deliberate: the price is the loudest thing on
 * the card and the name sits under it at 650, not bold.
 *
 * The price is the FIGURE, big and in ink — the accent belongs to the action,
 * and two accent elements on a card fight. A rental hangs its unit off the
 * figure in small soft type ("12,00 €" + "al giorno"); a sale price stands
 * alone. No "da" prefix: the packages on the product page are the real price,
 * and the card says so by not pretending to be exact.
 *
 * Out of stock renders as one change, not five: the action becomes a flat grey
 * "Esaurito" plate and the photo dims. The price stays — hiding it makes a
 * customer open the page to learn what they already wanted to know.
 *
 * `min-h-[2.7em]` on the name is two lines of its own type, so a one-line name
 * still reserves two and every price in a row lands on one baseline. Zero
 * JavaScript.
 *
 * Photos never crop: `object-contain` letterboxes anything that is not the
 * house 3:2.
 */
import { perUnitLabel } from '@mia/i18n';

import { formatMoney, mediaUrl } from '~/lib/api';
import type { ProductSummary } from '~/lib/catalog';
import { localeForRequest, localeTag, translate } from '~/lib/i18n';
import { type BrowseContext, productPath } from '~/lib/routes';

interface Props {
  product: ProductSummary;
  /** Marks the LCP candidate. Set on the first card of the first grid only. */
  priority?: boolean;
  /** Heading level, so the card fits the host page's outline. */
  headingLevel?: 2 | 3;
  /** Optional shorter label for constrained promotional rails. */
  displayTitle?: string;
  /** Where and when, from the home search — handed on so the funnel remembers. */
  context?: BrowseContext;
}

const { product, priority = false, headingLevel = 3, displayTitle, context = {} } = Astro.props;

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = productPath(product.slug, context, locale);
const out = !product.inStock;

/* On a rental the figure is the back office's MARKETING rate and carries its
   unit; with none typed it falls back to the cheapest package's total, which is
   a total and takes no unit. A card never renders with no figure at all. */
const amount = product.pricing.marketingRate ?? product.pricing.fromPrice;
const price =
  amount === null ? null : formatMoney(amount, product.pricing.currency, localeTag(locale));
const unit =
  product.pricing.mode === 'rental' && product.pricing.marketingRate !== null
    ? perUnitLabel(product.pricing.rentalUnit, locale)
    : null;

/* `mt-auto`, so the action sits on the card's floor and every action in a row
   lines up even when one product carries no figure to print. */
const actionClass =
  'mt-auto font-ui inline-flex min-h-12 items-center justify-center rounded-xl ' +
  'text-base font-semibold';
---

<a
  class="group/product rounded-card border-hair hover:border-hair-strong flex h-full w-full min-w-0 flex-col border bg-white p-3.5 no-underline"
  href={href}
>
  <span class="bg-tint mid:h-46 block h-38 flex-none rounded-[14px] p-3.5">
    {
      product.thumbnail && (
        <img
          class:list={['block size-full object-contain mix-blend-multiply', out && 'opacity-55']}
          src={mediaUrl(product.thumbnail.path)}
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding={priority ? 'sync' : 'async'}
        />
      )
    }
  </span>

  {
    /* `text-ink` on the name, not on the link: with `a { color: inherit }` in
       app.css § base a colour utility on the anchor loses to the inherited
       scope colour, and the editorial home sections set their own. */
  }
  <Heading
    class="font-ui text-ink mt-4 mb-2.5 line-clamp-2 min-h-[2.7em] text-[1rem]/[1.35] font-[650] group-hover/product:text-accent"
  >
    {displayTitle ?? product.title}
  </Heading>

  {
    price && (
      <p class="text-ink-2 mb-3.5 flex flex-wrap items-baseline gap-x-1.5 text-[0.8438rem]">
        <b class="font-ui text-ink text-[1.25rem]/[1.15] font-bold tracking-[-0.01em] tabular-nums">
          {price}
        </b>
        {unit}
      </p>
    )
  }

  {
    out ? (
      <span class:list={[actionClass, 'bg-tint-2 text-ink-2']}>{text('card.outOfStock')}</span>
    ) : (
      <span
        class:list={[
          actionClass,
          'bg-accent-tint text-accent group-hover/product:bg-accent group-hover/product:text-white',
        ]}
      >
        {text(product.pricing.mode === 'rental' ? 'card.rent' : 'card.buy')}
      </span>
    )
  }
</a>
