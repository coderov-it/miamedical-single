---
/**
 * Product card — the locked round-4 design. Zero JavaScript.
 *
 * Anatomy: clean 4:3 tint stage (nothing overlaid) → name → two-line blurb →
 * spec tags (one line, cropped) → full-bleed hairline → price + bordered
 * button. Out of stock renders dead: no price, a flat "Esaurito" plate, muted
 * art, no hover. Full spec: docs/code/storefront-design-system.md, reference
 * at docs/visual/examples/product-card/reference.html.
 *
 * The card is the one place the 16px type floor bends (14/15px data rows) and
 * the one Inter surface — both locked design decisions, not drift.
 */
import { perUnitLabel } from '@mia/i18n';
import { formatMoney, mediaUrl } from '~/lib/api';
import type { ProductSummary } from '~/lib/catalog';
import { type BrowseContext, productPath } from '~/lib/routes';

interface Props {
  product: ProductSummary;
  /** Marks the LCP candidate. Set on the first card of the first grid only. */
  priority?: boolean;
  /** Heading level, so the card fits the host page's outline. */
  headingLevel?: 2 | 3;
  /** Optional shorter label for constrained promotional rails. */
  displayTitle?: string;
  /** Where and when, from the home search — handed on so the funnel remembers. */
  context?: BrowseContext;
}

const { product, priority = false, headingLevel = 3, displayTitle, context = {} } = Astro.props;

const href = productPath(product.slug, context);
const image = product.thumbnail;
const out = !product.inStock;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

/* Big amount + small unit on one baseline — no "da" prefix, per the locked
   design. On a rental the amount is the MARKETING rate, which is copy the back
   office typed; with none set it falls back to the cheapest package's total, so
   a card never renders with no price. */
const amount = product.pricing.marketingRate ?? product.pricing.fromPrice;
const unit =
  product.pricing.mode === 'rental' && product.pricing.marketingRate !== null
    ? perUnitLabel(product.pricing.rentalUnit, 'it')
    : null;
const priceLabel = amount === null ? null : formatMoney(amount, product.pricing.currency);
const ctaLabel = product.pricing.mode === 'rental' ? 'Noleggia' : 'Acquista';

const btnBase =
  'inline-flex min-h-12 items-center justify-center rounded-field border px-5 ' +
  'text-[16px] font-semibold whitespace-nowrap transition-colors duration-150';
---

{
  /*
    The whole card is one link: one destination gets one tab stop. The button is
    a styled span, never a nested <a>. Every hover affordance is conditional on
    stock — a dead card must not breathe.
  */
}
<a
  class:list={[
    'group rounded-card border-hair font-card flex h-full w-full min-w-0 flex-col overflow-hidden border bg-white no-underline',
    !out &&
      'hover:border-hair-strong transition-[border-color,box-shadow,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-[3px] hover:shadow-[0_18px_40px_-26px_rgb(19_29_64/0.4)]',
  ]}
  href={href}
>
  {
    /* ONE RATIO EVERYWHERE: the media well is 4:3 at any card width, and the
      stage carries nothing but the product — no chip, no flag, no text. */
  }
  <span
    class="border-hair to-tint relative grid aspect-4/3 flex-none place-items-center border-b bg-linear-to-b from-[#f7f9fd]"
  >
    {
      image && (
        <img
          class:list={[
            'absolute inset-0 size-full object-contain px-4.5 pt-3.5 pb-5 mix-blend-multiply',
            out
              ? 'opacity-55'
              : 'transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-1',
          ]}
          src={mediaUrl(image.path)}
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding={priority ? 'sync' : 'async'}
        />
      )
    }
  </span>

  <span class="flex flex-1 flex-col px-5 pt-4">
    {/* Clamped, no minimum height: feet align via the auto margin on the rule. */}
    <Heading
      class:list={[
        'font-card line-clamp-2 text-[18px]/[1.3] font-bold tracking-[-0.01em] text-wrap',
        out && 'text-ink-2',
      ]}
    >
      {displayTitle ?? product.title}
    </Heading>

    {
      product.shortDescription && (
        <span class="text-ink-2 mt-1.5 line-clamp-2 text-[15px]/[1.5]">
          {product.shortDescription}
        </span>
      )
    }

    {
      /* Chips dress like tags: quiet tint pills, ONE line only — a chip that does
        not fit is cropped, never wrapped. That crop is why the admin caps chip
        text at 20 characters. The full spec sheet lives on the detail page. */
    }
    {
      product.chips.length > 0 && (
        <span class="mt-3.5 flex h-7.5 flex-wrap gap-1.5 overflow-hidden">
          {product.chips.map((tag) => (
            <span class="border-hair bg-tint text-ink-2 rounded-full border px-[11px] py-1 text-[14px]/[1.4] font-medium whitespace-nowrap">
              {tag}
            </span>
          ))}
        </span>
      )
    }
  </span>

  {
    /* A divider is a divider: one hairline, edge to edge, outside the padding.
      The auto top margin pins the foot so every foot in a row aligns. */
  }
  <span class="border-hair mt-auto border-b pt-4" aria-hidden="true"></span>

  {
    /* flex-wrap: on a very narrow card the button drops below the price instead
      of squeezing — the demo's four-up rule, kept as insurance. */
  }
  <span class="flex flex-wrap items-center justify-between gap-3.5 px-5 pt-3.5 pb-4.5">
    {
      out ? (
        <span class:list={[btnBase, 'border-tint-2 bg-tint-2 text-ink-2 flex-1']}>Esaurito</span>
      ) : (
        <>
          <span class="text-ink-2 flex items-baseline gap-1.5 text-[14px] whitespace-nowrap">
            <b class="text-ink text-[24px]/[1.1] font-bold tracking-[-0.01em] lining-nums tabular-nums">
              {priceLabel}
            </b>
            {unit}
          </span>
          <span
            class:list={[
              btnBase,
              'border-hair-strong text-ink flex-none bg-white',
              'group-hover:border-accent group-hover:bg-accent group-hover:text-white',
            ]}
          >
            {ctaLabel}
          </span>
        </>
      )
    }
  </span>
</a>
