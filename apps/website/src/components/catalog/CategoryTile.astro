---
/**
 * One category tile — quiet white card, one hairline, a pale well for the art.
 *
 * Shared by the home grid and the catalogue directory so the two can never
 * drift. It paints from the blueprint tokens carried by the region around it
 * through the editorial Tailwind token class, so each host carries that theme.
 */
import { mediaUrl } from '~/lib/api';
import type { CategoryTile } from '~/lib/catalog-page';

interface Props {
  tile: CategoryTile;
  /** Heading level, so the tile fits the host page's outline. */
  headingLevel?: 2 | 3;
}

const { tile, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{/* Centered composition since 2026-08-31, matching the reference tiles:
    the art well on top, the name and the offer centered under it. */}
<a
  class="group/category rounded-card block h-full border border-[var(--color-line)] bg-white px-4 pt-4 pb-4.5 text-center no-underline hover:border-[#ccd2e2]"
  href={tile.href}
>
  <span class="mb-3 block h-24 rounded-xl bg-[var(--color-surface-2)] p-1.5">
    {
      tile.imagePath && (
        <img
          class="block size-full object-contain mix-blend-multiply"
          src={mediaUrl(tile.imagePath)}
          alt=""
          loading="lazy"
        />
      )
    }
  </span>
  <Heading
    class="text-[1.0625rem] leading-[1.35] font-bold group-hover/category:text-[var(--color-accent)]"
    >{tile.name}</Heading
  >
  {/* A price is an offer and a count is inventory — same slot, different ink. */}
  <p
    class:list={[
      'mt-1 text-sm text-[var(--color-ink-soft)] tabular-nums',
      tile.isPriced && 'font-[650] text-[var(--color-accent)]',
    ]}
  >
    {tile.detail}
  </p>
</a>
