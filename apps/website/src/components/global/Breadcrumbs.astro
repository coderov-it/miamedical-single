---
/**
 * Breadcrumb trail. Zero JavaScript.
 *
 * Emits BreadcrumbList JSON-LD from the same array it renders, so the markup and
 * the structured data can never disagree.
 */
import { serializeJsonLd } from '~/lib/json-ld';
import { localeForRequest, translate } from '~/lib/i18n';

interface Crumb {
  label: string;
  /** Root-relative. Omit on the current page. */
  href?: string;
}

interface Props {
  items: Crumb[];
  /** Absolute site origin, needed for JSON-LD item URLs. */
  origin?: string;
}

const { items, origin = Astro.site?.origin ?? Astro.url.origin } = Astro.props;
const locale = localeForRequest();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    ...(crumb.href ? { item: `${origin}${crumb.href}` } : {}),
  })),
};
---

<nav class="pb-4" aria-label={translate(locale, 'breadcrumbs.label')}>
  {
    /* 14px, regular, muted — a trail kept for structured data and orientation,
       not a second heading. It used to render 16px/600 with a bold near-black
       current item, so a category page opened with the same word twice: once in
       the trail and once as the h1 under it (owner, 2026-08-30). */
  }
  <ol class="flex flex-wrap items-center gap-2 text-[14px]">
    {
      items.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {/*
            Breadcrumb links are navigation, not prose, so they keep the full
            48px target rather than the WCAG 2.5.8 inline exception. They no
            longer PAINT at 48px, though: a 48px-tall box around 13.5px text
            spent 72px of every page on one line of it (owner, 2026-08-30).
            `.hit-48` is the checkout's `.target-48` deal — the paint is the
            text, the hit area is still 48×48. See app.css § target sizing.
          */}
          {crumb.href ? (
            <a class="hit-48 text-ink-2 inline-flex items-center font-normal" href={crumb.href}>
              {crumb.label}
            </a>
          ) : (
            <span class="text-ink-2 font-bold" aria-current="page">
              {crumb.label}
            </span>
          )}
          {/*
            Decorative only: it carries no information and is hidden from
            assistive technology, so the lighter tone is acceptable here.
          */}
          {index < items.length - 1 && (
            <span class="text-ink-decorative" aria-hidden="true">
              ›
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />
