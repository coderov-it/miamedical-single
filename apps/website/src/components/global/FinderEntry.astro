---
/**
 * The way into "Aiutami a scegliere" from a browsing surface.
 *
 * A customer who can name the aid they want uses the catalogue; this is for the
 * one who cannot, and it has to be visible on the pages where that becomes
 * obvious — the home page and the category directory. Both mount this same
 * band, so the offer is worded once.
 *
 * Accent-tinted, not accent-filled: it sits among white cards on the grey
 * ground and a solid accent block there would outrank the products it is meant
 * to help someone reach. The button inside carries the accent instead — one
 * loud element, the way the product card does it (CLAUDE.md § controls).
 */
import { localeForRequest, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';

interface Props {
  /** Heading level, so the band fits the host page's outline. */
  headingLevel?: 2 | 3;
  class?: string;
}

const { headingLevel = 2, class: className = '' } = Astro.props;
const locale = localeForRequest();
const text = (key: string) => translate(locale, key);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<section
  class:list={[
    'bg-accent-tint rounded-panel mid:flex-row mid:items-center mid:gap-7 mid:p-7 max-mid:p-5',
    'flex flex-col gap-4',
    className,
  ]}
>
  {
    /* The compass is the tab bar's own "aiutami" glyph on the reference site —
      decorative here, because the heading beside it says the same thing. */
  }
  <span
    class="max-mid:hidden grid size-14 flex-none place-items-center rounded-full bg-accent text-white"
    aria-hidden="true"
  >
    <svg
      class="size-7"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="m15.5 8.5-2 5-5 2 2-5Z"></path>
    </svg>
  </span>

  <div class="min-w-0 flex-1">
    <Heading class="font-ui text-ink text-[1.1875rem]/[1.3] font-bold">
      {text('finder.entry.title')}
    </Heading>
    <p class="text-ink-2 mt-1.5 text-base/[1.5]">{text('finder.entry.text')}</p>
  </div>

  <a
    class="font-ui hover:bg-accent-deep rounded-field max-mid:w-full inline-flex min-h-13 flex-none items-center justify-center gap-2 bg-accent px-7 text-[1.0313rem] font-semibold text-white no-underline"
    href={routePath(locale, 'productFinder')}
  >
    {text('finder.entry.cta')}
    <svg
      class="size-4.5 flex-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14"></path>
      <path d="m13 6 6 6-6 6"></path>
    </svg>
  </a>
</section>
