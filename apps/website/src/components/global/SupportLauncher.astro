---
/**
 * The support launcher — a pinned button, bottom right of every page, opening
 * the three ways to reach a person: WhatsApp, the freephone number, and the
 * support page.
 *
 * It replaces the header's support link (owner, 2026-08-30). A nav item costs a
 * slot the catalogue needs and still lands the customer on a page they then
 * have to read; this puts the phone one tap away from wherever they got stuck.
 *
 * Built on `<details>`, so it opens, closes and takes focus with no JavaScript
 * at all. The only script closes it on Escape and on an outside click — two
 * conveniences, never the mechanism.
 *
 * It sits above the phone's bottom navigation, never over it — see
 * `.support-launcher` in styles/app.css, which also stands it down on the
 * product page, where the price bar already fills that corner.
 */
import { localeForRequest, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { CONTACT, whatsappUrl } from '~/lib/site';

const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

const itemClass =
  'flex items-center gap-3 rounded-field px-3.5 py-3 font-display text-ui font-semibold no-underline';
---

<details class="support-launcher" data-support-launcher>
  <summary
    class="rounded-field font-display text-ui-strong hover:bg-accent-deep flex min-h-13 items-center gap-2.5 border-0 bg-accent px-5 font-semibold text-white shadow-[0_14px_34px_-14px_rgb(11_18_32/0.55)]"
    aria-label={text('support.launcher.open')}
  >
    <svg
      class="size-5 flex-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.7L3 21l1.8-5.1A8.3 8.3 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"
      ></path>
    </svg>
    <span>{text('support.launcher.label')}</span>
  </summary>

  <div class="support-launcher-panel rounded-card border-hair border bg-white p-2.5 shadow-lg">
    <p class="font-display text-ui text-ink-2 px-3.5 pt-2 pb-1.5 font-semibold">
      {CONTACT.hours[locale]}
    </p>

    <a
      class:list={[itemClass, 'bg-accent-tint text-accent']}
      href={whatsappUrl()}
      target="_blank"
      rel="noopener"
    >
      <svg
        class="size-5 flex-none"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.7L3 21l1.8-5.1A8.3 8.3 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"
        ></path>
      </svg>
      <span>{text('support.launcher.whatsapp')}</span>
    </a>

    <a
      class:list={[itemClass, 'bg-tint text-ink hover:bg-tint-2 mt-1.5']}
      href={`tel:${CONTACT.phoneE164}`}
      data-analytics="phone-call"
    >
      <svg
        class="size-5 flex-none"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.1"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"
        ></path>
      </svg>
      <span>{CONTACT.phoneDisplay}</span>
    </a>

    <a
      class:list={[itemClass, 'bg-tint text-ink hover:bg-tint-2 mt-1.5']}
      href={routePath(locale, 'support')}
    >
      <svg
        class="size-5 flex-none"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M9.6 9.3a2.5 2.5 0 0 1 4.8.8c0 1.7-2.4 2.1-2.4 3.4"></path>
        <path d="M12 17.2v.01"></path>
      </svg>
      <span>{text('support.launcher.page')}</span>
    </a>
  </div>
</details>

<script>
  /**
   * Escape and an outside click close the panel. `<details>` already opens it,
   * closes it on the summary and gives it a tab stop — this only adds the two
   * dismissals a floating panel is expected to have.
   */
  const launcher = document.querySelector<HTMLDetailsElement>('[data-support-launcher]');

  if (launcher) {
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !launcher.open) return;
      launcher.open = false;
      launcher.querySelector('summary')?.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (!launcher.open) return;
      if (event.target instanceof Node && launcher.contains(event.target)) return;
      launcher.open = false;
    });
  }
</script>
