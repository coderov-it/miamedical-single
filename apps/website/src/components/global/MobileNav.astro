---
/**
 * Persistent bottom tab bar, phones only — the app's primary navigation.
 *
 * Matched to the reference site's own tab bar (miamedicalitalia.it at 390px,
 * measured 2026-08-31): a sticky white bar that LIFTS off the page on a soft
 * upward shadow rather than ruling itself off it, `6px 8px 8px+safe-area` of
 * padding, and equal-width tabs of a pill-backed icon over its label. The
 * selected tab is marked by filling that pill with `accent-tint` and turning
 * the whole tab accent — a fill, never a border (CLAUDE.md § controls).
 *
 * FOUR TABS: home, catalogue, the guided selector, support. This follows the
 * reference's own re-cut (re-measured 2026-09-05, 390px) — it used to run
 * noleggio/vendita in the last two slots and now runs "Aiutami"/"Aiuto", which
 * is the right trade on a phone. Noleggio and vendita are a MODE, not a
 * destination: the catalogue's own pills carry both, so they cost one extra tap
 * and lose nothing. What they were displacing is the two things a customer who
 * cannot name the aid actually needs, and neither had a phone entry point —
 * the selector had none at all, and support only had the floating launcher.
 *
 * The type floor is why this stays four and not their earlier five: they set
 * tab labels at 11px, and this project has no token below 16px for an audience
 * that reads magnified. Four 16px labels fit 390px; five clip. Both new labels
 * are shorter than the ones they replace, so the fit got easier, not tighter.
 *
 * Search moved UP into the header as an icon on 2026-08-31, following the
 * reference; the cart lives in the header too, badge and all.
 *
 * Deliberately static: every item is a real route link and the active route is
 * derived on the server, so there is no menu state and no client JavaScript.
 */
import { publicPathForRequest, translate, type SiteLocale } from '~/lib/i18n';
import { routePath } from '~/lib/routes';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const text = (key: string) => translate(locale, key);

const items = [
  { href: routePath(locale, 'home'), label: text('header.home'), exact: true, icon: 'home' },
  {
    href: routePath(locale, 'catalog'),
    label: text('header.catalog'),
    exact: true,
    icon: 'catalog',
  },
  /* Both are `exact`: the selector keeps its own path through all three steps
     (the answers are query parameters), so the tab stays lit while the customer
     is inside it. */
  {
    href: routePath(locale, 'productFinder'),
    label: text('navigation.finder'),
    exact: true,
    icon: 'finder',
  },
  {
    href: routePath(locale, 'support'),
    label: text('navigation.help'),
    exact: true,
    icon: 'help',
  },
] as const;

const path = Astro.locals.publicPath ?? publicPathForRequest() ?? Astro.url.pathname;
const isActive = (item: (typeof items)[number]) =>
  item.exact ? path === item.href : path.startsWith(item.href);
---

<nav
  id="mobile-nav"
  class="border-hair mid:hidden shadow-tabbar sticky bottom-0 z-70 flex border-t bg-white px-2 pt-1.5 pb-[calc(0.5rem+env(safe-area-inset-bottom))]"
  aria-label={text('navigation.primary')}
>
  {
    items.map((item) => (
      <a
        class:list={[
          'rounded-field font-display flex min-h-15.25 flex-1 basis-0 flex-col items-center justify-center gap-0.75 px-0.5 py-1.25 text-base/[1.15] font-bold no-underline',
          isActive(item) ? 'text-accent' : 'text-ink-2',
        ]}
        href={item.href}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        {/* 52×30 pill, the reference's own tab marker: it is wider than the
            icon so the fill reads as a selected SLOT rather than a badge. */}
        <span
          class:list={[
            'grid h-7.5 w-13 place-items-center rounded-[10px]',
            isActive(item) && 'bg-accent-tint',
          ]}
          aria-hidden="true"
        >
          {item.icon === 'home' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m3 11 9-8 9 8" />
              <path d="M5 10v10h14V10M9 20v-6h6v6" />
            </svg>
          )}
          {item.icon === 'catalog' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
          )}
          {/* The compass is the selector's mark everywhere it appears — the
              home search card and the catalogue entry band use this exact
              glyph, so the tab is recognisably the same door. */}
          {item.icon === 'finder' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="m15.5 8.5-2 5-5 2 2-5Z" />
            </svg>
          )}
          {/* A headset, not a question mark: it promises a person on the phone,
              which is what this page is, and it is the reference's own glyph. */}
          {item.icon === 'help' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 18v-6a8 8 0 0 1 16 0v6" />
              <path d="M2.5 14.5h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1a2 2 0 0 1-2-2Z" />
              <path d="M21.5 14.5h-3a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h1a2 2 0 0 0 2-2Z" />
            </svg>
          )}
        </span>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>
