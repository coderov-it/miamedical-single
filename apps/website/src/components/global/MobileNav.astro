---
/**
 * Persistent bottom navigation, phones only.
 *
 * The approved design hides the inline navigation below 720px and shows no
 * mobile alternative. Leaving phone users with no navigation at all is not an
 * option for this audience, so the bottom bar stays — restyled to the same
 * hairline-and-tint vocabulary as the rest of the page.
 *
 * Deliberately static: every item is a real route link and the active route is
 * derived on the server, so there is no menu state and no client JavaScript.
 */
import { routes } from '~/lib/routes';

const items = [
  { href: routes.home, label: 'Home', exact: true, icon: 'home' },
  { href: routes.catalog, label: 'Catalogo', exact: false, icon: 'catalog' },
  { href: routes.cart, label: 'Richiesta', exact: false, icon: 'cart' },
  { href: routes.support, label: 'Assistenza', exact: false, icon: 'help' },
] as const;

const path = Astro.url.pathname;
const isActive = (item: (typeof items)[number]) =>
  item.exact ? path === item.href : path.startsWith(item.href);
---

<nav
  id="navigazione-mobile"
  class="border-hair mid:hidden sticky bottom-0 z-70 grid grid-cols-4 gap-2 border-t bg-white px-2 pt-1.5 pb-[calc(0.5rem+env(safe-area-inset-bottom))]"
  aria-label="Navigazione principale"
>
  {
    items.map((item) => (
      <a
        class:list={[
          'rounded-field font-display text-ui flex min-h-14.5 min-w-0 flex-col items-center justify-center gap-0.5 px-0.5 py-1 font-bold no-underline',
          isActive(item) ? 'text-accent' : 'text-ink-2',
        ]}
        href={item.href}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        <span
          class:list={[
            'grid h-6 w-6 place-items-center',
            isActive(item) && 'bg-tint h-7.5 w-13 rounded-full',
          ]}
          aria-hidden="true"
        >
          {item.icon === 'home' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m3 11 9-8 9 8" />
              <path d="M5 10v10h14V10M9 20v-6h6v6" />
            </svg>
          )}
          {item.icon === 'catalog' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
          )}
          {item.icon === 'cart' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 5h2l2.2 10.2a2 2 0 0 0 2 1.6h7.1a2 2 0 0 0 2-1.5L21 8H6.4" />
              <circle cx="10.5" cy="20" r="1.4" />
              <circle cx="17.5" cy="20" r="1.4" />
            </svg>
          )}
          {item.icon === 'help' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
              <rect x="2" y="13" width="4" height="7" rx="2" />
              <rect x="18" y="13" width="4" height="7" rx="2" />
              <path d="M18 20c0 1-1 2-3 2h-2" />
            </svg>
          )}
        </span>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>
