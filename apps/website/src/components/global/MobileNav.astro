---
/**
 * Persistent bottom tab bar, phones only — the app's primary navigation.
 *
 * Matched to the reference site's own tab bar (miamedicalitalia.it at 390px,
 * measured 2026-08-31): a sticky white bar that LIFTS off the page on a soft
 * upward shadow rather than ruling itself off it, `6px 8px 8px+safe-area` of
 * padding, and equal-width tabs of a pill-backed icon over its label. The
 * selected tab is marked by filling that pill with `accent-tint` and turning
 * the whole tab accent — a fill, never a border (CLAUDE.md § controls).
 *
 * FOUR TABS, NOT THE REFERENCE'S FIVE, and the difference is the type floor.
 * They set their tab labels at 13.3px; this project has no token below 16px and
 * that floor is not negotiable for an audience that reads magnified. Four
 * 16px labels fit a 390px viewport; five clip. The dropped slot is their
 * "Aiuto", which the support launcher already reaches from every screen.
 *
 * WHAT THE FOUR ARE is the reference's information architecture, not the
 * header's list in miniature: browse (home, catalogue) and the two things a
 * customer actually chooses between (noleggio, vendita). Search moved UP into
 * the header as an icon on 2026-08-31, following the reference, which is what
 * freed the slot; the cart lives in the header too, badge and all.
 *
 * Deliberately static: every item is a real route link and the active route is
 * derived on the server, so there is no menu state and no client JavaScript.
 */
import { publicPathForRequest, translate, type SiteLocale } from '~/lib/i18n';
import { routePath } from '~/lib/routes';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const text = (key: string) => translate(locale, key);

const items = [
  { href: routePath(locale, 'home'), label: text('header.home'), exact: true, icon: 'home' },
  {
    href: routePath(locale, 'catalog'),
    label: text('header.catalog'),
    exact: true,
    icon: 'catalog',
  },
  {
    href: routePath(locale, 'catalogRental'),
    label: text('header.rental'),
    exact: false,
    icon: 'rental',
  },
  {
    href: routePath(locale, 'catalogSale'),
    label: text('header.sale'),
    exact: false,
    icon: 'sale',
  },
] as const;

const path = Astro.locals.publicPath ?? publicPathForRequest() ?? Astro.url.pathname;
const isActive = (item: (typeof items)[number]) =>
  item.exact ? path === item.href : path.startsWith(item.href);
---

<nav
  id="mobile-nav"
  class="border-hair mid:hidden shadow-tabbar sticky bottom-0 z-70 flex border-t bg-white px-2 pt-1.5 pb-[calc(0.5rem+env(safe-area-inset-bottom))]"
  aria-label={text('navigation.primary')}
>
  {
    items.map((item) => (
      <a
        class:list={[
          'rounded-field font-display flex min-h-15.25 flex-1 basis-0 flex-col items-center justify-center gap-0.75 px-0.5 py-1.25 text-base/[1.15] font-bold no-underline',
          isActive(item) ? 'text-accent' : 'text-ink-2',
        ]}
        href={item.href}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        {/* 52×30 pill, the reference's own tab marker: it is wider than the
            icon so the fill reads as a selected SLOT rather than a badge. */}
        <span
          class:list={[
            'grid h-7.5 w-13 place-items-center rounded-[10px]',
            isActive(item) && 'bg-accent-tint',
          ]}
          aria-hidden="true"
        >
          {item.icon === 'home' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m3 11 9-8 9 8" />
              <path d="M5 10v10h14V10M9 20v-6h6v6" />
            </svg>
          )}
          {item.icon === 'catalog' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
          )}
          {/* Rental is a calendar and sale is a price tag — the reference's own
              two glyphs, and the only pair that says "for a while" against
              "to keep" without a word. */}
          {item.icon === 'rental' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="5" width="18" height="16" rx="2.5" />
              <path d="M3 10h18M8 3v4M16 3v4" />
            </svg>
          )}
          {item.icon === 'sale' && (
            <svg
              class="size-5.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3.5 12.6V4.5a1 1 0 0 1 1-1h8.1a1 1 0 0 1 .7.3l7 7a1 1 0 0 1 0 1.4l-8.1 8.1a1 1 0 0 1-1.4 0l-7-7a1 1 0 0 1-.3-.7Z" />
              <circle cx="8" cy="8" r="1.4" />
            </svg>
          )}
        </span>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>
