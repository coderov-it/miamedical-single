---
/**
 * Global footer — the page closes on the design system's deep navy, ported 1:1
 * from docs/blueprint/home.html (styles in styles/editorial.css).
 *
 * The rental links are editorial labels, not category records: the footer
 * renders on every page, and fetching the category tree here would add an API
 * round trip to every request for four link labels. They point at a catalogue
 * search, which is a real destination that cannot become a dead URL if a
 * category is renamed.
 */
import { catalogPath, routes } from '~/lib/routes';
import { COMPANY, CONTACT } from '~/lib/site';

const year = new Date().getFullYear();

const rentalLinks = [
  { href: routes.catalog, label: 'Catalogo completo' },
  { href: catalogPath({ q: 'Carrozzine' }), label: 'Carrozzine' },
  { href: catalogPath({ q: 'Letti ortopedici' }), label: 'Letti ortopedici' },
  { href: catalogPath({ q: 'Scooter elettrici' }), label: 'Scooter elettrici' },
  { href: catalogPath({ q: 'Deambulatori' }), label: 'Deambulatori' },
];

const supportLinks = [
  { href: routes.support, label: 'Contatti' },
  { href: routes.search, label: 'Cerca un ausilio' },
  { href: routes.account, label: 'Area clienti' },
  { href: routes.cart, label: 'Il tuo carrello' },
];

const informationLinks = [
  { href: routes.blog, label: 'Blog' },
  { href: routes.terms, label: 'Termini e condizioni' },
  { href: routes.privacy, label: 'Privacy policy' },
  { href: routes.cookies, label: 'Cookie policy' },
];

/* Placeholder profiles — swap for the real ones when marketing hands them over. */
const socials = [
  {
    href: 'https://www.facebook.com/miamedicalitalia',
    label: 'Seguici su Facebook',
    icon: 'facebook',
  },
  {
    href: 'https://www.instagram.com/miamedicalitalia',
    label: 'Seguici su Instagram',
    icon: 'instagram',
  },
  { href: 'https://x.com/miamedicalitalia', label: 'Seguici su X', icon: 'x' },
  {
    href: 'https://maps.google.com/?q=M.i.a.+Medical+Italia',
    label: 'La nostra sede su Google Maps',
    icon: 'maps',
  },
] as const;
---

<footer class="site-foot">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href={routes.home}>MIA-MEDICAL</a>
        <p class="foot-tagline">Moving in autonomy</p>
        <p class="foot-about">
          Noleggio di ausili medicali con consegna a domicilio a Roma e Firenze. Prodotti sanificati
          e certificati, assistenza con persone vere.
        </p>
        <a
          class="foot-phone"
          href={`tel:${CONTACT.phoneE164}`}
          aria-label={`Chiama il numero verde ${CONTACT.phoneDisplay}, gratuito`}
          data-analytics="phone-call"
        >
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"
            ></path>
          </svg>
          {CONTACT.phoneDisplay}
        </a>
        <p class="foot-hours">Numero verde gratuito · {CONTACT.hours.it}</p>

        <div class="foot-socials">
          {
            socials.map((social) => (
              <a href={social.href} target="_blank" rel="noopener" aria-label={social.label}>
                {social.icon === 'facebook' && (
                  <svg
                    width="19"
                    height="19"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M13.5 21.5v-7.4h2.5l.4-2.9h-2.9V9.3c0-.85.23-1.43 1.45-1.43l1.55-.01V5.27c-.27-.04-1.19-.12-2.26-.12-2.24 0-3.77 1.37-3.77 3.88v2.16H8v2.9h2.47v7.4Z" />
                  </svg>
                )}
                {social.icon === 'instagram' && (
                  <svg
                    width="19"
                    height="19"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
                    <circle cx="12" cy="12" r="4.1" />
                    <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {social.icon === 'x' && (
                  <svg
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M17.8 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5.2 21H2.1l7.3-8.3L2 3h6.4l4.4 5.9L17.8 3Zm-1.1 16.1h1.7L7.4 4.8H5.6l11.1 14.3Z" />
                  </svg>
                )}
                {social.icon === 'maps' && (
                  <svg
                    width="19"
                    height="19"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-labelledby="foot-catalog-heading">
        <h2 class="foot-heading" id="foot-catalog-heading">Noleggio</h2>
        <div class="foot-links">
          {rentalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </nav>

      <nav aria-labelledby="foot-support-heading">
        <h2 class="foot-heading" id="foot-support-heading">Assistenza</h2>
        <div class="foot-links">
          {supportLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </nav>

      <nav aria-labelledby="foot-info-heading">
        <h2 class="foot-heading" id="foot-info-heading">Informazioni</h2>
        <div class="foot-links">
          {informationLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </nav>
    </div>

    <div class="foot-bottom">
      <p>{`© ${year} ${COMPANY.legalName} · P.IVA ${COMPANY.vat}`}</p>
      <p>
        <a href={routes.privacy}>Privacy</a> · <a href={routes.cookies}>Cookie</a>
      </p>
    </div>
  </div>
</footer>
