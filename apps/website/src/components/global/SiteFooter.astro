---
/**
 * Global footer — the darkest step of the closing descent: the "parla con noi"
 * band sits on --accent-deep, this sits on --footer. Two steps of the same
 * brand blue, not two different blues.
 *
 * The rental headings are editorial labels, not category records: the footer
 * renders on every page, including on-demand ones, and fetching the category
 * tree here would add an API round trip to every request for four link labels.
 * They point at a catalogue search, which is a real destination that cannot
 * become a dead URL if a category is renamed.
 */
import { catalogPath, routes } from '~/lib/routes';
import { COMPANY, CONTACT, LOCATIONS, whatsappUrl } from '~/lib/site';

const year = new Date().getFullYear();

const rentalCategories = [
  'Carrozzine',
  'Carrozzine elettriche e scooter',
  'Letti ortopedici',
  'Deambulatori e rollatori',
  'Montascale',
  'Materassi antidecubito',
];

const help = [
  { href: `${routes.home}#come-funziona`, label: 'Come funziona' },
  { href: `${routes.home}#domande-frequenti`, label: 'Domande frequenti' },
  { href: routes.support, label: 'Assistenza' },
  { href: routes.catalog, label: 'Catalogo noleggio' },
];

const information = [
  { href: routes.terms, label: 'Termini e condizioni' },
  { href: routes.privacy, label: 'Privacy policy' },
  { href: routes.cookies, label: 'Cookie policy' },
];
---

<footer class="bg-footer text-white">
  <div class="max-w-page mid:px-8 mid:pt-16 mx-auto w-full px-5 pt-12">
    <div class="mid:grid-cols-2 wide:grid-cols-[1.4fr_repeat(3,1fr)] grid gap-10 pb-12">
      <section aria-label="Mia Medical Italia">
        {
          /*
            The mark is brand blue on transparent and would disappear on the
            dark footer. Production wants a dedicated white file; until then it
            is knocked out here.
          */
        }
        <img
          class="mb-4.5 h-10 w-auto brightness-0 invert"
          src="/img/logo.svg"
          alt="M.i.a. Medical Italia — moving in autonomy"
          width="71"
          height="38"
        />
        <p class="text-ui text-on-dark">
          Noleggio e vendita di ausili sanitari a domicilio, per brevi e lunghi periodi. Consegna a
          Roma e Firenze in 24–48 ore.
        </p>
        <address class="text-ui text-on-dark mt-4 not-italic">
          Numero verde: <a class="text-white" href={`tel:${CONTACT.phoneE164}`}
            >{CONTACT.phoneDisplay}</a
          ><br />
          WhatsApp: <a class="text-white" href={whatsappUrl()} target="_blank" rel="noopener">
            {CONTACT.whatsappDisplay}
          </a><br />
          Email: <a class="text-white" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </address>
      </section>

      <nav aria-labelledby="footer-rental-title">
        <h2 id="footer-rental-title" class="text-ui-strong mb-3 text-white">Noleggio</h2>
        <ul>
          {
            rentalCategories.map((category) => (
              <li>
                <a
                  class="text-ui-strong text-on-dark inline-flex min-h-10.5 items-center no-underline hover:text-white hover:underline"
                  href={catalogPath({ q: category })}
                >
                  {category}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-help-title">
        <h2 id="footer-help-title" class="text-ui-strong mb-3 text-white">Aiuto</h2>
        <ul>
          {
            help.map((item) => (
              <li>
                <a
                  class="text-ui-strong text-on-dark inline-flex min-h-10.5 items-center no-underline hover:text-white hover:underline"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <nav aria-labelledby="footer-info-title">
          <h2 id="footer-info-title" class="text-ui-strong mb-3 text-white">Legale</h2>
          <ul>
            {
              information.map((item) => (
                <li>
                  <a
                    class="text-ui-strong text-on-dark inline-flex min-h-10.5 items-center no-underline hover:text-white hover:underline"
                    href={item.href}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <h2 class="text-ui-strong mt-6 mb-3 text-white">Le nostre sedi</h2>
        <ul class="text-ui text-on-dark grid gap-1">
          {
            LOCATIONS.map((location) => (
              <li>
                <strong class="text-white">{location.city}</strong> — {location.street}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      /*
        One expression, not three adjacent ones: the formatter breaks adjacent
        expressions onto separate lines and the whitespace between them is
        dropped at compile time, gluing the year to the company name.
      */
    }
    <div
      class="text-ui text-on-dark flex flex-wrap justify-between gap-x-8 gap-y-2.5 pt-6 pb-11 shadow-[inset_0_1px_0_rgb(255_255_255/0.14)]"
    >
      <span>{`© ${year} ${COMPANY.legalName} — P.IVA ${COMPANY.vat}`}</span>
      <span>Consegna a domicilio a Roma e Firenze</span>
    </div>
  </div>
</footer>
