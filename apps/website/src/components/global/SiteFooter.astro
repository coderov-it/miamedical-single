---
/**
 * Global footer from the approved storefront design.
 *
 * The rental headings are editorial labels, not category records: the footer
 * renders on every page, including on-demand ones, and fetching the category
 * tree here would add an API round trip to every request for four link labels.
 * They point at a catalogue search, which is a real destination that cannot
 * become a dead URL if a category is renamed.
 */
import { catalogPath, routes } from '~/lib/routes';
import { COMPANY, CONTACT, LOCATIONS, whatsappUrl } from '~/lib/site';

const year = new Date().getFullYear();

const rentalCategories = [
  'Carrozzine',
  'Carrozzine elettriche e scooter',
  'Letti ortopedici',
  'Deambulatori e rollatori',
  'Montascale',
  'Sollevatori e verticalizzatori',
  'Materassi antidecubito',
];

const information = [
  { href: routes.terms, label: 'Termini e condizioni' },
  { href: routes.privacy, label: 'Privacy policy' },
  { href: routes.cookies, label: 'Cookie policy' },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <section class="footer__brand" aria-label="Mia Medical Italia">
        <span class="footer__logo">
          <img
            src="/img/logo.svg"
            alt="M.i.a. Medical Italia — moving in autonomy"
            width="71"
            height="38"
          />
        </span>
        <p>
          Noleggio e vendita di ausili sanitari a domicilio, per brevi e lunghi periodi.{' '}
          <span class="footer__desktop-copy">Consegna a Roma e Firenze in 24–48 ore.</span>
        </p>
        <address class="footer__contacts">
          Numero verde: <a href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phoneDisplay}</a><br />
          WhatsApp: <a href={whatsappUrl()} target="_blank" rel="noopener">
            {CONTACT.whatsappDisplay}
          </a><br />
          Email: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </address>
      </section>

      <nav class="footer__categories" aria-labelledby="footer-rental-title">
        <h2 id="footer-rental-title">Affitto e noleggio</h2>
        <ul>
          {
            rentalCategories.map((category) => (
              <li>
                <a href={catalogPath({ q: category })}>{category}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="footer__locations" aria-labelledby="footer-location-title">
        <h2 id="footer-location-title">Le nostre sedi</h2>
        <ul>
          {
            LOCATIONS.map((location) => (
              <li>
                <strong>{location.city}</strong>
                <span>{location.street}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <nav class="footer__information" aria-labelledby="footer-info-title">
        <h2 id="footer-info-title">Informazioni</h2>
        <ul>
          {
            information.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {
      /*
      One expression, not three adjacent ones: the formatter breaks adjacent
      expressions onto separate lines and the whitespace between them is dropped
      at compile time, gluing the year to the company name.
    */
    }
    <p class="footer__legal">{`© ${year} ${COMPANY.legalName} — P.IVA ${COMPANY.vat}`}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-ink);
    color: #b9c2d6;
  }

  .footer__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 44px var(--container-pad) 20px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 36px;
  }

  .footer__logo {
    display: inline-flex;
    margin-bottom: var(--sp-4);
    padding: 7px 12px;
    border-radius: 10px;
    background: var(--c-surface);
  }

  .footer__logo img {
    width: auto;
    height: 38px;
  }

  .footer__brand > p,
  .footer__contacts,
  .footer__locations li {
    font-size: var(--fs-ui);
    line-height: var(--lh-body);
  }

  .footer__brand > p {
    margin-bottom: 14px;
  }

  .footer__contacts {
    color: inherit;
    font-style: normal;
  }

  .footer a {
    color: #fff;
  }

  .footer h2 {
    margin-bottom: var(--sp-3);
    color: #fff;
    font-size: var(--fs-ui);
  }

  .footer ul {
    display: grid;
    gap: 9px;
    list-style: none;
  }

  .footer__categories a,
  .footer__information a {
    font-size: var(--fs-ui);
    line-height: 1.5;
  }

  .footer__categories a {
    color: #b9c2d6;
    text-decoration: none;
  }

  .footer__categories a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer__locations li {
    display: grid;
  }

  .footer__locations li + li {
    margin-top: 1px;
  }

  .footer__locations strong {
    color: #fff;
  }

  .footer__information a {
    color: #b9c2d6;
  }

  .footer__legal {
    margin-top: var(--sp-8);
    padding-top: 18px;
    border-top: 1px solid #2a3550;
    color: #9aa5bc;
    font-size: var(--fs-ui);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .footer__inner {
      padding: 28px var(--sp-5) 30px;
    }

    .footer__grid {
      display: flex;
      flex-direction: column;
    }

    .footer__brand {
      display: contents;
    }

    .footer__logo {
      order: 1;
      align-self: flex-start;
      margin-bottom: 14px;
      padding: 6px 10px;
    }

    .footer__logo img {
      height: 34px;
    }

    .footer__desktop-copy,
    .footer__categories,
    .footer__locations h2,
    .footer__information h2 {
      display: none;
    }

    .footer__brand > p {
      order: 2;
    }

    .footer__locations {
      order: 3;
      margin-top: 14px;
    }

    .footer__locations ul {
      gap: 4px;
    }

    .footer__locations li {
      display: block;
    }

    .footer__locations strong::after {
      content: ' — ';
      color: #b9c2d6;
      font-weight: 400;
    }

    .footer__information {
      order: 5;
      margin-top: 14px;
    }

    .footer__contacts {
      order: 4;
      margin-top: 14px;
    }

    .footer__information ul {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 16px;
    }

    .footer__information a {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
    }

    .footer__legal {
      margin-top: var(--sp-3);
      padding-top: var(--sp-3);
    }
  }
</style>
