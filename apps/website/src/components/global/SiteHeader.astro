---
/**
 * Sticky site header — the editorial design system's quiet, typographic bar,
 * ported 1:1 from docs/blueprint/home.html with Tailwind utilities.
 *
 * Anatomy: text brand · plain-text nav (≥720px) · green phone pill · three
 * ink-tile icons (search, cart with badge, account). No pills, no hamburger —
 * below 720px navigation belongs to MobileNav's bottom bar.
 *
 * THE PHONE HEADER IS THE REFERENCE'S (miamedicalitalia.it at 390px, measured
 * 2026-08-31): brand, then icons only. Two swaps happen at `mid`, and they are
 * one trade:
 *
 *   search  hidden ≥720   the tab bar has four slots and the type floor keeps
 *                         it to four, so search never gets one; it comes up
 *                         here instead, where the reference has it too
 *   phone   hidden <720   its replacement, and the reason the swap is even —
 *                         the support launcher is pinned to every phone screen
 *                         with the same number one tap inside it
 *
 * The header's one script paints the cart badge; every link works without it.
 */
import { publicPathForRequest, translate, type SiteLocale } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { CONTACT } from '~/lib/site';
import { EDITORIAL_CONTAINER, EDITORIAL_THEME, INVISIBLE_48 } from '~/styles/editorial';

interface Props {
  locale: SiteLocale;
  languagePaths: Partial<Record<SiteLocale, string>>;
}

const { locale, languagePaths } = Astro.props;
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);
const italianPath = languagePaths.it;
const englishPath = languagePaths.en;

/**
 * Support is deliberately absent: it lives in the support launcher pinned to
 * the bottom-right of every page (owner, 2026-08-30), which reaches a person
 * faster than a nav item and does not spend a slot the catalogue needs. The
 * footer still carries the link for anyone looking for it there.
 */
const nav = [
  { href: routePath(locale, 'home'), label: text('header.home'), exact: true },
  { href: routePath(locale, 'catalog'), label: text('header.catalog'), exact: true },
  { href: routePath(locale, 'catalogRental'), label: text('header.rental'), exact: false },
  { href: routePath(locale, 'catalogSale'), label: text('header.sale'), exact: false },
  { href: routePath(locale, 'search'), label: text('header.browse'), exact: false },
  { href: routePath(locale, 'blog'), label: text('header.blog'), exact: false },
];

const account = { href: routePath(locale, 'account'), label: text('header.account'), exact: false };

const path = Astro.locals.publicPath ?? publicPathForRequest() ?? Astro.url.pathname;
const isActive = (item: { href: string; exact: boolean }) =>
  item.exact ? path === item.href : path.startsWith(item.href);

const navLinkClass =
  'text-[clamp(0.875rem,calc(0.268vw+0.7544rem),0.9688rem)] font-[550] whitespace-nowrap ' +
  'text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-ink)] ' +
  'aria-[current=page]:font-bold aria-[current=page]:text-[var(--color-ink)]';

const headerIconClass =
  `${INVISIBLE_48} grid size-11 place-items-center rounded-xl bg-[rgb(11_18_32_/_0.05)] ` +
  'text-[var(--color-ink)] hover:bg-[rgb(11_18_32_/_0.09)] hover:text-[var(--color-accent)]';
---

{
  /* `font-ui` because the chrome is not prose: the reference site sets its nav
     in the display face (Lexend 16/700) and keeps its text face for running
     copy, so the header names the face rather than inheriting the editorial
     theme's body face. */
}
<header
  class:list={[
    EDITORIAL_THEME,
    'font-ui sticky top-0 z-50 border-b border-[var(--color-line)] bg-white',
  ]}
>
  <div
    class:list={[
      EDITORIAL_CONTAINER,
      'flex min-h-[clamp(52px,5.94vw,76px)] items-center gap-[clamp(12px,calc(2.86vw-8.6px),28px)]',
    ]}
  >
    <a
      class="flex-none text-[clamp(1.0625rem,calc(0.536vw+0.821rem),1.25rem)] font-extrabold tracking-[-0.01em] no-underline"
      href={routePath(locale, 'home')}
      aria-label={text('header.brand')}
    >
      MIA-MEDICAL
    </a>

    <nav
      class="mid:flex ms-[clamp(8px,calc(5vw-28px),36px)] me-auto hidden items-center gap-[clamp(10px,calc(4.29vw-20.9px),34px)]"
      aria-label={text('navigation.primary')}
    >
      {
        nav.map((item) => (
          <a
            class={navLinkClass}
            href={item.href}
            aria-current={isActive(item) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex items-center gap-[clamp(6px,calc(0.36vw+3.4px),8px)]">
      <details class="relative">
        <summary
          class="mid:max-wide:min-w-11 mid:max-wide:px-1.5 inline-flex min-h-11 min-w-13.5 cursor-pointer list-none items-center justify-center gap-1.5 rounded-xl bg-[rgb(11_18_32_/_0.05)] px-2.5 text-sm font-bold text-[var(--color-ink)] hover:bg-[rgb(11_18_32_/_0.09)] hover:text-[var(--color-accent)] [&::-webkit-details-marker]:hidden"
          aria-label={text('language.switch')}
        >
          <span class="mid:max-wide:hidden" aria-hidden="true">{locale === 'it' ? '🇮🇹' : '🇬🇧'}</span
          >
          <span>{locale.toUpperCase()}</span>
        </summary>
        <div
          class="absolute top-[calc(100%+8px)] right-0 grid min-w-37 rounded-xl border border-[var(--color-line)] bg-white p-1.5 shadow-[0_10px_28px_rgb(11_18_32_/_0.16)]"
        >
          {
            italianPath && (
              <a
                class="flex min-h-9.5 items-center gap-2 rounded-lg px-2 text-[0.9375rem] font-semibold text-[var(--color-ink)] no-underline hover:bg-[var(--color-surface)] hover:text-[var(--color-accent)] aria-[current=true]:bg-[var(--color-surface)] aria-[current=true]:text-[var(--color-accent)]"
                href={italianPath}
                aria-current={locale === 'it' ? 'true' : undefined}
              >
                <span aria-hidden="true">🇮🇹</span>
                <span>{text('language.italian')}</span>
              </a>
            )
          }
          {
            englishPath && (
              <a
                class="flex min-h-9.5 items-center gap-2 rounded-lg px-2 text-[0.9375rem] font-semibold text-[var(--color-ink)] no-underline hover:bg-[var(--color-surface)] hover:text-[var(--color-accent)] aria-[current=true]:bg-[var(--color-surface)] aria-[current=true]:text-[var(--color-accent)]"
                href={englishPath}
                aria-current={locale === 'en' ? 'true' : undefined}
              >
                <span aria-hidden="true">🇬🇧</span>
                <span>{text('language.english')}</span>
              </a>
            )
          }
        </div>
      </details>

      <a
        class="mid:max-wide:w-11 mid:max-wide:justify-center mid:max-wide:px-0 max-mid:hidden relative inline-flex min-h-11 items-center gap-2.25 rounded-xl bg-[var(--color-phone-tint)] px-3.75 text-base font-[650] whitespace-nowrap text-[var(--color-phone-ink)] tabular-nums no-underline hover:bg-[#d3ecdd]"
        href={`tel:${CONTACT.phoneE164}`}
        aria-label={text('header.call', { phone: CONTACT.phoneDisplay })}
        data-analytics="phone-call"
      >
        <svg
          class="flex-none"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path
            d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"
          ></path>
        </svg>
        <span class="mid:max-wide:hidden">{CONTACT.phoneDisplay}</span>
      </a>

      {
        /*
          The badge is never rendered on the server: it ships empty and `hidden`,
          and the script below fills it from the same store the cart page reads —
          a cached page cannot carry a wrong number, only no number. It is
          `aria-hidden` because the script rewrites the LINK's label with the
          count; two announcements of one number is worse than one.
        */
      }
      {
        /* Phones only: search has no slot in the four-tab bar, so typed
           search lives here — the reference's own arrangement. */
      }
      <a
        class:list={[headerIconClass, 'mid:hidden']}
        href={routePath(locale, 'search')}
        aria-label={text('header.searchAction')}
      >
        <svg
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m20 20-4.2-4.2"></path>
        </svg>
      </a>

      <a
        class={headerIconClass}
        href={routePath(locale, 'cart')}
        aria-label={text('header.cart')}
        data-cart-link
        data-cart-aid-one={text('header.medicalAid.one')}
        data-cart-aid-many={text('header.medicalAid.many')}
      >
        <svg
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 5h2l2.2 10.2a2 2 0 0 0 2 1.6h7.1a2 2 0 0 0 2-1.5L21 8H6.4"></path>
          <circle cx="10.5" cy="20" r="1.4"></circle>
          <circle cx="17.5" cy="20" r="1.4"></circle>
        </svg>
        <span
          class="absolute -top-1.25 -right-1.25 grid h-4.5 min-w-4.5 place-items-center rounded-full bg-[var(--color-accent)] px-1 text-[0.6563rem] font-bold text-white tabular-nums"
          data-cart-count
          aria-hidden="true"
          hidden></span>
      </a>

      <a
        class={headerIconClass}
        href={account.href}
        aria-label={account.label}
        aria-current={isActive(account) ? 'page' : undefined}
      >
        <svg
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="3.6"></circle>
          <path d="M4.6 20a7.4 7.4 0 0 1 14.8 0"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  /*
   * The cart badge, and the header's only JavaScript.
   *
   * It reads the same store the cart page and the product page write, and listens
   * on two channels because they cover different cases: `mia:cart-changed` for
   * this tab (a native `storage` event never fires in the tab that wrote), and
   * `storage` for the others. The count is a paint, never a source of truth —
   * the cart page always re-reads storage itself — so a badge that is briefly
   * wrong after a bfcache restore is cosmetic, which is why `pageshow` is enough.
   */
  import { CART_CHANGED_EVENT, cartCount, readCartLines } from '~/lib/cart-store';

  const $link = document.querySelector<HTMLAnchorElement>('[data-cart-link]');
  const $badge = document.querySelector<HTMLElement>('[data-cart-count]');

  if ($link && $badge) {
    const baseLabel = $link.getAttribute('aria-label') ?? '';
    const aidOne = $link.dataset.cartAidOne ?? '';
    const aidMany = $link.dataset.cartAidMany ?? '';

    const paint = (count: number) => {
      $badge.hidden = count === 0;
      /* Capped at 9+: two digits do not fit the 18px badge, and a cart of ten
         aids is already a phone call rather than a number to read. */
      $badge.textContent = count > 9 ? '9+' : String(count);
      $link.setAttribute(
        'aria-label',
        count === 0 ? baseLabel : `${baseLabel} — ${count} ${count === 1 ? aidOne : aidMany}`,
      );
    };

    const refresh = () => paint(cartCount(readCartLines()));

    refresh();
    window.addEventListener(CART_CHANGED_EVENT, refresh);
    // Another tab wrote the store.
    window.addEventListener('storage', refresh);
    // Restored from the back/forward cache, where no script re-runs.
    window.addEventListener('pageshow', refresh);
  }
</script>
