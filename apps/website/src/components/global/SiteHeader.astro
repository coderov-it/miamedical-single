---
/**
 * Sticky site header, transcribed from the approved desktop design.
 *
 * Design values: inner max-width 1244px (border-box equivalent of the 1180px
 * content column), padding 12px 32px, flex with 28px gaps; logo 44px tall;
 * free-phone pill #E8F5EE on #BFE3CF with #0E6B41 text; cart 50×50 #EDF1FA on
 * #D9E1F2 at 12px radius; "Noleggia ora" 50px tall, 12px radius, #2E4699.
 *
 * Zero JavaScript. Tablet navigation is a native `<details>` disclosure; the
 * mobile layout uses the persistent bottom navigation instead.
 */
import { CONTACT } from '~/lib/site';
import { routes } from '~/lib/routes';

const nav = [
  { href: routes.home, label: 'Home', exact: true },
  { href: routes.catalog, label: 'Catalogo noleggio', exact: false },
  { href: routes.search, label: 'Cerca', exact: false },
  { href: routes.support, label: 'Assistenza', exact: false },
];

const path = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) =>
  item.exact ? path === item.href : path.startsWith(item.href);
---

<header class="hdr">
  <div class="hdr__bar">
    <a class="hdr__logo" href="/" aria-label="Vai alla home di Mia Medical Italia">
      <img
        src="/img/logo.svg"
        alt="M.i.a. Medical Italia — moving in autonomy"
        width="82"
        height="44"
      />
    </a>

    <nav class="hdr__nav" aria-label="Navigazione principale">
      {
        nav.map((item) => (
          <a
            class:list={['hdr__navlink', isActive(item) && 'is-active']}
            href={item.href}
            aria-current={isActive(item) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      class="hdr__phone"
      href={`tel:${CONTACT.phoneE164}`}
      aria-label={`Chiama il numero verde ${CONTACT.phoneDisplay}, gratuito`}
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"
        ></path>
      </svg>
      <span class="hdr__phone-text">
        <strong>{CONTACT.phoneDisplay}</strong><span class="hdr__phone-free"> — gratis</span>
      </span>
    </a>

    {
      /*
      Cart. A link, not a button: it navigates. The numeric count is deliberately
      absent — on a prerendered page it would either be stale or force every
      cached page to bootstrap a script.
    */
    }
    <a class="hdr__cart" href={routes.cart} aria-label="Apri il carrello">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="9" cy="20" r="1.4"></circle>
        <circle cx="18" cy="20" r="1.4"></circle>
        <path d="M2 3h2.6l2.6 12.2h11.4l2.4-8.6H6"></path>
      </svg>
    </a>

    <a class="hdr__cta" href={routes.catalog}>Noleggia ora</a>

    <details class="hdr__menu">
      <summary aria-label="Apri il menu">
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <nav class="hdr__menu-nav" aria-label="Navigazione principale">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
  }

  .hdr__bar {
    display: flex;
    align-items: center;
    /* Design gap is 28px. Wrapping is added so the bar cannot overflow
       horizontally at 200% zoom, which the original prototype does. */
    flex-wrap: wrap;
    gap: var(--sp-3) 28px;
    max-width: var(--container);
    min-height: 75px;
    margin-inline: auto;
    padding: var(--sp-3) var(--container-pad);
  }

  .hdr__logo {
    display: flex;
    align-items: center;
    flex: none;
  }

  .hdr__logo img {
    height: 44px;
    width: auto;
  }

  /* flex:1 pushes the phone, cart and CTA to the right edge. */
  .hdr__nav {
    display: flex;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .hdr__navlink {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding: 11px 16px;
    border-radius: 10px;
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 700;
    color: var(--c-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__navlink.is-active {
    background: var(--c-surface-tint);
    color: var(--c-primary);
  }

  .hdr__phone {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
    min-height: 50px;
    padding-inline: var(--sp-5);
    border-radius: var(--radius-pill);
    background: #e8f5ee;
    border: 1px solid #bfe3cf;
    /* 6.3:1 on #E8F5EE */
    color: #0e6b41;
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__cart {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: var(--c-surface-tint);
    border: 1px solid var(--c-surface-accent);
    color: var(--c-primary);
  }

  .hdr__cta {
    display: inline-flex;
    align-items: center;
    flex: none;
    height: 50px;
    padding-inline: 22px;
    border-radius: 12px;
    background: var(--c-primary);
    color: var(--c-primary-ink);
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__menu {
    display: none;
    flex: none;
  }

  .hdr__menu summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    border-radius: 12px;
    background: var(--c-surface-tint);
    cursor: pointer;
    list-style: none;
  }

  .hdr__menu summary::-webkit-details-marker {
    display: none;
  }

  .hdr__menu-nav {
    position: absolute;
    inset-inline: 0;
    display: grid;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
    padding: var(--sp-2) var(--container-pad) var(--sp-4);
  }

  .hdr__menu-nav a {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    border-bottom: 1px solid var(--c-border);
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
  }

  @media (max-width: 1080px) {
    .hdr__nav {
      display: none;
    }
    .hdr__menu {
      display: block;
      order: 3;
    }
    .hdr__logo {
      flex: 1;
    }
  }

  @media (max-width: 700px) {
    .hdr__bar {
      min-height: 67px;
      flex-wrap: nowrap;
      gap: 10px;
      padding: 10px 16px;
    }

    .hdr__logo img {
      width: auto;
      height: 36px;
    }

    .hdr__phone {
      min-height: 48px;
      gap: 7px;
      padding-inline: 13px;
      font-size: var(--fs-ui);
    }

    .hdr__phone-free {
      display: none;
    }

    .hdr__cart {
      width: 48px;
      height: 48px;
    }

    .hdr__cta {
      display: none;
    }

    .hdr__menu {
      display: none;
    }
  }
</style>
