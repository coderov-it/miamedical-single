---
/**
 * The free-phone call to action.
 *
 * Appears on every screen of the design: header, catalogue empty state, product
 * help card, 404, support and footer. Treat a phone call as a successful
 * conversion, not a failed checkout — a large share of this audience will
 * prefer to speak to someone.
 *
 * Zero JavaScript. A `tel:` link is a native affordance.
 */
import { CONTACT } from '~/lib/site';
import { localeForRequest, translate } from '~/lib/i18n';

interface Props {
  /**
   * `primary` — solid brand pill. `soft` — tinted pill with a hairline, for a
   * white ground. `on-dark` — white pill, for the closing band. `inline` — a
   * bare underlined link inside prose.
   */
  variant?: 'primary' | 'soft' | 'on-dark' | 'inline';
  /** Show the "gratis" qualifier. Omit only where space genuinely forbids it. */
  showFree?: boolean;
  /** Extra context for assistive tech, e.g. "per aiuto sulla scelta". */
  srHint?: string | undefined;
  class?: string;
}

const { variant = 'primary', showFree = true, srHint, class: className = '' } = Astro.props;
const locale = localeForRequest();

const variants = {
  primary: 'bg-accent text-white hover:bg-accent-deep',
  soft: 'bg-tint text-ink hover:bg-tint-2',
  'on-dark': 'bg-white text-accent-deep hover:bg-[#dfe4f2]',
  inline: 'font-semibold text-accent underline decoration-2',
} as const;

const buttonClass =
  'inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 mid:rounded-full max-mid:rounded-field px-7 font-display text-ui-strong font-semibold no-underline';

/*
 * `inline` carries no icon and is not a flex container — it is a hyperlink in a
 * sentence, which is what "bare underlined link inside prose" means. The handset
 * is a 20px glyph sized for a 17px pill; beside 13.5px helper text it reads as a
 * shrunken button rather than a link, and `inline-flex` on a link inside a
 * paragraph stops it wrapping with the text around it.
 */
const bare = variant === 'inline';
---

<a
  href={`tel:${CONTACT.phoneE164}`}
  class:list={[!bare && buttonClass, variants[variant], className]}
  data-analytics="phone-call"
>
  {
    !bare && (
      <svg
        class="size-5 flex-none"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.1"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z" />
      </svg>
    )
  }

  <span>{CONTACT.phoneDisplay}</span>
  {showFree && <span class="font-normal opacity-90">— {translate(locale, 'phone.free')}</span>}
  {srHint && <span class="sr-only">{srHint}</span>}
</a>
