---
/**
 * A language's flag, drawn as inline SVG. The artwork lives in `@mia/i18n`
 * (`LANGUAGE_FLAGS`), shared with the back office — see the note there on why
 * SVG and not emoji.
 */
import { LANGUAGE_FLAGS } from '@mia/i18n';

import type { SiteLocale } from '~/lib/i18n';

interface Props {
  code: SiteLocale;
}

const { code } = Astro.props;
const flag = LANGUAGE_FLAGS[code];
---

<svg
  class="block h-3 w-4.5 shrink-0 rounded-[2px] shadow-[0_0_0_1px_rgb(11_18_32/0.12)]"
  viewBox={flag.viewBox}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  set:html={flag.body}
/>
