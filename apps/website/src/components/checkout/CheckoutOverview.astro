---
/**
 * The sticky order overview — the one elevated card on the page.
 *
 * It has the reference design's two shapes and picks between them on the item
 * count, which is the whole of "direct product or cart" as far as this component
 * is concerned: one item renders expanded, because there is nothing to compare it
 * against and hiding its dates behind a disclosure would be hiding the entire
 * order; several render as collapsible rows with their own subtotals.
 *
 * Money here is a DISPLAY ESTIMATE, exactly as in the product detail page's
 * order panel: no payment is taken online and the phone call settles the real
 * amount. See docs/code/storefront-checkout.md.
 */
import { formatMoney, mediaUrl } from '~/lib/api';
import type { Checkout } from '~/lib/checkout';
import { localeForRequest, localeTag } from '~/lib/i18n';
import { t } from '~/lib/labels';
import { EYEBROW, LINE_AMOUNT, LINE_LABEL, LINE_ROW } from './styles';

interface Props {
  checkout: Checkout;
}

const { checkout } = Astro.props;
const { items, itemsTotal, noPackage, currency } = checkout;
const single = items.length === 1;
const intl = localeTag(localeForRequest());

/*
 * The reference file draws a diagonal-stripe pattern in these thumbnails because
 * it has no catalogue behind it. This does, so the real image goes in — and the
 * fallback is the site's own empty media well rather than the stripes, which is
 * what every other product thumbnail on the storefront falls back to.
 */
const THUMB_FALLBACK = 'bg-tint';
---

{
  /*
    `wide:` on both, and 24 rather than the reference's 6: the reference page has
    no site chrome, but this one has a sticky 83px header, so a 24px offset parks
    the panel underneath it. 96px clears the header and keeps the reference's own
    gap below it. Sticky only from `wide` up, because below that the panel wraps
    to full width and pinning it would cover the step it belongs to.
  */
}
<aside
  class="border-hair shadow-pdp-panel wide:sticky wide:top-24 flex max-w-100 min-w-0 flex-[1_1_320px] flex-col gap-4.5 rounded-2xl border bg-white p-7"
  aria-labelledby="checkout-overview-title"
  data-overview
  data-items-total={itemsTotal}
  data-currency={currency}
>
  <h2 class={EYEBROW} id="checkout-overview-title">{t('orderSummary')}</h2>

  {
    single && items[0] && (
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3.5">
          {items[0].product.media.thumbnail ? (
            <img
              class="bg-tint size-16 flex-none rounded-[10px] object-contain p-1 mix-blend-multiply"
              src={mediaUrl(items[0].product.media.thumbnail.path)}
              alt={items[0].product.media.thumbnail.alt ?? items[0].product.title}
              loading="lazy"
            />
          ) : (
            <span class={`size-16 flex-none rounded-[10px] ${THUMB_FALLBACK}`} aria-hidden="true" />
          )}
          <div class="flex min-w-0 flex-col gap-0.75">
            <strong class="text-[14.5px]">{items[0].product.title}</strong>
            {items[0].summary && <span class="text-ink-2 text-[12.5px]">{items[0].summary}</span>}
          </div>
        </div>

        {items[0].facts.length > 0 && (
          <dl class="bg-tint flex flex-col gap-1 rounded-[11px] px-3.5 py-3 text-[13px]">
            {items[0].facts.map((fact) => (
              <div class="flex justify-between gap-3">
                <dt class="text-ink-2">{fact.label}</dt>
                <dd class="font-semibold tabular-nums">{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <ul class="border-hair -mt-0.5 flex list-none flex-col gap-2.25 border-t pt-3.5 text-[13.5px]">
          {items[0].lines.map((line) => (
            <li class={LINE_ROW}>
              <span class={LINE_LABEL}>{line.label}</span>
              <span class={LINE_AMOUNT}>{line.amount}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    !single && items.length > 0 && (
      <div class="flex flex-col gap-2.5">
        {items.map((item, index) => (
          <div class="border-hair overflow-hidden rounded-xl border">
            <button
              class="group/item flex w-full cursor-pointer items-center gap-3 border-0 bg-white px-3.5 py-3 text-left"
              type="button"
              aria-expanded="false"
              aria-controls={`checkout-item-${index}`}
              data-item-toggle={index}
            >
              {item.product.media.thumbnail ? (
                <img
                  class="bg-tint size-11.5 flex-none rounded-[9px] object-contain p-0.5 mix-blend-multiply"
                  src={mediaUrl(item.product.media.thumbnail.path)}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <span
                  class={`size-11.5 flex-none rounded-[9px] ${THUMB_FALLBACK}`}
                  aria-hidden="true"
                />
              )}
              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <strong class="text-[13.5px] leading-[1.3]">{item.product.title}</strong>
                {item.summary && <span class="text-ink-2 text-[12px]">{item.summary}</span>}
              </span>
              <span class="flex flex-none flex-col items-end gap-0.5">
                <strong class="text-[14px] tabular-nums">{item.subtotal}</strong>
                <span
                  class="text-ink-2 text-[12px] transition-transform duration-150 group-aria-expanded/item:rotate-180"
                  data-item-chevron
                  aria-hidden="true"
                >
                  ▾
                </span>
              </span>
            </button>

            <div
              class="flex flex-col gap-3 px-3.5 pt-0.5 pb-4"
              id={`checkout-item-${index}`}
              data-item-panel={index}
              hidden
            >
              {item.facts.length > 0 && (
                <div class="border-hair text-ink-2 border-t pt-3 text-[12.5px]">
                  {item.facts.map((fact, factIndex) => (
                    <>
                      {factIndex > 0 && <span aria-hidden="true"> · </span>}
                      {fact.label} {fact.value}
                    </>
                  ))}
                </div>
              )}
              <ul class="flex list-none flex-col gap-2 text-[12.5px]">
                {item.lines.map((line) => (
                  <li class={LINE_ROW}>
                    <span class={LINE_LABEL}>{line.label}</span>
                    <span class={LINE_AMOUNT}>{line.amount}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    )
  }

  {/* Revealed by the script once a delivery option is chosen. */}
  <div
    class="border-hair flex justify-between gap-3 border-t pt-4 text-[13.5px]"
    data-overview-delivery
    hidden
  >
    <span class="text-ink-2" data-overview-delivery-label>{t('delivery')}</span>
    <span class={LINE_AMOUNT} data-overview-delivery-fee>—</span>
  </div>

  <div class="border-hair flex items-baseline justify-between border-t pt-4">
    <span class="text-[13.5px] font-semibold">{t('total')}</span>
    <span class="flex flex-col items-end">
      <strong class="text-[24px] tracking-[-0.01em] tabular-nums" data-overview-total>
        {formatMoney(itemsTotal, currency, intl)}
      </strong>
      {
        /*
          An open-ended rental is normal here, and its figure is a per-unit rate,
          not a sum — so the qualifier under the number has to say which one this
          is rather than always claiming a tax-inclusive total.
        */
      }
      <span class="text-ink-2 text-[12px]" data-overview-note>
        {noPackage ? t('estimateNoPackage') : t('vatIncluded')}
      </span>
    </span>
  </div>

  <p class="text-ink-2 m-0 text-center text-[12.5px] leading-normal">
    {t('noPaymentFootnote')}
  </p>
</aside>
