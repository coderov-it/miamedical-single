---
/**
 * Step 3 — read it back, record the order, then hand over.
 *
 * Two paths, and both are complete:
 *
 *   no JavaScript  the CTA is the <a> it renders as — a WhatsApp handover already
 *                  carrying every line item, which is what the reference design's
 *                  own copy describes ("our agent will message you").
 *   with it        the same control posts the request to `POST /api/orders` first,
 *                  and the confirmation then leads with the order number. WhatsApp
 *                  stays, one step down, now quoting that number.
 *
 * The order is recorded either way — in the second path by the API, in the first
 * by a human reading the message. The page never claims more than happened: on a
 * failed POST it says so and leaves the handover in place, because the message
 * still carries the whole request.
 *
 * The gate takes the CTA's place entirely when the request is not confirmable.
 * A rental with no return date has a daily rate and no total, and an order needs a
 * total; a line missing a required choice is one the API refuses outright. Either
 * way there is nothing to confirm yet, so the panel says what is missing and sends
 * the customer to the page where they can fix it — rather than offering a button
 * that is certain to fail.
 */
import { t } from '~/lib/labels';
import type { CheckoutBlocked, CheckoutItem } from '~/lib/checkout';
import { routes } from '~/lib/routes';
import { CONTACT } from '~/lib/site';
import { EYEBROW } from './styles';

interface Props {
  /** `wa.me` URL already carrying the line items. */
  whatsappHref: string;
  /** The same message as plain text, for the script to extend at click time. */
  whatsappBase: string;
  /** Why this request cannot be placed, or `null` when it can. */
  blocked: CheckoutBlocked;
  /** The item that blocked it, so the notice can name the product and the gap. */
  blockedItem: CheckoutItem | null;
  /** Back to the product, or the cart — wherever the gap can be closed. */
  backHref: string;
}

const { whatsappHref, whatsappBase, blocked, blockedItem, backHref } = Astro.props;

/** One notice per reason: what is missing, and the words for going to fix it. */
const GATE =
  blocked === 'incomplete'
    ? {
        title: t('configurationIncomplete'),
        detail: t('configurationIncompleteDetail', {
          product: blockedItem?.product.title ?? '',
          missing: (blockedItem?.missingRequired ?? []).join(', '),
        }),
        cta: t('completeConfiguration'),
      }
    : blocked === 'noPackage'
      ? {
          title: t('packageMissing'),
          detail: t('packageMissingDetail'),
          cta: t('pickPackage'),
        }
      : null;

const REVIEW_CARD =
  'flex flex-col gap-1.5 rounded-xl border border-hair px-4.5 py-4 text-[13.5px] text-ink-2';
const PRIMARY_CTA =
  'hover:bg-accent-deep cursor-pointer rounded-full border-0 bg-accent p-3.75 text-center text-[15.5px] font-semibold text-white no-underline';
const SECONDARY_CTA =
  'bg-tint text-ink hover:bg-tint-2 hover:text-accent cursor-pointer rounded-full px-5.5 py-2.75 text-center text-[15px] font-semibold no-underline';
---

<div data-confirm-pending>
  <div class="flex flex-col gap-5">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3.5">
      <div class={REVIEW_CARD}>
        <div class={`${EYEBROW} mb-1`}>{t('contact')}</div>
        <strong class="text-ink text-[15px]" data-review="name">—</strong>
        <span data-review="email">—</span>
        <span data-review="phone">—</span>
        <span data-review="type">—</span>
      </div>

      <div class={REVIEW_CARD}>
        <div class={`${EYEBROW} mb-1`}>{t('delivery')}</div>
        <strong class="text-ink text-[15px]" data-review="delivery">—</strong>
        <span data-review="deliveryDetail">—</span>
      </div>
    </div>

    <div class="bg-tint flex items-center gap-3.5 rounded-xl px-4.5 py-4">
      <span class="bg-tint-2 grid size-10 flex-none place-items-center rounded-full text-accent">
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M21 11.5a8.4 8.4 0 0 1-8.5 8.3 8.7 8.7 0 0 1-3.8-.9L3 20l1.2-5.3a8 8 0 0 1-.7-3.2A8.4 8.4 0 0 1 12 3.2a8.4 8.4 0 0 1 9 8.3Z"
          ></path>
        </svg>
      </span>
      <span class="flex flex-col gap-0.5">
        <strong class="text-[14.5px]">{t('noPaymentNow')}</strong>
        <span class="text-ink-2 text-[14px] leading-normal">
          {t('noPaymentNowDetail')}
          {CONTACT.hours.it}.
        </span>
      </span>
    </div>

    {
      GATE ? (
        <div class="border-hair flex flex-col items-start gap-3 rounded-xl border bg-white px-4.5 py-4">
          <strong class="text-[15.5px]">{GATE.title}</strong>
          <p class="text-ink-2 m-0 text-[14px] leading-[1.55]">{GATE.detail}</p>
          <a class={SECONDARY_CTA} href={backHref}>
            {GATE.cta}
          </a>
        </div>
      ) : (
        <>
          {/*
            An <a> rather than a <button>, and it stays one: with no JavaScript
            this IS the handover. The script calls preventDefault, posts, and only
            then follows the link — see the confirm section of checkout.astro.
          */}
          <a
            class={PRIMARY_CTA}
            href={whatsappHref}
            target="_blank"
            rel="noopener"
            data-place-order
            data-wa-base={whatsappBase}
            data-analytics="whatsapp"
          >
            {t('sendOrderOnWhatsApp')}
          </a>

          <div class="text-ink-2 -mt-1.5 text-center text-[12.5px]">
            {t('termsNoticeBefore')}
            <a class="underline" href={routes.terms}>
              {t('rentalTerms')}
            </a>
            .
          </div>
        </>
      )
    }
  </div>
</div>

{
  /*
    Revealed only after the API accepted the order, so everything it states is
    true of a row that exists. It deliberately does not claim a confirmation
    email — there is no mail service behind this page, which is what the
    reference design's copy assumes.
  */
}
<div
  class="flex flex-col items-center gap-2.5 py-4.5 text-center"
  data-confirm-placed
  role="status"
  hidden
>
  <span
    class="bg-tint grid size-11.5 place-items-center rounded-full text-[22px] font-bold text-accent"
    aria-hidden="true">✓</span
  >
  <strong class="text-[17px]">{t('requestSent')}</strong>

  {
    /*
      The number is the reference the phone call opens with, so it is the largest
      thing here after the confirmation itself, and it is selectable text rather
      than an image or a pseudo-element.
    */
  }
  <div
    class="border-hair bg-tint flex flex-col gap-0.5 rounded-xl border px-5 py-3"
    hidden
    data-placed-number-card
  >
    <span class={EYEBROW}>{t('requestNumber')}</span>
    <strong class="font-ui text-[19px] tracking-[0.01em] tabular-nums" data-placed-number>—</strong>
    <span class="text-ink-2 text-[13px]" hidden data-placed-total-row>
      {t('requestTotalEstimate')}
      <span class="tabular-nums" data-placed-total>—</span>
    </span>
  </div>

  <span class="text-ink-2 max-w-105 text-[15px] leading-[1.55]">
    {
      /*
      The greeting carries its own template as data, so the page script can fold
      the customer's first name in without holding an Italian string itself.
    */
    }
    <span data-placed-greeting data-greeting-template={t('thanksName')}>{t('thanks')}</span>
    {t('requestSentDetail')}
  </span>

  <a class={SECONDARY_CTA} href={whatsappHref} target="_blank" rel="noopener" data-placed-whatsapp>
    {t('continueOnWhatsApp')}
  </a>
</div>

{
  /*
    The POST failed. The request is not lost — the WhatsApp message below still
    carries all of it — so this offers both the retry and the path that does not
    depend on our API being up.
  */
}
<div
  class="border-hair flex flex-col items-start gap-3 rounded-xl border bg-white px-4.5 py-4"
  data-confirm-error
  role="alert"
  hidden
>
  <strong class="text-[15.5px]">{t('requestFailed')}</strong>
  <p class="text-ink-2 m-0 text-[14px] leading-[1.55]">{t('requestFailedDetail')}</p>
  <div class="flex flex-wrap gap-2.5">
    <button class={SECONDARY_CTA} type="button" data-confirm-retry>{t('retry')}</button>
    <a class={SECONDARY_CTA} href={whatsappHref} target="_blank" rel="noopener" data-error-whatsapp>
      {t('continueOnWhatsApp')}
    </a>
  </div>
</div>
