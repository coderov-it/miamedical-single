---
/**
 * The last step — read it back, then pay. Flow: docs/code/online-payments.md.
 *
 *   "Pay and Confirm"  → POST /api/orders → order placed, stock held
 *                      → the browser goes to the gateway's page (Nexi)
 *                      → back on /payment/?token=…, which says how it went
 *
 * The panels below the button are for when the browser never leaves:
 *
 *   awaiting   the order exists and is unpaid — the back button from the
 *              gateway, a reload, or a gateway that could not be reached.
 *              "Pay now" opens the result page, which starts a new payment.
 *   error      refused before anything was written; nothing was charged.
 *   uncertain  no answer, so it may exist. No retry here: a second POST would
 *              be a second order.
 *
 * The gate takes the button's place entirely when the request is not
 * confirmable — what is missing, and the way to the page that fixes it.
 */
import PhoneCta from '~/components/global/PhoneCta.astro';
import { t } from '~/lib/labels';
import type { CheckoutBlocked, CheckoutItem } from '~/lib/checkout';
import { routePath } from '~/lib/routes';
import CheckoutRetryForm, { type CheckoutRetry } from './CheckoutRetryForm.astro';
import { EYEBROW } from './styles';
import { localeForRequest } from '~/lib/i18n';

interface Props {
  /** Why this request cannot be placed, or `null` when it can. */
  blocked: CheckoutBlocked;
  /** The item that blocked it, so the notice can name the product and the gap. */
  blockedItem: CheckoutItem | null;
  /** Back to the product, or the cart — wherever the gap can be closed. */
  backHref: string;
  /** The request this page was built from, for the `unavailable` notice's retry. */
  retry: CheckoutRetry;
}

const { blocked, blockedItem, backHref, retry } = Astro.props;
const locale = localeForRequest();

/** One notice per reason: what is missing, and the words for going to fix it. */
function gateFor(reason: CheckoutBlocked) {
  if (reason === 'unavailable') {
    return {
      title: t('checkoutUnavailable'),
      detail: t('checkoutUnavailableDetail'),
      cta: t('retry'),
    };
  }
  if (reason === 'incomplete') {
    return {
      title: t('configurationIncomplete'),
      detail: t('configurationIncompleteDetail', {
        product: blockedItem?.product.title ?? '',
        missing: (blockedItem?.missingRequired ?? []).join(', '),
      }),
      cta: t('completeConfiguration'),
    };
  }
  if (reason === 'pastStart') {
    return {
      title: t('startDatePassed'),
      detail: t('startDatePassedDetail', { product: blockedItem?.product.title ?? '' }),
      cta: t('pickNewStartDate'),
    };
  }
  if (reason === 'noPackage') {
    return { title: t('packageMissing'), detail: t('packageMissingDetail'), cta: t('pickPackage') };
  }
  return null;
}

const GATE = gateFor(blocked);

const REVIEW_CARD =
  'flex flex-col gap-1.5 rounded-xl border border-hair px-4.5 py-4 text-[13.5px] text-ink-2';
const PRIMARY_CTA =
  'hover:bg-accent-deep cursor-pointer rounded-full border-0 bg-accent p-3.75 text-center text-[15.5px] font-semibold text-white no-underline aria-busy:cursor-progress aria-busy:opacity-80';
const SECONDARY_CTA =
  'bg-tint text-ink hover:bg-tint-2 hover:text-accent cursor-pointer rounded-full px-5.5 py-2.75 text-center text-[15px] font-semibold no-underline';
const NOTICE = 'border-hair flex flex-col items-start gap-3 rounded-xl border bg-white px-4.5 py-4';
---

<div data-confirm-pending>
  <div class="flex flex-col gap-5">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3.5">
      <div class={REVIEW_CARD}>
        <div class={`${EYEBROW} mb-1`}>{t('contact')}</div>
        <strong class="text-ink text-[15px]" data-review="name">
          —
        </strong>
        <span data-review="email">—</span>
        <span data-review="phone">—</span>
        <span data-review="type">—</span>
      </div>

      <div class={REVIEW_CARD}>
        <div class={`${EYEBROW} mb-1`}>{t('delivery')}</div>
        <strong class="text-ink text-[15px]" data-review="delivery">
          —
        </strong>
        <span data-review="deliveryDetail">—</span>
      </div>
    </div>

    {/*
        The payment option card. One option today — the card gateway — drawn as
        a chosen option rather than a bare paragraph, so a second method later
        is a second card here, not a redesign.
      */}
    <div
      class="border-accent bg-tint flex items-center gap-3.5 rounded-xl border-2 px-4.5 py-4"
      data-payment-option="card"
    >
      <span
        class="grid size-5 flex-none place-items-center rounded-full border-2 border-accent"
        aria-hidden="true"
      >
        <span class="size-2.5 rounded-full bg-accent"></span>
      </span>
      <span class="flex min-w-0 flex-1 flex-col gap-0.5">
        <strong class="text-[14.5px]">{t('paymentMethodTitle')}</strong>
        <span class="text-ink-2 text-[14px] leading-normal">{t('paymentMethodDetail')}</span>
      </span>
      <svg
        class="size-6 flex-none text-accent"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2.5" y="5" width="19" height="14" rx="2"></rect>
        <path d="M2.5 10h19M6.5 15h4"></path>
      </svg>
    </div>

    {GATE ? (
      <div class={NOTICE}>
        <strong class="text-[15.5px]">{GATE.title}</strong>
        <p class="text-ink-2 m-0 text-[14px] leading-[1.55]">{GATE.detail}</p>
        {blocked === 'unavailable' ? (
          <CheckoutRetryForm {retry} label={GATE.cta} class={SECONDARY_CTA} />
        ) : (
          <a class={SECONDARY_CTA} href={backHref}>
            {GATE.cta}
          </a>
        )}
      </div>
    ) : (
      <>
        <button class={PRIMARY_CTA} type="button" data-place-order>
          {t('payAndConfirm')}
        </button>
        <noscript>
          <p class="text-danger m-0 text-center text-[14px]">{t('javascriptToPay')}</p>
        </noscript>

        <div class="text-ink-2 -mt-1.5 text-center text-[12.5px]">
          {t('termsNoticePay')}{' '}
          <a class="underline" href={routePath(locale, 'terms')}>
            {t('termsLink')}
          </a>
          .
        </div>
      </>
    )}
  </div>
</div>

{/*
    The order exists and is unpaid. Everything it states is true of a row the
    API wrote; the number is the one the server issued.
  */}
<div class={NOTICE} data-confirm-awaiting role="status" hidden>
  <strong class="text-[16px]">{t('orderAwaitingPayment')}</strong>
  <div class="border-hair bg-tint flex flex-col gap-0.5 rounded-xl border px-5 py-3">
    <span class={EYEBROW}>{t('payment.orderNumber')}</span>
    <strong class="font-ui text-[19px] tracking-[0.01em] tabular-nums" data-awaiting-number>
      —
    </strong>
  </div>
  <p
    class="text-ink-2 m-0 text-[14px] leading-[1.55]"
    data-awaiting-detail
    data-template={t('orderAwaitingPaymentDetail')}
  ></p>
  <p class="text-ink-2 m-0 text-[14px] leading-[1.55]" hidden data-placed-account>
    {t('requestSentActivate')}
  </p>
  <a class={PRIMARY_CTA + ' self-stretch'} href="#" hidden data-awaiting-pay>
    {t('payNow')}
  </a>
</div>

<div class={NOTICE} data-confirm-error role="alert" hidden>
  <strong class="text-[15.5px]">{t('requestFailed')}</strong>
  <p
    class="text-ink-2 m-0 text-[14px] leading-[1.55]"
    data-error-detail
    data-default={t('orderFailedDetail')}
  >
    {t('orderFailedDetail')}
  </p>
  <button class={SECONDARY_CTA} type="button" data-confirm-retry>
    {t('retry')}
  </button>
</div>

<div class={NOTICE} data-confirm-uncertain role="alert" hidden>
  <strong class="text-[15.5px]">{t('requestUncertain')}</strong>
  <p class="text-ink-2 m-0 text-[14px] leading-[1.55]">{t('orderUncertainDetail')}</p>
  <div class="flex flex-wrap gap-2.5">
    <a class={SECONDARY_CTA} href={routePath(locale, 'accountOrders')}>
      {t('account.myOrders')}
    </a>
    <PhoneCta variant="soft" />
  </div>
</div>
