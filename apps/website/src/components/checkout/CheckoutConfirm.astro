---
/**
 * Step 3 — read it back, then hand over.
 *
 * There is no orders endpoint and no online payment, so `sendOrderOnWhatsApp` is a
 * WhatsApp handover, which is what the reference design's own copy already
 * describes ("our agent will message you on WhatsApp"). It is an <a> carrying a
 * server-built message with every line item in it, so it works with no
 * JavaScript; the script only widens the message with what the customer typed
 * into steps 1 and 2 and then reveals the confirmation.
 */
import { t } from '~/lib/labels';
import { routes } from '~/lib/routes';
import { CONTACT } from '~/lib/site';
import { EYEBROW } from './styles';

interface Props {
  /** `wa.me` URL already carrying the line items. */
  whatsappHref: string;
  /** The same message as plain text, for the script to extend at click time. */
  whatsappBase: string;
}

const { whatsappHref, whatsappBase } = Astro.props;

const REVIEW_CARD =
  'flex flex-col gap-1.5 rounded-xl border border-hair px-4.5 py-4 text-[13.5px] text-ink-2';
---

<div data-confirm-pending>
  <div class="flex flex-col gap-5">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3.5">
      <div class={REVIEW_CARD}>
        <div class={`${EYEBROW} mb-1`}>{t('contact')}</div>
        <strong class="text-ink text-[15px]" data-review="name">—</strong>
        <span data-review="email">—</span>
        <span data-review="phone">—</span>
        <span data-review="type">—</span>
      </div>

      <div class={REVIEW_CARD}>
        <div class={`${EYEBROW} mb-1`}>{t('delivery')}</div>
        <strong class="text-ink text-[15px]" data-review="delivery">—</strong>
        <span data-review="deliveryDetail">—</span>
      </div>
    </div>

    <div class="border-hair bg-tint flex items-center gap-3.5 rounded-xl border px-4.5 py-4">
      <span class="bg-tint-2 grid size-10 flex-none place-items-center rounded-full text-accent">
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M21 11.5a8.4 8.4 0 0 1-8.5 8.3 8.7 8.7 0 0 1-3.8-.9L3 20l1.2-5.3a8 8 0 0 1-.7-3.2A8.4 8.4 0 0 1 12 3.2a8.4 8.4 0 0 1 9 8.3Z"
          ></path>
        </svg>
      </span>
      <span class="flex flex-col gap-0.5">
        <strong class="text-[14.5px]">{t('noPaymentNow')}</strong>
        <span class="text-ink-2 text-[14px] leading-normal">
          {t('noPaymentNowDetail')}
          {CONTACT.hours.it}.
        </span>
      </span>
    </div>

    <a
      class="hover:bg-accent-deep cursor-pointer rounded-full border-0 bg-accent p-3.75 text-center text-[15.5px] font-semibold text-white no-underline"
      href={whatsappHref}
      target="_blank"
      rel="noopener"
      data-place-order
      data-wa-base={whatsappBase}
      data-analytics="whatsapp"
    >
      {t('sendOrderOnWhatsApp')}
    </a>

    <div class="text-ink-2 -mt-1.5 text-center text-[12.5px]">
      {t('termsNoticeBefore')}
      <a class="underline" href={routes.terms}>{t('rentalTerms')}</a>.
    </div>
  </div>
</div>

{
  /*
    The confirmation deliberately claims nothing we cannot do: there is no mail
    service behind this page, so it does not say a confirmation email was sent,
    which is what the reference design's copy does.
  */
}
<div
  class="flex flex-col items-center gap-2.5 py-4.5 text-center"
  data-confirm-placed
  role="status"
  hidden
>
  <span
    class="bg-tint grid size-11.5 place-items-center rounded-full text-[22px] font-bold text-accent"
    aria-hidden="true">✓</span
  >
  <strong class="text-[17px]">{t('requestSent')}</strong>
  <span class="text-ink-2 max-w-105 text-[15px] leading-[1.55]">
    {
      /*
      The greeting carries its own template as data, so the page script can fold
      the customer's first name in without holding an Italian string itself.
    */
    }
    <span data-placed-greeting data-greeting-template={t('thanksName')}>{t('thanks')}</span>
    {t('requestSentDetail')}
  </span>
</div>
