---
/**
 * Section 01 — the variant groups, one hairline row per group with pill
 * options. Real radios/checkboxes styled through `peer`, so the whole page
 * stays a native GET form.
 *
 * Price semantics (owner's rule): a modifier is a FLAT amount in both modes. On
 * a rental it is added once on top of the chosen package — the package already
 * carries the duration, so multiplying a modifier by it would charge for the
 * days twice. The estimate script reads the `data-est-*` attributes; the server
 * never trusts them.
 */
import { formatMoney, mediaUrl } from '~/lib/api';
import type { ProductDetail } from '~/lib/catalog';
import { VARIANT_PREFIX } from '~/lib/request-config';
import PdpSectionHead from './PdpSectionHead.astro';

interface Props {
  variants: ProductDetail['variants'];
}

const { variants } = Astro.props;

const signed = (amount: string, currency: string) =>
  `${Number(amount) > 0 ? '+' : ''}${formatMoney(amount, currency)}`;

const pill =
  'flex min-h-11 cursor-pointer items-center gap-2 rounded-full bg-tint px-4 text-[14px]/[1] hover:bg-tint-2 ' +
  'peer-checked:bg-accent-tint peer-checked:text-accent peer-checked:hover:bg-accent-tint peer-checked:[&_[data-delta]]:text-accent ' +
  'peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-white ' +
  'peer-focus-visible:shadow-[0_0_0_6px_var(--color-ink)]';

const rowCard =
  'flex flex-wrap items-center gap-x-4.5 gap-y-2.5 rounded-field border border-hair bg-white px-4.5 py-3.5 shadow-pdp-card';

/* Reference: `flex: 0 0 88px; font-size: 13.5px; font-weight: 700`. The Italian
   labels are longer than the reference's ("Sponde laterali" vs "Size"), so the
   column may wrap to two lines where the reference never does. */
const groupLabel = 'flex flex-none basis-22 items-center gap-2 text-[13.5px] font-bold';

const inlineInput =
  'min-h-11 rounded-[9px] border border-transparent bg-tint px-3.5 text-[15px] font-normal';
---

<section>
  <PdpSectionHead n="01" title="Configura" hint="influisce sul prezzo" />

  <div class="flex flex-col gap-2.5">
    {
      variants.map((group) => {
        const name = `${VARIANT_PREFIX}${group.key}`;
        const multiple = group.valueType === 'multi_select';

        if (group.options.length > 0) {
          // No `border-0 p-0` reset on the fieldset: those are the same utility
          // families as `rowCard`'s `border` and `px-4.5 py-3.5`, and Tailwind
          // resolves the clash by its own canonical CSS order rather than the
          // order written here — the resets win and the row silently loses the
          // card border every other section has. `rowCard` states both in full.
          /*
            A single-select group always has something ticked (a default, or the
            first option), so only a REQUIRED MULTI-SELECT can actually come up
            empty — and native `required` cannot express "at least one of these
            boxes", it demands every one of them. Hence the gate, which is also
            the only thing that can mark an `sr-only` input's group at all.
          */
          const gated = group.isRequired && multiple;

          return (
            <fieldset
              class:list={['m-0 min-w-0', rowCard]}
              data-gate={gated ? `variant-${group.id}` : undefined}
            >
              <legend class="sr-only">{group.label}</legend>
              <span class={groupLabel} aria-hidden="true">
                {group.icon && (
                  <img
                    class="size-5.5 flex-none object-contain"
                    src={mediaUrl(group.icon)}
                    alt=""
                  />
                )}
                {group.label}
              </span>
              <span class="flex min-w-0 flex-wrap gap-2">
                {group.options.map((option, index) => (
                  <span>
                    <input
                      class="peer sr-only"
                      type={multiple ? 'checkbox' : 'radio'}
                      name={name}
                      id={`v-${group.id}-${option.id}`}
                      value={option.value}
                      checked={multiple ? option.isDefault : option.isDefault || index === 0}
                      data-est-kind="variant"
                      data-est-price={option.priceModifier.amount}
                      data-est-label={option.label}
                    />
                    <label class={pill} for={`v-${group.id}-${option.id}`}>
                      <span class="font-semibold">{option.label}</span>
                      <span class="text-ink-2 text-[13px]" data-delta>
                        {option.priceModifier.amount === '0.00'
                          ? 'incluso'
                          : signed(option.priceModifier.amount, option.priceModifier.currency)}
                      </span>
                    </label>
                  </span>
                ))}
              </span>
              {group.helpText && (
                <p class="text-ink-2 m-0 w-full text-[13.5px]">{group.helpText}</p>
              )}
              {gated && (
                <p class="field-error w-full" data-field-error={`variant-${group.id}`} hidden>
                  Scegli almeno un'opzione per {group.label.toLocaleLowerCase('it-IT')}.
                </p>
              )}
            </fieldset>
          );
        }

        if (group.valueType === 'number' || group.valueType === 'number_range') {
          /* `required` below stays for the no-JavaScript path; the gate is what
             enforces it once the script turns native validation off, so the two
             halves of the form speak with one voice. */
          return (
            <div class={rowCard} data-gate={group.isRequired ? `variant-${group.id}` : undefined}>
              <label class={groupLabel} for={`v-${group.id}`}>
                {group.label}
              </label>
              <span class="flex items-center gap-2">
                <input
                  id={`v-${group.id}`}
                  class:list={[inlineInput, 'w-30']}
                  type="number"
                  name={name}
                  min={group.min ?? undefined}
                  max={group.max ?? undefined}
                  step={group.step ?? undefined}
                  required={group.isRequired}
                  inputmode="numeric"
                  data-est-kind="number"
                  data-est-per-unit={group.priceModifierPerUnit?.amount ?? '0.00'}
                />
                {group.unit && <span class="text-ink-2 text-[14px]">{group.unit}</span>}
              </span>
              {group.priceModifierPerUnit && (
                <span class="text-ink-2 text-[13px]">
                  {signed(group.priceModifierPerUnit.amount, group.priceModifierPerUnit.currency)}{' '}
                  per {group.unit ?? 'unità'}
                </span>
              )}
              {group.helpText && (
                <p class="text-ink-2 m-0 w-full text-[13.5px]">{group.helpText}</p>
              )}
              {group.isRequired && (
                <p class="field-error w-full" data-field-error={`variant-${group.id}`} hidden>
                  Indica {group.label.toLocaleLowerCase('it-IT')} per continuare.
                </p>
              )}
            </div>
          );
        }

        return (
          <div class={rowCard} data-gate={group.isRequired ? `variant-${group.id}` : undefined}>
            <label class={groupLabel} for={`v-${group.id}`}>
              {group.label}
            </label>
            <input
              id={`v-${group.id}`}
              class:list={[inlineInput, 'min-w-50 flex-1']}
              type="text"
              name={name}
              maxlength="300"
              required={group.isRequired}
            />
            {group.helpText && <p class="text-ink-2 m-0 w-full text-[13.5px]">{group.helpText}</p>}
            {group.isRequired && (
              <p class="field-error w-full" data-field-error={`variant-${group.id}`} hidden>
                Indica {group.label.toLocaleLowerCase('it-IT')} per continuare.
              </p>
            )}
          </div>
        );
      })
    }
  </div>
</section>
