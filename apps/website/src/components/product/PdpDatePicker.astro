---
/**
 * The rental start control of the order panel: a label over a single filled
 * field, matching the package field above it (`pdp-chooser.ts`), which opens a
 * custom calendar popover rather than the browser's.
 *
 * ONE date, and one field for it. The customer picks a package, the package
 * carries a duration, and the return follows from the two — so the return is
 * printed in the OVERVIEW below, never here. A field shows what was entered;
 * putting the derived return inside it would read as a second thing to set.
 *
 * PROGRESSIVE ENHANCEMENT, and this is the point of the shape below. A calendar
 * grid cannot exist without JavaScript, but the request form must. So this
 * renders BOTH:
 *
 *   - `[data-date-native]` — a real `<input type="date">`, visible by default.
 *     Without JavaScript this is the entire control and it works.
 *   - `[data-cal-block]` + `[data-cal-pop]` — the same field driving a custom
 *     calendar, `hidden` by default.
 *
 * The page script swaps them on load: it unhides the card, hides the native
 * row, and drives the SAME input. A `display:none` input still submits (only
 * `disabled` suppresses it), so `from` reaches /carrello/ either way, and every
 * listener keeps working untouched because the calendar writes through the
 * input and dispatches `change`.
 *
 * The start-TIME row sits outside both, because it is needed in both: an hour
 * package cannot be ordered without one, and the calendar has no cell for it.
 */
import { PDP_FIELD, PDP_LABEL } from '~/components/product/pdp-chooser.ts';
import { localeForRequest, localeTag, translate } from '~/lib/i18n';
import { FIELD } from '~/lib/request-config';

interface Props {
  /** Today in Europe/Rome, ISO `YYYY-MM-DD`. The floor for the start date. */
  today: string;
  /**
   * The product offers at least one package quoted in hours, so a time of day
   * has to be askable. The row stays hidden until such a package is picked —
   * a day rental starts on a date and nothing finer.
   */
  hasHourPackage: boolean;
  /**
   * The delivery city carried from the home search, printed under the date as
   * a fact already settled. Null when the customer came straight to the
   * catalogue — then nothing is shown and the confirmation call establishes the
   * zone, which is why this is a quiet line and not a field.
   */
  deliveryCity?: string | null;
  /** A start date carried from the home search, already checked as orderable. */
  startDate?: string;
}

const { today, hasHourPackage, deliveryCity = null, startDate = '' } = Astro.props;
const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

/*
 * Weekday initials for the custom grid, from Intl rather than a hardcoded
 * "lun mar mer…". 2024-01-01 is a Monday, so seven days from it walk a
 * Monday-first week — which is the order the grid below renders.
 */
const weekdays = Array.from({ length: 7 }, (_, index) =>
  new Intl.DateTimeFormat(localeTag(locale), { weekday: 'short' }).format(
    new Date(Date.UTC(2024, 0, 1 + index)),
  ),
);

/* The native inputs wear the shared field directly — a date input draws its own
   calendar affordance at the right edge, which is what the enhanced trigger
   below has to imitate with an icon. */
const nativeField = `${PDP_FIELD} tabular-nums focus-visible:border-accent`;

/* The calendar is 7 columns of a 48×48 target — the project floor — plus the
   gaps and the popover padding: 7·48 + 6·2 + 2·10 = 368px. The popover is
   therefore WIDER than the panel column and breaks out symmetrically. On a
   narrow phone it clamps to the viewport and the cells fall back to a 44px
   floor, which keeps the row readable rather than overflowing the screen. */
const dayCell =
  'grid min-h-12 min-w-11 place-items-center rounded-lg border-0 bg-transparent text-[13.5px] font-semibold tabular-nums cursor-pointer ' +
  'hover:bg-tint-2 disabled:cursor-default disabled:text-ink-decorative disabled:hover:bg-transparent ' +
  'data-[range]:bg-tint-2 data-[edge]:bg-accent data-[edge]:text-white data-[edge]:hover:bg-accent ' +
  'data-[out]:text-ink-decorative';

const navButton =
  'grid size-11 flex-none place-items-center rounded-lg bg-tint text-[15px] cursor-pointer hover:bg-tint-2';
---

{
  /*
    THE GATE sits on the OUTER block, not on either of the two date controls.
    The script hides whichever one is not in use, and a hidden block is read as
    "nothing asked" — so gating the native row would silently stop asking for a
    start date the moment the calendar mounted. The outer block is visible in
    both modes, which is exactly what the question is.

    Focus goes to the calendar trigger when there is one; the proxy resolves to
    null while `[data-cal-block]` is still hidden, and the gate's own scan finds
    the native input instead. See `discoverGates` in lib/form-validation.ts.
  */
}
<div
  class="relative flex flex-col gap-2.5"
  data-date-block
  data-gate="startDate"
  data-gate-focus="[data-cal-trigger]"
>
  {/* ---- no-JavaScript control, and the source of truth in both modes ---- */}
  <div class="flex flex-col gap-1.5" data-date-native>
    <label class={PDP_LABEL} for="pdp-start-date">{text('pdp.startDate')}</label>
    <input
      class={nativeField}
      id="pdp-start-date"
      type="date"
      name={FIELD.startDate}
      min={today}
      value={startDate}
      data-est-start
    />
  </div>

  {
    /* ---- enhanced control: one date, one line ----
      ONE field, because there is one date to pick. The return is a consequence
      of the package, so it belongs to the overview, not to this field. */
  }
  <div class="flex flex-col gap-1.5" hidden data-cal-block>
    <span class={PDP_LABEL} id="pdp-cal-label">{text('pdp.startDate')}</span>
    <button
      class={`${PDP_FIELD} cursor-pointer aria-expanded:border-accent focus-visible:border-accent`}
      type="button"
      aria-expanded="false"
      aria-labelledby="pdp-cal-label pdp-cal-value"
      data-cal-trigger
    >
      <span class="min-w-0 flex-1 truncate" id="pdp-cal-value" data-cal-start>
        {text('pdp.chooseDate')}
      </span>
      {/* The affordance the native date input draws for itself. */}
      <svg
        class="text-ink-2 size-4.5 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="16" rx="2.5"></rect>
        <path d="M3 10h18M8 3v4M16 3v4"></path>
      </svg>
    </button>
  </div>

  {
    /* AFTER both date blocks, because it is needed in both and belongs below
      whichever one is showing: the script hides the native row once the calendar
      mounts, and an hour package cannot be ordered without a time, so nesting
      this inside either block would leave one path unable to express it. */
  }
  {
    /* Direct child of the date block, so the gate's focus scan reads this block
      and lands on whichever of the two date controls is currently showing.
      Placed here, under both of them and above the time row, because the message
      belongs to the control it is about. */
  }
  <p
    class="text-danger m-0 flex items-start gap-1.5 text-[13px] font-medium before:flex-none before:not-italic before:content-['⚠']"
    data-field-error="startDate"
    hidden
  >
    Scegli la data di inizio del noleggio.
  </p>

  {
    /* Its OWN gate, nested inside the date block's. An hourly package cannot be
       ordered without a time, but the row is `hidden` until one is chosen — and a
       hidden gate asks nothing, so this becomes required exactly when the package
       makes it so. `answersIn` stops the date above from answering for it. */
  }
  {
    hasHourPackage && (
      <div class="flex flex-col gap-1.5" data-time-row hidden data-gate="startTime">
        <label class={PDP_LABEL} for="pdp-start-time">
          Scegli l'ora di inizio
        </label>
        <input
          class={nativeField}
          id="pdp-start-time"
          type="time"
          name={FIELD.startTime}
          step="900"
          data-est-time
        />
        <p
          class="text-danger m-0 flex items-start gap-1.5 text-[13px] font-medium before:flex-none before:not-italic before:content-['⚠']"
          data-field-error="startTime"
          hidden
        >
          Indica l'ora di inizio: il pacchetto scelto è a ore.
        </p>
      </div>
    )
  }

  {
    /* The city the customer already chose, stated rather than asked. It is not
      a field: this page cannot change it — the home search set it and the
      confirmation call settles the street — so making it look editable would
      promise something the panel does not do. */
  }
  {
    deliveryCity && (
      <p class="text-ink-2 m-0 flex items-center gap-1.5 text-[13px]">
        <svg
          class="size-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" />
          <circle cx="12" cy="10" r="2.5" />
        </svg>
        Consegna a {deliveryCity}
      </p>
    )
  }

  {
    /* Visibility is the `hidden` ATTRIBUTE alone — Tailwind's preflight makes
      `[hidden]` `display:none !important`, so it beats the `flex` below and the
      script has exactly one thing to toggle. A `hidden` CLASS here would survive
      the attribute being removed and keep the popover silently collapsed. */
  }
  <div
    class="border-hair rounded-field shadow-pdp-cal absolute top-[calc(100%-6px)] left-1/2 z-30 flex max-h-[62vh] w-92 max-w-[calc(100vw-2rem)] -translate-x-1/2 flex-col gap-3 overflow-x-clip overflow-y-auto border bg-white p-2.5"
    hidden
    data-cal-pop
  >
    <div class="flex items-center justify-between gap-2">
      <button
        class={navButton}
        type="button"
        data-cal-prev
        aria-label={text('picker.previousMonth')}
      >
        ‹
      </button>
      <strong class="text-[14px]" aria-live="polite" data-cal-title></strong>
      <button class={navButton} type="button" data-cal-next aria-label={text('picker.nextMonth')}>
        ›
      </button>
    </div>

    <div
      class="text-ink-2 grid grid-cols-7 gap-0.5 text-center text-[11px] font-bold"
      aria-hidden="true"
    >
      {weekdays.map((day) => <span>{day}</span>)}
    </div>

    <div class="grid grid-cols-7 gap-0.5" data-cal-grid></div>

    <p class="text-ink-2 m-0 text-[13px]" data-cal-hint>{text('pdp.chooseStartDay')}</p>

    <button
      class="hover:bg-accent-deep min-h-12 cursor-pointer rounded-full border-0 bg-accent px-5 text-[14.5px] font-semibold text-white"
      type="button"
      data-cal-done
    >
      {text('picker.done')}
    </button>
  </div>

  {
    /* The day-cell class list lives on the server so the script never hard-codes
      design tokens; it clones this template for each of the 42 cells. */
  }
  <template data-cal-cell-class={dayCell}></template>
</div>
