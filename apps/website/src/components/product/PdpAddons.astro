---
/**
 * Section 02 — optional extras as one-line checkbox cards: box · icon · name
 * with a one-line description · price. A required add-on renders checked and
 * disabled; the summary page re-adds required add-ons from the product itself
 * rather than trusting the URL, so the unsubmitted disabled control is fine.
 */
import { formatPricing, mediaUrl } from '~/lib/api';
import type { ProductDetail } from '~/lib/catalog';
import { FIELD } from '~/lib/request-config';
import PdpSectionHead from './PdpSectionHead.astro';

interface Props {
  addons: ProductDetail['addons'];
}

const { addons } = Astro.props;

const priceLabel = (addon: Props['addons'][number]) =>
  addon.pricing.price === '0.00' ? 'Incluso' : formatPricing(addon.pricing);

const card =
  'flex h-full cursor-pointer items-center gap-3.5 rounded-field border-[1.5px] border-hair bg-white px-4 py-3.5 shadow-pdp-card ' +
  'peer-checked:border-accent peer-checked:[&_[data-box]]:border-accent peer-checked:[&_[data-box]]:bg-accent peer-checked:[&_[data-box]_svg]:opacity-100 ' +
  'hover:border-hair-strong peer-checked:hover:border-accent ' +
  'peer-disabled:cursor-default ' +
  'peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-white ' +
  'peer-focus-visible:shadow-[0_0_0_6px_var(--color-ink)]';
---

<section>
  <PdpSectionHead n="02" title="Extra" hint="facoltativi, si aggiungono al totale" />

  <div class="grid [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))] gap-2.5">
    {
      addons.map((addon) => (
        <span>
          <input
            class="peer sr-only"
            type="checkbox"
            name={FIELD.addon}
            id={`addon-${addon.id}`}
            value={addon.id}
            checked={addon.isRequired}
            disabled={addon.isRequired}
            data-est-kind="addon"
            data-est-price={addon.pricing.price}
            data-est-mode={addon.pricing.mode}
            data-est-label={addon.name}
          />
          <label class={card} for={`addon-${addon.id}`}>
            <span
              class="border-hair-strong grid size-5 flex-none place-items-center rounded-md border-[1.5px] bg-white"
              data-box
              aria-hidden="true"
            >
              <svg
                class="size-3.5 opacity-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#fff"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6L9 17l-5-5" />
              </svg>
            </span>
            {addon.icon && (
              <img
                class="bg-tint size-11 flex-none rounded-[9px] object-cover"
                src={mediaUrl(addon.icon)}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <span class="flex min-w-0 flex-1 flex-col gap-0.5 text-left">
              <strong class="text-[14.5px]">{addon.name}</strong>
              {addon.description && (
                <span class="text-ink-2 text-[12.5px]">{addon.description}</span>
              )}
            </span>
            <span class="text-[14px] font-semibold whitespace-nowrap tabular-nums">
              {priceLabel(addon)}
            </span>
          </label>
        </span>
      ))
    }
  </div>
</section>
