---
/**
 * Section 02 — optional extras as one-line checkbox cards: box · icon · name
 * with a one-line description · price, and a quantity stepper on the ones the
 * back office allowed more than one of.
 *
 * `maxQuantity` is what says whether an extra is multiple-selectable: `1` means
 * a bare tick, anything higher reveals the stepper. The stepper is hidden until
 * the box is ticked — a quantity for something nobody asked for is noise.
 *
 * A rental-mode extra is priced per its OWN unit and multiplied by the chosen
 * package's duration, so a "3,00 € al giorno" extra at quantity 2 on a 9-day
 * package is 54,00 €. Nothing here computes that; the label states the rate and
 * the estimate does the arithmetic.
 */
import { MAX_ADDON_QUANTITY } from '@mia/pricing';
import { formatRate, mediaUrl } from '~/lib/api';
import type { ProductDetail } from '~/lib/catalog';
import { localeForRequest, localeTag, translate } from '~/lib/i18n';
import { ADDON_QUANTITY_PREFIX, FIELD } from '~/lib/request-config';
import PdpSectionHead from './PdpSectionHead.astro';

interface Props {
  addons: ProductDetail['addons'];
}

const { addons } = Astro.props;
const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

/** More than one allowed — see `maxQuantity` above. `null` means no cap set. */
const allowsMultiple = (addon: Props['addons'][number]) =>
  addon.maxQuantity === null || addon.maxQuantity > 1;

/* A rental-mode add-on is quoted per its own unit and multiplied by the chosen
   package's duration at pricing time, so the label has to carry the unit. */
const priceLabel = (addon: Props['addons'][number]) =>
  addon.pricing.price === '0.00'
    ? text('included')
    : formatRate(
        addon.pricing.price,
        addon.pricing.currency,
        addon.pricing.mode === 'rental' ? addon.pricing.rentalUnit : null,
        localeTag(locale),
        locale,
      );

const card =
  'flex h-full cursor-pointer items-center gap-3.5 rounded-field border-[1.5px] border-transparent bg-tint px-4 py-3.5 hover:bg-tint-2 ' +
  'peer-checked:border-accent peer-checked:bg-white peer-checked:hover:bg-white ' +
  'peer-checked:[&_[data-box]]:bg-accent peer-checked:[&_[data-box]_svg]:opacity-100 ' +
  'peer-disabled:cursor-default ' +
  'peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-white ' +
  'peer-focus-visible:shadow-[0_0_0_6px_var(--color-ink)]';
---

<section>
  <PdpSectionHead n="01" title={text('pdp.extras')} hint={text('pdp.extrasHint')} />

  <div class="grid [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))] gap-2.5">
    {
      addons.map((addon) => (
        <span>
          <input
            class="peer sr-only"
            type="checkbox"
            name={FIELD.addon}
            id={`addon-${addon.id}`}
            value={addon.id}
            data-est-kind="addon"
            data-est-price={addon.pricing.price}
            data-est-mode={addon.pricing.mode}
            data-est-unit={addon.pricing.rentalUnit ?? ''}
            data-est-label={addon.name}
            data-addon-id={addon.id}
          />
          <label class={card} for={`addon-${addon.id}`}>
            <span
              class="grid size-5 flex-none place-items-center rounded-md bg-white"
              data-box
              aria-hidden="true"
            >
              <svg
                class="size-3.5 opacity-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#fff"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6L9 17l-5-5" />
              </svg>
            </span>
            {addon.icon && (
              <img
                class="size-11 flex-none rounded-[9px] bg-white object-contain p-0.5"
                src={mediaUrl(addon.icon)}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <span class="flex min-w-0 flex-1 flex-col gap-0.5 text-left">
              <strong class="text-[14.5px]">{addon.name}</strong>
              {addon.description && (
                <span class="text-ink-2 text-[12.5px]">{addon.description}</span>
              )}
            </span>
            <span class="text-[14px] font-semibold whitespace-nowrap tabular-nums">
              {priceLabel(addon)}
            </span>
          </label>

          {allowsMultiple(addon) && (
            <span
              class="mt-1.5 flex items-center justify-end gap-2.5 text-[13px]"
              data-qty-row
              data-addon-qty-row={addon.id}
              hidden
            >
              <span class="text-ink-2">{text('quantity')}</span>
              <span class="bg-tint flex items-center overflow-clip rounded-[10px]">
                <button
                  type="button"
                  class="hover:bg-tint-2 grid size-9 cursor-pointer place-items-center border-0 bg-transparent text-lg font-bold"
                  data-qty-dec
                  aria-label={`Riduci quantità di ${addon.name}`}
                >
                  −
                </button>
                <input
                  class="h-9 w-10 appearance-none border-0 bg-transparent text-center text-[14px] font-bold tabular-nums [-moz-appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                  type="number"
                  name={`${ADDON_QUANTITY_PREFIX}${addon.id}`}
                  value="1"
                  min="1"
                  max={addon.maxQuantity ?? MAX_ADDON_QUANTITY}
                  inputmode="numeric"
                  aria-label={translate(locale, 'quantityOf', { title: addon.name })}
                  data-qty-input
                  data-est-addon-qty={addon.id}
                />
                <button
                  type="button"
                  class="hover:bg-tint-2 grid size-9 cursor-pointer place-items-center border-0 bg-transparent text-lg font-bold"
                  data-qty-inc
                  aria-label={`Aumenta quantità di ${addon.name}`}
                >
                  +
                </button>
              </span>
            </span>
          )}
        </span>
      ))
    }
  </div>
</section>
