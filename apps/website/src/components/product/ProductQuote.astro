---
/**
 * The product configurator inside the buy box.
 *
 * A native GET form whose field names come from `request-config.ts`. Nothing is
 * priced in the browser and the CTA sends a request, never a payment — see
 * docs/code/storefront-design-system.md.
 *
 * The choice grids are radio/checkbox `peer`s followed by their label, so the
 * whole selected state — border, fill and tick — is expressed as variants on
 * the label rather than as a stylesheet the markup cannot see.
 */
import PhoneCta from '~/components/global/PhoneCta.astro';
import { formatMoney, formatPricing } from '~/lib/api';
import type { ProductDetail } from '~/lib/catalog';
import { FIELD, MAX_QUANTITY, QUESTION_PREFIX, VARIANT_PREFIX } from '~/lib/request-config';
import { routes } from '~/lib/routes';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;

const isRental = product.pricing.mode === 'rental';
const inStock = product.skus.length === 0 || product.skus.some((sku) => sku.inStock);

const signed = (amount: string, currency: string) =>
  `${Number(amount) > 0 ? '+' : ''}${formatMoney(amount, currency)}`;

const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Europe/Rome',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

/*
 * The selected state of a choice tile: accent border, tinted fill and a tick.
 *
 * The tick is a real element toggled by the peer, not a `content-['✓']`
 * pseudo-element — Tailwind's arbitrary-value parser silently drops the unicode
 * escape and you end up with an empty string and no tick at all.
 */
const tierLabel =
  'grid h-full min-h-12 cursor-pointer content-center justify-items-center gap-1 rounded-field border border-hair-strong bg-white p-3 text-center ' +
  'peer-checked:border-accent peer-checked:bg-tint peer-checked:shadow-[inset_0_0_0_1px_var(--color-accent)] ' +
  'peer-checked:[&_[data-tick]]:inline ' +
  'peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-white ' +
  'peer-focus-visible:shadow-[0_0_0_6px_var(--color-ink)]';

const tick = 'mr-1 hidden text-accent';

const fieldRow = 'grid gap-2.25';
/* The buy box labels every control the same way — sentence case, never the
   hero panel's uppercase treatment, which belongs to that panel alone. */
const labelClass = 'font-display text-ui-strong font-semibold';
const legendClass = `mb-3 ${labelClass}`;
const hintClass = 'mt-2 text-ui text-ink-2';
const textInput =
  'w-full min-h-12 rounded-field border border-hair-strong bg-white px-4 py-3 text-ui-strong';
---

{
  inStock ? (
    <form class="grid gap-5" id="quote-form" method="get" action={routes.cart}>
      <input type="hidden" name={FIELD.product} value={product.slug} />

      {/*
        One branch per value shape. A group whose shape has no control here would
        silently vanish from the form, so `string` and `multi_select` are handled
        explicitly rather than falling through to a select.
      */}
      {product.variants.map((group) => {
        const name = `${VARIANT_PREFIX}${group.key}`;
        const multiple = group.valueType === 'multi_select';

        if (group.options.length > 0) {
          return (
            <fieldset class="grid gap-4">
              <legend class={legendClass}>
                {group.label}
                {!group.isRequired && <span class="text-ink-2 font-normal"> (facoltativo)</span>}
              </legend>
              {group.helpText && <p class="text-ui text-ink-2 mb-3">{group.helpText}</p>}
              <ul class="grid grid-cols-1 gap-2 min-[380px]:grid-cols-2">
                {group.options.map((option, index) => (
                  <li>
                    <input
                      class="peer sr-only"
                      type={multiple ? 'checkbox' : 'radio'}
                      name={name}
                      id={`v-${group.id}-${option.id}`}
                      value={option.value}
                      checked={multiple ? option.isDefault : option.isDefault || index === 0}
                      required={group.isRequired && !multiple}
                    />
                    <label class={tierLabel} for={`v-${group.id}-${option.id}`}>
                      <span class="font-display text-ui font-semibold">
                        <span class={tick} data-tick aria-hidden="true">
                          ✓
                        </span>
                        {option.label}
                      </span>
                      {option.priceModifier.amount !== '0.00' && (
                        <span class="font-display text-body font-semibold text-accent">
                          {signed(option.priceModifier.amount, option.priceModifier.currency)}
                        </span>
                      )}
                    </label>
                  </li>
                ))}
              </ul>
            </fieldset>
          );
        }

        if (group.valueType === 'number' || group.valueType === 'number_range') {
          return (
            <div class={fieldRow}>
              <label class={labelClass} for={`v-${group.id}`}>
                {group.unit ? `${group.label} (${group.unit})` : group.label}
              </label>
              <input
                id={`v-${group.id}`}
                class={textInput}
                type="number"
                name={name}
                min={group.min ?? undefined}
                max={group.max ?? undefined}
                step={group.step ?? undefined}
                required={group.isRequired}
                inputmode="numeric"
              />
              {group.helpText && <p class={hintClass}>{group.helpText}</p>}
            </div>
          );
        }

        return (
          <div class={fieldRow}>
            <label class={labelClass} for={`v-${group.id}`}>
              {group.label}
            </label>
            <input
              id={`v-${group.id}`}
              class={textInput}
              type="text"
              name={name}
              maxlength="300"
              required={group.isRequired}
            />
            {group.helpText && <p class={hintClass}>{group.helpText}</p>}
          </div>
        );
      })}

      {isRental && (
        <div class={fieldRow}>
          <label class={labelClass} for={`inizio-${product.id}`}>
            Da quando ti serve?
          </label>
          <input
            id={`inizio-${product.id}`}
            class={textInput}
            type="date"
            name={FIELD.startDate}
            min={today}
          />
        </div>
      )}

      {product.addons.length > 0 && (
        <fieldset class="grid gap-4">
          <legend class={legendClass}>Vuoi aggiungere qualcosa?</legend>
          <ul class="grid gap-2">
            {product.addons.map((addon) => (
              <li class="grid grid-cols-[48px_minmax(0,1fr)] items-center">
                {/*
                  A required add-on is shown checked and disabled so it cannot be
                  removed. A disabled control is not submitted, which is fine:
                  the summary re-adds every required add-on from the product
                  itself rather than trusting the URL.
                */}
                <input
                  class="size-12 accent-accent"
                  type="checkbox"
                  name={FIELD.addon}
                  id={`addon-${addon.id}`}
                  value={addon.id}
                  checked={addon.isRequired}
                  disabled={addon.isRequired}
                />
                <label class="flex items-center justify-between gap-3" for={`addon-${addon.id}`}>
                  <span class="text-ui">
                    {addon.name}
                    {addon.isRequired && <span class="text-ok"> — incluso</span>}
                  </span>
                  <span class="font-display text-ui flex-none font-semibold text-accent">
                    {formatPricing(addon.pricing)}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      )}

      {product.questions.length > 0 && (
        <fieldset class="grid gap-4">
          <legend class={legendClass}>Qualche informazione per la consegna</legend>
          <p class="text-ui text-ink-2 mb-3">
            Ci serve per organizzare il trasporto. Se preferisci, ce lo dici al telefono.
          </p>

          {product.questions.map((question) => {
            const name = `${QUESTION_PREFIX}${question.key}`;

            if (question.options.length > 0) {
              const multiple = question.valueType === 'multi_select';
              return (
                <fieldset>
                  <legend class="font-display text-ui mb-2 font-semibold">{question.prompt}</legend>
                  {question.helpText && <p class={hintClass}>{question.helpText}</p>}
                  <ul class="grid grid-cols-1 gap-2 min-[380px]:grid-cols-2">
                    {question.options.map((option) => (
                      <li>
                        <input
                          class="peer sr-only"
                          type={multiple ? 'checkbox' : 'radio'}
                          name={name}
                          id={`q-${question.id}-${option.id}`}
                          value={option.value}
                        />
                        <label class={tierLabel} for={`q-${question.id}-${option.id}`}>
                          <span class="font-display text-ui font-semibold">
                            <span class={tick} data-tick aria-hidden="true">
                              ✓
                            </span>
                            {option.label}
                          </span>
                        </label>
                      </li>
                    ))}
                  </ul>
                </fieldset>
              );
            }

            if (question.valueType === 'boolean') {
              return (
                <fieldset>
                  <legend class="font-display text-ui mb-2 font-semibold">{question.prompt}</legend>
                  {question.helpText && <p class={hintClass}>{question.helpText}</p>}
                  <ul class="grid grid-cols-2 gap-2">
                    {[
                      { value: 'si', label: 'Sì' },
                      { value: 'no', label: 'No' },
                    ].map((option) => (
                      <li>
                        <input
                          class="peer sr-only"
                          type="radio"
                          name={name}
                          id={`q-${question.id}-${option.value}`}
                          value={option.value}
                        />
                        <label class={tierLabel} for={`q-${question.id}-${option.value}`}>
                          <span class="font-display text-ui font-semibold">
                            <span class={tick} data-tick aria-hidden="true">
                              ✓
                            </span>
                            {option.label}
                          </span>
                        </label>
                      </li>
                    ))}
                  </ul>
                </fieldset>
              );
            }

            return (
              <div class={fieldRow}>
                <label class={labelClass} for={`q-${question.id}`}>
                  {question.prompt}
                </label>
                {question.valueType === 'text' ? (
                  <textarea
                    id={`q-${question.id}`}
                    class={textInput}
                    name={name}
                    rows="3"
                    maxlength={question.maxLength ?? 300}
                  />
                ) : (
                  <input
                    id={`q-${question.id}`}
                    class={textInput}
                    name={name}
                    type={
                      question.valueType === 'number'
                        ? 'number'
                        : question.valueType === 'date'
                          ? 'date'
                          : 'text'
                    }
                    min={question.min ?? undefined}
                    max={question.max ?? undefined}
                    maxlength={
                      question.valueType === 'string' ? (question.maxLength ?? 300) : undefined
                    }
                  />
                )}
                {question.helpText && <p class={hintClass}>{question.helpText}</p>}
              </div>
            );
          })}
        </fieldset>
      )}

      <div class="flex items-center justify-between gap-4" data-qty-row>
        <label class={labelClass} for={`qta-${product.id}`}>
          Quantità
        </label>
        <div class="rounded-field border-hair-strong flex items-center overflow-hidden border">
          <button
            type="button"
            class="hover:bg-tint grid size-12 place-items-center border-0 bg-white text-xl font-bold"
            data-qty-dec
            aria-label="Riduci quantità"
          >
            −
          </button>
          <input
            id={`qta-${product.id}`}
            class="border-hair-strong font-display text-ui-strong h-12 min-h-12 w-12 appearance-none border-x bg-white text-center font-bold [-moz-appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
            type="number"
            name={FIELD.quantity}
            value="1"
            min="1"
            max={MAX_QUANTITY}
            inputmode="numeric"
            data-qty-input
          />
          <button
            type="button"
            class="hover:bg-tint grid size-12 place-items-center border-0 bg-white text-xl font-bold"
            data-qty-inc
            aria-label="Aumenta quantità"
          >
            +
          </button>
        </div>
      </div>

      <div class="border-hair flex items-baseline justify-between gap-3 border-t pt-4">
        <span class="font-display text-ui-strong font-semibold">
          {isRental ? 'Noleggio da' : 'Prezzo'}
        </span>
        <span class="font-display text-h3 font-bold tabular-nums">
          {formatPricing(product.pricing)}
        </span>
      </div>

      <button class="btn btn-primary w-full" type="submit">
        {isRental ? 'Richiedi il noleggio' : 'Richiedi il prodotto'}
      </button>
    </form>
  ) : (
    <div class="rounded-card border-hair-strong bg-tint grid gap-4 border p-5">
      <p>
        Questo ausilio è momentaneamente esaurito. Chiamaci: spesso abbiamo un modello equivalente
        disponibile subito.
      </p>
      <PhoneCta variant="primary" />
    </div>
  )
}

<script>
  document.querySelectorAll('[data-qty-dec], [data-qty-inc]').forEach((button) => {
    button.addEventListener('click', () => {
      const row = button.closest('[data-qty-row]');
      const input = row?.querySelector<HTMLInputElement>('[data-qty-input]');
      if (!input) return;
      const current = Number.parseInt(input.value, 10) || 1;
      const min = Number.parseInt(input.min, 10) || 1;
      const max = Number.parseInt(input.max, 10) || 10;
      input.value = String(
        button.hasAttribute('data-qty-dec')
          ? Math.max(min, current - 1)
          : Math.min(max, current + 1),
      );
    });
  });
</script>
