---
/**
 * The sticky order panel — the one elevated card on the page. Total first,
 * then the packages, the start date, the line items, quantity and the request
 * CTA.
 *
 * Everything money-shaped here is a DISPLAY ESTIMATE: the page script mirrors
 * the form into these slots, the server re-resolves the real configuration on
 * /carrello/, and the price that counts is the one confirmed by phone.
 *
 * A PACKAGE IS THE PRICE, and that shapes this whole panel. There is no
 * "no package" option and no standard rate to fall back to, so nothing shows a
 * total until one is picked — the headline reads "scegli un pacchetto" and the
 * estimate a dash. A variant modifier is added flat on top of the package; a
 * rental-mode add-on multiplies by the package's duration.
 *
 * THE CTA IS NOT DISABLED WHILE THAT IS TRUE, and used to be. A dead button
 * stops the customer without telling them anything; the actions stay live and
 * the form gate marks the missing field instead — `PdpOrderActions.astro`.
 *
 * The panel is four parts, in the order the customer meets them: the estimate,
 * the rental fields (`PdpRentalFields.astro`), the overview those two produce,
 * and the actions.
 */
import PdpOrderActions from '~/components/product/PdpOrderActions.astro';
import PdpRentalFields from '~/components/product/PdpRentalFields.astro';
import { formatMoney } from '~/lib/api';
import type { ProductDetail } from '~/lib/catalog';
import { REVIEW_AGGREGATE } from '~/lib/home-content';
import { localeForRequest, localeTag } from '~/lib/i18n';
import { t } from '~/lib/labels';
import { FIELD, MAX_QUANTITY } from '~/lib/request-config';
import { routePath } from '~/lib/routes';
import { whatsappUrl } from '~/lib/site';

interface Props {
  product: ProductDetail;
  /** Today in Europe/Rome, ISO. The floor for the start date. */
  today: string;
  /**
   * The delivery city the customer chose in the home search, carried here by
   * the browse links. Null when they came straight to the catalogue or selected
   * "Altra zona".
   */
  deliveryCity?: string | null;
  /** A start date carried from the home search, already checked as orderable. */
  startDate?: string;
}

const { product, today, deliveryCity = null, startDate = '' } = Astro.props;
const locale = localeForRequest();

const isRental = product.pricing.mode === 'rental';
const { currency } = product.pricing;
const money = (amount: number) => formatMoney(amount.toFixed(2), currency, localeTag(locale));

/*
  On a rental there is nothing to show until a package is picked: no rate exists,
  so there is no number to print that would be the price of anything. Nothing is
  preselected for the same reason the card says "Scegli un pacchetto" — the
  choice is the customer's, and a default would quote them a price they never
  asked for. A fixed product has its price from the start.

  Initial paint mirrors the form's default state (no add-ons ticked, no package,
  quantity 1) so the script never causes a flash.
*/
const initialTotal = isRental ? null : Number(product.pricing.price ?? '0');
const initialNote = t(isRental ? 'pdp.pickPackageNote' : 'pdp.productPrice');
const baseLineLabel = t('baseRate');

const packages = product.rentalPackages;
---

{
  /*
    The `aside` is the COLUMN, not the card. Only what the customer has to
    decide belongs inside the white panel; the help line below it is outside on
    purpose — see the note by it.
  */
}
<aside
  id="order"
  class="wide:sticky wide:top-6 flex max-w-100 min-w-0 flex-[1_1_320px] scroll-mt-24 flex-col gap-4"
>
  <div
    class="border-hair shadow-pdp-panel flex flex-col gap-6 rounded-2xl border bg-white px-7 py-[30px]"
  >
    <div>
      <div class="text-ink-2 text-[11.5px] font-bold tracking-[0.1em] uppercase">
        Totale stimato
      </div>
      <div class="mt-1 flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
        <span class="text-[32px] font-bold tracking-[-0.02em] tabular-nums" data-est-total>
          {initialTotal === null ? '—' : money(initialTotal)}
        </span>
        <span class="text-ink-2 text-[13.5px]" data-est-note>{initialNote}</span>
      </div>
    </div>

    {
      isRental && (
        <PdpRentalFields packages={packages} {currency} {today} {deliveryCity} {startDate} />
      )
    }

    {
      /*
      The overview. The return date leads it because it is the one thing the
      customer did not enter and cannot see anywhere else — the package decides
      it. It stays out of the date field for exactly that reason: a field holds
      what you typed, not what was derived from it.
    */
    }
    <div class="border-hair flex flex-col gap-2.5 border-t pt-5 text-[13.5px]">
      {
        isRental && (
          <div class="flex justify-between gap-3" data-period-row hidden>
            <span class="text-ink-2 min-w-0">Riconsegna</span>
            <span class="font-semibold whitespace-nowrap" data-cal-end />
          </div>
        )
      }

      <ul class="m-0 flex list-none flex-col gap-2.5 p-0" data-est-lines>
        {
          initialTotal !== null && (
            <li class="flex justify-between gap-3">
              <span class="text-ink-2 min-w-0">{baseLineLabel}</span>
              <span class="font-semibold whitespace-nowrap tabular-nums">
                {money(initialTotal)}
              </span>
            </li>
          )
        }
        {
          /*
        Only the base line is server-rendered. Add-ons used to be able to declare
        themselves required, and those were printed here because they were charged
        whether or not anyone touched the form. Every add-on is opt-in now, so
        there is nothing to print before a choice is made — the estimate script
        replaces this list from the ticked boxes.
      */
        }
      </ul>
    </div>

    <div class="flex items-center justify-between gap-4" data-qty-row>
      <label class="text-[14px] font-semibold" for={`qta-${product.id}`}>{t('quantity')}</label>
      <div class="bg-tint flex items-center overflow-clip rounded-[10px]">
        <button
          type="button"
          class="hover:bg-tint-2 grid size-11 cursor-pointer place-items-center border-0 bg-transparent text-xl font-bold"
          data-qty-dec
          aria-label={t('decreaseQuantity')}
        >
          −
        </button>
        <input
          id={`qta-${product.id}`}
          class="h-11 w-11 appearance-none border-0 bg-transparent text-center text-[15px] font-bold tabular-nums [-moz-appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
          type="number"
          name={FIELD.quantity}
          value="1"
          min="1"
          max={MAX_QUANTITY}
          inputmode="numeric"
          data-qty-input
          data-est-qty
        />
        <button
          type="button"
          class="hover:bg-tint-2 grid size-11 cursor-pointer place-items-center border-0 bg-transparent text-xl font-bold"
          data-qty-inc
          aria-label={t('increaseQuantity')}
        >
          +
        </button>
      </div>
    </div>

    <PdpOrderActions {isRental} productTitle={product.title} />

    {
      /*
      The aggregate review line of the reference design. It reuses the SAME
      governed-content adapter as the home page, so the storefront never shows
      two different ratings — and, for the same reason as the home band, it is
      deliberately NOT emitted as AggregateRating structured data: the figure
      has no governed source yet, and a stale one is a Google policy problem.
    */
    }
    <a
      class="border-hair text-ink flex flex-wrap items-center justify-center gap-x-2 gap-y-1 border-t pt-3.5 text-[13px] no-underline"
      href={`${routePath(locale, 'home')}#recensioni`}
      aria-label={t('pdp.reviewRating', {
        rating: REVIEW_AGGREGATE.rating,
        count: t(REVIEW_AGGREGATE.countKey),
      })}
    >
      <span class="text-star tracking-[0.12em]" aria-hidden="true">★★★★★</span>
      <strong class="tabular-nums">{REVIEW_AGGREGATE.rating}</strong>
      <span class="text-ink-2">· {t(REVIEW_AGGREGATE.countKey)}</span>
    </a>
  </div>

  {
    /*
      Asking a human is NOT a third way to order, so it is not a third button
      competing with the two that are. It sits outside the panel, in text, at
      the weight of an offer of help — which is what it is.
    */
  }
  <p class="text-ink-2 m-0 text-center text-[13px]">
    Serve aiuto?{' '}
    <a
      class="text-ok inline-flex items-center gap-1.5 font-semibold underline"
      href={whatsappUrl(`Domanda su: ${product.title}`)}
      target="_blank"
      rel="noopener"
      data-analytics="whatsapp"
    >
      <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.85 9.85 0 0 0 12.04 2Zm5.8 14.16c-.24.68-1.42 1.31-1.96 1.36-.5.05-.98.24-3.3-.7-2.78-1.13-4.55-3.98-4.69-4.16-.14-.19-1.12-1.5-1.12-2.86s.71-2.03.96-2.31c.25-.28.55-.35.73-.35s.37 0 .53.01c.17.01.4-.06.62.48.24.55.8 1.92.87 2.06.07.14.12.3.02.49-.1.19-.15.3-.29.47-.15.17-.31.38-.44.51-.15.14-.3.3-.13.59.17.28.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.44.29.14.46.12.63-.07.17-.19.72-.85.92-1.14.19-.28.38-.24.64-.14.26.09 1.64.78 1.92.92.28.14.47.21.54.33.07.11.07.66-.17 1.34Z"
        ></path>
      </svg>
      Scrivici su WhatsApp
    </a>
  </p>
</aside>
