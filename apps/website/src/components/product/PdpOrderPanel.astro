---
/**
 * The sticky order panel — the one elevated card on the page. Total first,
 * then the packages, the start date, the line items, quantity and the request
 * CTA.
 *
 * Everything money-shaped here is a DISPLAY ESTIMATE: the page script mirrors
 * the form into these slots, the server re-resolves the real configuration on
 * /carrello/, and the price that counts is the one confirmed by phone.
 *
 * A PACKAGE IS THE PRICE, and that shapes this whole panel. There is no
 * "no package" option and no standard rate to fall back to, so nothing shows a
 * total until one is picked — the headline reads "scegli un pacchetto" and the
 * CTA is disabled. A variant modifier is added flat on top of the package; a
 * rental-mode add-on multiplies by the package's duration.
 *
 * The packages are a plain radio LIST rather than the old popover: they are the
 * first decision now, not an optional upgrade hidden behind a disclosure.
 */
import PdpDatePicker from '~/components/product/PdpDatePicker.astro';
import { formatMoney } from '~/lib/api';
import type { ProductDetail } from '~/lib/catalog';
import { REVIEW_AGGREGATE } from '~/lib/home-content';
import { FIELD, MAX_QUANTITY } from '~/lib/request-config';
import { routes } from '~/lib/routes';
import { whatsappUrl } from '~/lib/site';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;

const isRental = product.pricing.mode === 'rental';
const { currency } = product.pricing;
const money = (amount: number) => formatMoney(amount.toFixed(2), currency);

/* Initial paint mirrors the form's default state (default option per group, no
   add-ons ticked, no package, quantity 1) so the script never causes a flash. */
const defaultLabels: string[] = [];
const defaultModifiers = product.variants.reduce((sum, group) => {
  if (group.options.length === 0) return sum;
  if (group.valueType === 'multi_select') {
    const chosen = group.options.filter((option) => option.isDefault);
    defaultLabels.push(...chosen.map((option) => option.label));
    return sum + chosen.reduce((acc, option) => acc + Number(option.priceModifier.amount), 0);
  }
  const chosen = group.options.find((option) => option.isDefault) ?? group.options[0];
  if (!chosen) return sum;
  defaultLabels.push(chosen.label);
  return sum + Number(chosen.priceModifier.amount);
}, 0);

/*
  On a rental there is nothing to show until a package is picked: no rate exists,
  and printing the variant modifiers alone would put a number on the panel that
  is not the price of anything. A fixed product has its price from the start.
*/
const initialTotal = isRental ? null : Number(product.pricing.price ?? '0') + defaultModifiers;
const initialNote = isRental ? 'scegli un pacchetto' : 'prezzo del prodotto';
const baseLineLabel = defaultLabels.length > 0 ? defaultLabels.join(' · ') : 'Tariffa base';

const packages = product.rentalPackages;
const hasHourPackage = packages.some((pkg) => pkg.unit === 'hour');

const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Europe/Rome',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

/* A package is a required choice, so its rows read as selectable cards rather
   than menu lines: a visible border in every state, filled when chosen. */
const pkgRow =
  'flex cursor-pointer items-center gap-3 rounded-[11px] border-[1.5px] border-hair bg-white px-3.5 py-3 hover:border-hair-strong ' +
  'peer-checked:border-accent peer-checked:bg-tint peer-checked:[&_[data-pkg-name]]:text-accent ' +
  'peer-focus-visible:outline-3 peer-focus-visible:-outline-offset-3 peer-focus-visible:outline-white ' +
  'peer-focus-visible:shadow-[inset_0_0_0_3px_var(--color-ink)]';
---

<aside
  id="order"
  class="border-hair wide:sticky wide:top-6 shadow-pdp-panel flex max-w-100 min-w-0 flex-[1_1_320px] scroll-mt-24 flex-col gap-6 rounded-2xl border bg-white px-7 py-[30px]"
>
  <div>
    <div class="text-ink-2 text-[11.5px] font-bold tracking-[0.1em] uppercase">Totale stimato</div>
    <div class="mt-1 flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
      <span class="text-[32px] font-bold tracking-[-0.02em] tabular-nums" data-est-total>
        {initialTotal === null ? '—' : money(initialTotal)}
      </span>
      <span class="text-ink-2 text-[13.5px]" data-est-note>{initialNote}</span>
    </div>
  </div>

  {
    isRental && (
      <div class="flex flex-col gap-4">
        {/* The price of the rental, so it comes before the date it starts on. */}
        <fieldset class="m-0 flex flex-col gap-1.5 border-0 p-0" data-pkg-list>
          <legend class="text-ink-2 mb-1 p-0 text-[11.5px] font-bold tracking-[0.1em] uppercase">
            Pacchetto
          </legend>
          {packages.map((pkg) => (
            <span class="relative block">
              <input
                class="peer sr-only"
                type="radio"
                name={FIELD.rentalPackage}
                id={`pdp-pkg-${pkg.code}`}
                value={pkg.code}
                required
                data-est-kind="package"
                data-est-price={pkg.price}
                data-est-duration={pkg.duration}
                data-est-unit={pkg.unit}
                data-est-label={pkg.name}
                data-est-detail={pkg.label}
              />
              <label class={pkgRow} for={`pdp-pkg-${pkg.code}`}>
                <span class="flex min-w-0 flex-1 flex-col gap-0.5 text-left">
                  <strong class="text-[14px]" data-pkg-name>
                    {pkg.name}
                  </strong>
                  {/* Only when the back office named it something else — an
                      unnamed package falls back to its own duration label, and
                      printing "3 giorni" twice says nothing. */}
                  {pkg.name !== pkg.label && (
                    <span class="text-ink-2 text-[13px]">{pkg.label}</span>
                  )}
                </span>
                <strong class="text-[14px] whitespace-nowrap tabular-nums">
                  {formatMoney(pkg.price, currency)}
                </strong>
              </label>
            </span>
          ))}
        </fieldset>

        <PdpDatePicker {today} {hasHourPackage} />
      </div>
    )
  }

  <ul
    class="border-hair m-0 flex list-none flex-col gap-2.5 border-t p-0 pt-5 text-[13.5px]"
    data-est-lines
  >
    {
      initialTotal !== null && (
        <li class="flex justify-between gap-3">
          <span class="text-ink-2 min-w-0">{baseLineLabel}</span>
          <span class="font-semibold whitespace-nowrap tabular-nums">{money(initialTotal)}</span>
        </li>
      )
    }
    {
      /*
        Only the base line is server-rendered. Add-ons used to be able to declare
        themselves required, and those were printed here because they were charged
        whether or not anyone touched the form. Every add-on is opt-in now, so
        there is nothing to print before a choice is made — the estimate script
        replaces this list from the ticked boxes.
      */
    }
  </ul>

  <div class="flex items-center justify-between gap-4" data-qty-row>
    <label class="text-[14px] font-semibold" for={`qta-${product.id}`}>Quantità</label>
    <div class="border-hair-strong flex items-center overflow-clip rounded-[10px] border">
      <button
        type="button"
        class="hover:bg-tint grid size-11 cursor-pointer place-items-center border-0 bg-white text-xl font-bold"
        data-qty-dec
        aria-label="Riduci quantità"
      >
        −
      </button>
      <input
        id={`qta-${product.id}`}
        class="border-hair-strong h-11 w-11 appearance-none border-x bg-white text-center text-[15px] font-bold tabular-nums [-moz-appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        type="number"
        name={FIELD.quantity}
        value="1"
        min="1"
        max={MAX_QUANTITY}
        inputmode="numeric"
        data-qty-input
        data-est-qty
      />
      <button
        type="button"
        class="hover:bg-tint grid size-11 cursor-pointer place-items-center border-0 bg-white text-xl font-bold"
        data-qty-inc
        aria-label="Aumenta quantità"
      >
        +
      </button>
    </div>
  </div>

  {
    /*
      Three actions, in three weights, because they are three different sizes of
      commitment: go and confirm this one now, put it aside and keep looking, or
      ask a human. Solid → accent outline → neutral outline, so the hierarchy is
      readable without reading the words.

      Both of the first two are `type="submit"` on the SAME form, which is what
      makes the second one work without JavaScript: `formaction` overrides the
      form's `/checkout/` target, so "aggiungi" degrades to a plain GET of this
      configuration to `/carrello/` — the cart renders it server-side and folds it
      into the store on mount. The script below only upgrades that to "stay on the
      page"; it never becomes the only way to add something.
    */
  }
  <div class="flex flex-col gap-2.5">
    {
      /*
        Disabled by the script until a rental has both a package and a start
        date, because the API refuses that line — better to say so on the page
        that can still fix it than to fail at the last step. It ships ENABLED so
        the no-JavaScript path still submits and gets the server's own message.
      */
    }
    <button
      class="hover:bg-accent-deep min-h-12 cursor-pointer rounded-full border-0 bg-accent px-5 text-[15.5px] font-semibold text-white focus-visible:shadow-[0_0_0_6px_var(--color-ink)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-not-allowed disabled:opacity-45"
      type="submit"
      data-est-submit
    >
      {isRental ? 'Richiedi il noleggio' : 'Richiedi il prodotto'}
    </button>

    <button
      class="hover:bg-tint flex min-h-12 cursor-pointer items-center justify-center rounded-full border-[1.5px] border-accent bg-white px-5 text-[14.5px] font-semibold text-accent"
      type="submit"
      formaction={routes.cart}
      formmethod="get"
      data-add-to-cart
      data-product-title={product.title}
    >
      Aggiungi alla richiesta
    </button>

    <a
      class="border-hair-strong text-ink flex min-h-12 items-center justify-center rounded-full border-[1.5px] bg-transparent px-5 text-[14.5px] font-semibold no-underline hover:border-accent hover:text-accent"
      href={whatsappUrl(`Domanda su: ${product.title}`)}
      target="_blank"
      rel="noopener"
      data-analytics="whatsapp"
    >
      Fai una domanda
    </a>
  </div>

  {
    /*
      The confirmation, revealed by the script after a successful add. Ships with
      the `hidden` attribute rather than a `hidden:` utility, for the reason the
      calendar popover and the checkout's step bodies both do: preflight makes
      `[hidden]` `display: none !important`, so the attribute is the ONE thing
      that decides visibility and a utility class cannot fight it.
    */
  }
  <div
    class="border-ok/30 rounded-field flex flex-wrap items-center gap-x-3 gap-y-1 border bg-white px-4 py-3 text-[13.5px]"
    data-cart-added
    hidden
  >
    <span class="text-ok font-semibold">Aggiunto alla richiesta</span>
    <a class="font-semibold text-accent underline" href={routes.cart}>Vai alla richiesta</a>
  </div>

  {
    /*
      The spoken half of that confirmation, and a separate element on purpose.
      Revealing a `role="status"` region announces it once; adding a second time
      changes nothing in the DOM, so a screen-reader user would hear nothing at
      all on every add after the first. This region's text ends in the cart's new
      SIZE, which does change every time — so every add is announced, and the
      thing it announces is the fact the customer actually wants confirmed.

      The template is a value, not an identifier, so Italian belongs in it. The
      island's own live region is built the same way.
    */
  }
  <p
    class="sr-only"
    role="status"
    aria-live="polite"
    data-cart-announce
    data-message-template="Aggiunto alla richiesta. Ora contiene {count}."
    data-count-one="1 ausilio"
    data-count-many="{count} ausili"
  >
  </p>

  {
    /*
      The aggregate review line of the reference design. It reuses the SAME
      governed-content adapter as the home page, so the storefront never shows
      two different ratings — and, for the same reason as the home band, it is
      deliberately NOT emitted as AggregateRating structured data: the figure
      has no governed source yet, and a stale one is a Google policy problem.
    */
  }
  <a
    class="border-hair text-ink flex flex-wrap items-center justify-center gap-x-2 gap-y-1 border-t pt-3.5 text-[13px] no-underline"
    href={`${routes.home}#recensioni`}
    aria-label={`Valutazione ${REVIEW_AGGREGATE.rating} su 5, basata su ${REVIEW_AGGREGATE.countLabel}`}
  >
    <span class="text-star tracking-[0.12em]" aria-hidden="true">★★★★★</span>
    <strong class="tabular-nums">{REVIEW_AGGREGATE.rating}</strong>
    <span class="text-ink-2">· {REVIEW_AGGREGATE.countLabel}</span>
  </a>
</aside>
