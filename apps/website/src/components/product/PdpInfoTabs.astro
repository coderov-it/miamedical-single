---
/**
 * The information tabs at the foot of the main column: description, FAQ,
 * delivery & hygiene, applicable terms. CSS-only — hidden radios drive the
 * panels, so the tabs survive without JavaScript.
 *
 * The radios carry `form="pdp-detached"`, an id that exists nowhere: a control
 * whose form attribute matches no element has no form owner, which keeps these
 * purely-presentational inputs out of the surrounding GET form's submission.
 *
 * Empty tabs are filtered server-side; the nth-of-type CSS below follows the
 * rendered order, so it stays correct whichever subset survives.
 */
import type { ProductDetail } from '~/lib/catalog';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;
const isRental = product.pricing.mode === 'rental';

const includes = [
  'Consegna a domicilio',
  'Ritiro a fine noleggio',
  'Montaggio e istruzioni',
  'Assistenza telefonica',
];

const hygiene = [
  'Sanificato e certificato',
  'Controllato prima della consegna',
  'Accessori inclusi e integri',
];

type TabKey = 'descrizione' | 'faq' | 'consegna' | 'condizioni';

const tabs: { key: TabKey; title: string }[] = [
  ...(product.description ? [{ key: 'descrizione' as const, title: 'Descrizione' }] : []),
  ...(product.faqs.length > 0 ? [{ key: 'faq' as const, title: 'Domande frequenti' }] : []),
  { key: 'consegna' as const, title: 'Consegna e igiene' },
  ...(product.terms.length > 0 ? [{ key: 'condizioni' as const, title: 'Condizioni' }] : []),
];

/**
 * `description` is rich text — the back office writes it in a Tiptap editor and
 * the server sanitises it against an allowlist on write (h2–h6, strong/em/u/s,
 * lists, blockquote, hr, links; no images, no `style`, no `class`), so `set:html`
 * below renders markup this system produced, never a raw request body. The
 * `.pdp-prose` block at the foot of this file is the only styling it gets: the
 * HTML carries no classes of its own, by design.
 */

const checkRow = 'flex items-center gap-3 text-[14.5px]';
---

<section class="pdp-tabs">
  {
    tabs.map((tab, index) => (
      <input
        class="sr-only"
        type="radio"
        name="pdp-info-tab"
        id={`pdp-tab-${index}`}
        checked={index === 0}
        form="pdp-detached"
        aria-label={tab.title}
      />
    ))
  }

  <div class="tabbar border-hair flex gap-1 overflow-x-auto border-b-[1.5px]">
    {
      tabs.map((tab, index) => (
        <label
          class="text-ink-2 cursor-pointer px-4.5 py-3 text-[14.5px] font-semibold whitespace-nowrap hover:text-accent"
          for={`pdp-tab-${index}`}
        >
          {tab.title}
        </label>
      ))
    }
  </div>

  <div class="panels text-ink-2 pt-6 text-[15px]/[1.65]">
    {
      tabs.map((tab, index) => (
        <div class={`pdp-panel pdp-panel-${index}`}>
          {tab.key === 'descrizione' && (
            <div class="pdp-prose max-w-180" set:html={product.description} />
          )}

          {tab.key === 'faq' && (
            <div class="flex max-w-180 flex-col">
              {product.faqs.map((faq) => (
                <details class="border-hair group border-b">
                  <summary class="text-ink flex min-h-12 cursor-pointer list-none items-center justify-between gap-5 py-3.5 text-[15px] font-semibold [&::-webkit-details-marker]:hidden">
                    {faq.question}
                    <svg
                      class="size-4.5 flex-none transition-transform duration-200 group-open:rotate-180"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <p class="m-0 max-w-[68ch] pb-4 text-pretty">{faq.answer}</p>
                </details>
              ))}
            </div>
          )}

          {tab.key === 'consegna' && (
            <div class="grid max-w-180 gap-8 min-[560px]:grid-cols-2">
              <div>
                <h3 class="text-ink m-0 mb-3.5 text-[15.5px] font-bold">
                  {isRental ? 'Cosa è incluso nel noleggio' : 'Cosa è incluso'}
                </h3>
                <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
                  {includes.map((item) => (
                    <li class={checkRow}>
                      <svg
                        class="text-ok size-4.5 flex-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="text-ink m-0 mb-3.5 text-[15.5px] font-bold">Igiene e sicurezza</h3>
                <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
                  {hygiene.map((item) => (
                    <li class={checkRow}>
                      <svg
                        class="text-ok size-4.5 flex-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}

          {tab.key === 'condizioni' && (
            <div class="flex max-w-180 flex-col gap-3">
              <p class="m-0">Al noleggio di questo ausilio si applicano le seguenti condizioni:</p>
              <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
                {product.terms.map((terms) => (
                  <li>
                    <a
                      class="inline-flex min-h-10 items-center text-[14.5px] font-semibold text-accent"
                      href={`/${terms.slug}/`}
                    >
                      {terms.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .pdp-panel {
    display: none;
  }

  /*
    The description's prose. The markup arrives class-less from the sanitiser, so
    every rule here is an element selector, and the panel's own 15px/1.65 is the
    body size — headings step off that rather than off the page's scale, because
    this is a block of copy inside a tab, not a section of the page.

    Headings start at h2: the PDP's single h1 is the product title. Values track
    the reference design's type ramp (docs/code/storefront-design-system.md).
  */
  .pdp-prose > :global(* + *) {
    margin-top: 0.85em;
  }
  .pdp-prose :global(h2),
  .pdp-prose :global(h3),
  .pdp-prose :global(h4),
  .pdp-prose :global(h5),
  .pdp-prose :global(h6) {
    color: var(--color-ink);
    font-weight: 700;
    line-height: 1.25;
    margin-top: 1.5em;
  }
  .pdp-prose :global(h2) {
    font-size: 19px;
  }
  .pdp-prose :global(h3) {
    font-size: 17px;
  }
  .pdp-prose :global(h4),
  .pdp-prose :global(h5),
  .pdp-prose :global(h6) {
    font-size: 15px;
  }
  /* First heading in the panel has the panel's own padding above it already. */
  .pdp-prose > :global(:first-child) {
    margin-top: 0;
  }
  .pdp-prose :global(p) {
    text-wrap: pretty;
  }
  .pdp-prose :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .pdp-prose :global(ul),
  .pdp-prose :global(ol) {
    padding-left: 1.35em;
  }
  .pdp-prose :global(ul) {
    list-style: disc;
  }
  .pdp-prose :global(ol) {
    list-style: decimal;
  }
  .pdp-prose :global(li + li) {
    margin-top: 0.35em;
  }
  .pdp-prose :global(li > ul),
  .pdp-prose :global(li > ol) {
    margin-top: 0.35em;
  }
  .pdp-prose :global(blockquote) {
    border-left: 2px solid var(--color-hair);
    padding-left: 1em;
  }
  .pdp-prose :global(hr) {
    border: 0;
    border-top: 1.5px solid var(--color-hair);
    margin: 1.5em 0;
  }
  .pdp-prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The rendered order of radios, labels and panels is the same, so plain
     positional selectors wire tab N to panel N whatever subset exists. */
  input:nth-of-type(1):checked ~ .panels .pdp-panel-0,
  input:nth-of-type(2):checked ~ .panels .pdp-panel-1,
  input:nth-of-type(3):checked ~ .panels .pdp-panel-2,
  input:nth-of-type(4):checked ~ .panels .pdp-panel-3 {
    display: block;
  }

  input:nth-of-type(1):checked ~ .tabbar label:nth-of-type(1),
  input:nth-of-type(2):checked ~ .tabbar label:nth-of-type(2),
  input:nth-of-type(3):checked ~ .tabbar label:nth-of-type(3),
  input:nth-of-type(4):checked ~ .tabbar label:nth-of-type(4) {
    color: var(--color-accent);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  input:nth-of-type(1):focus-visible ~ .tabbar label:nth-of-type(1),
  input:nth-of-type(2):focus-visible ~ .tabbar label:nth-of-type(2),
  input:nth-of-type(3):focus-visible ~ .tabbar label:nth-of-type(3),
  input:nth-of-type(4):focus-visible ~ .tabbar label:nth-of-type(4) {
    outline: 3px solid #fff;
    outline-offset: -3px;
    box-shadow:
      inset 0 -2px 0 var(--color-accent),
      0 0 0 3px var(--color-ink);
  }
</style>
