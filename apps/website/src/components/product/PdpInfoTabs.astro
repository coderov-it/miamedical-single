---
/**
 * The information tabs at the foot of the main column: description, FAQ,
 * delivery & hygiene, applicable terms. CSS-only — hidden radios drive the
 * panels, so the tabs survive without JavaScript.
 *
 * The radios carry `form="pdp-detached"`, an id that exists nowhere: a control
 * whose form attribute matches no element has no form owner, which keeps these
 * purely-presentational inputs out of the surrounding GET form's submission.
 *
 * Empty tabs are filtered server-side; the nth-of-type CSS below follows the
 * rendered order, so it stays correct whichever subset survives.
 */
import type { ProductDetail } from '~/lib/catalog';
import { localeForRequest, translate } from '~/lib/i18n';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;
const isRental = product.pricing.mode === 'rental';
const locale = localeForRequest();
const text = (key: string) => translate(locale, key);

const includes = [
  text('pdp.includes.delivery'),
  text('pdp.includes.collection'),
  text('pdp.includes.assembly'),
  text('pdp.includes.phone'),
];

const hygiene = [
  text('pdp.hygiene.sanitised'),
  text('pdp.hygiene.checked'),
  text('pdp.hygiene.accessories'),
];

type TabKey = 'description' | 'faq' | 'delivery' | 'terms';

const tabs: { key: TabKey; title: string }[] = [
  ...(product.description
    ? [{ key: 'description' as const, title: text('pdp.tab.description') }]
    : []),
  ...(product.faqs.length > 0 ? [{ key: 'faq' as const, title: text('pdp.tab.faq') }] : []),
  { key: 'delivery' as const, title: text('pdp.tab.delivery') },
  ...(product.terms.length > 0 ? [{ key: 'terms' as const, title: text('pdp.tab.terms') }] : []),
];

/**
 * `description` is rich text — the back office writes it in a Tiptap editor and
 * the server sanitises it against an allowlist on write (h2–h6, strong/em/u/s,
 * lists, blockquote, hr, links; no images, no `style`, no `class`), so `set:html`
 * below renders markup this system produced, never a raw request body. The
 * `.pdp-prose` block at the foot of this file is the only styling it gets: the
 * HTML carries no classes of its own, by design.
 */

const checkRow = 'flex items-center gap-3 text-[14.5px]';
const inputClasses = [
  'peer/tab0 sr-only',
  'peer/tab1 sr-only',
  'peer/tab2 sr-only',
  'peer/tab3 sr-only',
];
const tabbarStateClass =
  'peer-checked/tab0:[&_.pdp-tab-label-0]:text-accent peer-checked/tab0:[&_.pdp-tab-label-0]:shadow-[inset_0_-2px_0_var(--color-accent)] ' +
  'peer-checked/tab1:[&_.pdp-tab-label-1]:text-accent peer-checked/tab1:[&_.pdp-tab-label-1]:shadow-[inset_0_-2px_0_var(--color-accent)] ' +
  'peer-checked/tab2:[&_.pdp-tab-label-2]:text-accent peer-checked/tab2:[&_.pdp-tab-label-2]:shadow-[inset_0_-2px_0_var(--color-accent)] ' +
  'peer-checked/tab3:[&_.pdp-tab-label-3]:text-accent peer-checked/tab3:[&_.pdp-tab-label-3]:shadow-[inset_0_-2px_0_var(--color-accent)] ' +
  'peer-focus-visible/tab0:[&_.pdp-tab-label-0]:outline-3 peer-focus-visible/tab0:[&_.pdp-tab-label-0]:-outline-offset-3 peer-focus-visible/tab0:[&_.pdp-tab-label-0]:outline-white peer-focus-visible/tab0:[&_.pdp-tab-label-0]:shadow-[inset_0_-2px_0_var(--color-accent),0_0_0_3px_var(--color-ink)] ' +
  'peer-focus-visible/tab1:[&_.pdp-tab-label-1]:outline-3 peer-focus-visible/tab1:[&_.pdp-tab-label-1]:-outline-offset-3 peer-focus-visible/tab1:[&_.pdp-tab-label-1]:outline-white peer-focus-visible/tab1:[&_.pdp-tab-label-1]:shadow-[inset_0_-2px_0_var(--color-accent),0_0_0_3px_var(--color-ink)] ' +
  'peer-focus-visible/tab2:[&_.pdp-tab-label-2]:outline-3 peer-focus-visible/tab2:[&_.pdp-tab-label-2]:-outline-offset-3 peer-focus-visible/tab2:[&_.pdp-tab-label-2]:outline-white peer-focus-visible/tab2:[&_.pdp-tab-label-2]:shadow-[inset_0_-2px_0_var(--color-accent),0_0_0_3px_var(--color-ink)] ' +
  'peer-focus-visible/tab3:[&_.pdp-tab-label-3]:outline-3 peer-focus-visible/tab3:[&_.pdp-tab-label-3]:-outline-offset-3 peer-focus-visible/tab3:[&_.pdp-tab-label-3]:outline-white peer-focus-visible/tab3:[&_.pdp-tab-label-3]:shadow-[inset_0_-2px_0_var(--color-accent),0_0_0_3px_var(--color-ink)]';
const panelStateClass =
  'peer-checked/tab0:[&_.pdp-panel-0]:block peer-checked/tab1:[&_.pdp-panel-1]:block ' +
  'peer-checked/tab2:[&_.pdp-panel-2]:block peer-checked/tab3:[&_.pdp-panel-3]:block';

const proseClass =
  'max-w-180 [&>*+*]:mt-[0.85em] [&>:first-child]:mt-0 [&_h2]:mt-[1.5em] ' +
  '[&_h2]:text-[19px] [&_h3]:mt-[1.5em] [&_h3]:text-[17px] [&_h4]:mt-[1.5em] ' +
  '[&_h4]:text-[15px] [&_h5]:mt-[1.5em] [&_h5]:text-[15px] [&_h6]:mt-[1.5em] ' +
  '[&_h6]:text-[15px] [&_h2]:leading-tight [&_h3]:leading-tight [&_h4]:leading-tight ' +
  '[&_h5]:leading-tight [&_h6]:leading-tight [&_h2]:font-bold [&_h3]:font-bold [&_h4]:font-bold ' +
  '[&_h5]:font-bold [&_h6]:font-bold [&_h2]:text-ink [&_h3]:text-ink [&_h4]:text-ink ' +
  '[&_h5]:text-ink [&_h6]:text-ink [&_p]:text-pretty [&_strong]:font-semibold [&_strong]:text-ink ' +
  '[&_ul]:list-disc [&_ol]:list-decimal [&_ul]:ps-[1.35em] [&_ol]:ps-[1.35em] ' +
  '[&_li+li]:mt-[0.35em] [&_li>ul]:mt-[0.35em] [&_li>ol]:mt-[0.35em] ' +
  '[&_blockquote]:border-s-2 [&_blockquote]:border-hair [&_blockquote]:ps-[1em] ' +
  '[&_hr]:my-[1.5em] [&_hr]:border-0 [&_hr]:border-t-[1.5px] [&_hr]:border-hair ' +
  '[&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2';
---

<section class="pdp-tabs">
  {
    tabs.map((tab, index) => (
      <input
        class={inputClasses[index]}
        type="radio"
        name="pdp-info-tab"
        id={`pdp-tab-${index}`}
        checked={index === 0}
        form="pdp-detached"
        aria-label={tab.title}
      />
    ))
  }

  <div class:list={['border-hair flex gap-1 overflow-x-auto border-b', tabbarStateClass]}>
    {
      tabs.map((tab, index) => (
        <label
          class={`pdp-tab-label-${index} text-ink-2 cursor-pointer px-4.5 py-3 text-[14.5px] font-semibold whitespace-nowrap hover:text-accent`}
          for={`pdp-tab-${index}`}
        >
          {tab.title}
        </label>
      ))
    }
  </div>

  <div class:list={['text-ink-2 pt-6 text-[15px]/[1.65]', panelStateClass]}>
    {
      tabs.map((tab, index) => (
        <div class={`pdp-panel-${index} hidden`}>
          {tab.key === 'description' && <div class={proseClass} set:html={product.description} />}

          {tab.key === 'faq' && (
            <div class="flex max-w-180 flex-col">
              {product.faqs.map((faq) => (
                <details class="border-hair group border-b">
                  <summary class="text-ink flex min-h-12 cursor-pointer list-none items-center justify-between gap-5 py-3.5 text-[15px] font-semibold [&::-webkit-details-marker]:hidden">
                    {faq.question}
                    <svg
                      class="size-4.5 flex-none transition-transform duration-200 group-open:rotate-180"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <p class="m-0 max-w-[68ch] pb-4 text-pretty">{faq.answer}</p>
                </details>
              ))}
            </div>
          )}

          {tab.key === 'delivery' && (
            <div class="grid max-w-180 gap-8 min-[560px]:grid-cols-2">
              <div>
                <h3 class="text-ink m-0 mb-3.5 text-[15.5px] font-bold">
                  {text(isRental ? 'pdp.includedRental' : 'pdp.includedSale')}
                </h3>
                <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
                  {includes.map((item) => (
                    <li class={checkRow}>
                      <svg
                        class="text-ok size-4.5 flex-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="text-ink m-0 mb-3.5 text-[15.5px] font-bold">
                  {text('pdp.hygieneHeading')}
                </h3>
                <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
                  {hygiene.map((item) => (
                    <li class={checkRow}>
                      <svg
                        class="text-ok size-4.5 flex-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}

          {tab.key === 'terms' && (
            <div class="flex max-w-180 flex-col gap-3">
              <p class="m-0">{text('pdp.termsIntro')}</p>
              <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
                {product.terms.map((terms) => (
                  <li>
                    <a
                      class="inline-flex min-h-10 items-center text-[14.5px] font-semibold text-accent"
                      href={`/${terms.slug}/`}
                    >
                      {terms.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>
