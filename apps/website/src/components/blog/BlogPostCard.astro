---
import { mediaUrl } from '~/lib/api';
import type { BlogPostSummary } from '~/lib/blog';
import { blogPostPath } from '~/lib/routes';

interface Props {
  post: BlogPostSummary;
  priority?: boolean;
  headingLevel?: 2 | 3;
}

const { post, priority = false, headingLevel = 3 } = Astro.props;

const href = blogPostPath(post.slug);
const Heading = `h${headingLevel}` as 'h2' | 'h3';

const publishedAt = post.publishedAt
  ? new Intl.DateTimeFormat('it-IT', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(new Date(post.publishedAt))
  : null;
---

<a
  class="group rounded-card border-hair font-card flex h-full w-full min-w-0 flex-col overflow-hidden border bg-white no-underline transition-[border-color,box-shadow,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-[3px] hover:border-[var(--hair-strong)] hover:shadow-[0_18px_40px_-26px_rgb(19_29_64/0.4)]"
  href={href}
>
  <span
    class="border-hair to-tint relative grid aspect-16/9 flex-none place-items-center overflow-hidden border-b bg-linear-to-b from-[#f7f9fd]"
  >
    {
      post.featuredImage ? (
        <img
          class="absolute inset-0 size-full object-cover transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]"
          src={mediaUrl(post.featuredImage)}
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding={priority ? 'sync' : 'async'}
        />
      ) : (
        <svg
          class="text-ink-decorative size-10"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2" />
          <path d="M18 14h-8M15 18h-5M10 6h8v4h-8V6Z" />
        </svg>
      )
    }
  </span>

  <span class="flex flex-1 flex-col px-5 pt-4 pb-5">
    {
      post.categories.length > 0 && (
        <span class="mb-2 flex flex-wrap gap-1.5">
          {post.categories.map((cat) => (
            <span class="text-[13px] font-semibold tracking-wide text-accent uppercase">
              {(cat.name as { it: string }).it}
            </span>
          ))}
        </span>
      )
    }

    <Heading
      class="font-card line-clamp-2 text-[18px]/[1.3] font-bold tracking-[-0.01em] text-wrap"
    >
      {post.title}
    </Heading>

    {
      post.excerpt && (
        <span class="text-ink-2 mt-2 line-clamp-3 text-[15px]/[1.6]">{post.excerpt}</span>
      )
    }

    <span class="mt-auto pt-3">
      {publishedAt && <span class="text-ink-2 text-[14px]">{publishedAt}</span>}
    </span>
  </span>
</a>
