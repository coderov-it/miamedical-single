---
/**
 * Presentation for a legal document. Resolution and 404 handling belong to the
 * route; this component only renders what it is handed.
 *
 * The body renders as escaped text with preserved line breaks, never as HTML: a
 * legal page is the last place to hand markup privileges to stored content.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import type { TermsDocument } from '~/lib/catalog';
import { localeForRequest, localeTag, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { CONTACT } from '~/lib/site';

interface Props {
  /** `null` when the document exists as a route but is not published yet. */
  document: TermsDocument | null;
  /** Heading to show while the document is unpublished. */
  fallbackTitle: string;
  description: string;
}

const { document, fallbackTitle, description } = Astro.props;
const locale = localeForRequest();
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const title = document?.title ?? fallbackTitle;

const body = document
  ? document.body
      .replace(/<[^>]*>/g, ' ')
      .replace(/[ \t]+/g, ' ')
      .replace(/\n{3,}/g, '\n\n')
      .trim()
  : '';

const effectiveDate = document?.publishedAt
  ? new Intl.DateTimeFormat(localeTag(locale), { dateStyle: 'long' }).format(
      new Date(document.publishedAt),
    )
  : null;
---

<BaseLayout title={`${title} | Mia Medical Italia`} {description}>
  <div class="max-w-page pb-section-sm mid:px-8 mid:pb-section mx-auto w-full px-5">
    <Breadcrumbs
      items={[{ label: text('home'), href: routePath(locale, 'home') }, { label: title }]}
    />

    <article class="max-w-[78ch]">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">{title}</h1>

      {
        document ? (
          <Fragment>
            <p class="text-ui text-ink-2 mt-3 mb-6">
              {text('legal.version', { version: document.version })}
              {effectiveDate && text('legal.effective', { date: effectiveDate })}
            </p>
            <div class="whitespace-pre-line">{body}</div>
          </Fragment>
        ) : (
          <div class="rounded-card border-hair bg-tint mid:p-8 mt-6 grid justify-items-start gap-4 border p-6">
            <p>{text('legal.unpublished')}</p>
            <p class="text-ui text-ink-2">{CONTACT.hours[locale]}</p>
            <PhoneCta variant="primary" />
            <p>
              {text('legal.orWriteTo')}{' '}
              <a class="text-accent underline" href={`mailto:${CONTACT.email}`}>
                {CONTACT.email}
              </a>
              .
            </p>
          </div>
        )
      }
    </article>
  </div>
</BaseLayout>
