---
/**
 * "You have to answer this one."
 *
 * It exists because REQUIRED IS NOT THE DEFAULT on a product page: most of what
 * the buy box asks is optional, the delivery section says so in its own hint, and
 * the back office decides per question which few are not. Without a mark, the
 * only way to discover a required field is to be stopped by it — which is the
 * failure the form gate was built to end, not one to leave in place.
 *
 * An asterisk carries it visually because that is the convention every Italian
 * form already uses, and the word rides along `sr-only` because an asterisk on
 * its own announces as "asterisk" or as nothing at all.
 *
 * `--color-danger` is deliberately NOT used. Nothing is wrong yet; this is the
 * shape of the question, not a complaint about the answer. Danger belongs to
 * the field-error treatment, and spending it here would leave a page pre-painted with
 * errors nobody has made.
 */
import { localeForRequest, translate } from '~/lib/i18n';

interface Props {
  /** Rendered only when true, so callers can pass the flag straight through. */
  on?: boolean;
}

const { on = false } = Astro.props;
const locale = localeForRequest();
---

{
  on && (
    <>
      <span class="text-ink-2 ml-0.5 font-normal" aria-hidden="true">
        *
      </span>
      <span class="sr-only">{translate(locale, 'field.required')}</span>
    </>
  )
}
