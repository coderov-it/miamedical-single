---
/**
 * Standard page section wrapper. Zero JavaScript.
 *
 * Enforces the design's vertical rhythm and, more importantly, guarantees every
 * section is a landmark with an accessible name. A heading passed here is always
 * rendered as a real `<h2>`, so heading order stays correct and screen reader
 * users can navigate by section.
 */
interface Props {
  /** Section heading. Rendered as `<h2>`. */
  heading?: string;
  /** Supporting line under the heading. */
  lede?: string;
  /** Anchor id, e.g. "come-funziona". */
  id?: string;
  /** Tinted background panel. */
  tint?: boolean;
  /** Let the content span the full viewport instead of the container. */
  wide?: boolean;
  class?: string;
}

const { heading, lede, id, tint = false, wide = false, class: className = '' } = Astro.props;

const headingId = id ? `${id}-title` : undefined;
const hasAside = Astro.slots.has('aside');
---

<section id={id} class:list={['sec', tint && 'sec--tint', className]} aria-labelledby={headingId}>
  <div class:list={['sec__inner', !wide && 'container']}>
    {
      (heading || hasAside) && (
        <div class="sec__head">
          <div>
            {heading && (
              <h2 id={headingId} class="sec__title">
                {heading}
              </h2>
            )}
            {lede && <p class="sec__lede">{lede}</p>}
          </div>
          {hasAside && (
            <div class="sec__aside">
              <slot name="aside" />
            </div>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .sec {
    padding-block: var(--sp-13) 0;
  }

  .sec--tint {
    background: var(--c-surface-tint);
    padding-block: var(--sp-13);
    margin-block: var(--sp-13) 0;
  }

  .sec__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-6);
    margin-bottom: var(--sp-6);
  }

  .sec__title {
    font-size: var(--fs-h2);
  }

  .sec__lede {
    margin-top: var(--sp-2);
    color: var(--c-ink-secondary);
    max-width: 60ch;
  }

  .sec__aside {
    flex: none;
  }

  @media (max-width: 640px) {
    .sec {
      padding-block: var(--sp-8) 0;
    }
    .sec--tint {
      padding-block: var(--sp-8);
      margin-block: var(--sp-8) 0;
    }
    .sec__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-3);
    }
  }
</style>
