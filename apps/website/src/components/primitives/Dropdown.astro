---
/**
 * Reusable select with a server-rendered native control and an enhanced
 * listbox. The native `<select>` remains the form's source of truth, so the
 * submitted value and no-JavaScript path are identical on every instance.
 *
 * BELOW `mid` THE LISTBOX IS A MODAL, NOT A POPOVER (owner, 2026-08-31). The
 * catalogue's category list is 20-odd entries: anchored under a filter pill it
 * covered the pills it was narrowing, ran off the bottom of the screen, and its
 * rounded floating rows read as a pile rather than a list. So on a phone it
 * centres itself at 90vw over a dimmed page, takes its HEIGHT FROM ITS ITEMS
 * and scrolls only once they pass 72dvh.
 *
 * IT IS A LIST, NOT A STACK OF CHIPS (owner, 2026-08-31). The rows are
 * full-bleed white, separated by a hairline and nothing else, and the chosen
 * one is marked by accent ink and a tick rather than by a tinted band. The
 * desktop popover keeps its tint, because there the rows ARE floating chips in
 * a padded box and a fill is the only thing that could mark one.
 *
 * Above them sits a caption bar carrying the label and the close — grey ground,
 * 11px uppercase, so that the name of the list cannot be mistaken for a member
 * of it. It is phone-only chrome; on a desktop the trigger is still on screen
 * beside the popover and says the same thing.
 *
 * The three concerns are deliberately kept apart, because the previous version
 * had them tangled and grew a dead `data-mobile-fullscreen` attribute out of it:
 *
 *   shape        here, in `max-mid:` classes beside the desktop shape
 *   presentation `scripts/primitives/surface.ts` — anchored, or a locked sheet
 *   position     `scripts/primitives/floating.ts` — anchored only, nothing else
 */
import { localeForRequest, translate } from '~/lib/i18n';

export interface DropdownOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  options: readonly DropdownOption[];
  value?: string | undefined;
  placeholder?: string | undefined;
  /**
   * `compact` is the 48px control, for a row of 48px pills rather than a form.
   * `pill` is the catalogue filter row's control: a white fill on the page's
   * grey ground, shaped and sized exactly like the pills beside it.
   */
  variant?: 'default' | 'hero' | 'compact' | 'pill' | undefined;
  /**
   * Keep the label for assistive tech but take it off the screen. For a row
   * where the placeholder already names the control ("Tutte le categorie") and
   * a stacked label would knock the row out of alignment. Never a way to ship
   * an unlabelled select — the label is still rendered and still referenced.
   */
  hideLabel?: boolean | undefined;
  /**
   * Lands on the WRAPPER, which contains the listbox as well as the control, so
   * a descendant selector reaches every option too. Address the control itself:
   * `[&_[data-dropdown-trigger]]:…` for the enhanced button, `[&_select]:…` for
   * the native one. Anything that is true of the control at every width belongs
   * in a variant above rather than here.
   */
  class?: string | undefined;
  describedBy?: string | undefined;
}

const {
  id,
  name,
  label,
  options,
  value = '',
  placeholder,
  variant = 'default',
  hideLabel = false,
  class: className,
  describedBy,
} = Astro.props;

const locale = localeForRequest();
const closeLabel = translate(locale, 'picker.close');

const labelId = `${id}-label`;
const valueId = `${id}-value`;
const listboxId = `${id}-listbox`;
const selected = options.find((option) => option.value === value);
const displayValue = selected?.label ?? placeholder ?? options[0]?.label ?? '';
const isEmpty = selected === undefined && placeholder !== undefined;
const hasIcon = Astro.slots.has('icon');

/* `hero` renders no box of its own: the booking bar's grey segment is the
   consumer's wrapper, the label sits inside it and the control is transparent
   (owner's hero reference, 2026-08-31). The box states — hover, expanded —
   belong to that wrapper, which is why they live only in default/compact. */
const labelVariants = {
  default: 'mb-2.25 text-ui',
  compact: 'mb-1.5 text-[14px]',
  hero: 'mb-0.5 text-[0.6875rem] font-[650] tracking-[0.08em] text-[var(--color-ink-soft)] uppercase',
  pill: 'mb-1.5 text-[14px]',
} as const;
/* Each variant carries its own ink and weight: `pill` is accent-on-white and
   bold, the rest are the semibold ink the forms have always used. */
const controlVariants = {
  default:
    'min-h-14.5 px-3.5 border border-hair rounded-field bg-tint font-display text-body ' +
    'text-ink font-semibold hover:border-hair-strong ' +
    'focus-visible:shadow-[0_0_0_2px_#fff] aria-expanded:border-accent aria-expanded:bg-white',
  compact:
    'min-h-12 px-3.5 border border-hair rounded-field bg-tint font-display text-body ' +
    'text-ink font-semibold hover:border-hair-strong ' +
    'focus-visible:shadow-[0_0_0_2px_#fff] aria-expanded:border-accent aria-expanded:bg-white',
  hero:
    'min-h-7 px-0 border-0 rounded-none bg-transparent font-inherit text-[1rem] ' +
    'text-ink font-semibold hover:border-hair-strong',
  /* Shaped and sized like the catalogue pills beside it AT BOTH WIDTHS — 46px
     above `mid`, 44px below it, and `rounded-field` throughout. The size step
     used to be injected by the consumer as `[&_button]:…`, which also hit every
     option in the listbox; it is the control's own shape and lives here.

     The name outlived the shape: `pill` now means "the catalogue filter row's
     control", which stopped being a pill on 2026-08-31. */
  pill:
    'mid:min-h-11.5 max-mid:min-h-11 mid:px-4.75 max-mid:px-3.5 border-0 ' +
    'rounded-field bg-white font-display text-[0.9688rem] ' +
    'text-accent font-bold hover:bg-accent-tint aria-expanded:bg-accent-tint',
} as const;
const controlClass =
  `w-full min-w-0 leading-[1.2] ` +
  `focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ` +
  controlVariants[variant];
---

<div
  class:list={['core-dropdown group/dropdown relative min-w-0', className]}
  data-core-dropdown
  data-has-icon={hasIcon ? '' : undefined}
>
  {
    /* `core-dropdown-label` is the mount script's hook — it retargets the
      label to the enhanced trigger. Without it enhancement silently bails. */
  }
  <label
    class:list={[
      'core-dropdown-label font-display text-ink-2 block font-bold',
      labelVariants[variant],
      hideLabel && 'sr-only',
    ]}
    id={labelId}
    for={id}
  >
    {label}
  </label>

  <div class="relative">
    {
      hasIcon && (
        <span
          class="text-ink-2 pointer-events-none absolute top-1/2 left-3.5 z-1 grid size-4.5 -translate-y-1/2 place-items-center [&_img]:block [&_img]:size-4.5 [&_svg]:block [&_svg]:size-4.5"
          aria-hidden="true"
        >
          <slot name="icon" />
        </span>
      )
    }

    <select
      class:list={[controlClass, hasIcon && 'ps-11']}
      {id}
      {name}
      aria-labelledby={labelId}
      aria-describedby={describedBy}
      data-dropdown-native
    >
      {
        placeholder !== undefined && (
          <option value="" selected={value === ''} disabled hidden>
            {placeholder}
          </option>
        )
      }
      {
        options.map((option) => (
          <option value={option.value} selected={option.value === value}>
            {option.label}
          </option>
        ))
      }
    </select>

    <button
      class:list={[
        controlClass,
        'group/trigger flex items-center gap-2.5 text-left',
        hasIcon && 'ps-11',
      ]}
      id={`${id}-trigger`}
      type="button"
      hidden
      aria-expanded="false"
      aria-haspopup="listbox"
      aria-controls={listboxId}
      aria-labelledby={`${labelId} ${valueId}`}
      data-dropdown-trigger
    >
      {
        /* Placeholder paint rides `.is-empty`, which the mount script keeps in
          sync — a static conditional would style the VALUE as a placeholder
          forever after the first pick. */
      }
      <span
        class:list={[
          'min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap',
          '[&.is-empty]:text-ink-placeholder [&.is-empty]:font-normal',
          isEmpty && 'is-empty',
        ]}
        id={valueId}
        data-dropdown-value
        data-placeholder={placeholder}
      >
        {displayValue}
      </span>
      <svg
        class="text-ink-2 ms-auto size-3.75 flex-none transition-transform duration-160 ease-out group-aria-expanded/trigger:rotate-180 motion-reduce:transition-none"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m7 9.5 5 5 5-5"></path>
      </svg>
    </button>

    {
      /* Two shapes, one element. The phone half needs no inline coordinates —
        `surface.ts` stands the anchored positioning down below `mid` and clears
        what it wrote, so `top-1/2 left-1/2` is free to take over. `max-h` is a
        CAP, not a height: a four-option list is four options tall. */
    }
    <div
      class:list={[
        'rounded-field border-hair fixed top-0 left-0 z-60 border bg-white p-2 shadow-[0_18px_44px_rgb(11_18_32_/_0.16)]',
        'max-mid:top-1/2 max-mid:left-1/2 max-mid:z-100 max-mid:-translate-x-1/2 max-mid:-translate-y-1/2',
        /* `rounded-field`, not `rounded-card`: 18px on a 375px sheet whose
           rows are square reads as bulbous, and the corner eats into the
           first and last row (owner, 2026-08-31). 12px is the phone's shape
           step everywhere else on the storefront. */
        'max-mid:rounded-field max-mid:max-h-[72dvh] max-mid:w-[90vw] max-mid:max-w-none max-mid:overflow-y-auto max-mid:p-0',
      ]}
      id={listboxId}
      role="listbox"
      aria-labelledby={labelId}
      hidden
      data-dropdown-popover
    >
      {
        /* THE TITLE IS NOT AN ITEM, SO IT MUST NOT LOOK LIKE ONE (owner,
          2026-08-31). Two signals say so at once and neither is subtle: it sits
          on the grey ground while every row is white, and it takes the caption
          tier — 11px, uppercase, tracked, muted — rather than the row's 14px
          semibold ink. Sticky, so it also keeps naming the list once the rows
          start scrolling under it. */
      }
      <div
        class="border-hair bg-tint mid:hidden sticky top-0 z-1 flex items-center gap-2 border-b ps-4"
      >
        <span
          class="font-display text-ink-2 flex-1 text-[0.6875rem] font-[650] tracking-[0.08em] uppercase"
        >
          {label}
        </span>
        <button
          class="text-ink-2 hover:text-ink grid size-12 flex-none place-items-center rounded-none border-0 bg-transparent"
          type="button"
          aria-label={closeLabel}
          data-dropdown-dismiss
        >
          <svg
            class="size-4.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6 18 18M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      {
        options.map((option) => (
          <button
            class:list={[
              'group/option font-display text-ui text-ink hover:bg-tint focus-visible:bg-tint mid:aria-selected:bg-accent-tint flex min-h-12 w-full items-center gap-3 rounded-[10px] border-0 bg-transparent px-3.5 text-left leading-[1.3] font-semibold aria-selected:text-accent',
              /* Full-bleed rows ruled off from each other and NOTHING ELSE: the
                 separation is the hairline, so no fill has to buy it and no
                 padding has to buy it either. 48px stays — that is the project
                 target floor, not slack. */
              /* 44px, which is BELOW the site's 48px target floor and is the
                 one place that is true (owner, 2026-08-31). It survives the
                 reasoning behind that floor because the target is 450x44: only
                 the short side gives way, adjacent rows still cannot be
                 confused by an imprecise tap, and it is still nearly twice WCAG
                 2.5.8's 24px. The caption bar's close button keeps 48 — it is a
                 small icon target, which is exactly what the floor is for. */
              'max-mid:min-h-11 max-mid:border-hair max-mid:rounded-none max-mid:border-b max-mid:text-(length:--text-phone-body) max-mid:last:border-b-0',
              /* The two-paint ring stays — it just draws INSIDE the row. A
                 full-bleed row is exactly as wide as the scroll container,
                 so at the default +2px offset both paints fall outside it
                 and get clipped away on the left and right. */
              'max-mid:focus-visible:-outline-offset-2',
            ]}
            type="button"
            role="option"
            aria-selected={option.value === value}
            data-value={option.value}
          >
            <span class="min-w-0 flex-1">{option.label}</span>
            {/* The phone's entire selected marker, in place of the tinted band. */}
            <svg
              class="mid:hidden size-4.5 flex-none text-accent opacity-0 group-aria-selected/option:opacity-100"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m5 12.5 4.5 4.5L19 7" />
            </svg>
          </button>
        ))
      }
    </div>
  </div>

  {
    /* Derived from `aria-expanded`, which is already the single source of truth
      for open — no second flag for the script to keep in sync. It sits inside
      the dropdown so its paint lives beside the surface it dims, which is why
      `dropdown.ts` closes on it explicitly. */
  }
  <div
    class="max-mid:group-has-[[aria-expanded=true]]/dropdown:block fixed inset-0 z-90 hidden bg-[rgb(11_18_32_/_0.42)]"
    aria-hidden="true"
    data-dropdown-scrim
  >
  </div>
</div>

<script>
  import { mountDropdowns } from '~/scripts/primitives/dropdown';

  mountDropdowns();
</script>
