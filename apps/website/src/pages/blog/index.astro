---
import BlogPostCard from '~/components/blog/BlogPostCard.astro';
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { listBlogCategories, listBlogPosts, type BlogCategory } from '~/lib/blog';
import { safely } from '~/lib/catalog';
import { localeFromLocals, translate } from '~/lib/i18n';
import { blogPath, routePath } from '~/lib/routes';

export const prerender = false;

const PER_PAGE = 12;
const locale = localeFromLocals(Astro.locals);

const params = Astro.url.searchParams;
const categoria = params.get('categoria')?.trim() ?? '';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const [result, categories] = await Promise.all([
  safely(
    () =>
      listBlogPosts({
        page,
        perPage: PER_PAGE,
        ...(categoria ? { category: categoria } : {}),
      }),
    { data: [], meta: { page, perPage: PER_PAGE, total: 0, pageCount: 1 } },
    'listBlogPosts',
  ),
  safely(() => listBlogCategories(), [] as BlogCategory[], 'listBlogCategories'),
]);

const { data: posts, meta } = result;
const isFirstPage = meta.page <= 1;
const activeCategory = categories.find((cat) => cat.slug === categoria);
const activeCategoryName = activeCategory
  ? locale === 'en'
    ? ((activeCategory.name as { it: string; en?: string }).en ??
      (activeCategory.name as { it: string }).it)
    : (activeCategory.name as { it: string }).it
  : null;

const prevUrl = meta.page > 1 ? blogPath({ categoria, page: meta.page - 1 }, locale) : null;
const nextUrl =
  meta.page < meta.pageCount ? blogPath({ categoria, page: meta.page + 1 }, locale) : null;

const heading = activeCategoryName ?? 'Blog';
const title = isFirstPage
  ? `${heading} | Mia Medical Italia`
  : `${heading} — ${translate(locale, 'blog.pageTitle', { page: meta.page })} | Mia Medical Italia`;

const chipClass =
  'inline-flex min-h-12 items-center rounded-full px-4.5 font-display text-ui font-semibold no-underline';
---

<BaseLayout
  {title}
  description={translate(locale, 'blog.description')}
  canonical={new URL(routePath(locale, 'blog'), Astro.site ?? Astro.url.origin).href}
  noindex={!isFirstPage}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  <div class="max-w-page px-gutter pb-section-sm mid:pb-section mx-auto w-full">
    <Breadcrumbs
      items={[
        { label: translate(locale, 'home'), href: routePath(locale, 'home') },
        ...(activeCategoryName
          ? [{ label: 'Blog', href: routePath(locale, 'blog') }, { label: activeCategoryName }]
          : [{ label: 'Blog' }]),
      ]}
    />

    <header class="pt-2 pb-8">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">{heading}</h1>
      <p class="text-lead text-ink-2 mt-3 max-w-[56ch]">
        {translate(locale, 'blog.intro')}
      </p>
      {
        meta.total > 0 && (
          <p class="font-display text-ui text-ink-2 mt-3.5 font-semibold">
            {`${meta.total} ${translate(locale, meta.total === 1 ? 'blog.article.one' : 'blog.article.many')}`}
            {meta.pageCount > 1 && (
              <span>{` · ${translate(locale, 'blog.page', { page: meta.page, total: meta.pageCount })}`}</span>
            )}
          </p>
        )
      }
    </header>

    {
      categories.length > 0 && (
        <section class="pb-10" aria-labelledby="browse-categories">
          <h2 id="browse-categories" class="sr-only">
            {translate(locale, 'blog.categories')}
          </h2>
          <ul class="flex flex-wrap gap-2">
            <li>
              <a
                class:list={[
                  chipClass,
                  !categoria ? 'bg-accent-tint text-accent' : 'bg-tint text-ink hover:bg-tint-2',
                ]}
                href={blogPath({}, locale)}
                aria-current={!categoria ? 'true' : undefined}
              >
                {translate(locale, 'blog.all')}
              </a>
            </li>
            {categories.map((cat) => (
              <li>
                <a
                  class:list={[
                    chipClass,
                    cat.slug === categoria
                      ? 'bg-accent-tint text-accent'
                      : 'bg-tint text-ink hover:bg-tint-2',
                  ]}
                  href={blogPath({ categoria: cat.slug }, locale)}
                  aria-current={cat.slug === categoria ? 'true' : undefined}
                >
                  {locale === 'en'
                    ? ((cat.name as { it: string; en?: string }).en ??
                      (cat.name as { it: string }).it)
                    : (cat.name as { it: string }).it}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="posts-title">
      <h2 id="posts-title" class="sr-only">{translate(locale, 'blog.posts')}</h2>

      {
        posts.length === 0 ? (
          <div class="rounded-card bg-tint mid:p-8 grid justify-items-start gap-4 p-6">
            <p class="font-display text-h4 font-semibold">
              {translate(locale, 'blog.empty.title')}
            </p>
            <p>{translate(locale, 'blog.empty.detail')}</p>
          </div>
        ) : (
          <ul class="card-grid">
            {posts.map((post, index) => (
              <li class="flex">
                <BlogPostCard {post} priority={isFirstPage && index === 0} headingLevel={3} />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      meta.pageCount > 1 && (
        <nav
          class="border-hair mt-10 flex flex-wrap items-center justify-between gap-4 border-t pt-6"
          aria-label="Pagine del blog"
        >
          {prevUrl ? (
            <a
              class="font-display text-ui-strong bg-tint text-ink hover:bg-tint-2 inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full px-7 font-semibold no-underline"
              href={prevUrl}
              rel="prev"
            >
              {translate(locale, 'blog.previous')}
            </a>
          ) : (
            <span
              class="font-display text-ui-strong bg-tint text-ink-2 hover:bg-tint-2 inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full px-7 font-semibold no-underline opacity-60"
              aria-hidden="true"
            >
              {translate(locale, 'blog.previous')}
            </span>
          )}

          <p class="font-display text-ui text-ink-2 font-semibold">
            {translate(locale, 'blog.page', { page: meta.page, total: meta.pageCount })}
          </p>

          {nextUrl ? (
            <a
              class="font-display text-ui-strong bg-tint text-ink hover:bg-tint-2 inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full px-7 font-semibold no-underline"
              href={nextUrl}
              rel="next"
            >
              {translate(locale, 'blog.next')}
            </a>
          ) : (
            <span
              class="font-display text-ui-strong bg-tint text-ink-2 hover:bg-tint-2 inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full px-7 font-semibold no-underline opacity-60"
              aria-hidden="true"
            >
              {translate(locale, 'blog.next')}
            </span>
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
