---
import BlogPostCard from '~/components/blog/BlogPostCard.astro';
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { listBlogCategories, listBlogPosts, type BlogCategory } from '~/lib/blog';
import { safely } from '~/lib/catalog';
import { blogPath, routes } from '~/lib/routes';

export const prerender = false;

const PER_PAGE = 12;

const params = Astro.url.searchParams;
const categoria = params.get('categoria')?.trim() ?? '';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const [result, categories] = await Promise.all([
  safely(
    () =>
      listBlogPosts({
        page,
        perPage: PER_PAGE,
        ...(categoria ? { category: categoria } : {}),
      }),
    { data: [], meta: { page, perPage: PER_PAGE, total: 0, pageCount: 1 } },
    'listBlogPosts',
  ),
  safely(() => listBlogCategories(), [] as BlogCategory[], 'listBlogCategories'),
]);

const { data: posts, meta } = result;
const isFirstPage = meta.page <= 1;
const activeCategory = categories.find(
  (cat) => cat.slug === categoria,
);
const activeCategoryName = activeCategory
  ? (activeCategory.name as { it: string }).it
  : null;

const prevUrl = meta.page > 1 ? blogPath({ categoria, page: meta.page - 1 }) : null;
const nextUrl =
  meta.page < meta.pageCount ? blogPath({ categoria, page: meta.page + 1 }) : null;

const heading = activeCategoryName ?? 'Blog';
const title = isFirstPage
  ? `${heading} | Mia Medical Italia`
  : `${heading} — pagina ${meta.page} | Mia Medical Italia`;

const chipClass =
  'inline-flex min-h-12 items-center rounded-full border px-4.5 font-display text-ui font-semibold no-underline';
---

<BaseLayout
  {title}
  description="Approfondimenti, consigli e novità dal mondo degli ausili medici. Leggi il blog di Mia Medical Italia."
  canonical={new URL(routes.blog, Astro.site ?? Astro.url.origin).href}
  noindex={!isFirstPage}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  <div class="max-w-page pb-section-sm mid:px-8 mid:pb-section mx-auto w-full px-5">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        ...(activeCategoryName
          ? [{ label: 'Blog', href: routes.blog }, { label: activeCategoryName }]
          : [{ label: 'Blog' }]),
      ]}
    />

    <header class="pt-2 pb-8">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">{heading}</h1>
      <p class="text-lead text-ink-2 mt-3 max-w-[56ch]">
        Approfondimenti, consigli e novità dal mondo degli ausili medici.
      </p>
      {
        meta.total > 0 && (
          <p class="font-display text-ui text-ink-2 mt-3.5 font-semibold">
            {`${meta.total} ${meta.total === 1 ? 'articolo' : 'articoli'}`}
            {meta.pageCount > 1 && (
              <span>{` · pagina ${meta.page} di ${meta.pageCount}`}</span>
            )}
          </p>
        )
      }
    </header>

    {
      categories.length > 0 && (
        <section class="pb-10" aria-labelledby="browse-categories">
          <h2 id="browse-categories" class="sr-only">
            Categorie
          </h2>
          <ul class="flex flex-wrap gap-2">
            <li>
              <a
                class:list={[
                  chipClass,
                  !categoria
                    ? 'bg-tint border-accent text-accent'
                    : 'border-hair-strong text-ink hover:bg-tint bg-white',
                ]}
                href={blogPath()}
                aria-current={!categoria ? 'true' : undefined}
              >
                Tutti
              </a>
            </li>
            {categories.map((cat) => (
              <li>
                <a
                  class:list={[
                    chipClass,
                    cat.slug === categoria
                      ? 'bg-tint border-accent text-accent'
                      : 'border-hair-strong text-ink hover:bg-tint bg-white',
                  ]}
                  href={blogPath({ categoria: cat.slug })}
                  aria-current={cat.slug === categoria ? 'true' : undefined}
                >
                  {(cat.name as { it: string }).it}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="posts-title">
      <h2 id="posts-title" class="sr-only">Articoli</h2>

      {
        posts.length === 0 ? (
          <div class="rounded-card border-hair bg-tint mid:p-8 grid justify-items-start gap-4 border p-6">
            <p class="font-display text-h4 font-semibold">Nessun articolo trovato.</p>
            <p>Non ci sono ancora articoli in questa sezione. Torna presto!</p>
          </div>
        ) : (
          <ul class="wide:grid-cols-3 grid gap-6 sm:grid-cols-2">
            {posts.map((post, index) => (
              <li class="flex">
                <BlogPostCard
                  {post}
                  priority={isFirstPage && index === 0}
                  headingLevel={3}
                />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      meta.pageCount > 1 && (
        <nav
          class="border-hair mt-10 flex flex-wrap items-center justify-between gap-4 border-t pt-6"
          aria-label="Pagine del blog"
        >
          {prevUrl ? (
            <a class="btn btn-soft" href={prevUrl} rel="prev">
              ← Pagina precedente
            </a>
          ) : (
            <span class="btn btn-soft text-ink-2 opacity-60" aria-hidden="true">
              ← Pagina precedente
            </span>
          )}

          <p class="font-display text-ui text-ink-2 font-semibold">
            Pagina {meta.page} di {meta.pageCount}
          </p>

          {nextUrl ? (
            <a class="btn btn-soft" href={nextUrl} rel="next">
              Pagina successiva →
            </a>
          ) : (
            <span class="btn btn-soft text-ink-2 opacity-60" aria-hidden="true">
              Pagina successiva →
            </span>
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
