---
/**
 * Storefront home page, in the 2026-08 editorial design — ported 1:1 from the
 * approved blueprint at docs/blueprint/home.html. Section order is the
 * blueprint's: hero (copy, product showcase, booking card, trust strip) →
 * categories → trending → how → delivery → testimonials → faq. The only framework-free JavaScript on the page is the
 * two Embla carousels, the booking date floor and the header's cart badge.
 *
 * The page coordinates data and SEO; every visual section is a focused
 * component.
 *
 * Rendered on demand, not prerendered: the hero and the trending rail are live
 * catalogue state — a product added, retired or gone out of stock has to show
 * without a deploy, and a build must not need the API to be up. The cost is a
 * ~4 ms render, and `cached()` keeps the API out of the common path; the layers
 * and their numbers are in docs/code/storefront-caching.md.
 *
 * Reads still go through `safely()` as the last line: a cold cache plus an API
 * that is down means sections with no data, and those hide themselves rather
 * than break the page.
 */
import HomeCategoryGrid from '~/components/home/HomeCategoryGrid.astro';
import HomeDelivery from '~/components/home/HomeDelivery.astro';
import HomeFaq from '~/components/home/HomeFaq.astro';
import HomeHero from '~/components/home/HomeHero.astro';
import HomeHowItWorks from '~/components/home/HomeHowItWorks.astro';
import HomeProductRail from '~/components/home/HomeProductRail.astro';
import HomeReviews from '~/components/home/HomeReviews.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { cached, CATALOG_POLICY } from '~/lib/cache';
import { listAllProducts, listCategories, safely } from '~/lib/catalog';
import { buildHomeCategories, HOME_FAQ, selectHomeFeatured } from '~/lib/home-content';
import { cacheHtml } from '~/lib/http-cache';

export const prerender = false;

// The same HTML for every visitor — no cookie is read here, and the cart badge
// and account link are filled in by the browser.
cacheHtml(Astro.response.headers);

const [products, categories] = await Promise.all([
  safely(
    () => cached('catalog:products', listAllProducts, CATALOG_POLICY),
    { items: [], total: 0 },
    'listAllProducts',
  ),
  safely(() => cached('catalog:categories', listCategories, CATALOG_POLICY), [], 'listCategories'),
]);

const spotlight = selectHomeFeatured(products.items, 3);
/* The carousel's cards have no out-of-stock state by design — a dead card in a
   promotional rail sells nothing — so the selection considers stock. */
const trending = selectHomeFeatured(
  products.items.filter((product) => product.inStock),
  8,
);
const categoryCards = buildHomeCategories(categories, products.items);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: HOME_FAQ.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title="Noleggio carrozzine e ausili medicali a domicilio | Roma e Firenze — Mia Medical Italia"
  description="Noleggio carrozzine, letti ortopedici e ausili medicali con consegna a domicilio a Roma e Firenze in 24–48 ore. Prodotti sanificati e certificati, assistenza telefonica gratuita."
  jsonLd={jsonLd}
>
  <HomeHero products={spotlight} />
  <HomeCategoryGrid categories={categoryCards} />
  <HomeProductRail products={trending} total={products.total} />
  <HomeHowItWorks />
  <HomeDelivery />
  <HomeReviews />
  <HomeFaq />
</BaseLayout>
