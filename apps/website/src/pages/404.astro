---
import PhoneCta from '~/components/global/PhoneCta.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localeFromLocals, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { CONTACT } from '~/lib/site';

/**
 * On demand, not prerendered. Astro forbids rewriting from an on-demand route
 * to a prerendered one, and the product and legal routes both `rewrite('/404')`
 * when a slug does not resolve. The page reads nothing, so rendering it per
 * request costs nothing worth measuring.
 */
export const prerender = false;
const locale = localeFromLocals(Astro.locals);
---

<BaseLayout
  title={translate(locale, 'notFound.title')}
  description={translate(locale, 'notFound.description')}
  noindex
>
  <div class="max-w-page px-gutter py-section-sm mid:py-section mx-auto w-full">
    <div class="max-w-[62ch]">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">
        {translate(locale, 'notFound.heading')}
      </h1>
      <p class="text-lead text-ink-2 mt-4">
        {translate(locale, 'notFound.detail')}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="font-display text-ui-strong hover:bg-accent-deep inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full bg-accent px-7 font-semibold text-white no-underline"
          href={routePath(locale, 'catalog')}
        >
          {translate(locale, 'notFound.catalog')}
        </a>
        <PhoneCta variant="soft" />
      </div>

      <p class="text-ui text-ink-2 mt-5">{CONTACT.hours[locale]}</p>
    </div>
  </div>
</BaseLayout>
