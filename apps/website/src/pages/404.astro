---
import PhoneCta from '~/components/global/PhoneCta.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { routes } from '~/lib/routes';
import { CONTACT } from '~/lib/site';

/**
 * On demand, not prerendered. Astro forbids rewriting from an on-demand route
 * to a prerendered one, and the product and legal routes both `rewrite('/404')`
 * when a slug does not resolve. The page reads nothing, so rendering it per
 * request costs nothing worth measuring.
 */
export const prerender = false;
---

<BaseLayout
  title="Pagina non trovata | Mia Medical Italia"
  description="La pagina che cercavi non esiste più. Sfoglia il catalogo o chiamaci: ti aiutiamo noi."
  noindex
>
  <div class="max-w-page py-section-sm mid:px-8 mid:py-section mx-auto w-full px-5">
    <div class="max-w-[62ch]">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">Questa pagina non c'è più</h1>
      <p class="text-lead text-ink-2 mt-4">
        Forse il prodotto è stato spostato o l'indirizzo è stato digitato male. Puoi ripartire dal
        catalogo, oppure chiamarci: ti diciamo subito dove trovare quello che cerchi.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={routes.catalog}>Vai al catalogo</a>
        <PhoneCta variant="soft" />
      </div>

      <p class="text-ui text-ink-2 mt-5">{CONTACT.hours.it}</p>
    </div>
  </div>
</BaseLayout>
