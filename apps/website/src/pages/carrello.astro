---
/**
 * `/carrello/` — the cart, from the owner's reference design.
 *
 * Spec: the Claude Design file "Cart.dc.html", same project as the product detail
 * page and the checkout, and released from Variante B the same way they are.
 * Layout, deviations and the no-JavaScript path: docs/code/storefront-cart.md
 *
 * This page is a SHELL. It renders the chrome and the first paint; the island
 * under `components/cart/` owns everything after that, because the cart lives in
 * `localStorage` and the server cannot know what is in it.
 *
 * The first paint is not a placeholder, though. Whatever the URL carries is
 * resolved and rendered server-side, which is the whole no-JavaScript path: with
 * scripting off, "Aggiungi alla richiesta" on a product page degrades to a plain
 * GET of its form to here, and this page shows that one configured product,
 * priced, with a working way on to the checkout — which is exactly what the page
 * did before it became a cart at all.
 */
import CartContainer from '~/components/cart/CartContainer.svelte';
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { cartCopy, cartLinesFromParams, resolveCart } from '~/lib/cart';
import { t } from '~/lib/labels';
import { routes } from '~/lib/routes';
import { CONTACT } from '~/lib/site';

export const prerender = false;

// Never cache a page built from someone's request details.
Astro.response.headers.set('cache-control', 'no-store, max-age=0');

/*
 * Read the URL, not a store: the server has no access to one. `cartLinesFromParams`
 * accepts the product page's un-prefixed single-item form AND a full `item.<n>.`
 * set, so a hand-off and a re-post read identically.
 */
const urlLines = cartLinesFromParams(Astro.url.searchParams);
const initial = await resolveCart(urlLines);

const copy = cartCopy();
---

<BaseLayout title={t('cartMetaTitle')} description={t('cartMetaDescription')} noindex>
  {
    /*
      The island's first paint is a loading plate, because only the browser can read
      the cart out of `localStorage`. With scripting off that plate can never
      resolve, so it is hidden and the <noscript> block below speaks instead. A
      stylesheet cannot ask whether JavaScript runs; a <noscript> in the head can,
      and this is the one thing it is for.
    */
  }
  <noscript slot="head"><style is:inline>[data-cart-boot] { display: none }</style></noscript>
  <div
    class="cart mid:px-8 mid:pb-24 mx-auto w-full max-w-310 px-5 pb-[calc(var(--spacing-mobile-nav)+1.25rem)]"
  >
    <Breadcrumbs items={[{ label: t('home'), href: routes.home }, { label: t('cart') }]} />

    {
      /*
        `client:load` rather than `client:visible`: the island is the page. Waiting
        for an intersection would leave a customer looking at a server-rendered
        empty cart while their actual cart sat unread in `localStorage`.
      */
    }
    <CartContainer
      client:load
      {initial}
      {urlLines}
      {copy}
      checkoutPath={routes.checkout}
      catalogPath={routes.catalog}
    />

    {
      /*
        One helper line, not a card with a call button.

        Still outside the island on purpose: a phone call is a successful conversion
        here, not a fallback for a cart that failed, so the number is server-rendered
        and present whether or not the island ever mounts. But it is a HYPERLINK in a
        sentence rather than a second pill — the page already closes on a primary
        action ("Vai alla conferma"), and a same-weight phone button beside it made
        two competing CTAs out of one page.

        `showFree={false}` because "gratuito" is in the sentence: the qualifier is
        not dropped, only moved out of the link so the link is just the number.
      */
    }
    {
      /* Centred under the cart, not ranged left against it: the closing line of the
         page rather than a footnote to the last row (owner, 2026-08-20). */
    }
    <p class="border-hair text-ink-2 mt-12 border-t pt-7 text-center text-[16px] leading-[1.55]">
      <strong class="text-ink font-semibold">{t('cartHelpTitle')}</strong>
      {' '}{t('cartHelpDetail')}{' '}
      <PhoneCta variant="inline" showFree={false} />
      {' '}<span class="whitespace-nowrap">· {CONTACT.hours.it}</span>
    </p>

    {
      /*
        Scripting off, and nothing in the URL to render: the island is showing a
        plate that will never resolve (hidden by the head style above), so say why.
        Not rendered on the hand-off path — there the server HAS the line, the page
        works without a single byte of JavaScript, and this would contradict it.
      */
    }
    {
      urlLines.length === 0 && (
        <noscript>
          <p class="border-hair text-ink-2 rounded-card border bg-white p-6 text-center text-[16px]">
            {t('cartNoScript')}
          </p>
        </noscript>
      )
    }
  </div>
</BaseLayout>
