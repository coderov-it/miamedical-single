---
/**
 * Assistance. Prerendered — the fastest page we can serve to someone who needs
 * help right now.
 *
 * A phone call is a successful conversion for this audience, so the page leads
 * with the channels and keeps its own operational FAQ rather than sending
 * people back to hunt for answers.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import SectionHeading from '~/components/primitives/SectionHeading.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { supportFaq } from '~/lib/home-content';
import { localeFromLocals, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';
import { CONTACT, LOCATIONS, whatsappUrl } from '~/lib/site';

const locale = localeFromLocals(Astro.locals);
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);
const faq = supportFaq(locale);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={text('support.metaTitle')}
  description={text('support.metaDescription')}
  {jsonLd}
>
  <div class="max-w-page px-gutter pb-section-sm mid:pb-section mx-auto w-full">
    <Breadcrumbs
      items={[
        { label: text('home'), href: routePath(locale, 'home') },
        { label: text('support.launcher.label') },
      ]}
    />

    <header class="pt-2 pb-10">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">{text('support.title')}</h1>
      <p class="text-lead text-ink-2 mt-3 max-w-[60ch]">
        {text('support.lede', { hours: CONTACT.hours[locale] })}
      </p>
    </header>

    <ul class="card-grid [--card-gap:18px] [--card-min:240px]">
      <li class="rounded-card bg-tint flex flex-col items-start gap-3.5 p-5.5">
        <h2 class="text-lead">{text('support.freephone')}</h2>
        <p class="text-ui text-ink-2 flex-1">{text('support.freephoneDetail')}</p>
        <PhoneCta variant="primary" srHint={text('support.phoneHint')} />
      </li>

      <li class="rounded-card border-hair flex flex-col items-start gap-3.5 border bg-white p-5.5">
        <h2 class="text-lead">WhatsApp</h2>
        <p class="text-ui text-ink-2 flex-1">{text('support.whatsappDetail')}</p>
        <a
          class="font-display text-ui-strong bg-tint text-ink hover:bg-tint-2 inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full px-7 font-semibold no-underline"
          href={whatsappUrl()}
          target="_blank"
          rel="noopener"
        >
          {CONTACT.whatsappDisplay}
        </a>
      </li>

      <li class="rounded-card border-hair flex flex-col items-start gap-3.5 border bg-white p-5.5">
        <h2 class="text-lead">{text('email')}</h2>
        <p class="text-ui text-ink-2 flex-1">{text('support.emailDetail')}</p>
        <a
          class="font-display text-ui-strong bg-tint text-ink hover:bg-tint-2 inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full px-7 font-semibold no-underline"
          href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a
        >
      </li>
    </ul>

    <section class="pt-section-sm mid:pt-section" aria-labelledby="support-locations-title">
      <SectionHeading id="support-locations" heading={text('support.locations')} />

      <div class="rounded-card bg-tint overflow-hidden">
        <ul class="mid:grid-cols-2 grid">
          {
            LOCATIONS.map((location, index) => (
              <li
                class:list={[
                  'mid:px-7 px-5 py-5.5',
                  index > 0 &&
                    'mid:shadow-[inset_1px_0_0_var(--color-hair-strong)] shadow-[inset_0_1px_0_var(--color-hair-strong)]',
                ]}
              >
                <h3 class="text-lead">{location.city}</h3>
                <p class="text-ui text-ink-2 mt-1.75">{location.street}</p>
              </li>
            ))
          }
        </ul>
        <p class="border-hair text-ui text-ink-2 mid:px-7 border-t bg-white px-5 py-4.5">
          {text('support.deliveryBefore')}{' '}
          <a class="text-accent" href={`tel:${CONTACT.phoneE164}`}>{text('support.callUs')}</a>
          {text('support.deliveryAfter')}
        </p>
      </div>
    </section>

    <section class="pt-section-sm mid:pt-section" aria-labelledby="support-faq-title">
      <SectionHeading id="support-faq" heading={text('support.launcher.page')} />

      <ul class="grid gap-2.5">
        {
          faq.map((item, index) => (
            <li>
              <details
                class="group rounded-field border-hair bg-tint mid:px-6 border px-4"
                open={index === 0}
              >
                <summary class="font-display text-h4 flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3.5 font-semibold [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <svg
                    class="text-ink-2 size-5.5 flex-none transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="text-ui-strong text-ink-2 max-w-[68ch] pb-5.5">{item.answer}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="pt-section-sm mid:pt-section" aria-labelledby="support-cta-title">
      <SectionHeading
        id="support-cta"
        heading={text('support.ctaHeading')}
        lede={text('support.ctaLede')}
      />
      <a
        class="font-display text-ui-strong hover:bg-accent-deep inline-flex min-h-14 cursor-pointer items-center justify-center gap-2.5 rounded-full bg-accent px-7 font-semibold text-white no-underline"
        href={routePath(locale, 'catalog')}>{text('goToCatalog')}</a
      >
    </section>
  </div>
</BaseLayout>
