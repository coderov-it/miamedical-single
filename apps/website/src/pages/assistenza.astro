---
/**
 * Assistance. Prerendered — the fastest page we can serve to someone who needs
 * help right now.
 *
 * A phone call is a successful conversion for this audience, so the page leads
 * with the channels and repeats the home FAQ rather than sending people back to
 * hunt for it.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import SectionHeading from '~/components/primitives/SectionHeading.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { HOME_FAQ } from '~/lib/home-content';
import { routes } from '~/lib/routes';
import { CONTACT, LOCATIONS, whatsappUrl } from '~/lib/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: HOME_FAQ.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title="Assistenza e contatti | Mia Medical Italia"
  description="Parla con noi: numero verde gratuito, WhatsApp ed email. Ti aiutiamo a scegliere l'ausilio giusto e possiamo fare l'ordine per te al telefono."
  {jsonLd}
>
  <div class="max-w-page pb-section-sm mid:px-8 mid:pb-section mx-auto w-full px-5">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Assistenza' }]} />

    <header class="pt-2 pb-10">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">Parla con noi</h1>
      <p class="text-lead text-ink-2 mt-3 max-w-[60ch]">
        Ti aiutiamo a scegliere e possiamo fare l'ordine per te, al telefono. {CONTACT.hours.it}.
      </p>
    </header>

    <ul class="wide:grid-cols-3 grid gap-4.5">
      <li
        class="rounded-card border-hair-strong bg-tint flex flex-col items-start gap-3.5 border p-5.5"
      >
        <h2 class="text-lead">Numero verde</h2>
        <p class="text-ui text-ink-2 flex-1">
          Gratuito da fisso e da cellulare. È il modo più rapido.
        </p>
        <PhoneCta variant="primary" srHint="per assistenza sulla scelta di un ausilio" />
      </li>

      <li class="rounded-card border-hair flex flex-col items-start gap-3.5 border bg-white p-5.5">
        <h2 class="text-lead">WhatsApp</h2>
        <p class="text-ui text-ink-2 flex-1">
          Scrivici: puoi mandarci anche una foto dello spazio o della prescrizione.
        </p>
        <a class="btn btn-soft" href={whatsappUrl()} target="_blank" rel="noopener">
          {CONTACT.whatsappDisplay}
        </a>
      </li>

      <li class="rounded-card border-hair flex flex-col items-start gap-3.5 border bg-white p-5.5">
        <h2 class="text-lead">Email</h2>
        <p class="text-ui text-ink-2 flex-1">Per preventivi, fatturazione e documenti.</p>
        <a class="btn btn-soft" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </li>
    </ul>

    <section class="pt-section-sm mid:pt-section" aria-labelledby="support-locations-title">
      <SectionHeading id="support-locations" heading="Le nostre sedi" />

      <div class="rounded-card border-hair-strong bg-tint overflow-hidden border">
        <ul class="mid:grid-cols-2 grid">
          {
            LOCATIONS.map((location, index) => (
              <li
                class:list={[
                  'mid:px-7 px-5 py-5.5',
                  index > 0 &&
                    'mid:shadow-[inset_1px_0_0_var(--color-hair-strong)] shadow-[inset_0_1px_0_var(--color-hair-strong)]',
                ]}
              >
                <h3 class="text-lead">{location.city}</h3>
                <p class="text-ui text-ink-2 mt-1.75">{location.street}</p>
              </li>
            ))
          }
        </ul>
        <p class="border-hair-strong text-ui text-ink-2 mid:px-7 border-t bg-white px-5 py-4.5">
          Consegniamo a domicilio a Roma e Firenze e nelle rispettive province. Sei in un'altra
          zona?{' '}
          <a class="text-accent" href={`tel:${CONTACT.phoneE164}`}>Chiamaci</a>: spesso riusciamo a
          organizzare la consegna.
        </p>
      </div>
    </section>

    <section class="pt-section-sm mid:pt-section" aria-labelledby="support-faq-title">
      <SectionHeading id="support-faq" heading="Domande frequenti" />

      <ul class="grid gap-2.5">
        {
          HOME_FAQ.map((item, index) => (
            <li>
              <details
                class="group rounded-field border-hair bg-tint mid:px-6 border px-4"
                open={index === 0}
              >
                <summary class="font-display text-h4 flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3.5 font-semibold [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <svg
                    class="text-ink-2 size-5.5 flex-none transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="text-ui-strong text-ink-2 max-w-[68ch] pb-5.5">{item.answer}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="pt-section-sm mid:pt-section" aria-labelledby="support-cta-title">
      <SectionHeading
        id="support-cta"
        heading="Sai già cosa ti serve?"
        lede="Sfoglia il catalogo e invia la richiesta: nessun pagamento online."
      />
      <a class="btn btn-primary" href={routes.catalog}>Vai al catalogo</a>
    </section>
  </div>
</BaseLayout>
