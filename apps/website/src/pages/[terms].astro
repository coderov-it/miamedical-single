---
/**
 * Every published legal document, at the top level under its own slug. One route
 * rather than a file per document, so a newly published document is reachable
 * immediately and a product can link to its own terms without a code change.
 *
 * Astro gives static routes priority over dynamic ones, so this never shadows
 * `/cerca/`, `/assistenza/` or `/carrello/`.
 */
import PolicyDocument from '~/components/legal/PolicyDocument.astro';
import { getTermsBySlug } from '~/lib/catalog';
import { localeFromLocals, translate } from '~/lib/i18n';

export const prerender = false;

/**
 * Slugs the footer links to unconditionally, with the message keys of their
 * fallback heading and description — keys, not Italian strings, because the
 * fallback renders on every locale (PUB-018). The heading is the footer's own
 * label, so the link and the page it opens say the same thing.
 *
 * `privacy-policy` is deliberately absent: it is a legal page now, with its own
 * table, its own editor and its own route file (`pages/privacy-policy.astro`),
 * which Astro prefers over this dynamic route. Leaving it here would be a second
 * owner of a URL only one of them serves.
 */
const REQUIRED_DOCUMENTS: Record<string, { titleKey: string; descriptionKey: string }> = {
  'termini-e-condizioni': { titleKey: 'footer.terms', descriptionKey: 'terms.termsDescription' },
  'cookie-policy': { titleKey: 'footer.cookies', descriptionKey: 'terms.cookieDescription' },
};

const slug = Astro.params.terms ?? '';
const locale = localeFromLocals(Astro.locals);
const required = REQUIRED_DOCUMENTS[slug];

/*
 * An outage is not a missing document. A required one keeps rendering its
 * "being written" fallback, as it always has; any other slug lets the failure
 * surface as a 5xx rather than telling a crawler the page is gone.
 */
async function readDocument() {
  if (!slug) return null;
  try {
    return await getTermsBySlug(slug, locale);
  } catch (error) {
    if (!required) throw error;
    console.warn(`[terms] ${slug} (${locale}) could not be read:`, error);
    return null;
  }
}

const document = await readDocument();

if ((!document && !required) || (document && document.slug !== slug)) {
  return Astro.rewrite('/404');
}

const documentLabel = document?.title ?? translate(locale, 'terms.document');
const { fallbackTitle, description } = fallbackCopy();

function fallbackCopy(): { fallbackTitle: string; description: string } {
  if (required) {
    return {
      fallbackTitle: translate(locale, required.titleKey),
      description: translate(locale, required.descriptionKey),
    };
  }
  return {
    fallbackTitle: documentLabel,
    description: translate(locale, 'terms.description', { title: documentLabel }),
  };
}
---

<PolicyDocument {document} {fallbackTitle} {description} />
