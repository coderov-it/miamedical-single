---
/**
 * Search. A dedicated destination for the header's "Cerca", rendered on demand.
 *
 * Deliberately not indexed: a search results page adds no canonical content and
 * an indexable one invites thin-content duplicates of the catalogue.
 */
import ProductCard from '~/components/catalog/ProductCard.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { listProducts, safely } from '~/lib/catalog';
import { routes } from '~/lib/routes';
import { CONTACT } from '~/lib/site';

export const prerender = false;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';

const result = q
  ? await safely(
      () => listProducts({ q, perPage: 24, sort: 'title' }),
      { data: [], meta: { page: 1, perPage: 24, total: 0, pageCount: 1 }, facets: { specs: [] } },
      'search',
    )
  : null;
---

<BaseLayout
  title={q ? `Ricerca: ${q} | Mia Medical Italia` : 'Cerca un ausilio | Mia Medical Italia'}
  description="Cerca fra gli ausili disponibili a noleggio: carrozzine, letti ortopedici, deambulatori e molto altro."
  noindex
>
  <div class="max-w-page pb-section-sm mid:px-8 mid:pb-section mx-auto w-full px-5 pt-10">
    <header>
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">Cerca un ausilio</h1>
      <p class="text-lead text-ink-2 mt-3 max-w-[56ch]">
        Scrivi il nome del prodotto o a cosa ti serve. Se non lo trovi, chiamaci: te lo troviamo
        noi.
      </p>
    </header>

    <form
      class="mt-6 mb-10 flex flex-wrap gap-3.5"
      method="get"
      role="search"
      aria-label="Cerca un ausilio"
    >
      <label class="sr-only" for="cerca-q">Cerca un ausilio</label>
      <div class="field-control flex-1 basis-80">
        <svg
          class="text-ink-2 size-4.75 flex-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m20 20-4.2-4.2"></path>
        </svg>
        <input
          id="cerca-q"
          class="font-display text-body w-full min-w-0 border-0 bg-transparent p-0 font-semibold focus:outline-none"
          type="search"
          name="q"
          value={q}
          placeholder="Es. carrozzina, letto, deambulatore…"
          autofocus
        />
      </div>
      <button
        class="rounded-field font-display text-ui-strong hover:bg-accent-deep inline-flex min-h-14.5 min-w-38 flex-none items-center justify-center border-0 bg-accent px-6 font-semibold text-white"
        type="submit"
      >
        Cerca
      </button>
    </form>

    {
      result && (
        <section aria-labelledby="search-results-title">
          <h2 id="search-results-title" class="text-h3 mb-6">
            {result.meta.total === 0
              ? `Nessun risultato per “${q}”`
              : `${result.meta.total} ${result.meta.total === 1 ? 'risultato' : 'risultati'} per “${q}”`}
          </h2>

          {result.data.length > 0 ? (
            <ul class="wide:grid-cols-3 grid gap-6 sm:grid-cols-2">
              {result.data.map((product, index) => (
                <li class="flex">
                  <ProductCard product={product} priority={index === 0} headingLevel={3} />
                </li>
              ))}
            </ul>
          ) : (
            <div class="rounded-card border-hair bg-tint mid:p-8 grid justify-items-start gap-4 border p-6">
              <p class="max-w-[60ch]">
                Prova con una parola più semplice — per esempio <strong>carrozzina</strong> invece
                del modello — oppure sfoglia il catalogo completo.
              </p>
              <a class="btn btn-soft border-hair-strong bg-white" href={routes.catalog}>
                Vedi tutto il catalogo
              </a>
              <p class="text-ui text-ink-2">{CONTACT.hours.it}</p>
              <PhoneCta variant="primary" />
            </div>
          )}
        </section>
      )
    }

    {
      !result && (
        <section
          class="rounded-card border-hair bg-tint mid:p-8 grid justify-items-start gap-4 border p-6"
          aria-labelledby="search-suggest-title"
        >
          <h2 id="search-suggest-title" class="text-h3">
            Non sai da dove iniziare?
          </h2>
          <p class="max-w-[60ch]">
            Sfoglia il catalogo per categoria, oppure chiamaci e ti guidiamo noi nella scelta.
          </p>
          <a class="btn btn-soft border-hair-strong bg-white" href={routes.catalog}>
            Vedi tutto il catalogo
          </a>
          <p class="text-ui text-ink-2">{CONTACT.hours.it}</p>
          <PhoneCta variant="primary" />
        </section>
      )
    }
  </div>
</BaseLayout>
