---
/**
 * Customer contract signing page.
 *
 * Reached from the signing link in the contract-ready email. The token in the
 * query string is the entire authorisation — no account sign-in needed. The page
 * renders the full contract, a canvas-based signature pad, and submits the drawn
 * signature as a data URL.
 */
import AccountCopy from '~/components/account/AccountCopy.astro';
import ContractLinkError from '~/components/contract/ContractLinkError.astro';
import { ANNOUNCE, FIELD_ERROR } from '~/components/account/fields';
import LoadingState from '~/components/primitives/LoadingState.svelte';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localeFromLocals, translate } from '~/lib/i18n';
import { CONTACT } from '~/lib/site';

export const prerender = false;

const locale = localeFromLocals(Astro.locals);
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

/*
 * The page used to print every label twice — "Firma / Signature" — because it
 * had no locale to choose with. It has one now, so each label appears once, in
 * the reader's language (owner, 2026-08-30).
 */
const SCRIPT_KEYS = [
  'contract.submitting',
  'contract.linkIncomplete',
  'contract.loadFailed',
  'contract.loadError',
  'contract.signError',
  'contract.linkExpired',
  'contract.alreadySigned',
] as const;
---

<BaseLayout
  title={text('contract.metaTitle')}
  description={text('contract.metaDescription')}
  noindex
  bare
>
  <AccountCopy keys={SCRIPT_KEYS} />
  <div class="mx-auto w-full max-w-3xl px-5 py-8 md:py-12">
    <ContractLinkError />

    <!-- Loading state -->
    <div data-loading>
      <LoadingState label={text('contract.loading')} />
    </div>

    <!-- Main content (hidden until loaded) -->
    <div data-content hidden>
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h1 class="text-[clamp(1.4rem,2.2vw,1.75rem)]/[1.2] font-semibold">
            {text('contract.title')}
          </h1>
          <p class="mt-1 text-sm text-neutral-600">
            {text('contract.number')}
            <span data-contract-number class="font-mono font-medium"></span>
            <span data-order-line>
              {text('contract.orderLine')}
              <span data-order-number class="font-mono"></span>
            </span>
          </p>
        </div>
      </div>

      <!-- Contract HTML preview -->
      <div
        data-contract-body
        class="border-hair overflow-hidden rounded-xl border bg-white shadow-sm"
      ></div>

      <!-- Signature section -->
      <div data-signature-section id="signature-section" class="mt-8 scroll-mt-24">
        <h2 class="text-lg font-semibold">{text('contract.signatureHeading')}</h2>
        <p class="mt-1 text-sm text-neutral-500">{text('contract.signatureHint')}</p>

        <div data-gate="signature">
          <div class="relative mt-4">
            <canvas
              data-signature-canvas
              class="bg-tint aria-invalid:ring-danger h-48 w-full cursor-crosshair touch-none rounded-xl aria-invalid:ring-2"
              aria-label={text('contract.signatureHint')}
            ></canvas>
            <button
              data-clear-signature
              type="button"
              class="text-ink-2 absolute top-2 right-2 rounded-md bg-white/90 px-2.5 py-1 text-xs font-medium shadow-sm transition hover:bg-white"
            >
              {text('contract.clear')}
            </button>
          </div>
          <p class={FIELD_ERROR} data-field-error="signature" hidden>
            {text('contract.errorSignature')}
          </p>
        </div>

        <div data-gate="consent" class="mt-4">
          <label class="flex items-start gap-3 text-sm">
            <input data-consent type="checkbox" class="mt-0.5 size-4 shrink-0 accent-neutral-900" />
            <span class="text-neutral-600">{text('contract.consent')}</span>
          </label>
          <p class={FIELD_ERROR} data-field-error="consent" hidden>
            {text('contract.errorConsent')}
          </p>
        </div>

        <!-- Never disabled: a click with something missing says what, at the
             thing that is missing (lib/form-validation.ts). -->
        <button
          data-submit
          type="button"
          class="hover:bg-accent-deep mt-6 w-full rounded-xl bg-accent px-6 py-3 text-[15px] font-medium text-white transition aria-busy:opacity-70"
        >
          {text('contract.submit')}
        </button>
        <p
          class={ANNOUNCE}
          role="status"
          aria-live="polite"
          data-announce
          data-message-one={text('errorCountOne')}
          data-message-many={text('errorCountMany')}
        ></p>
      </div>
    </div>

    <!-- Success state -->
    <div data-done hidden class="py-16 text-center">
      <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-emerald-100">
        <svg
          class="size-8 text-emerald-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h2 class="mt-4 text-xl font-semibold">{text('contract.doneTitle')}</h2>
      <p class="mt-2 text-neutral-600">{text('contract.doneDetail')}</p>
      <p class="mt-4 text-sm text-neutral-500">
        {text('contract.questions', { phone: CONTACT.phoneDisplay })}
      </p>
    </div>

    <!-- Floating "Go to signature" button -->
    <button
      data-scroll-to-sign
      hidden
      type="button"
      class="hover:bg-accent-deep fixed right-6 bottom-6 z-50 rounded-full bg-accent px-6 py-3 text-sm font-medium text-white shadow-lg transition max-sm:right-6 max-sm:left-6 max-sm:text-center md:right-8 md:bottom-8"
    >
      {text('contract.goToSignature')}
    </button>
  </div>
</BaseLayout>

<script>
  import { API_BASE } from '~/lib/api-base';
  import { createFormGate } from '~/lib/form-validation';
  import { readAccountCopy } from '~/scripts/account/copy';
  import { createSignaturePad } from '~/scripts/signature-pad';

  const copy = readAccountCopy();
  const say = (key: string) => copy.text[key] ?? '';

  const loading = document.querySelector<HTMLElement>('[data-loading]')!;
  const content = document.querySelector<HTMLElement>('[data-content]')!;
  const errorState = document.querySelector<HTMLElement>('[data-error-state]')!;
  const errorBox = document.querySelector<HTMLElement>('[data-error]')!;
  const done = document.querySelector<HTMLElement>('[data-done]')!;
  const contractBody = document.querySelector<HTMLElement>('[data-contract-body]')!;
  const contractNumber = document.querySelector<HTMLElement>('[data-contract-number]')!;
  const orderNumber = document.querySelector<HTMLElement>('[data-order-number]')!;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-signature-canvas]')!;
  const clearBtn = document.querySelector<HTMLElement>('[data-clear-signature]')!;
  const consentBox = document.querySelector<HTMLInputElement>('[data-consent]')!;
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit]')!;
  const scrollToSign = document.querySelector<HTMLElement>('[data-scroll-to-sign]')!;
  const signatureSection = document.getElementById('signature-section')!;

  const token = new URLSearchParams(window.location.search).get('token');

  /**
   * Copy for a refused request. The API's own message is English whatever the
   * page's language, so only its status is read: a token that is unknown,
   * expired or used (404/410) and a contract already signed (409) each get a
   * sentence of their own.
   */
  function contractErrorKey(status: number, fallback: string): string {
    if (status === 409) return 'contract.alreadySigned';
    if (status === 404 || status === 410) return 'contract.linkExpired';
    return fallback;
  }

  function fail(message: string) {
    loading.hidden = true;
    content.hidden = true;
    errorState.hidden = false;
    errorBox.textContent = message;
  }

  if (!token) {
    fail(say('contract.linkIncomplete'));
  }

  // --- Signature pad ---
  const pad = createSignaturePad(canvas, () => updateSubmitState());

  clearBtn.addEventListener('click', () => pad.clear());

  consentBox.addEventListener('change', updateSubmitState);

  /* The button is never disabled. Pressing it with no signature or no consent
     marks what is missing, moves focus there and announces the count. */
  const gate = createFormGate(
    signatureSection,
    [
      /* Focus named, not found: "Cancella" is the first button in this block. */
      {
        key: 'signature',
        isSatisfied: () => !pad.isEmpty(),
        controls: () => [canvas],
        focus: () => canvas,
      },
      { key: 'consent', isSatisfied: () => consentBox.checked, controls: () => [consentBox] },
    ],
    { announce: signatureSection.querySelector<HTMLElement>('[data-announce]') },
  );

  /** Clears a message the moment its answer is given; never reveals one. */
  function updateSubmitState() {
    gate.refresh();
  }

  // --- Floating button visibility ---
  const observer = new IntersectionObserver(
    (entries) => {
      const entry = entries[0];
      if (!entry) return;
      scrollToSign.hidden = entry.isIntersecting;
    },
    { threshold: 0.1 },
  );

  scrollToSign.addEventListener('click', () => {
    signatureSection.scrollIntoView({ behavior: 'smooth' });
  });

  // --- Load contract ---
  async function loadContract() {
    if (!token) return;
    try {
      const res = await fetch(`${API_BASE}/api/contracts/sign?token=${encodeURIComponent(token)}`, {
        credentials: 'include',
      });

      if (!res.ok) {
        fail(say(contractErrorKey(res.status, 'contract.loadFailed')));
        return;
      }

      const { data } = (await res.json()) as {
        data: {
          contract: { number: string; orderNumber: string | null };
          html: string;
        };
      };

      contractNumber.textContent = data.contract.number;
      // Manual contracts have no order behind them — hide the whole line
      // rather than showing a dangling "Ordine" label.
      if (data.contract.orderNumber) {
        orderNumber.textContent = data.contract.orderNumber;
      } else {
        orderNumber.closest<HTMLElement>('[data-order-line]')!.hidden = true;
      }

      const shadow = contractBody.attachShadow({ mode: 'open' });
      shadow.innerHTML = data.html;

      loading.hidden = true;
      content.hidden = false;

      pad.fit();
      observer.observe(signatureSection);
      scrollToSign.hidden = false;
    } catch {
      fail(say('contract.loadError'));
    }
  }

  // --- Submit signature ---
  let busy = false;

  submitBtn.addEventListener('click', () => {
    // No token never shows the contract, so there is no button to press.
    if (!token) return;
    if (!gate.enforce()) return;
    // A second press while sending is ignored, not blocked: the button stays live.
    if (busy) return;
    busy = true;
    submitBtn.setAttribute('aria-busy', 'true');
    submitBtn.textContent = say('contract.submitting');

    const signatureDataUrl = pad.toDataUrl();

    void (async () => {
      try {
        const res = await fetch(
          `${API_BASE}/api/contracts/sign?token=${encodeURIComponent(token)}`,
          {
            method: 'POST',
            credentials: 'include',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ signatureDataUrl }),
          },
        );

        if (!res.ok) {
          fail(say(contractErrorKey(res.status, 'contract.signError')));
          return;
        }

        content.hidden = true;
        scrollToSign.hidden = true;
        done.hidden = false;
      } catch {
        fail(say('contract.signError'));
      }
    })();
  });

  void loadContract();
</script>
