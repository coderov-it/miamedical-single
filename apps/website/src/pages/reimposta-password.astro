---
/**
 * Password reset. The same operation as activation — redeem a token, get a session,
 * set a password — so it renders `attiva-account.astro` with different copy rather
 * than duplicating the flow.
 *
 * The one behavioural difference: here a password is required. Somebody who asked
 * to reset one and then skipped would have achieved nothing.
 */
import ActivateAccount from './attiva-account.astro';

export const prerender = false;
---

<ActivateAccount
  headingKey="account.reset.heading"
  introKey="account.reset.intro"
  passwordRequired
/>
