---
/**
 * `/reset-password/` — where password-reset emails land. The same card as
 * activation (`views/account/ActivateAccountView.astro`) with its own copy, and
 * one behavioural difference: a password is required, and the link is spent
 * together with it on save rather than on load.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localeFromLocals, translate } from '~/lib/i18n';
import ActivateAccountView from '~/views/account/ActivateAccountView.astro';

export const prerender = false;

const locale = localeFromLocals(Astro.locals);
const heading = translate(locale, 'account.reset.heading');
---

<BaseLayout
  title={`${heading} | Mia Medical Italia`}
  description={translate(locale, 'account.activate.metaDescription')}
  noindex
  fillGround
  bare
>
  <ActivateAccountView
    {heading}
    intro={translate(locale, 'account.reset.intro')}
    passwordRequired
  />
</BaseLayout>
