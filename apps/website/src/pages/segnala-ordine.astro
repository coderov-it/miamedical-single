---
/**
 * "I did not place this order."
 *
 * Reached only from the button in an order email. The emailed token is the entire
 * authorisation — no account, no sign-in, no order number in the URL — because the
 * person filling this in may be exactly the person who does NOT own the account the
 * order was attached to.
 *
 * For the same reason the page shows nothing about the order. Confirming what was
 * ordered, or by whom, to whoever holds the link would be the leak this form exists
 * to report.
 */
import AccountCopy from '~/components/account/AccountCopy.astro';
import {
  AUTH_CARD,
  AUTH_LEDE,
  AUTH_TITLE,
  FIELD,
  HINT,
  LABEL,
  NOTICE_ERROR,
  PRIMARY,
} from '~/components/account/fields';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localeFromLocals, translate } from '~/lib/i18n';
import { CONTACT } from '~/lib/site';

export const prerender = false;

const locale = localeFromLocals(Astro.locals);
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

/** What the script below writes into the DOM. See lib/account-page.ts. */
const SCRIPT_KEYS = [
  'account.report.linkIncomplete',
  'account.report.errorPhone',
  'account.report.errorMessage',
  'account.report.errorSend',
] as const;
---

<BaseLayout
  title={text('account.report.metaTitle')}
  description={text('account.report.metaDescription')}
  noindex
  fillGround
  bare
>
  <AccountCopy keys={SCRIPT_KEYS} />
  <div class={AUTH_CARD}>
    <h1 class={AUTH_TITLE}>{text('account.report.title')}</h1>

    <div data-error hidden class={`${NOTICE_ERROR} mt-6`}></div>

    <div data-form-wrap>
      <p class={AUTH_LEDE}>{text('account.report.lede')}</p>

      <form data-form class="mt-7 space-y-5" novalidate>
        <div>
          <label class={LABEL} for="phone">
            {text('account.report.phone')}
          </label>
          <input class={FIELD} id="phone" name="phone" type="tel" autocomplete="tel" required />
          <p class={`${HINT} mt-2`}>{text('account.report.phoneNote')}</p>
        </div>
        <div>
          <label class={LABEL} for="message">
            {text('account.report.message')}
          </label>
          <textarea class={FIELD} id="message" name="message" rows="4" required></textarea>
        </div>
        <button class={`${PRIMARY} w-full`} type="submit" data-submit>
          {text('account.report.submit')}
        </button>
      </form>
    </div>

    <div data-done hidden class="bg-tint rounded-field mt-6 px-5 py-5">
      <p class="font-ui text-ui font-semibold">{text('account.report.doneTitle')}</p>
      <p class="text-ink-2 mt-1.5">
        {text('account.report.doneDetail', { phone: CONTACT.phoneDisplay })}
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import { ApiError, reportOrder, tokenFromQuery } from '~/lib/customer-session';
  import { readAccountCopy } from '~/scripts/account/copy';

  const copy = readAccountCopy();
  const say = (key: string) => copy.text[key] ?? '';

  const formWrap = document.querySelector<HTMLElement>('[data-form-wrap]');
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const errorBox = document.querySelector<HTMLElement>('[data-error]');
  const done = document.querySelector<HTMLElement>('[data-done]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');

  const token = tokenFromQuery();

  function fail(message: string) {
    if (!errorBox) return;
    errorBox.hidden = false;
    errorBox.textContent = message;
  }

  if (!token) {
    if (formWrap) formWrap.hidden = true;
    fail(say('account.report.linkIncomplete'));
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!token) return;

    const phone = document.querySelector<HTMLInputElement>('#phone')?.value.trim() ?? '';
    const message = document.querySelector<HTMLTextAreaElement>('#message')?.value.trim() ?? '';

    if (phone.length < 5) return fail(say('account.report.errorPhone'));
    if (message.length === 0) return fail(say('account.report.errorMessage'));
    if (errorBox) errorBox.hidden = true;

    void (async () => {
      if (submit) submit.disabled = true;
      try {
        await reportOrder({ token, reportedPhone: phone, message });
        if (formWrap) formWrap.hidden = true;
        if (done) done.hidden = false;
      } catch (error) {
        // The token is single-use, so the most likely failure here is a second
        // submit of a report that already went through.
        fail(error instanceof ApiError ? error.message : say('account.report.errorSend'));
        if (submit) submit.disabled = false;
      }
    })();
  });
</script>
