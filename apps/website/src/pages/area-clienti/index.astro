---
/**
 * `/area-clienti/` — the customer area.
 *
 * A ROUTE DECLARATION, nothing more. Everything this page does lives in
 * `components/account/AccountApp.svelte`; see
 * docs/code/storefront-account-island.md.
 *
 * The copy travels as a PROP rather than through `<AccountCopy>`: the island
 * is server-rendered too, and `readAccountCopy()` reaches for `document`.
 * `<AccountCopy>` is unchanged and still serves the four account pages that
 * are not part of the island.
 */
import AccountApp from '~/components/account/AccountApp.svelte';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { ACCOUNT_ISLAND_KEYS, accountCopy } from '~/lib/account-page';
import { localeFromLocals, translate } from '~/lib/i18n';

export const prerender = false;

const locale = localeFromLocals(Astro.locals);
const text = (key: string) => translate(locale, key);
const copy = accountCopy(locale, ACCOUNT_ISLAND_KEYS);
---

<BaseLayout title={text('account.metaTitle')} description={text('account.metaDescription')} noindex>
  <div class="mx-auto w-full max-w-2xl px-5 py-10">
    <AccountApp client:load {copy} initial={{ name: 'account' }} />
  </div>
</BaseLayout>
