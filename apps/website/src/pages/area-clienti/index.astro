---
/**
 * Account home: who you are, your password, and the way out.
 *
 * Email is displayed but not editable. Changing it needs a re-verification round
 * trip, and accepting a new address without one would hand every future magic link
 * to whoever typed it — so the field is absent from the form rather than disabled,
 * which would only invite the question.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { routes } from '~/lib/routes';

export const prerender = false;

const field =
  'w-full rounded-lg border border-transparent bg-tint px-3 py-2.5 text-[15px] focus:border-accent';
const label = 'mb-1.5 block text-sm font-medium';
const primary =
  'rounded-lg bg-accent px-4 py-2.5 text-[15px] font-medium text-white transition hover:bg-accent-deep disabled:opacity-50';
---

<BaseLayout title="Area clienti | Mia Medical Italia" description="Il tuo account." noindex>
  <div class="mx-auto w-full max-w-2xl px-5 py-10">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h1 class="text-[clamp(1.6rem,2.4vw,2rem)]/[1.2]">Area clienti</h1>
      <button class="text-sm text-neutral-600 underline" type="button" data-logout>Esci</button>
    </div>

    <p data-loading class="mt-6 text-[15px] text-neutral-600">Caricamento…</p>

    <div data-content hidden>
      <a
        class="bg-tint hover:bg-tint-2 mt-6 flex items-center justify-between rounded-xl px-4 py-4 transition"
        href={routes.accountOrders}
      >
        <span class="font-medium">I miei ordini</span>
        <span aria-hidden="true">→</span>
      </a>

      <section class="mt-8">
        <h2 class="text-base font-medium">I tuoi dati</h2>
        <p class="mt-1 text-sm text-neutral-600">
          Email: <span data-email class="font-medium text-neutral-900"></span>
        </p>

        <div
          data-feedback
          hidden
          class="bg-tint mt-4 rounded-lg px-4 py-3 text-sm"
        >
        </div>

        <form data-profile-form class="mt-4 space-y-4" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={label} for="firstName">Nome</label>
              <input
                class={field}
                id="firstName"
                name="firstName"
                autocomplete="given-name"
                required
              />
            </div>
            <div>
              <label class={label} for="lastName">Cognome</label>
              <input
                class={field}
                id="lastName"
                name="lastName"
                autocomplete="family-name"
                required
              />
            </div>
          </div>
          <div>
            <label class={label} for="phone">Numero WhatsApp</label>
            <input class={field} id="phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
          <button class={primary} type="submit" data-profile-submit>Salva</button>
        </form>
      </section>

      <section class="border-hair mt-10 border-t pt-8">
        <h2 class="text-base font-medium" data-password-heading>Password</h2>
        <p class="mt-1 text-sm text-neutral-600" data-password-note></p>

        <div
          data-password-feedback
          hidden
          class="bg-tint mt-4 rounded-lg px-4 py-3 text-sm"
        >
        </div>

        <form data-password-form class="mt-4 space-y-4" novalidate>
          <!-- Only rendered when a password already exists: an account that has
               never had one cannot be asked to prove it. -->
          <div data-current-wrap hidden>
            <label class={label} for="currentPassword">Password attuale</label>
            <input
              class={field}
              id="currentPassword"
              type="password"
              autocomplete="current-password"
            />
          </div>
          <div>
            <label class={label} for="newPassword">Nuova password</label>
            <input
              class={field}
              id="newPassword"
              type="password"
              autocomplete="new-password"
              minlength="12"
            />
            <p class="mt-1.5 text-xs text-neutral-500">Almeno 12 caratteri.</p>
          </div>
          <button class={primary} type="submit" data-password-submit>Salva password</button>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    ApiError,
    loadCustomer,
    logout,
    setPassword,
    updateProfile,
    type Customer,
  } from '~/lib/customer-session';
  import { routes } from '~/lib/routes';

  const loading = document.querySelector<HTMLElement>('[data-loading]');
  const content = document.querySelector<HTMLElement>('[data-content]');
  const feedback = document.querySelector<HTMLElement>('[data-feedback]');
  const passwordFeedback = document.querySelector<HTMLElement>('[data-password-feedback]');

  function say(box: HTMLElement | null, message: string, isError = false) {
    if (!box) return;
    box.hidden = false;
    box.textContent = message;
    box.classList.toggle('border-red-300', isError);
    box.classList.toggle('bg-red-50', isError);
  }

  function fill(customer: Customer) {
    const set = (selector: string, value: string) => {
      const input = document.querySelector<HTMLInputElement>(selector);
      if (input) input.value = value;
    };

    const emailSpan = document.querySelector<HTMLElement>('[data-email]');
    if (emailSpan) emailSpan.textContent = customer.email;

    set('#firstName', customer.firstName);
    set('#lastName', customer.lastName);
    set('#phone', customer.phone ?? '');

    const heading = document.querySelector<HTMLElement>('[data-password-heading]');
    const note = document.querySelector<HTMLElement>('[data-password-note]');
    const currentWrap = document.querySelector<HTMLElement>('[data-current-wrap]');

    if (customer.hasPassword) {
      if (heading) heading.textContent = 'Cambia password';
      if (note)
        note.textContent = 'Cambiando la password gli altri dispositivi verranno disconnessi.';
      if (currentWrap) currentWrap.hidden = false;
    } else {
      if (heading) heading.textContent = 'Imposta una password';
      if (note)
        note.textContent =
          'Non hai ancora una password: accedi con il link via email. Impostandola potrai accedere anche con email e password.';
      if (currentWrap) currentWrap.hidden = true;
    }
  }

  const customer = await loadCustomer();

  if (!customer) {
    window.location.replace(`${routes.login}?next=${encodeURIComponent(window.location.pathname)}`);
  } else {
    if (loading) loading.hidden = true;
    if (content) content.hidden = false;
    fill(customer);
  }

  document.querySelector('[data-profile-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const button = document.querySelector<HTMLButtonElement>('[data-profile-submit]');
    const value = (selector: string) =>
      document.querySelector<HTMLInputElement>(selector)?.value.trim() ?? '';

    void (async () => {
      if (button) button.disabled = true;
      try {
        const updated = await updateProfile({
          firstName: value('#firstName'),
          lastName: value('#lastName'),
          phone: value('#phone'),
        });
        fill(updated);
        say(feedback, 'Dati aggiornati.');
      } catch (error) {
        say(
          feedback,
          error instanceof ApiError ? error.message : 'Qualcosa è andato storto.',
          true,
        );
      } finally {
        if (button) button.disabled = false;
      }
    })();
  });

  document.querySelector('[data-password-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const button = document.querySelector<HTMLButtonElement>('[data-password-submit]');
    const current = document.querySelector<HTMLInputElement>('#currentPassword')?.value ?? '';
    const next = document.querySelector<HTMLInputElement>('#newPassword')?.value ?? '';

    if (next.length < 12) {
      say(passwordFeedback, 'La password deve avere almeno 12 caratteri.', true);
      return;
    }

    void (async () => {
      if (button) button.disabled = true;
      try {
        await setPassword({ ...(current ? { currentPassword: current } : {}), newPassword: next });
        say(passwordFeedback, 'Password aggiornata.');
        // The session deliberately survives a password change — see the server's
        // customer-auth service — so there is nothing to redirect to.
        const refreshed = await loadCustomer();
        if (refreshed) fill(refreshed);
        const newField = document.querySelector<HTMLInputElement>('#newPassword');
        const currentField = document.querySelector<HTMLInputElement>('#currentPassword');
        if (newField) newField.value = '';
        if (currentField) currentField.value = '';
      } catch (error) {
        say(
          passwordFeedback,
          error instanceof ApiError ? error.message : 'Qualcosa è andato storto.',
          true,
        );
      } finally {
        if (button) button.disabled = false;
      }
    })();
  });

  document.querySelector('[data-logout]')?.addEventListener('click', () => {
    void (async () => {
      await logout().catch(() => undefined);
      window.location.assign(routes.home);
    })();
  });
</script>
