---
/**
 * One order, as the customer sees it: the lines they configured, where it is going,
 * and what it costs. Deliberately not the admin view — no status timeline, no
 * operator notes, no fiscal identifiers.
 *
 * `prerender = false` with a dynamic segment: there is no set of paths to build, and
 * the number is only meaningful to whoever holds it.
 */
import AccountCopy from '~/components/account/AccountCopy.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localeFromLocals, translate } from '~/lib/i18n';
import { routePath } from '~/lib/routes';

export const prerender = false;

const { number } = Astro.params;
const locale = localeFromLocals(Astro.locals);
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

/** What the script below writes into the DOM. See lib/account-page.ts. */
const SCRIPT_KEYS = [
  'account.order.title',
  'account.order.placedOn',
  'account.order.subtotal',
  'account.order.storePickup',
  'account.order.pieces',
  'account.order.yourNotes',
  'account.order.unavailable',
  'account.order.backToOrders',
  'homeDeliveryShort',
  'deliveryPending',
  'delivery',
  'total',
] as const;
---

<BaseLayout
  title={text('account.order.metaTitle', { number: number ?? '' })}
  description={text('account.order.metaDescription')}
  noindex
>
  <AccountCopy keys={SCRIPT_KEYS} />
  <div class="mx-auto w-full max-w-2xl px-5 py-10" data-order-number={number}>
    <nav class="mb-6 text-sm text-neutral-500">
      <a class="underline" href={routePath(locale, 'accountOrders')}>{text('account.myOrders')}</a>
      <span class="mx-1.5">/</span>
      <span>{number}</span>
    </nav>

    <p data-loading class="text-[15px] text-neutral-600">{text('account.loading')}</p>

    <div data-error hidden class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm">
    </div>

    <article data-detail hidden></article>
  </div>
</BaseLayout>

<script>
  import { API_BASE } from '~/lib/api';
  import { formatDate, formatMoney, loadCustomer } from '~/lib/customer-session';
  import { fill, readAccountCopy } from '~/scripts/account/copy';

  const copy = readAccountCopy();
  const say = (key: string) => copy.text[key] ?? '';

  const root = document.querySelector<HTMLElement>('[data-order-number]');
  const number = root?.dataset.orderNumber ?? '';
  const loading = document.querySelector<HTMLElement>('[data-loading]');
  const errorBox = document.querySelector<HTMLElement>('[data-error]');
  const detail = document.querySelector<HTMLElement>('[data-detail]');

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"]/g, (c) =>
      c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&quot;',
    );
  }

  interface OrderItem {
    productTitle: string;
    quantity: number;
    total: string;
  }

  interface OrderDetail {
    number: string;
    status: string;
    totals: { subtotal: string; shippingTotal: string; total: string; currency: string };
    items: OrderItem[];
    shippingAddress: {
      fullName?: string;
      line1?: string;
      city?: string;
      postalCode?: string;
    } | null;
    delivery: { method?: string } | null;
    notes: string | null;
    placedAt: string;
  }

  const DELIVERY_LABELS: Record<string, string> = {
    homeDelivery: say('homeDeliveryShort'),
    storePickup: say('account.order.storePickup'),
  };

  /**
   * What to print on the delivery line.
   *
   * A home delivery still at zero has not been agreed yet, not been given away:
   * nothing prices delivery, so an order is placed at 0,00 € and stays there until
   * somebody writes the amount settled on the phone. Printing "0,00 €" would tell
   * the customer their delivery is free. A collection genuinely is free.
   */
  function deliveryAmount(order: OrderDetail): string {
    const settled = Number(order.totals.shippingTotal) > 0;
    if (settled || order.delivery?.method !== 'homeDelivery') {
      return formatMoney(order.totals.shippingTotal, order.totals.currency);
    }
    return escapeHtml(say('deliveryPending'));
  }

  function row(labelText: string, value: string, strong = false): string {
    return `<div class="flex justify-between gap-4 ${strong ? 'font-medium' : 'text-neutral-600'}">
      <span>${escapeHtml(labelText)}</span><span class="tabular-nums">${value}</span></div>`;
  }

  function render(order: OrderDetail) {
    const currency = order.totals.currency;
    const address = order.shippingAddress;

    const lines = order.items
      .map(
        (item) => `<li class="flex justify-between gap-4 border-hair border-b py-3 last:border-0">
          <div>
            <p class="font-medium">${escapeHtml(item.productTitle)}</p>
            <p class="text-sm text-neutral-600">${escapeHtml(
              fill(say('account.order.pieces'), { count: item.quantity }),
            )}</p>
          </div>
          <span class="tabular-nums">${formatMoney(item.total, currency)}</span>
        </li>`,
      )
      .join('');

    if (!detail) return;
    detail.hidden = false;
    detail.innerHTML = `
      <header class="flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-[clamp(1.5rem,2.2vw,1.9rem)]/[1.2]">${escapeHtml(
          fill(say('account.order.title'), { number: order.number }),
        )}</h1>
        <span class="bg-tint rounded-full px-3 py-1 text-sm">
          ${escapeHtml(copy.status[order.status] ?? order.status)}
        </span>
      </header>
      <p class="mt-1 text-sm text-neutral-600">${escapeHtml(
        fill(say('account.order.placedOn'), { date: formatDate(order.placedAt) }),
      )}</p>

      <ul class="mt-7">${lines}</ul>

      <div class="mt-5 space-y-1.5 text-[15px]">
        ${row(say('account.order.subtotal'), formatMoney(order.totals.subtotal, currency))}
        ${row(say('delivery'), deliveryAmount(order))}
        ${row(say('total'), formatMoney(order.totals.total, currency), true)}
      </div>

      ${
        order.delivery?.method
          ? `<section class="border-hair mt-7 rounded-xl border p-4">
               <h2 class="text-sm font-medium">${escapeHtml(say('delivery'))}</h2>
               <p class="mt-1 text-[15px] text-neutral-600">
                 ${escapeHtml(DELIVERY_LABELS[order.delivery.method] ?? order.delivery.method)}
               </p>
               ${
                 address?.line1
                   ? `<p class="mt-1 text-[15px] text-neutral-600">
                        ${escapeHtml([address.line1, address.postalCode, address.city].filter(Boolean).join(', '))}
                      </p>`
                   : ''
               }
             </section>`
          : ''
      }

      ${
        order.notes
          ? `<section class="border-hair mt-4 rounded-xl border p-4">
               <h2 class="text-sm font-medium">${escapeHtml(say('account.order.yourNotes'))}</h2>
               <p class="mt-1 text-[15px] whitespace-pre-line text-neutral-600">${escapeHtml(order.notes)}</p>
             </section>`
          : ''
      }`;
  }

  const customer = await loadCustomer();

  if (!customer) {
    window.location.replace(
      `${copy.routes.login}?next=${encodeURIComponent(window.location.pathname)}`,
    );
  } else {
    const response = await fetch(`${API_BASE}/api/customer/orders/${encodeURIComponent(number)}`, {
      credentials: 'include',
    });

    if (loading) loading.hidden = true;

    if (response.ok) {
      const payload = (await response.json()) as { data: OrderDetail };
      render(payload.data);
    } else if (errorBox) {
      // A number that is not theirs 404s rather than 403s, so "not found" is the
      // only thing this page can honestly say about either case.
      errorBox.hidden = false;
      errorBox.innerHTML = `${escapeHtml(say('account.order.unavailable'))} <a class="underline" href="${copy.routes.accountOrders}">${escapeHtml(say('account.order.backToOrders'))}</a>.`;
    }
  }
</script>
