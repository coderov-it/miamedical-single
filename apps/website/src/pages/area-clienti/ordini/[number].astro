---
/**
 * `/area-clienti/ordini/<number>/` — one order.
 *
 * A ROUTE DECLARATION. The screen is
 * `components/account/OrderDetailScreen.svelte`.
 *
 * `prerender = false` with a dynamic segment: there is no set of paths to
 * build, and the number is only meaningful to whoever holds it.
 *
 * `languagePaths` is passed explicitly because `BaseLayout` cannot derive it
 * here — it matches the pathname against the static route table, and this
 * route has a segment. Without it the switcher offers only the current
 * language, which it did until now.
 */
import AccountApp from '~/components/account/AccountApp.svelte';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { ACCOUNT_ISLAND_KEYS, accountCopy } from '~/lib/account-page';
import { localeFromLocals, LOCALES, translate } from '~/lib/i18n';
import { accountOrderPath } from '~/lib/routes';

export const prerender = false;

const number = Astro.params.number ?? '';
const locale = localeFromLocals(Astro.locals);
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);
const copy = accountCopy(locale, ACCOUNT_ISLAND_KEYS);

const languagePaths = Object.fromEntries(
  LOCALES.map((code) => [code, accountOrderPath(number, code)]),
);
---

<BaseLayout
  title={text('account.order.metaTitle', { number })}
  description={text('account.order.metaDescription')}
  noindex
  {languagePaths}
>
  <AccountApp client:load {copy} initial={{ name: 'orderDetail', number }} />
</BaseLayout>
