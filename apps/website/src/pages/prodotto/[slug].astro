---
/**
 * Product detail, from one composed product read.
 *
 * Rendered on demand so stock, price and specifications are never stale. The
 * whole page is server-rendered HTML; the only JavaScript is the quantity
 * stepper inside the buy box.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import ProductQuote from '~/components/product/ProductQuote.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatPricing, mediaUrl, offerPrice } from '~/lib/api';
import { getProductBySlug } from '~/lib/catalog';
import { productPath, routes } from '~/lib/routes';
import { CONTACT, whatsappUrl } from '~/lib/site';

export const prerender = false;

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : null;

if (!product) {
  return Astro.rewrite('/404');
}

const isRental = product.pricing.mode === 'rental';
const inStock = product.skus.length === 0 || product.skus.some((sku) => sku.inStock);

const hero = product.media.cleanPng ?? product.media.thumbnail ?? product.media.gallery[0] ?? null;
const gallery = product.media.gallery.filter((item) => item.path !== hero?.path).slice(0, 4);

/**
 * "Perché sceglierla" reuses the short description, split into its sentences.
 * The back office has no dedicated bullet field, and inventing marketing claims
 * here is not an option — every line on this page is a governed fact.
 */
const whyPoints = (product.shortDescription ?? '')
  .split(/(?<=[.!])\s+/)
  .map((sentence) => sentence.replace(/[.!]+$/, '').trim())
  .filter((sentence) => sentence.length > 0)
  .slice(0, 4);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    ...(product.shortDescription ? { description: product.shortDescription } : {}),
    ...(hero ? { image: [new URL(mediaUrl(hero.path), Astro.url.origin).href] } : {}),
    ...(product.baseSku ? { sku: product.baseSku } : {}),
    ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
    category: product.category.name,
    offers: {
      '@type': 'Offer',
      price: offerPrice(product.pricing.price),
      priceCurrency: product.pricing.currency,
      availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: new URL(productPath(product.slug), Astro.site ?? Astro.url.origin).href,
    },
  },
];

if (product.faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: product.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={product.seo.title ??
    `${product.title} | ${isRental ? 'Noleggio' : 'Vendita'} — Mia Medical Italia`}
  description={product.seo.description ??
    product.shortDescription?.slice(0, 155) ??
    `${isRental ? 'Noleggio' : 'Vendita'} ${product.title} con consegna a domicilio a Roma e Firenze.`}
  canonical={new URL(productPath(product.slug), Astro.site ?? Astro.url.origin).href}
  ogImage={hero ? new URL(mediaUrl(hero.path), Astro.url.origin).href : undefined}
  {jsonLd}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Catalogo noleggio', href: routes.catalog },
        { label: product.title },
      ]}
    />

    <div class="pdp">
      <div class="pdp__left">
        <div class="pdp__gallery-card">
          {
            hero ? (
              <img
                class="pdp__hero"
                src={mediaUrl(hero.path)}
                alt={hero.alt ?? product.title}
                loading="eager"
                fetchpriority="high"
                decoding="sync"
              />
            ) : (
              <div class="pdp__hero pdp__hero--empty" aria-hidden="true" />
            )
          }

          {
            gallery.length > 0 && (
              <ul class="pdp__thumbs">
                {gallery.map((item) => (
                  <li>
                    <img
                      src={mediaUrl(item.path)}
                      alt={item.alt ?? ''}
                      loading="lazy"
                      decoding="async"
                    />
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="pdp__mobile-identity">
          <a class="pdp__back" href={routes.catalog}>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            Torna al catalogo
          </a>
          <div class="pdp__identity-meta">
            <span class="pdp__cat-pill">{product.category.name}</span>
            {
              inStock && (
                <span class="pdp__avail-badge">
                  <span class="pdp__dot" aria-hidden="true" />
                  Disponibile subito
                </span>
              )
            }
          </div>
          <h1 class="pdp__title">{product.title}</h1>
          {product.shortDescription && <p class="pdp__summary">{product.shortDescription}</p>}
        </div>

        {
          whyPoints.length > 0 && (
            <section class="pdp__section pdp__why" aria-labelledby="why-title">
              <h2 id="why-title">
                {isRental ? 'Perché scegliere questo ausilio' : 'Perché sceglierlo'}
              </h2>
              <ul class="pdp__why-list">
                {whyPoints.map((point) => (
                  <li>
                    <svg
                      class="pdp__check-icon"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="12" fill="var(--c-primary)" />
                      <path
                        d="M7 12.5l3 3 7-7"
                        stroke="#fff"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          product.description && (
            <section class="pdp__section" aria-labelledby="desc-title">
              <h2 id="desc-title">Descrizione</h2>
              <div class="pdp__prose">
                {product.description.split(/\n{2,}/).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </section>
          )
        }

        {
          isRental && (
            <div class="pdp__includes-row">
              <section class="pdp__includes-card" aria-labelledby="includes-title">
                <h3 id="includes-title">Cosa è incluso</h3>
                <ul class="pdp__includes-list">
                  {[
                    'Consegna a domicilio',
                    'Ritiro a fine noleggio',
                    'Montaggio e istruzioni',
                    'Assistenza telefonica',
                  ].map((item) => (
                    <li>
                      <svg
                        class="pdp__include-icon"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M20 6L9 17l-5-5"
                          stroke="var(--c-success)"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </section>

              <section class="pdp__includes-card" aria-labelledby="hygiene-title">
                <h3 id="hygiene-title">Igiene e sicurezza</h3>
                <ul class="pdp__includes-list">
                  {[
                    'Sanificato e certificato',
                    'Controllato prima della consegna',
                    'Accessori inclusi e integri',
                  ].map((item) => (
                    <li>
                      <svg
                        class="pdp__shield-icon"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                          stroke="var(--c-success)"
                          stroke-width="2"
                          fill="none"
                        />
                        <path
                          d="M9 12l2 2 4-4"
                          stroke="var(--c-success)"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          )
        }

        {
          !isRental && (
            <section class="pdp__section" aria-labelledby="hygiene-title">
              <h2 id="hygiene-title">Igiene e sicurezza</h2>
              <p>
                Ogni ausilio viene <strong>sanificato, controllato e certificato</strong>. Lo ricevi
                igienizzato e pronto all'uso, con tutti gli accessori.
              </p>
            </section>
          )
        }

        {
          product.specifications.length > 0 && (
            <section class="pdp__section" aria-labelledby="specs-title">
              <h2 id="specs-title">Scheda tecnica</h2>
              <div class="pdp__specs-table">
                {product.specifications.map((spec, index) => (
                  <div class:list={['pdp__spec-row', index % 2 === 0 && 'pdp__spec-row--alt']}>
                    <span class="pdp__spec-label">{spec.label}</span>
                    <span class="pdp__spec-value">{spec.displayValue}</span>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          product.faqs.length > 0 && (
            <section class="pdp__section" aria-labelledby="faq-title">
              <h2 id="faq-title">Domande frequenti su questo ausilio</h2>
              <div class="pdp__faq">
                {product.faqs.map((faq, index) => (
                  <details class="pdp__faq-item" open={index === 0}>
                    <summary class="pdp__faq-question">
                      <span>{faq.question}</span>
                      <svg
                        class="pdp__faq-chevron"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        aria-hidden="true"
                      >
                        <path d="M6 9l6 6 6-6" />
                      </svg>
                    </summary>
                    <div class="pdp__faq-answer">
                      <p>{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        {
          product.terms.length > 0 && (
            <section class="pdp__section" aria-labelledby="terms-title">
              <h2 id="terms-title">Condizioni applicabili</h2>
              <ul class="pdp__terms">
                {product.terms.map((terms) => (
                  <li>
                    <a href={`/${terms.slug}/`}>{terms.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <div class="pdp__right">
        <div class="pdp__buybox">
          <div class="pdp__buybox-meta">
            <span class="pdp__cat-pill">{product.category.name}</span>
            {
              inStock && (
                <span class="pdp__avail-badge">
                  <span class="pdp__dot" aria-hidden="true" />
                  Disponibile subito
                </span>
              )
            }
          </div>

          <h1 class="pdp__title">{product.title}</h1>
          {product.brand && <p class="pdp__brand">{product.brand}</p>}
          {product.shortDescription && <p class="pdp__summary">{product.shortDescription}</p>}

          <ProductQuote {product} />

          <div class="pdp__reassure">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="var(--c-success)" stroke-width="2"></circle>
              <path
                d="M9 12l2 2 4-4"
                stroke="var(--c-success)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <p>
              <strong>Nessun pagamento online adesso.</strong> Invia la richiesta e confermiamo tutto
              al telefono.
            </p>
          </div>
        </div>

        <div class="pdp__help-card">
          <p class="pdp__help-title">Non sai se è adatto a te?</p>
          <p class="pdp__help-subtitle">Chiamaci, ti aiutiamo a scegliere</p>
          <PhoneCta variant="primary" srHint="per informazioni su questo prodotto" />
          <a
            class="pdp__wa-btn"
            href={whatsappUrl(`Informazioni su: ${product.title}`)}
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.019-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            WhatsApp
          </a>
          <p class="pdp__help-hours">{CONTACT.hours.it}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="pdp__mobile-bar">
    <div class="pdp__mobile-bar-inner">
      <div class="pdp__mobile-bar-price">
        {isRental && <span class="pdp__mobile-bar-label">da</span>}
        <span class="pdp__mobile-bar-amount">{formatPricing(product.pricing)}</span>
      </div>
      <a class="pdp__mobile-bar-cta" href="#quote-form">
        {isRental ? 'Noleggia ora' : 'Richiedi'}
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  /* -------------------- Two-column desktop layout -------------------- */
  .pdp {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 36px;
    padding-block: var(--sp-4) var(--sp-10);
    align-items: start;
  }

  .pdp__left {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    min-width: 0;
  }

  /* -------------------- Gallery -------------------- */
  .pdp__gallery-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .pdp__hero {
    width: 100%;
    height: 400px;
    object-fit: contain;
    border-radius: var(--radius-md);
    background: var(--c-surface);
    mix-blend-mode: multiply;
  }

  .pdp__hero--empty {
    background: var(--c-surface-tint);
  }

  .pdp__thumbs {
    display: flex;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
    list-style: none;
    overflow-x: auto;
  }

  .pdp__thumbs li {
    flex: 0 0 74px;
  }

  .pdp__thumbs img {
    width: 74px;
    height: 74px;
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    background: var(--c-surface);
  }

  /* -------------------- Mobile-only identity -------------------- */
  .pdp__mobile-identity {
    display: none;
  }

  .pdp__back {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: var(--target-min);
    font-family: var(--font-heading);
    font-size: var(--fs-ui);
    font-weight: 600;
    color: var(--c-ink-secondary);
    text-decoration: none;
  }

  .pdp__identity-meta,
  .pdp__buybox-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .pdp__cat-pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: var(--c-surface-tint);
    color: var(--c-primary);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: var(--fs-ui);
    font-weight: 600;
  }

  .pdp__avail-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: var(--fs-ui);
    font-weight: 600;
    color: var(--c-success);
  }

  .pdp__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .pdp__title {
    margin-top: var(--sp-3);
    font-family: var(--font-heading);
    font-size: 1.5625rem; /* 25px, per the design */
    font-weight: 800;
    line-height: var(--lh-heading);
    color: var(--c-ink);
  }

  .pdp__brand {
    margin-top: var(--sp-1);
    color: var(--c-ink-secondary);
    font-size: var(--fs-ui);
  }

  .pdp__summary {
    margin-top: var(--sp-3);
    color: var(--c-ink-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* -------------------- Right column (buy box) -------------------- */
  .pdp__right {
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .pdp__buybox {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: 24px;
    background: var(--c-surface);
    border: 2px solid var(--c-surface-accent);
    border-radius: var(--radius-lg);
  }

  .pdp__reassure {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background: #e8f5ee;
    border-radius: var(--radius-md);
    font-size: var(--fs-ui);
    color: var(--c-ink);
  }

  .pdp__reassure svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* -------------------- Help card -------------------- */
  .pdp__help-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: 24px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }

  .pdp__help-title {
    font-family: var(--font-heading);
    font-size: var(--fs-h4);
    font-weight: 700;
    color: var(--c-ink);
  }

  .pdp__help-subtitle {
    margin-bottom: var(--sp-2);
    font-size: var(--fs-ui);
    color: var(--c-ink-secondary);
  }

  .pdp__wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: var(--target-min);
    padding: var(--sp-3) var(--sp-5);
    border: 2px solid var(--c-success);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--c-success);
    font-family: var(--font-heading);
    font-size: var(--fs-ui-strong);
    font-weight: 700;
    text-decoration: none;
  }

  .pdp__help-hours {
    font-size: var(--fs-ui);
    color: var(--c-ink-secondary);
  }

  /* -------------------- Sections -------------------- */
  .pdp__section h2 {
    font-size: var(--fs-h3);
    margin-bottom: var(--sp-4);
  }

  .pdp__why-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    list-style: none;
  }

  .pdp__why-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .pdp__check-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pdp__prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .pdp__prose p + p {
    margin-top: var(--sp-4);
  }

  .pdp__terms {
    display: grid;
    gap: var(--sp-2);
    list-style: none;
  }

  .pdp__terms a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-heading);
    font-size: var(--fs-ui);
    font-weight: 600;
  }

  /* -------------------- Includes / hygiene -------------------- */
  .pdp__includes-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }

  .pdp__includes-card {
    padding: 24px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }

  .pdp__includes-card h3 {
    font-size: var(--fs-h4);
    margin-bottom: var(--sp-4);
  }

  .pdp__includes-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    list-style: none;
  }

  .pdp__includes-list li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-ui);
    color: var(--c-ink);
  }

  .pdp__include-icon,
  .pdp__shield-icon {
    flex-shrink: 0;
  }

  /* -------------------- Specs table -------------------- */
  .pdp__specs-table {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .pdp__spec-row {
    display: flex;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-border);
    font-size: var(--fs-ui);
  }

  .pdp__spec-row:last-child {
    border-bottom: 0;
  }

  .pdp__spec-row--alt {
    background: var(--c-surface-tint);
  }

  .pdp__spec-label {
    flex: 0 0 45%;
