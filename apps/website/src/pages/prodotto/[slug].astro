---
/**
 * Product detail, from one composed product read.
 *
 * Rendered on demand so stock, price and specifications are never stale. The
 * whole page is server-rendered HTML; the only JavaScript is the quantity
 * stepper inside the buy box.
 *
 * Reading order on phones is gallery → identity → buy box → the rest, achieved
 * with `display: contents` on the left column so its children join the page
 * grid and can be ordered independently.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import ProductQuote from '~/components/product/ProductQuote.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatPricing, mediaUrl, offerPrice } from '~/lib/api';
import { getProductBySlug } from '~/lib/catalog';
import { productPath, routes } from '~/lib/routes';
import { CONTACT, whatsappUrl } from '~/lib/site';

export const prerender = false;

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : null;

if (!product) {
  return Astro.rewrite('/404');
}

const isRental = product.pricing.mode === 'rental';
const inStock = product.skus.length === 0 || product.skus.some((sku) => sku.inStock);

const hero = product.media.cleanPng ?? product.media.thumbnail ?? product.media.gallery[0] ?? null;
const gallery = product.media.gallery.filter((item) => item.path !== hero?.path).slice(0, 4);

/**
 * "Perché sceglierla" reuses the short description, split into its sentences.
 * The back office has no dedicated bullet field, and inventing marketing claims
 * here is not an option — every line on this page is a governed fact.
 */
const whyPoints = (product.shortDescription ?? '')
  .split(/(?<=[.!])\s+/)
  .map((sentence) => sentence.replace(/[.!]+$/, '').trim())
  .filter((sentence) => sentence.length > 0)
  .slice(0, 4);

const includes = [
  'Consegna a domicilio',
  'Ritiro a fine noleggio',
  'Montaggio e istruzioni',
  'Assistenza telefonica',
];

const hygiene = [
  'Sanificato e certificato',
  'Controllato prima della consegna',
  'Accessori inclusi e integri',
];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    ...(product.shortDescription ? { description: product.shortDescription } : {}),
    ...(hero ? { image: [new URL(mediaUrl(hero.path), Astro.url.origin).href] } : {}),
    ...(product.baseSku ? { sku: product.baseSku } : {}),
    ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
    category: product.category.name,
    offers: {
      '@type': 'Offer',
      price: offerPrice(product.pricing.price),
      priceCurrency: product.pricing.currency,
      availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: new URL(productPath(product.slug), Astro.site ?? Astro.url.origin).href,
    },
  },
];

if (product.faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: product.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}

const sectionTitle = 'mb-4 text-h3';
---

<BaseLayout
  title={product.seo.title ??
    `${product.title} | ${isRental ? 'Noleggio' : 'Vendita'} — Mia Medical Italia`}
  description={product.seo.description ??
    product.shortDescription?.slice(0, 155) ??
    `${isRental ? 'Noleggio' : 'Vendita'} ${product.title} con consegna a domicilio a Roma e Firenze.`}
  canonical={new URL(productPath(product.slug), Astro.site ?? Astro.url.origin).href}
  ogImage={hero ? new URL(mediaUrl(hero.path), Astro.url.origin).href : undefined}
  {jsonLd}
>
  {
    /*
      The bottom padding clears BOTH fixed bars on phones: the price bar and the
      persistent navigation under it.
    */
  }
  <div
    class="max-w-page mid:px-8 mid:pb-16 mx-auto w-full px-5 pb-[calc(var(--spacing-mobile-bar)+var(--spacing-mobile-nav)+1.25rem)]"
  >
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Catalogo noleggio', href: routes.catalog },
        { label: product.title },
      ]}
    />

    <div class="mid:gap-9 wide:grid-cols-[minmax(0,1fr)_400px] grid items-start gap-5 pt-2">
      <div class="wide:flex wide:flex-col wide:gap-8 contents min-w-0">
        <div class="rounded-card border-hair mid:p-6 order-1 border bg-white p-4">
          {/* The site-wide 4:3 media well — same ratio as the card stage. */}
          <div class="rounded-field bg-tint relative grid aspect-4/3 place-items-center">
            {
              hero && (
                <img
                  class="absolute inset-0 size-full object-contain p-6 mix-blend-multiply"
                  src={mediaUrl(hero.path)}
                  alt={hero.alt ?? product.title}
                  loading="eager"
                  fetchpriority="high"
                  decoding="sync"
                />
              )
            }
          </div>

          {
            gallery.length > 0 && (
              <ul class="mt-4 flex gap-3 overflow-x-auto">
                {gallery.map((item) => (
                  <li class="flex-none">
                    <img
                      class="rounded-field border-hair bg-tint aspect-4/3 w-24 border object-contain p-1.5 mix-blend-multiply"
                      src={mediaUrl(item.path)}
                      alt={item.alt ?? ''}
                      loading="lazy"
                      decoding="async"
                    />
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        {
          /*
            The identity block lives here on phones and inside the buy box on
            desktop. Only one of the two is ever rendered visible, so the title
            is never announced twice.
          */
        }
        <div class="wide:hidden order-2 flex flex-col gap-3">
          <a
            class="font-display text-ui text-ink-2 inline-flex min-h-12 items-center gap-2 self-start font-semibold no-underline"
            href={routes.catalog}
          >
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            Torna al catalogo
          </a>

          <div class="flex flex-wrap items-center gap-3">
            <span
              class="bg-tint font-display text-ui inline-flex items-center rounded-full px-3.5 py-1.5 font-semibold text-accent"
            >
              {product.category.name}
            </span>
            {
              inStock && (
                <span class="font-display text-ui text-ok inline-flex items-center gap-1.5 font-semibold">
                  <span class="size-2 rounded-full bg-current" aria-hidden="true" />
                  Disponibile subito
                </span>
              )
            }
          </div>

          <h1 class="text-[1.5625rem]/[1.25]">{product.title}</h1>
          {product.shortDescription && <p class="text-ink-2">{product.shortDescription}</p>}
        </div>

        {
          whyPoints.length > 0 && (
            <section class="order-4" aria-labelledby="why-title">
              <h2 id="why-title" class={sectionTitle}>
                {isRental ? 'Perché scegliere questo ausilio' : 'Perché sceglierlo'}
              </h2>
              <ul class="grid gap-4">
                {whyPoints.map((point) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="mt-0.5 size-5.5 flex-none"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="12" fill="var(--color-accent)" />
                      <path
                        d="M7 12.5l3 3 7-7"
                        stroke="#fff"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          product.description && (
            <section class="order-5" aria-labelledby="desc-title">
              <h2 id="desc-title" class={sectionTitle}>
                Descrizione
              </h2>
              <div class="grid gap-4">
                {product.description.split(/\n{2,}/).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </section>
          )
        }

        {
          isRental && (
            <div class="wide:grid-cols-2 order-5 grid gap-5">
              <section
                class="rounded-card border-hair mid:p-6 border bg-white p-5"
                aria-labelledby="includes-title"
              >
                <h3 id="includes-title" class="text-lead mb-4">
                  Cosa è incluso
                </h3>
                <ul class="grid gap-3">
                  {includes.map((item) => (
                    <li class="text-ui flex items-center gap-3">
                      <svg
                        class="text-ok size-5 flex-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M20 6L9 17l-5-5"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </section>

              <section
                class="rounded-card border-hair mid:p-6 border bg-white p-5"
                aria-labelledby="hygiene-title"
              >
                <h3 id="hygiene-title" class="text-lead mb-4">
                  Igiene e sicurezza
                </h3>
                <ul class="grid gap-3">
                  {hygiene.map((item) => (
                    <li class="text-ui flex items-center gap-3">
                      <svg
                        class="text-ok size-5 flex-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                          stroke="currentColor"
                          stroke-width="2"
                          fill="none"
                        />
                        <path
                          d="M9 12l2 2 4-4"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          )
        }

        {
          !isRental && (
            <section class="order-5" aria-labelledby="hygiene-title">
              <h2 id="hygiene-title" class={sectionTitle}>
                Igiene e sicurezza
              </h2>
              <p>
                Ogni ausilio viene <strong>sanificato, controllato e certificato</strong>. Lo ricevi
                igienizzato e pronto all'uso, con tutti gli accessori.
              </p>
            </section>
          )
        }

        {
          product.specifications.length > 0 && (
            <section class="order-5" aria-labelledby="specs-title">
              <h2 id="specs-title" class={sectionTitle}>
                Scheda tecnica
              </h2>
              <div class="rounded-card border-hair overflow-hidden border">
                {product.specifications.map((spec, index) => (
                  <div
                    class:list={[
                      'border-hair text-ui flex gap-4 border-b px-4 py-3.5 last:border-b-0',
                      index % 2 === 0 ? 'bg-tint' : 'bg-white',
                    ]}
                  >
                    <span class="font-display flex-none basis-[45%] font-semibold">
                      {spec.label}
                    </span>
                    <span class="text-ink-2 flex-1">{spec.displayValue}</span>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          product.faqs.length > 0 && (
            <section class="order-5" aria-labelledby="faq-title">
              <h2 id="faq-title" class={sectionTitle}>
                Domande frequenti su questo ausilio
              </h2>
              <ul class="grid gap-2.5">
                {product.faqs.map((faq, index) => (
                  <li>
                    <details
                      class="group rounded-field border-hair bg-tint mid:px-6 border px-4"
                      open={index === 0}
                    >
                      <summary class="font-display text-h4 flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3.5 font-semibold [&::-webkit-details-marker]:hidden">
                        {faq.question}
                        <svg
                          class="text-ink-2 size-5.5 flex-none transition-transform duration-200 group-open:rotate-180"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M6 9l6 6 6-6" />
                        </svg>
                      </summary>
                      <p class="text-ui-strong text-ink-2 max-w-[68ch] pb-5.5">{faq.answer}</p>
                    </details>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          product.terms.length > 0 && (
            <section class="order-5" aria-labelledby="terms-title">
              <h2 id="terms-title" class={sectionTitle}>
                Condizioni applicabili
              </h2>
              <ul class="grid gap-2">
                {product.terms.map((terms) => (
                  <li>
                    <a
                      class="font-display text-ui inline-flex min-h-12 items-center font-semibold text-accent"
                      href={`/${terms.slug}/`}
                    >
                      {terms.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <div class="wide:sticky wide:top-24 order-3 flex flex-col gap-5">
        <div
          class="rounded-card border-hair-strong mid:p-6 flex flex-col gap-4 border bg-white p-5"
        >
          <div class="wide:block hidden">
            <div class="flex flex-wrap items-center gap-3">
              <span
                class="bg-tint font-display text-ui inline-flex items-center rounded-full px-3.5 py-1.5 font-semibold text-accent"
              >
                {product.category.name}
              </span>
              {
                inStock && (
                  <span class="font-display text-ui text-ok inline-flex items-center gap-1.5 font-semibold">
                    <span class="size-2 rounded-full bg-current" aria-hidden="true" />
                    Disponibile subito
                  </span>
                )
              }
            </div>

            <p class="font-display mt-3 text-[1.5625rem]/[1.25] font-semibold tracking-[-0.028em]">
              {product.title}
            </p>
            {product.brand && <p class="text-ui text-ink-2 mt-1">{product.brand}</p>}
            {product.shortDescription && <p class="text-ink-2 mt-3">{product.shortDescription}</p>}
          </div>

          <ProductQuote {product} />

          <p class="rounded-field bg-tint text-ui flex items-start gap-3 px-4 py-3.5">
            <svg
              class="text-ok mt-0.5 size-5 flex-none"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
              <path
                d="M9 12l2 2 4-4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>
              <strong>Nessun pagamento online adesso.</strong> Invia la richiesta e confermiamo tutto
              al telefono.
            </span>
          </p>
        </div>

        <div
          class="rounded-card border-hair mid:p-6 flex flex-col items-start gap-3 border bg-white p-5"
        >
          <p class="font-display text-lead font-semibold">Non sai se è adatto a te?</p>
          <p class="text-ui text-ink-2">Chiamaci, ti aiutiamo a scegliere</p>
          <PhoneCta variant="primary" class="w-full" srHint="per informazioni su questo prodotto" />
          <a
            class="btn btn-soft w-full"
            href={whatsappUrl(`Informazioni su: ${product.title}`)}
            target="_blank"
            rel="noopener"
            data-analytics="whatsapp"
          >
            WhatsApp
          </a>
          <p class="text-ui text-ink-2">{CONTACT.hours.it}</p>
        </div>
      </div>
    </div>
  </div>

  {
    /*
      The mobile price bar sits directly ABOVE the persistent bottom navigation
      rather than fighting it for `bottom: 0` — two overlapping bars means one of
      them is unusable, and the navigation already reserves the safe-area inset.
    */
  }
  <div
    class="bg-ink mid:hidden fixed inset-x-0 bottom-[calc(var(--spacing-mobile-nav)+env(safe-area-inset-bottom,0px))] z-65 px-5 py-4"
  >
    <div class="max-w-page mx-auto flex items-center justify-between gap-4">
      <p class="flex items-baseline gap-2 text-white">
        {isRental && <span class="text-ui opacity-70">da</span>}
        <span class="font-display text-h4 font-bold tabular-nums">
          {formatPricing(product.pricing)}
        </span>
      </p>
      <a class="btn btn-primary min-h-12 px-6" href="#quote-form">
        {isRental ? 'Noleggia ora' : 'Richiedi'}
      </a>
    </div>
  </div>
</BaseLayout>
