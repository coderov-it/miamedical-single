---
/**
 * `/prodotto/<slug>/` — the product detail route.
 *
 * A ROUTE DECLARATION, deliberately thin. The Italian name is the URL, which is
 * an SEO commitment (see `lib/routes.ts` and the file-naming rule in AGENTS.md),
 * so this file is allowed to carry it — and everything with a name of its own
 * lives in English beside it: the body in `views/product/ProductBody.astro`, the
 * server-side working out in `lib/product-page.ts`, the browser behaviour in
 * `scripts/product/`.
 *
 * Rendered on demand so stock, price and specifications are never stale.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { mediaUrl } from '~/lib/api';
import { getProductBySlug } from '~/lib/catalog';
import { localeFromLocals, LOCALES, SOURCE_LANGUAGE, translate, type SiteLocale } from '~/lib/i18n';
import { productSlugs } from '~/lib/language-paths';
import {
  buildProductJsonLd,
  isInStock,
  pdpScriptLabels,
  readBrowseAnswers,
  resolveImages,
} from '~/lib/product-page';
import { productPath } from '~/lib/routes';
import ProductBody from '~/views/product/ProductBody.astro';

export const prerender = false;

const { slug } = Astro.params;
const locale = localeFromLocals(Astro.locals);
const product = slug ? await getProductBySlug(slug, locale) : null;

if (!product || product.slug !== slug) {
  return Astro.rewrite('/404');
}

/*
 * TWO LISTS OF LANGUAGES, deliberately different (see `lib/language-paths.ts`).
 *
 * `getProductBySlug` answers in every locale, because the API falls back to
 * Italian rather than 404-ing on a missing translation. So every locale HAS a
 * page for this product — English chrome, order panel and checkout around the
 * Italian copy, which carries `lang="it"` — and the switcher offers all of them.
 *
 * `availableLocales` is the honest list of TRANSLATIONS, and only it reaches
 * `hreflang` (via `indexedLocales`) and the sitemap: telling a search engine
 * that a re-served Italian page is the English version would be a claim this
 * site does not make (owner, 2026-09-01).
 *
 * Only translated alternates are read — their slugs differ. An untranslated
 * locale is served at the source slug, which is known without a request.
 */
const translatedLocales = LOCALES.filter(
  (candidate) => candidate !== locale && product.availableLocales.includes(candidate),
);
/* The page's own read above THROWS on an outage (a 5xx, never a false 404). An
   alternate that fails to load only loses its language link for this render. */
const translated = await Promise.all(
  translatedLocales.map(async (candidate) => {
    const alternate = await getProductBySlug(slug, candidate).catch((error: unknown) => {
      console.warn(`[product] ${slug} (${candidate}) alternate could not be read:`, error);
      return null;
    });
    return alternate ? ([candidate, alternate.slug] as const) : null;
  }),
);
const slugs = productSlugs({
  locales: LOCALES,
  current: locale,
  source: SOURCE_LANGUAGE,
  currentSlug: product.slug,
  available: product.availableLocales,
  translated: Object.fromEntries(
    translated.filter((entry): entry is NonNullable<typeof entry> => entry !== null),
  ),
});
const languagePaths = Object.fromEntries(
  Object.entries(slugs).map(([code, value]) => [code, productPath(value, {}, code as SiteLocale)]),
);
const indexedLocales = LOCALES.filter((code) => product.availableLocales.includes(code));

const isRental = product.pricing.mode === 'rental';
const inStock = isInStock(product);
const answers = readBrowseAnswers(Astro.url);
const { hero, images } = resolveImages(product);
const site = Astro.site ?? Astro.url.origin;

const jsonLd = buildProductJsonLd({ product, hero, inStock, origin: Astro.url.origin, site });
---

<BaseLayout
  title={
    product.seo.title ??
    `${product.title} | ${translate(locale, isRental ? 'product.rental' : 'product.sale')} — Mia Medical Italia`
  }
  description={
    product.seo.description ??
    product.shortDescription?.slice(0, 155) ??
    translate(locale, 'product.metaFallback', {
      type: translate(locale, isRental ? 'product.rental' : 'product.sale'),
      title: product.title,
    })
  }
  canonical={new URL(productPath(product.slug, {}, locale), site).href}
  ogImage={hero ? new URL(mediaUrl(hero.path), Astro.url.origin).href : undefined}
  {jsonLd}
  {languagePaths}
  {indexedLocales}
>
  <ProductBody {product} {images} {answers} {inStock} />
</BaseLayout>

{/*
    The words the page scripts need, as data. They cannot import `~/lib/labels`
    without pulling the whole storefront catalog into the bundle — the same deal
    the checkout's own label island makes. See `scripts/product/labels.ts`.
  */}
<script
  type="application/json"
  data-pdp-labels
  is:inline
  set:html={JSON.stringify(pdpScriptLabels(locale))}
></script>
<script>
  import '~/scripts/product/index.ts';
</script>
