---
/**
 * Product detail, from one composed product read.
 *
 * Layout and visual language follow the owner-authored reference design
 * (Claude Design project "Product details page design", file
 * "Product Details.dc.html"): hero with gallery and identity side by side,
 * numbered sections 01 Configura / 02 Extra / 03 Per la consegna / 04 Scheda
 * tecnica, information tabs, and one sticky order panel. Rationale and the
 * few deliberate deviations: docs/code/storefront-design-system.md § Product
 * detail page.
 *
 * Rendered on demand so stock, price and specifications are never stale. One
 * native GET form wraps both columns; the page script only mirrors the form
 * into the panel's display estimate — the server re-resolves everything.
 *
 * The form's own target is the CHECKOUT: "Richiedi il noleggio" is a book-now and
 * goes straight to confirmation with this one product. The panel's second button
 * overrides it with `formaction={routes.cart}` to add to the cart instead, and the
 * page script upgrades that one to write the store without leaving the page. Both
 * paths send the SAME field names — `resolveCheckout()` reads the un-prefixed
 * single-item form directly — so neither needs a second vocabulary. See
 * docs/code/storefront-cart.md.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import PdpAddons from '~/components/product/PdpAddons.astro';
import PdpConfigure from '~/components/product/PdpConfigure.astro';
import PdpHero from '~/components/product/PdpHero.astro';
import PdpInfoTabs from '~/components/product/PdpInfoTabs.astro';
import PdpOrderPanel from '~/components/product/PdpOrderPanel.astro';
import PdpQuestions from '~/components/product/PdpQuestions.astro';
import PdpSpecs from '~/components/product/PdpSpecs.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { cardPrice, mediaUrl, offerPrice } from '~/lib/api';
import { getProductBySlug } from '~/lib/catalog';
import { FIELD } from '~/lib/request-config';
import { productPath, routes } from '~/lib/routes';
import { serviceAreaCity } from '~/lib/site';

export const prerender = false;

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : null;

if (!product) {
  return Astro.rewrite('/404');
}

const isRental = product.pricing.mode === 'rental';
const inStock = product.skus.length === 0 || product.skus.some((sku) => sku.inStock);

/*
 * What the customer already told the home search, handed on by every link
 * between there and here (see `BrowseContext` in lib/routes.ts).
 *
 * Arriving straight at the catalogue is the normal other path, and it is not a
 * lesser one: with no area carried, the panel simply asks for nothing more than
 * a package and a date, and the delivery zone is settled on the confirmation
 * call. So `deliveryCity` is null far more often than not, and null renders
 * nothing rather than a placeholder.
 *
 * The date is prefilled only if it is still orderable. A link shared in March
 * and opened in June carries a start date in the past, which the field's own
 * `min` would reject — better to show it empty than pre-filled and invalid.
 */
const deliveryCity = serviceAreaCity(Astro.url.searchParams.get('area'));
const carriedStart = Astro.url.searchParams.get('from')?.trim() ?? '';
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Europe/Rome',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());
const startDate =
  /^\d{4}-\d{2}-\d{2}$/.test(carriedStart) && carriedStart >= today ? carriedStart : '';

/* The mobile bar carries the same line as the hero: on a rental that is the
   marketing rate, which advertises rather than quotes. */
const barPrice = cardPrice(product.pricing);

const hero = product.media.cleanPng ?? product.media.thumbnail ?? product.media.gallery[0] ?? null;
const images = hero
  ? [hero, ...product.media.gallery.filter((item) => item.path !== hero.path)]
  : product.media.gallery;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    ...(product.shortDescription ? { description: product.shortDescription } : {}),
    ...(hero ? { image: [new URL(mediaUrl(hero.path), Astro.url.origin).href] } : {}),
    ...(product.baseSku ? { sku: product.baseSku } : {}),
    ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
    category: product.category.name,
    offers: {
      '@type': 'Offer',
      /* The lowest real figure: a fixed product's price, or the cheapest
         package. Never the marketing rate — that is copy, and Google reads this
         as an amount someone can be charged. */
      ...(product.pricing.fromPrice ? { price: offerPrice(product.pricing.fromPrice) } : {}),
      priceCurrency: product.pricing.currency,
      availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: new URL(productPath(product.slug), Astro.site ?? Astro.url.origin).href,
    },
  },
];

if (product.faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: product.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={product.seo.title ??
    `${product.title} | ${isRental ? 'Noleggio' : 'Vendita'} — Mia Medical Italia`}
  description={product.seo.description ??
    product.shortDescription?.slice(0, 155) ??
    `${isRental ? 'Noleggio' : 'Vendita'} ${product.title} con consegna a domicilio a Roma e Firenze.`}
  canonical={new URL(productPath(product.slug), Astro.site ?? Astro.url.origin).href}
  ogImage={hero ? new URL(mediaUrl(hero.path), Astro.url.origin).href : undefined}
  {jsonLd}
>
  {
    /*
      The bottom padding clears BOTH fixed bars on phones: the price bar and the
      persistent navigation under it.
    */
  }
  <div
    class="pdp mid:px-8 mid:pb-20 mx-auto w-full max-w-310 px-5 pb-[calc(var(--spacing-mobile-bar)+var(--spacing-mobile-nav)+1.25rem)]"
  >
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Catalogo noleggio', href: routes.catalog },
        { label: product.title },
      ]}
    />

    {
      inStock ? (
        <form
          id="quote-form"
          method="get"
          action={routes.checkout}
          class="flex flex-wrap items-start gap-x-12 gap-y-10 pt-3"
          data-est-base={product.pricing.price ?? ''}
          data-est-mode={product.pricing.mode}
          data-est-currency={product.pricing.currency}
        >
          <input type="hidden" name={FIELD.product} value={product.slug} />

          <main class="flex min-w-0 flex-[1_1_540px] flex-col gap-13">
            <PdpHero {product} {images} />
            {product.variants.length > 0 && <PdpConfigure variants={product.variants} />}
            {product.addons.length > 0 && <PdpAddons addons={product.addons} />}
            {product.questions.length > 0 && <PdpQuestions questions={product.questions} />}
            {product.specifications.length > 0 && (
              <PdpSpecs specifications={product.specifications} />
            )}
            <PdpInfoTabs {product} />
          </main>

          <PdpOrderPanel {product} {deliveryCity} {startDate} {today} />
        </form>
      ) : (
        <div class="flex flex-wrap items-start gap-x-12 gap-y-10 pt-3">
          <main class="flex min-w-0 flex-[1_1_540px] flex-col gap-13">
            <PdpHero {product} {images} />
            {product.specifications.length > 0 && (
              <PdpSpecs specifications={product.specifications} />
            )}
            <PdpInfoTabs {product} />
          </main>

          <aside
            id="order"
            class="bg-tint flex max-w-100 min-w-0 flex-[1_1_320px] scroll-mt-24 flex-col gap-4 rounded-2xl p-6"
          >
            <p class="m-0">
              Questo ausilio è momentaneamente esaurito. Chiamaci: spesso abbiamo un modello
              equivalente disponibile subito.
            </p>
            <PhoneCta variant="primary" />
          </aside>
        </div>
      )
    }
  </div>

  {
    /*
      The mobile price bar sits directly ABOVE the persistent bottom navigation
      rather than fighting it for `bottom: 0` — two overlapping bars means one of
      them is unusable, and the navigation already reserves the safe-area inset.
    */
  }
  <div
    class="bg-ink mid:hidden fixed inset-x-0 bottom-[calc(var(--spacing-mobile-nav)+env(safe-area-inset-bottom,0px))] z-65 px-5 py-4"
  >
    <div class="mx-auto flex max-w-310 items-center justify-between gap-4">
      <p class="m-0 flex items-baseline gap-2 text-white">
        {barPrice?.prefix && <span class="text-[14px] opacity-70">{barPrice.prefix}</span>}
        <span class="text-[18px] font-bold tabular-nums">{barPrice?.text ?? ''}</span>
      </p>
      <a class="btn btn-primary min-h-12 px-6" href="#order">
        {inStock ? (isRental ? 'Noleggia ora' : 'Richiedi') : 'Contattaci'}
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  /*
   * The PDP's only JavaScript. Four jobs, all enhancements:
   *  - gallery thumbnails swap the main image;
   *  - the quantity stepper;
   *  - the order panel's display estimate, mirrored from the form;
   *  - "Aggiungi alla richiesta", which writes the cart store instead of
   *    navigating (and without this script, navigates instead — see below).
   * Pricing is never authoritative here — /checkout/ and /carrello/ both
   * re-resolve the request, and the phone call confirms the real price.
   */
  import {
    CART_PRODUCT_FIELD,
    CART_QUANTITY_FIELD,
    type CartLine,
    cartCount,
    clampQuantity,
    lineKey,
    readCartLines,
    writeCartLines,
  } from '~/lib/cart-store';

  // --- gallery ---------------------------------------------------------------
  const mainImg = document.querySelector<HTMLImageElement>('[data-pdp-main-img]');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-pdp-thumb]')];
  for (const thumb of thumbs) {
    thumb.addEventListener('click', () => {
      if (!mainImg) return;
      mainImg.src = thumb.dataset.src ?? mainImg.src;
      mainImg.alt = thumb.dataset.alt ?? '';
      for (const other of thumbs) {
        const active = other === thumb;
        other.classList.toggle('border-accent', active);
        other.classList.toggle('border-transparent', !active);
        if (active) other.setAttribute('aria-current', 'true');
        else other.removeAttribute('aria-current');
      }
    });
  }

  // --- quantity stepper --------------------------------------------------------
  for (const button of document.querySelectorAll('[data-qty-dec], [data-qty-inc]')) {
    button.addEventListener('click', () => {
      const row = button.closest('[data-qty-row]');
      const input = row?.querySelector<HTMLInputElement>('[data-qty-input]');
      if (!input) return;
      const current = Number.parseInt(input.value, 10) || 1;
      const min = Number.parseInt(input.min, 10) || 1;
      const max = Number.parseInt(input.max, 10) || 10;
      input.value = String(
        button.hasAttribute('data-qty-dec')
          ? Math.max(min, current - 1)
          : Math.min(max, current + 1),
      );
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }

  // --- display estimate --------------------------------------------------------
  const form = document.getElementById('quote-form') as HTMLFormElement | null;

  if (form) {
    const cfg = form.dataset;
    const base = Number(cfg.estBase ?? '0');
    const rental = cfg.estMode === 'rental';
    const fmt = new Intl.NumberFormat('it-IT', {
      style: 'currency',
      currency: cfg.estCurrency || 'EUR',
    });
    const unitWord = (n: number, unit: string) =>
      unit === 'hour' ? (n === 1 ? 'ora' : 'ore') : n === 1 ? 'giorno' : 'giorni';

    const $total = document.querySelector('[data-est-total]');
    const $note = document.querySelector('[data-est-note]');
    const $lines = document.querySelector('[data-est-lines]');
    const $start = form.querySelector<HTMLInputElement>('[data-est-start]');
    const $time = form.querySelector<HTMLInputElement>('[data-est-time]');
    const $timeRow = form.querySelector<HTMLElement>('[data-time-row]');
    const $qty = form.querySelector<HTMLInputElement>('[data-est-qty]');
    const $submit = form.querySelector<HTMLButtonElement>('[data-est-submit]');
    const $pkgTitle = document.querySelector('[data-pkg-title]');
    const $pkgToggle = document.querySelector<HTMLInputElement>('[data-pkg-toggle]');
    const $periodRow = document.querySelector<HTMLElement>('[data-period-row]');
    const $periodEnd = document.querySelector('[data-cal-end]');

    /* Shared with the calendar below, which prints the same dates in its own
       trigger — two formats for one date would read as two dates. */
    const dateFmt = new Intl.DateTimeFormat('it-IT', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
    });

    const checkedPackage = () =>
      form.querySelector<HTMLInputElement>('[data-est-kind="package"]:checked');

    /*
     * The derived return, and the ONE reason this duplicates `resolvePeriod`
     * from `@mia/pricing`: the module is server-side and this runs in the
     * browser. Keep the two arithmetics identical — UTC epoch milliseconds, so
     * a rental that crosses a DST boundary is still exactly N days.
     */
    const HOUR = 3_600_000;
    const DAY = 86_400_000;

    function derivePeriod(startDate: string, startTime: string, unit: string, duration: number) {
      if (!startDate || !duration) return null;
      const [y, m, d] = startDate.split('-').map(Number);
      if (!y || !m || !d) return null;
      const day = Date.UTC(y, m - 1, d);

      if (unit !== 'hour') {
        return {
          endDate: new Date(day + duration * DAY).toISOString().slice(0, 10),
          endTime: '',
          duration,
          unit,
        };
      }

      if (!startTime) return null;
      const [hh, mm] = startTime.split(':').map(Number);
      if (hh === undefined || mm === undefined) return null;
      const iso = new Date(day + hh * HOUR + mm * 60_000 + duration * HOUR).toISOString();
      return { endDate: iso.slice(0, 10), endTime: iso.slice(11, 16), duration, unit };
    }

    /** A package duration read in another unit, rounded up — mirrors `convertDuration`. */
    const convert = (duration: number, from: string, to: string) => {
      if (from === to) return duration;
      if (from === 'hour') return Math.ceil(duration / 24);
      return duration * 24;
    };

    /**
     * The display estimate, mirroring `priceRequest` in `@mia/pricing`.
     *
     * A rental IS its package: the package price is the base, variant modifiers
     * are added FLAT on top of it, and a rental-mode add-on multiplies by the
     * package's duration read in the add-on's own unit. With no package there is
     * nothing to price, so the panel shows a dash rather than a number.
     */
    function update() {
      let modifiers = 0;
      const labels: string[] = [];
      for (const input of form!.querySelectorAll<HTMLInputElement>('[data-est-kind="variant"]')) {
        if (!input.checked) continue;
        modifiers += Number(input.dataset.estPrice ?? '0');
        if (input.dataset.estLabel) labels.push(input.dataset.estLabel);
      }
      for (const input of form!.querySelectorAll<HTMLInputElement>('[data-est-kind="number"]')) {
        const value = Number(input.value);
        if (input.value !== '' && Number.isFinite(value)) {
          modifiers += value * Number(input.dataset.estPerUnit ?? '0');
        }
      }

      const pkgInput = checkedPackage();
      const pkg = pkgInput
        ? {
            label: pkgInput.dataset.estLabel ?? '',
            detail: pkgInput.dataset.estDetail ?? '',
            price: Number(pkgInput.dataset.estPrice ?? '0'),
            duration: Number(pkgInput.dataset.estDuration ?? '0'),
            unit: pkgInput.dataset.estUnit ?? 'day',
          }
        : null;

      // An hour package is the only case that needs a time of day.
      if ($timeRow) $timeRow.hidden = !pkg || pkg.unit !== 'hour';

      const qty = Math.max(1, Math.min(Number($qty?.value) || 1, Number($qty?.max) || 10));
      const baseLabel = labels.length > 0 ? labels.join(' · ') : 'Tariffa base';
      const lines: { label: string; amount: string }[] = [];
      const incomplete = rental && !pkg;
      let total = 0;

      if (!incomplete) {
        total = rental ? pkg!.price + modifiers : base + modifiers;

        if (pkg) {
          lines.push({ label: pkg.detail, amount: fmt.format(pkg.price) });
          if (Math.abs(modifiers) > 0.005) {
            lines.push({ label: baseLabel, amount: fmt.format(modifiers) });
          }
        } else {
          lines.push({ label: baseLabel, amount: fmt.format(total) });
        }

        for (const input of form!.querySelectorAll<HTMLInputElement>('[data-est-kind="addon"]')) {
          const row = form!.querySelector<HTMLElement>(
            `[data-addon-qty-row="${input.dataset.addonId}"]`,
          );
          const qtyInput = form!.querySelector<HTMLInputElement>(
            `[data-est-addon-qty="${input.dataset.addonId}"]`,
          );
          if (row) row.hidden = !input.checked;
          /* `hidden` still submits — only `disabled` suppresses a field — and the
             cart stores this query string, so an untouched extra would leave a
             stray quantity in storage for as long as the line lives. */
          if (qtyInput) qtyInput.disabled = !input.checked;
          if (!input.checked) continue;

          const price = Number(input.dataset.estPrice ?? '0');
          const label = input.dataset.estLabel ?? 'Extra';
          const addonQty = Math.max(1, Number(qtyInput?.value) || 1);

          if (price === 0) {
            lines.push({ label, amount: 'Incluso' });
            continue;
          }

          const billed =
            pkg && input.dataset.estMode === 'rental'
              ? convert(pkg.duration, pkg.unit, input.dataset.estUnit || pkg.unit)
              : 1;
          const amount = price * addonQty * billed;
          total += amount;

          const parts = [label];
          if (addonQty > 1) parts.push(`× ${addonQty}`);
          if (pkg && input.dataset.estMode === 'rental') {
            const addonUnit = input.dataset.estUnit || pkg.unit;
            parts.push(`× ${billed} ${unitWord(billed, addonUnit)}`);
          }
          lines.push({ label: parts.join(' '), amount: fmt.format(amount) });
        }

        total *= qty;
        if (qty > 1) lines.push({ label: 'Quantità', amount: `× ${qty}` });
      }

      if ($total) $total.textContent = incomplete ? '—' : fmt.format(total);
      if ($note) {
        $note.textContent = !rental
          ? 'prezzo del prodotto'
          : pkg
            ? `pacchetto ${pkg.label}`
            : 'scegli un pacchetto';
      }
      // The disclosure is collapsed most of the time, so the field has to say
      // what is chosen.
      if ($pkgTitle) $pkgTitle.textContent = pkg ? pkg.label : 'Scegli un pacchetto';

      /* The return date is the overview's first row, not a sub-line of the date
         field: the customer did not enter it, the package derived it. The row
         is absent until both halves of that derivation exist. */
      if ($periodRow && $periodEnd) {
        const period =
          pkg && $start?.value
            ? derivePeriod($start.value, $time?.value ?? '', pkg.unit, pkg.duration)
            : null;
        $periodRow.hidden = period === null;
        $periodEnd.textContent = period ? dateFmt.format(new Date(`${period.endDate}T12:00`)) : '';
      }

      // The server refuses a rental with no package or no start, so the CTA says
      // so here rather than letting the customer meet that as a failure later.
      if ($submit) $submit.disabled = rental && (!pkg || !$start?.value);

      if ($lines) {
        $lines.replaceChildren(
          ...lines.map((line) => {
            const li = document.createElement('li');
            li.className = 'flex justify-between gap-3';
            const label = document.createElement('span');
            label.className = 'text-ink-2 min-w-0';
            label.textContent = line.label;
            const amount = document.createElement('span');
            amount.className = 'font-semibold whitespace-nowrap tabular-nums';
            amount.textContent = line.amount;
            li.append(label, amount);
            return li;
          }),
        );
      }
    }

    // Choosing a package closes the disclosure — the choice is made, and leaving
    // it open hides the panel underneath it.
    form.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (target.dataset?.estKind === 'package' && $pkgToggle) $pkgToggle.checked = false;
      update();
    });
    form.addEventListener('input', update);

    // A CSS disclosure has no dismiss of its own.
    if ($pkgToggle) {
      const wrapper = $pkgToggle.closest('div');
      document.addEventListener('click', (event) => {
        if (!$pkgToggle.checked) return;
        if (wrapper && !wrapper.contains(event.target as Node)) $pkgToggle.checked = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') $pkgToggle.checked = false;
      });
    }

    // --- calendar ----------------------------------------------------------
    /*
     * The reference design's start-date control. It never owns the value: it
     * writes through the native date input and dispatches `change`, so the
     * estimate and the derived return above keep working unmodified.
     *
     * There is one date to pick now, which is why there is no range state left
     * here — the package decides the end, and the calendar only highlights it.
     *
     * It replaces the native row only once it has actually mounted, which is
     * what keeps the no-JavaScript path whole.
     */
    const block = document.querySelector<HTMLElement>('[data-date-block]');
    const native = block?.querySelector<HTMLElement>('[data-date-native]');
    const calBlock = block?.querySelector<HTMLElement>('[data-cal-block]');
    const trigger = block?.querySelector<HTMLButtonElement>('[data-cal-trigger]');
    const pop = block?.querySelector<HTMLElement>('[data-cal-pop]');
    const grid = block?.querySelector<HTMLElement>('[data-cal-grid]');

    if (block && native && calBlock && trigger && pop && grid && $start) {
      const cellClass =
        block.querySelector<HTMLElement>('[data-cal-cell-class]')?.dataset.calCellClass ?? '';
      const $calTitle = block.querySelector('[data-cal-title]');
      const $calStart = block.querySelector('[data-cal-start]');

      const longFmt = dateFmt;
      const monthFmt = new Intl.DateTimeFormat('it-IT', { month: 'long', year: 'numeric' });
      const fullFmt = new Intl.DateTimeFormat('it-IT', { dateStyle: 'full' });

      // Dates are handled as local Y-M-D triples. Parsing "YYYY-MM-DD" with
      // Date.parse() yields UTC midnight, which shifts a day in Rome's summer
      // offset and lands the range highlight on the wrong cell.
      const toIso = (d: Date) =>
        `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const fromIso = (iso: string) => {
        const [y, m, d] = iso.split('-').map(Number);
        return new Date(y!, (m ?? 1) - 1, d ?? 1);
      };

      const floor = $start.min || toIso(new Date());
      let cursor = fromIso($start.value || floor);
      cursor.setDate(1);

      /** The end the current package derives, so the grid can shade the span. */
      function derivedEnd(): string {
        const pkg = checkedPackage();
        if (!pkg || !$start!.value) return '';
        const period = derivePeriod(
          $start!.value,
          $time?.value ?? '',
          pkg.dataset.estUnit ?? 'day',
          Number(pkg.dataset.estDuration ?? '0'),
        );
        return period?.endDate ?? '';
      }

      function paint() {
        const start = $start!.value;
        const end = derivedEnd();

        if ($calTitle) {
          const title = monthFmt.format(cursor);
          $calTitle.textContent = title.charAt(0).toUpperCase() + title.slice(1);
        }
        if ($calStart)
          $calStart.textContent = start ? longFmt.format(fromIso(start)) : 'Scegli la data';

        // Monday-first: JS getDay() is Sunday-first, so rotate by 6 mod 7.
        const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
        const lead = (first.getDay() + 6) % 7;
        const cells: HTMLButtonElement[] = [];

        for (let i = 0; i < 42; i++) {
          const day = new Date(cursor.getFullYear(), cursor.getMonth(), 1 - lead + i);
          const iso = toIso(day);
          const cell = document.createElement('button');
          cell.type = 'button'; // inside a form, the default would submit it
          cell.className = cellClass;
          cell.textContent = String(day.getDate());
          cell.dataset.iso = iso;

          if (iso < floor) cell.disabled = true;
          if (day.getMonth() !== cursor.getMonth()) cell.dataset.out = '';
          if (iso === start || (end && iso === end)) cell.dataset.edge = '';
          else if (start && end && iso > start && iso < end) cell.dataset.range = '';

          cell.setAttribute('aria-label', fullFmt.format(day));
          if (iso === start || iso === end) cell.setAttribute('aria-current', 'date');

          cells.push(cell);
        }
        grid!.replaceChildren(...cells);
      }

      // One date to pick, so a click always sets the start.
      function choose(iso: string) {
        $start!.value = iso;
        $start!.dispatchEvent(new Event('change', { bubbles: true }));
        paint();
      }

      const setOpen = (open: boolean) => {
        pop!.hidden = !open;
        trigger!.setAttribute('aria-expanded', String(open));
        if (open) paint();
      };

      grid.addEventListener('click', (event) => {
        const cell = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-iso]');
        if (cell && !cell.disabled) choose(cell.dataset.iso!);
      });

      const shift = (months: number) => {
        cursor = new Date(cursor.getFullYear(), cursor.getMonth() + months, 1);
        paint();
      };
      block.querySelector('[data-cal-prev]')?.addEventListener('click', () => shift(-1));
      block.querySelector('[data-cal-next]')?.addEventListener('click', () => shift(1));
      block.querySelector('[data-cal-done]')?.addEventListener('click', () => {
        setOpen(false);
        trigger.focus();
      });
      trigger.addEventListener('click', () => setOpen(pop.hidden !== false));

      document.addEventListener('click', (event) => {
        if (!pop.hidden && !block.contains(event.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !pop.hidden) {
          setOpen(false);
          trigger.focus();
        }
      });

      // Picking a package moves the derived end; repaint so the shaded span and
      // the panel agree.
      form.addEventListener('change', paint);

      // Only now is the enhanced control real — swap it in.
      native.hidden = true;
      calBlock.hidden = false;
      paint();
    }

    update();
  }

  // --- add to the cart ---------------------------------------------------------

  /*
   * Upgrades the panel's second submit button from "navigate to /carrello/" to
   * "write the store and stay here".
   *
   * The button is a real submit with `formaction={routes.cart}`, so with this
   * script absent it still adds the product — it just arrives on the cart page to
   * do it, and the cart folds the URL's line into the store on mount. Everything
   * below is the difference between that and not losing the customer's place.
   */
  const $addToCart = document.querySelector<HTMLButtonElement>('[data-add-to-cart]');
  const $added = document.querySelector<HTMLElement>('[data-cart-added]');
  const $announce = document.querySelector<HTMLElement>('[data-cart-announce]');

  if ($addToCart && form) {
    $addToCart.addEventListener('click', (event) => {
      /* The form is the source of truth for the configuration, exactly as it is
         for the estimate — reading FormData means a control added to the buy box
         later is carried without this handler having to learn about it. Native
         validation still applies: let the browser refuse an invalid form first. */
      if (!form.reportValidity()) return;
      event.preventDefault();

      const data = new FormData(form);
      const config = new URLSearchParams();
      let quantity = 1;

      for (const [key, value] of data) {
        if (typeof value !== 'string') continue;
        if (key === CART_QUANTITY_FIELD) {
          // Quantity lives beside the config, never inside it — see CartLine.
          quantity = clampQuantity(value);
          continue;
        }
        if (value === '') continue;
        config.append(key, value);
      }

      if (!config.get(CART_PRODUCT_FIELD)) return;

      const serialized = config.toString();
      const key = lineKey(serialized);
      const lines = readCartLines();
      const existing = lines.find((line) => lineKey(line.config) === key);

      if (existing) {
        // Same product, same configuration: one row, more of it.
        existing.quantity = clampQuantity(existing.quantity + quantity);
      } else {
        const line: CartLine = {
          /* Random is fine HERE — unlike the server-rendered ids in `cart.ts`,
             this runs only in the browser, so there is no markup to disagree
             with, and a fresh row genuinely is a new identity. */
          id: `line-${Math.random().toString(36).slice(2, 10)}`,
          config: serialized,
          quantity,
        };
        lines.push(line);
      }

      writeCartLines(lines);

      if ($added) $added.hidden = false;

      /* Spoken separately from the visible confirmation, and ending in the cart's
         new size so the text differs on every add — see the panel's comment. */
      if ($announce) {
        const total = cartCount(lines);
        const countLabel = (
          total === 1 ? ($announce.dataset.countOne ?? '') : ($announce.dataset.countMany ?? '')
        ).replace('{count}', String(total));
        $announce.textContent = ($announce.dataset.messageTemplate ?? '').replace(
          '{count}',
          countLabel,
        );
      }
    });
  }
</script>
