---
/**
 * `/accedi/` — sign in, and the storefront's only signup. On demand and noindex:
 * it carries a `next` parameter and there is nothing here for a search engine.
 *
 * A ROUTE DECLARATION, deliberately thin: the card is
 * `views/account/SignInView.astro`, its behaviour `scripts/account/sign-in.ts`.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localeFromLocals, translate } from '~/lib/i18n';
import SignInView from '~/views/account/SignInView.astro';

export const prerender = false;

const locale = localeFromLocals(Astro.locals);
---

<BaseLayout
  title={translate(locale, 'account.signIn.metaTitle')}
  description={translate(locale, 'account.signIn.metaDescription')}
  noindex
  fillGround
  bare
>
  <SignInView />
</BaseLayout>
