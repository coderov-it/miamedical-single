---
/**
 * Catalogue. Rendered on demand so search, category filter, sort and stock are
 * always live, and so a deep link like `?q=carrozzina&page=2` is a real URL.
 *
 * Pagination is plain `<a>` links with rel=prev/next, and the category chips
 * carry no per-category count — see the deviations and gaps recorded in
 * docs/code/storefront-design-system.md.
 */
import ProductCard from '~/components/catalog/ProductCard.astro';
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import Dropdown from '~/components/primitives/Dropdown.astro';
import SectionHeading from '~/components/primitives/SectionHeading.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { listCategories, listProducts, safely, type ProductSort } from '~/lib/catalog';
import { localeFromLocals, translate } from '~/lib/i18n';
import { t } from '~/lib/labels';
import { catalogPath, routePath } from '~/lib/routes';
import { CONTACT, SERVICE_AREAS } from '~/lib/site';

export const prerender = false;

const PER_PAGE = 24;
const locale = localeFromLocals(Astro.locals);

const SORTS: { value: ProductSort; label: string }[] = [
  { value: 'newest', label: translate(locale, 'catalog.sort.newest') },
  { value: 'price_asc', label: translate(locale, 'catalog.sort.priceAsc') },
  { value: 'price_desc', label: translate(locale, 'catalog.sort.priceDesc') },
  { value: 'title', label: translate(locale, 'catalog.sort.title') },
];

const params = Astro.url.searchParams;
const q = params.get('q')?.trim() ?? '';
const category = params.get('category')?.trim() ?? '';
const requestedSort = params.get('sort') ?? '';
const sort: ProductSort = SORTS.find((option) => option.value === requestedSort)?.value ?? 'newest';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

// Carried over from the home search. Not filters yet — the API matches on text,
// category and price only — but they are what the confirmation call needs, so
// they are echoed back rather than silently dropped. Every link out of this
// page carries them on: a chip, a page or a product card that dropped them
// would make the customer answer the home search's questions twice.
const area = params.get('area')?.trim() ?? '';
const fromDate = params.get('from')?.trim() ?? '';
const duration = params.get('duration')?.trim() ?? '';
const browseContext = { area, from: fromDate, duration };
const areaLabel = SERVICE_AREAS.find((candidate) => candidate.value === area)?.label ?? '';
const durationLabel =
  duration && duration !== '0'
    ? duration === '7'
      ? t('durationOneWeek')
      : duration === '30'
        ? t('durationOneMonth')
        : t('durationDays', { count: duration })
    : '';
const fromLabel = fromDate
  ? t('fromDateContext', { date: fromDate.split('-').reverse().join('/') })
  : '';
const requestContext = [areaLabel, fromLabel, durationLabel].filter(Boolean).join(' · ');

const [result, categories] = await Promise.all([
  safely(
    () =>
      listProducts({
        page,
        perPage: PER_PAGE,
        sort,
        ...(q ? { q } : {}),
        ...(category ? { category } : {}),
      }),
    { data: [], meta: { page, perPage: PER_PAGE, total: 0, pageCount: 1 }, facets: { specs: [] } },
    'listProducts',
  ),
  safely(() => listCategories(), [], 'listCategories'),
]);

const { data: productList, meta } = result;
const isFirstPage = meta.page <= 1;
const isFiltered = Boolean(q || category);
const activeCategory = categories.find((candidate) => candidate.code === category);

const prevUrl =
  meta.page > 1
    ? catalogPath({ q, category, sort, page: meta.page - 1, ...browseContext }, locale)
    : null;
const nextUrl =
  meta.page < meta.pageCount
    ? catalogPath({ q, category, sort, page: meta.page + 1, ...browseContext }, locale)
    : null;

const heading = activeCategory ? activeCategory.name : translate(locale, 'catalog.title');
const title = isFirstPage
  ? `${heading} | Roma e Firenze — Mia Medical Italia`
  : `${heading} — ${translate(locale, 'blog.pageTitle', { page: meta.page })} | Mia Medical Italia`;

const chipClass =
  'inline-flex min-h-12 items-center rounded-full px-4.5 font-display text-ui font-semibold no-underline';
---

<BaseLayout
  {title}
  description={translate(locale, 'catalog.description')}
  canonical={new URL(routePath(locale, 'catalog'), Astro.site ?? Astro.url.origin).href}
  noindex={isFiltered || !isFirstPage}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  <div class="max-w-page pb-section-sm mid:px-8 mid:pb-section mx-auto w-full px-5">
    <Breadcrumbs
      items={[
        { label: translate(locale, 'home'), href: routePath(locale, 'home') },
        ...(activeCategory
          ? [
              { label: translate(locale, 'catalog.title'), href: routePath(locale, 'catalog') },
              { label: activeCategory.name },
            ]
          : [{ label: translate(locale, 'catalog.title') }]),
      ]}
    />

    <header class="pt-2 pb-8">
      <h1 class="text-[clamp(2rem,3.2vw,2.5rem)]/[1.14]">{heading}</h1>
      <p class="text-lead text-ink-2 mt-3 max-w-[56ch]">
        {translate(locale, 'catalog.lede')}
      </p>
      <p class="font-display text-ui text-ink-2 mt-3.5 font-semibold">
        {
          `${meta.total} ${translate(locale, meta.total === 1 ? 'catalog.available.one' : 'catalog.available.many')}`
        }
        {
          meta.pageCount > 1 && (
            <span>{` · ${translate(locale, 'catalog.page', { page: meta.page, total: meta.pageCount })}`}</span>
          )
        }
      </p>
      {
        requestContext && (
          <p class="rounded-field bg-tint text-ui mt-4 px-5 py-4">
            <strong>{translate(locale, 'catalog.requestContext')}</strong> {requestContext}.{' '}
            {translate(locale, 'catalog.requestDetail')}
          </p>
        )
      }
    </header>

    <form
      class="rounded-card border-hair mb-10 flex flex-wrap items-end gap-3.5 border bg-white p-5"
      method="get"
      role="search"
      aria-label={translate(locale, 'catalog.search')}
    >
      {category && <input type="hidden" name="category" value={category} />}
      {area && <input type="hidden" name="area" value={area} />}
      {fromDate && <input type="hidden" name="from" value={fromDate} />}
      {duration && <input type="hidden" name="duration" value={duration} />}

      {
        /* The label wraps its own well: the micro-label, the grey box and every
           pixel of padding inside it all focus the field (app.css § field). */
      }
      <label class="flex min-w-0 flex-1 basis-65 flex-col gap-2.25" for="catalog-q">
        <span class="field-label">{translate(locale, 'catalog.searchLabel')}</span>
        <span class="field-control">
          <input
            id="catalog-q"
            class="font-display text-body font-semibold"
            type="search"
            name="q"
            value={q}
            placeholder={translate(locale, 'catalog.searchPlaceholder')}
          />
        </span>
      </label>

      <Dropdown
        id="catalog-sort"
        name="sort"
        label={translate(locale, 'catalog.sort')}
        options={SORTS}
        value={sort}
        class="mid:grow-0 flex min-w-0 flex-1 basis-60"
      />

      <button
        class="rounded-field font-display text-ui-strong hover:bg-accent-deep inline-flex min-h-14.5 flex-none items-center justify-center border-0 bg-accent px-6 font-semibold text-white"
        type="submit"
      >
        {translate(locale, 'catalog.apply')}
      </button>

      {
        isFiltered && (
          <a
            class="font-display text-ui text-ink-2 inline-flex min-h-14.5 items-center px-3 font-semibold"
            href={routePath(locale, 'catalog')}
          >
            {translate(locale, 'catalog.clear')}
          </a>
        )
      }
    </form>

    {
      categories.length > 0 && (
        <section class="pb-10" aria-labelledby="browse-title">
          <h2 id="browse-title" class="text-h3 mb-4">
            {translate(locale, 'catalog.browse')}
          </h2>
          {/*
            A wrapped grid of links, deliberately NOT the design's horizontal
            overflow scroller: at 200% zoom and 400% reflow the right-hand items
            become undiscoverable, and it reintroduces horizontal scrolling.
          */}
          <ul class="flex flex-wrap gap-2">
            <li>
              <a
                class:list={[
                  chipClass,
                  !category ? 'bg-accent-tint text-accent' : 'bg-tint text-ink hover:bg-tint-2',
                ]}
                href={catalogPath({ q, sort, ...browseContext }, locale)}
                aria-current={!category ? 'true' : undefined}
              >
                {translate(locale, 'catalog.all')}
              </a>
            </li>
            {/* `candidate`, not `category`: the outer `category` is the ACTIVE
                one from the URL, and shadowing it here silently compares a
                category against itself. */}
            {categories.map((candidate) => (
              <li>
                <a
                  class:list={[
                    chipClass,
                    candidate.code === category
                      ? 'bg-accent-tint text-accent'
                      : 'bg-tint text-ink hover:bg-tint-2',
                  ]}
                  href={catalogPath(
                    { q, category: candidate.code, sort, ...browseContext },
                    locale,
                  )}
                  aria-current={candidate.code === category ? 'true' : undefined}
                >
                  {candidate.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="products-title">
      <h2 id="products-title" class="text-h3 mb-6">
        {
          q
            ? translate(locale, 'catalog.results', { query: q })
            : translate(locale, 'catalog.allProducts')
        }
      </h2>

      {
        productList.length === 0 ? (
          <div class="rounded-card bg-tint mid:p-8 grid justify-items-start gap-4 p-6">
            <p class="font-display text-h4 font-semibold">{translate(locale, 'catalog.empty')}</p>
            <p>{translate(locale, 'catalog.helpDetail')}</p>
            <PhoneCta variant="primary" />
          </div>
        ) : (
          <ul class="wide:grid-cols-3 grid gap-6 sm:grid-cols-2">
            {productList.map((product, index) => (
              <li class="flex">
                <ProductCard
                  product={product}
                  priority={isFirstPage && index === 0}
                  headingLevel={3}
                  context={browseContext}
                />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      meta.pageCount > 1 && (
        <nav
          class="border-hair mt-10 flex flex-wrap items-center justify-between gap-4 border-t pt-6"
          aria-label={translate(locale, 'catalog.pagination')}
        >
          {prevUrl ? (
            <a class="btn btn-soft" href={prevUrl} rel="prev">
              {translate(locale, 'catalog.previous')}
            </a>
          ) : (
            <span class="btn btn-soft text-ink-2 opacity-60" aria-hidden="true">
              {translate(locale, 'catalog.previous')}
            </span>
          )}

          <p class="font-display text-ui text-ink-2 font-semibold">
            {translate(locale, 'catalog.page', { page: meta.page, total: meta.pageCount })}
          </p>

          {nextUrl ? (
            <a class="btn btn-soft" href={nextUrl} rel="next">
              {translate(locale, 'catalog.next')}
            </a>
          ) : (
            <span class="btn btn-soft text-ink-2 opacity-60" aria-hidden="true">
              {translate(locale, 'catalog.next')}
            </span>
          )}
        </nav>
      )
    }

    <section class="mt-section-sm mid:mt-section" aria-labelledby="help-title">
      <SectionHeading
        id="help"
        heading={translate(locale, 'catalog.help')}
        lede={translate(locale, 'catalog.helpDetail')}
      />
      <div class="rounded-card bg-tint mid:p-8 flex flex-wrap items-center gap-4 p-6">
        <PhoneCta variant="primary" />
        <p class="text-ui text-ink-2">{CONTACT.hours[locale]}</p>
      </div>
    </section>
  </div>
</BaseLayout>
