---
/**
 * `/checkout/` — the confirmation route.
 *
 * A ROUTE DECLARATION, deliberately thin: the body is in
 * `views/checkout/CheckoutBody.astro`, the server-side working out in
 * `lib/checkout-page.ts`, the browser behaviour in `scripts/checkout/`. See the
 * file-size and page-file rules in AGENTS.md.
 *
 * "Checkout" is the loanword Italian e-commerce actually uses, and it is what the
 * owner's reference design names this step — so the path is not translated. Its
 * governance is `lib/routes.ts` like every other public path.
 *
 * Rendered on demand, never cached and never indexed: this page is built out of
 * one person's request.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { resolveCheckout } from '~/lib/checkout';
import {
  CHECKOUT_SCRIPT_LABELS,
  buildHandoverMessage,
  readRequestParams,
} from '~/lib/checkout-page';
import { t } from '~/lib/labels';
import CheckoutBody from '~/views/checkout/CheckoutBody.astro';

export const prerender = false;

// Never cache a page built from someone's request details.
Astro.response.headers.set('cache-control', 'no-store, max-age=0');

const checkout = await resolveCheckout(await readRequestParams(Astro.request, Astro.url));
const handoverMessage = buildHandoverMessage(checkout.items);

/**
 * The order body's line items, resolved and priced on the server, shipped to the
 * browser as data.
 *
 * Choices only — a slug, option values, dates, a quantity. Not one amount,
 * because the API prices them again from the catalogue and would ignore any
 * figure sent here. That is also why it is safe for this to sit in the page: the
 * worst a reader can do by editing it is order something else at that thing's
 * real price.
 */
const orderItems = checkout.items.map((item) => item.order);
---

<BaseLayout title={t('checkoutMetaTitle')} description={t('checkoutMetaDescription')} noindex>
  <CheckoutBody {checkout} {handoverMessage} />

  <script
    type="application/json"
    data-checkout-labels
    is:inline
    set:html={JSON.stringify(CHECKOUT_SCRIPT_LABELS)}
  />

  <script
    type="application/json"
    data-checkout-items
    is:inline
    set:html={JSON.stringify(orderItems)}
  />

  {
    /*
      Synchronous and inline on purpose. The step bodies are server-rendered OPEN
      and the stepper's forward buttons server-rendered hidden, so that a browser
      with no JavaScript gets one long readable form and a WhatsApp handover that
      already carries the line items — a complete path, not a degraded one. This
      flips that arrangement during parse, before first paint, which is what keeps
      the enhanced page from flashing every step open.
    */
  }
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-checkout]');
      if (!root) return;
      var bodies = root.querySelectorAll('[data-step-body]');
      for (var i = 0; i < bodies.length; i++) {
        if (bodies[i].getAttribute('data-step-body') !== '1') bodies[i].hidden = true;
      }
      var ctas = root.querySelectorAll('[data-step-continue]');
      for (var j = 0; j < ctas.length; j++) ctas[j].hidden = false;

      /* The confirm CTA is server-rendered as the WhatsApp handover, because with
         no JavaScript that is exactly what it is. Here there IS JavaScript, so it
         records the order first — retitled at parse time, before first paint, so
         the button never visibly changes its mind. */
      var place = root.querySelector('[data-place-order]');
      var labels = document.querySelector('[data-checkout-labels]');
      if (place && labels) {
        try {
          var words = JSON.parse(labels.textContent || '{}');
          if (words.sendRequest) place.textContent = words.sendRequest;
        } catch (error) {
          /* Leave the WhatsApp label in place — it is the honest fallback. */
        }
      }
    })();
  </script>
</BaseLayout>

<script>
  import '~/scripts/checkout/index.ts';
</script>
