---
/**
 * Checkout — the owner-authored reference design, in three steps.
 *
 * Its spec is the Claude Design file "Checkout.dc.html" from the same project as
 * the product detail page, and like the PDP it is deliberately released from
 * Variante B: Instrument Sans, sub-16px secondary text, the reference's own
 * radii and spacing. Layout, rationale and every deliberate deviation:
 * docs/code/storefront-checkout.md
 *
 * One page serves both entry points. `resolveCheckout()` reads the single-item
 * form a product detail page writes and the `i<n>.`-indexed form a cart writes
 * into the same list, so nothing below branches on where the request came from —
 * only on how many items came with it.
 *
 * Rendered on demand, never cached and never indexed: this page is built out of
 * one person's request.
 */
import CheckoutConfirm from '~/components/checkout/CheckoutConfirm.astro';
import CheckoutDelivery from '~/components/checkout/CheckoutDelivery.astro';
import CheckoutDetails from '~/components/checkout/CheckoutDetails.astro';
import CheckoutOverview from '~/components/checkout/CheckoutOverview.astro';
import CheckoutReturn from '~/components/checkout/CheckoutReturn.astro';
import CheckoutStep from '~/components/checkout/CheckoutStep.astro';
import { CTA } from '~/components/checkout/styles';
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { API_BASE } from '~/lib/api';
import { resolveCheckout } from '~/lib/checkout';
import { t } from '~/lib/labels';
import { formatDateLabel } from '~/lib/request-config';
import { productPath, routes } from '~/lib/routes';
import { CONTACT, whatsappUrl } from '~/lib/site';

export const prerender = false;

// Never cache a page built from someone's request details.
Astro.response.headers.set('cache-control', 'no-store, max-age=0');

/**
 * A cart POSTs its line items; a product detail page can still GET a single one.
 *
 * POST is the cart's path because a multi-item request outgrows a URL and none of
 * it belongs in browser history — but it is a NATIVE form post of hidden inputs,
 * not a fetch, so it still works with JavaScript off. A FormData is normalised
 * into URLSearchParams here so everything downstream reads one shape and cannot
 * tell the two apart. Astro's `security.checkOrigin` default rejects a
 * cross-origin post before this runs.
 */
async function readRequestParams(): Promise<URLSearchParams> {
  if (Astro.request.method !== 'POST') return Astro.url.searchParams;

  const params = new URLSearchParams();
  try {
    for (const [key, value] of await Astro.request.formData()) {
      // A file upload has no business in a checkout request; drop it rather than
      // stringify it into "[object File]".
      if (typeof value === 'string') params.append(key, value);
    }
  } catch {
    // Malformed or missing body — fall through to the empty state.
  }
  return params;
}

const checkout = await resolveCheckout(await readRequestParams());
const { items } = checkout;
const single = items.length === 1;

/**
 * Whether anything here comes back — which is what makes step 2 two questions
 * instead of one.
 *
 * `some`, not `every`: a mixed request with one rented item still has a collection
 * to arrange, and a customer should not have to split the order to say where.
 */
const hasRental = items.some((item) => item.product.pricing.mode === 'rental');

/**
 * The handover message, from resolved labels only — never from raw input.
 *
 * The page script appends the contact and delivery details the customer types in
 * here; this part is server-built so the WhatsApp link is already complete and
 * correct without JavaScript.
 */
const whatsappBase = items
  .flatMap((item) => [
    `• ${item.product.title}`,
    ...item.request.selections.map((entry) => `  ${entry.label}: ${entry.value}`),
    ...(item.request.rentalPackage
      ? [
          `  ${t('msgPackage')}: ${item.request.rentalPackage.name} (${item.request.rentalPackage.label})`,
        ]
      : []),
    ...(item.request.startDate
      ? [`  ${t('msgFrom')}: ${formatDateLabel(item.request.startDate)}`]
      : []),
    ...(item.request.endDate ? [`  ${t('msgTo')}: ${formatDateLabel(item.request.endDate)}`] : []),
    ...(item.request.quantity > 1 ? [`  ${t('quantity')}: ${item.request.quantity}`] : []),
    ...item.request.addons.map((addon) => `  ${t('msgExtra')}: ${addon.name}`),
    ...item.request.answers.map((entry) => `  ${entry.label} ${entry.value}`),
    `  ${t('msgEstimate')}: ${item.subtotal}`,
  ])
  .join('\n');

const whatsappMessage = `${t('rentalRequestHeading')}\n${whatsappBase}`;

/**
 * The words the page script needs at click time, resolved on the server.
 *
 * It ships as a JSON island rather than being imported, for the same reason the
 * delivery fees ride on their cards: importing `~/lib/labels` would put the whole
 * storefront catalog in the browser bundle to get fourteen strings. This also
 * keeps the rule intact — no Italian literal exists inside the script.
 */
const SCRIPT_LABELS = {
  delivery: t('delivery'),
  free: t('free'),
  name: t('msgName'),
  email: t('msgEmail'),
  phone: t('msgPhone'),
  customerType: t('msgCustomerType'),
  codiceFiscale: t('codiceFiscale'),
  partitaIva: t('partitaIva'),
  deliveryLine: t('msgDelivery'),
  toBeArranged: t('msgToBeArranged'),
  deliveryAddress: t('msgDeliveryAddress'),
  deliveryPending: t('deliveryPending'),
  pickupBranch: t('msgPickupBranch'),
  notes: t('msgNotes'),
  collectedAtBranch: t('collectedAtBranch'),
  /* The return leg's heading, reused in the review line and the handover message. */
  returnStage: t('returnStage'),
  requestNumberPrefix: t('msgRequestNumber'),
  /* Read by the parse-time script, which retitles the CTA before first paint:
     with JavaScript the control records the order rather than opening WhatsApp. */
  sendRequest: t('sendRequest'),
  sendingRequest: t('sendingRequest'),
} as const;

/**
 * The order body's line items, resolved and priced on the server, shipped to the
 * browser as data.
 *
 * Choices only — a slug, option values, dates, a quantity. Not one amount, because
 * the API prices them again from the catalogue and would ignore any figure sent
 * here. That is also why it is safe for this to sit in the page: the worst a reader
 * can do by editing it is order something else at that thing's real price.
 */
const ORDER_ITEMS = items.map((item) => item.order);

/* The trail names where the request came from: the product itself when there is
   one, the cart when there are several. */
const originCrumb =
  single && items[0]
    ? { label: items[0].product.title, href: productPath(items[0].product.slug) }
    : { label: t('yourRequest'), href: routes.cart };
---

<BaseLayout title={t('checkoutMetaTitle')} description={t('checkoutMetaDescription')} noindex>
  {
    /*
      The bottom padding clears the persistent bottom navigation on phones; the
      reference design's own 96px takes over from `mid` up.
    */
  }
  <div
    class="checkout mid:px-8 mid:pb-24 mx-auto w-full max-w-310 px-5 pb-[calc(var(--spacing-mobile-nav)+1.25rem)]"
    data-checkout
    data-api-base={API_BASE}
  >
    <Breadcrumbs items={[{ label: t('home'), href: '/' }, originCrumb, { label: t('checkout') }]} />

    <h1 class="mb-7 text-[30px] font-bold tracking-[-0.015em]">{t('checkout')}</h1>

    {
      items.length > 0 ? (
        <div class="flex flex-wrap items-start gap-12">
          <main class="flex min-w-0 flex-[1_1_540px] flex-col gap-4">
            <CheckoutStep index={1} title={t('yourDetails')}>
              <CheckoutDetails />
            </CheckoutStep>

            <CheckoutStep index={2} title={t('delivery')} bodyGap="gap-3.5">
              {/*
                  Two questions, in the order they happen: where it goes, then where
                  it comes back from. The second only exists for a rental, and the
                  forward button sits after BOTH — a "Continua" rendered above an
                  unanswered question invites the customer to skip it.
                */}
              <CheckoutDelivery labelStage={hasRental} />
              {hasRental && <CheckoutReturn />}
              <button class={CTA} type="button" data-step-continue="2" hidden>
                {t('continueToConfirmation')}
              </button>
            </CheckoutStep>

            <CheckoutStep index={3} title={t('confirmRequest')} editable={false}>
              <CheckoutConfirm
                whatsappHref={whatsappUrl(whatsappMessage)}
                whatsappBase={whatsappMessage}
                blocked={checkout.blocked}
                blockedItem={checkout.blockedItem}
                backHref={
                  /* The blocking item's own page when there is one, so a
                     multi-item cart sends the customer to the row that needs
                     fixing rather than to the list. */
                  checkout.blockedItem && !single
                    ? productPath(checkout.blockedItem.product.slug)
                    : originCrumb.href
                }
              />
            </CheckoutStep>
          </main>

          <CheckoutOverview {checkout} />
        </div>
      ) : (
        /*
          The reference design has no empty state — it always has a cart behind
          it. Arriving here with nothing resolvable is normal all the same (a
          shared link, a product since unpublished), and it must not be a dead
          end.
        */
        <div class="border-hair shadow-pdp-card flex max-w-150 flex-col items-start gap-4 rounded-[14px] border bg-white p-7">
          <h2 class="text-[17px] font-bold">{t('nothingToConfirm')}</h2>
          <p class="text-ink-2 m-0 text-[15px] leading-[1.55]">{t('nothingToConfirmDetail')}</p>
          <a
            class="border-hair-strong text-ink rounded-full border-[1.5px] bg-white px-5.5 py-2.75 text-[15.5px] font-semibold no-underline hover:border-accent hover:text-accent"
            href={routes.catalog}
          >
            {t('goToCatalog')}
          </a>
          <p class="text-ink-2 m-0 text-[13.5px]">{CONTACT.hours.it}</p>
          <PhoneCta variant="primary" />
        </div>
      )
    }
  </div>

  {
    /*
      Synchronous and inline on purpose. The step bodies are server-rendered OPEN
      and the stepper's forward buttons server-rendered hidden, so that a
      browser with no JavaScript gets one long readable form and a WhatsApp
      handover that already carries the line items — a complete path, not a
      degraded one. This flips that arrangement during parse, before first paint,
      which is what keeps the enhanced page from flashing every step open.
    */
  }
  <script
    type="application/json"
    data-checkout-labels
    is:inline
    set:html={JSON.stringify(SCRIPT_LABELS)}
  />

  <script
    type="application/json"
    data-checkout-items
    is:inline
    set:html={JSON.stringify(ORDER_ITEMS)}
  />

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-checkout]');
      if (!root) return;
      var bodies = root.querySelectorAll('[data-step-body]');
      for (var i = 0; i < bodies.length; i++) {
        if (bodies[i].getAttribute('data-step-body') !== '1') bodies[i].hidden = true;
      }
      var ctas = root.querySelectorAll('[data-step-continue]');
      for (var j = 0; j < ctas.length; j++) ctas[j].hidden = false;

      /* The confirm CTA is server-rendered as the WhatsApp handover, because with
         no JavaScript that is exactly what it is. Here there IS JavaScript, so it
         records the order first — retitled at parse time, before first paint, so
         the button never visibly changes its mind. */
      var place = root.querySelector('[data-place-order]');
      var labels = document.querySelector('[data-checkout-labels]');
      if (place && labels) {
        try {
          var words = JSON.parse(labels.textContent || '{}');
          if (words.sendRequest) place.textContent = words.sendRequest;
        } catch (error) {
          /* Leave the WhatsApp label in place — it is the honest fallback. */
        }
      }
    })();
  </script>
</BaseLayout>

<script>
  /*
   * The checkout's only module script.
   *
   * It owns exactly one thing the server cannot: the customer's in-progress
   * answers. Everything visual is CSS keyed off `data-state` on a step and
   * `data-selected` on a card (see the checkout block in app.css), so this file
   * writes attributes and text, never style strings — unlike the reference
   * design, which rebuilds every style string on every render.
   *
   * Money is a DISPLAY ESTIMATE. The item totals are server-computed and arrive
   * in `data-items-total`; the only arithmetic here is adding the delivery fee.
   *
   * Nothing is imported on purpose. The delivery fees and labels live on the
   * cards as data attributes because importing them from src/lib/checkout.ts
   * would drag the whole typed API client into the browser bundle to get three
   * numbers, and the chips carry their own labels as text already.
   */
  const checkoutEl = document.querySelector<HTMLElement>('[data-checkout]');
  const overviewEl = document.querySelector<HTMLElement>('[data-overview]');

  if (checkoutEl && overviewEl) {
    /* Re-bound inside the guard: the functions below are hoisted declarations, so
       a narrowing that lives outside their scope does not reach them. */
    const root = checkoutEl;
    const overview = overviewEl;

    type StepIndex = 1 | 2 | 3;

    const cards = [...root.querySelectorAll<HTMLElement>('[data-delivery-card]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-customer-type]')];

    /* The return leg. All three are absent when nothing in the order is rented, so
       every use is guarded — `returnSame === null` IS "this order has no return". */
    const returnSame = root.querySelector<HTMLInputElement>('[data-field-return-same]');
    const returnSameLabel = root.querySelector<HTMLElement>('[data-return-same-label]');
    const returnAddressField = root.querySelector<HTMLElement>('[data-return-address-field]');

    const NAMES = new Map(
      cards.map((card) => [card.dataset.deliveryCard ?? '', card.dataset.deliveryName ?? '']),
    );
    const SHORT = new Map(
      cards.map((card) => [card.dataset.deliveryCard ?? '', card.dataset.deliveryShort ?? '']),
    );
    const TYPE_LABELS = new Map(
      chips.map((chip) => [chip.dataset.customerType ?? '', chip.textContent?.trim() ?? '']),
    );

    /* Server-resolved words; see SCRIPT_LABELS in this file's frontmatter. */
    const labels: Record<string, string | undefined> = JSON.parse(
      document.querySelector('[data-checkout-labels]')?.textContent ?? '{}',
    );

    /* The order's line items and the API origin, both resolved on the server and
       read off the DOM rather than imported: importing `~/lib/api` would pull the
       whole typed Hono client into this bundle to get one string. */
    const ORDER_ITEMS: unknown[] = JSON.parse(
      document.querySelector('[data-checkout-items]')?.textContent ?? '[]',
    );
    const API_BASE = root.dataset.apiBase ?? '';
    /* A missing key is a build-time bug, not a runtime one — but an empty string
       beats "undefined" turning up in a customer's WhatsApp message. */
    const L = (key: string): string => labels[key] ?? '';

    const itemsTotal = Number(overview.dataset.itemsTotal ?? '0');
    /* An open period used to matter here: it makes the big figure a per-unit rate,
       and a delivery fee must not be folded into one — two incompatible
       quantities. Nothing is added to it now, so the total is the items figure
       whichever kind it is, and the qualifier rendered underneath still says
       which. */
    const money = new Intl.NumberFormat('it-IT', {
      style: 'currency',
      currency: overview.dataset.currency || 'EUR',
    });

    const state = {
      step: 1 as StepIndex,
      done: { 1: false, 2: false } as Record<number, boolean>,
      type: 'private',
      delivery: '' as string,
      pickup: '',
      placed: false,
      /** A request is in flight; a second click must not open a second order. */
      sending: false,
    };

    const field = (name: string) =>
      root.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        `[data-field="${name}"]`,
      );
    const value = (name: string) => field(name)?.value.trim() ?? '';

    const sections = [...root.querySelectorAll<HTMLElement>('[data-step]')];

    // --- steps ---------------------------------------------------------------

    function summarise(index: StepIndex): string {
      if (index === 1) {
        return [
          `${value('firstName')} ${value('lastName')}`.trim(),
          value('email'),
          TYPE_LABELS.get(state.type) ?? '',
        ]
          .filter(Boolean)
          .join(' · ');
      }
      return NAMES.get(state.delivery) ?? '';
    }

    function paintSteps() {
      for (const section of sections) {
        const index = Number(section.dataset.step) as StepIndex;
        const done = state.done[index] === true && state.step !== index;
        section.dataset.state = done ? 'done' : state.step === index ? 'active' : 'todo';

        const body = section.querySelector<HTMLElement>('[data-step-body]');
        if (body) body.hidden = state.step !== index;

        const summary = section.querySelector<HTMLElement>('[data-step-summary]');
        if (summary) summary.textContent = index === 3 ? '' : summarise(index);
      }
    }

    function goTo(step: StepIndex) {
      state.step = step;
      paintSteps();
      if (step === 3) paintReview();
      const section = sections.find((candidate) => Number(candidate.dataset.step) === step);
      section?.scrollIntoView({ block: 'nearest' });
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-step-edit]')) {
      button.addEventListener('click', () => goTo(Number(button.dataset.stepEdit) as StepIndex));
    }

    // --- validity ------------------------------------------------------------

    /* Deliberately the same rules the reference design applies, in the same
       order: a name, an address, something that looks like an email, a phone,
       and whichever fiscal identifier the chosen identity implies. */
    /* Who they are, and how to reach them. No address: that is step 2's, and only
       when something is being delivered. */
    const step1Valid = () =>
      Boolean(
        value('firstName') &&
        value('lastName') &&
        value('email').includes('@') &&
        value('phone') &&
        (state.type !== 'private' || value('codiceFiscale')) &&
        (state.type !== 'company' || (value('partitaIva') && value('companyCodiceFiscale'))),
      );

    const step2Valid = () => {
      if (!state.delivery) return false;
      if (state.delivery === 'homeDelivery') {
        /* A street, a comune, and five digits exactly — the same shape the API's
           `CapSchema` insists on, checked here so the customer hears about it while
           they are still in the field rather than at the end.

           One free-text address, so there is one thing to check. The length floor
           matches `CheckoutAddressSchema`: shorter than this is not an address, and
           catching it here means the customer hears about it before they submit. */
        return value('address').length >= 6 && returnValid();
      }
      return Boolean(state.pickup) && returnValid();
    };

    /**
     * The return leg, which both methods have.
     *
     * Ticked, or absent because nothing is rented, means the delivery address and
     * there is nothing to check. Unticked means the customer took on answering, so
     * the answer has to be there.
     */
    const returnValid = () =>
      returnSame === null || returnSame.checked || Boolean(value('returnAddress'));

    function paintCtas() {
      const checks: Record<string, boolean> = { 1: step1Valid(), 2: step2Valid() };
      for (const cta of root.querySelectorAll<HTMLButtonElement>('[data-step-continue]')) {
        const ok = checks[cta.dataset.stepContinue ?? ''] === true;
        cta.setAttribute('aria-disabled', String(!ok));
      }
    }

    for (const cta of root.querySelectorAll<HTMLButtonElement>('[data-step-continue]')) {
      cta.addEventListener('click', () => {
        if (cta.getAttribute('aria-disabled') === 'true') return;
        const from = Number(cta.dataset.stepContinue) as StepIndex;
        state.done[from] = true;
        goTo((from + 1) as StepIndex);
      });
    }

    // --- identity chips ------------------------------------------------------

    function selectType(id: string) {
      state.type = id;
      for (const chip of chips) {
        const on = chip.dataset.customerType === id;
        chip.setAttribute('aria-checked', String(on));
        chip.setAttribute('aria-pressed', String(on));
      }
      for (const block of root.querySelectorAll<HTMLElement>('[data-when-type]')) {
        block.hidden = block.dataset.whenType !== id;
      }
      paintCtas();
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => selectType(chip.dataset.customerType ?? 'private'));
    }

    // --- auto-growing textareas ----------------------------------------------

    /**
     * A textarea that starts at its `rows` height and follows what is typed.
     *
     * Two rows is the resting size because an empty box three rows tall looks like
     * a field somebody already filled. It grows instead of scrolling, so a long
     * address is read in one piece rather than through a slot.
     *
     * Measured from `scrollHeight`, which needs the element laid out — inside a
     * hidden panel it reports 0 and would collapse the box to nothing. Hence the
     * visibility guard, and hence `growAll()` running when a panel opens rather
     * than on input alone.
     */
    const growers = [...root.querySelectorAll<HTMLTextAreaElement>('textarea[data-autogrow]')];

    function grow(box: HTMLTextAreaElement) {
      if (box.offsetParent === null) return;
      box.style.height = 'auto';
      /* `scrollHeight` covers content and padding but not the border, and these
         controls are `border-box` — so the border has to be added back or the box
         ends up one row short and scrolls by a hair. */
      const border = box.offsetHeight - box.clientHeight;
      box.style.height = `${box.scrollHeight + border}px`;
    }

    function growAll() {
      for (const box of growers) grow(box);
    }

    for (const box of growers) box.addEventListener('input', () => grow(box));

    // --- delivery ------------------------------------------------------------

    function selectDelivery(id: string) {
      state.delivery = id;
      for (const card of cards) {
        const on = card.dataset.deliveryCard === id;
        card.toggleAttribute('data-selected', on);
        card.querySelector('[data-delivery-select]')?.setAttribute('aria-checked', String(on));
        const panel = card.querySelector<HTMLElement>('[data-delivery-panel]');
        if (panel) panel.hidden = !on;
      }
      /* The panel this opened is only now measurable — see `grow`. */
      growAll();
      /* The question is the same for both methods; only the noun changes. An
         address gets collected from, a sede gets brought back to. */
      if (returnSameLabel) {
        const wording =
          id === 'storePickup'
            ? returnSameLabel.dataset.labelPickup
            : returnSameLabel.dataset.labelHome;
        if (wording) returnSameLabel.textContent = wording;
      }
      paintTotal();
      paintCtas();
    }

    for (const card of cards) {
      card
        .querySelector('[data-delivery-select]')
        ?.addEventListener('click', () => selectDelivery(card.dataset.deliveryCard ?? ''));
    }

    // --- the return leg ------------------------------------------------------

    /**
     * Unticking is the deliberate act, so it is what reveals the field. Ticking it
     * again CLEARS what was typed rather than remembering it: a stale address hidden
     * behind a ticked box is a fact nobody can see and the server would have
     * refused anyway.
     */
    function paintReturn() {
      if (!returnSame) return;
      const elsewhere = !returnSame.checked;
      if (returnAddressField) returnAddressField.hidden = !elsewhere;
      if (!elsewhere) {
        const input = field('returnAddress');
        if (input) input.value = '';
      }
      paintCtas();
    }

    returnSame?.addEventListener('change', paintReturn);
    field('returnAddress')?.addEventListener('input', () => paintCtas());

    // --- overview total -----------------------------------------------------

    /**
     * The overview's delivery row and running total.
     *
     * Collection is free and says so. Home delivery costs something nobody knows
     * yet — nothing prices it, so the row shows words where an amount would go and
     * the total below stays the goods alone. Adding a zero would read as free,
     * which is the one thing it is not.
     */
    function paintTotal() {
      const unknown = state.delivery === 'homeDelivery';

      const row = overview.querySelector<HTMLElement>('[data-overview-delivery]');
      if (row) {
        row.hidden = !state.delivery;
        const label = row.querySelector('[data-overview-delivery-label]');
        const amount = row.querySelector('[data-overview-delivery-fee]');
        if (label) label.textContent = SHORT.get(state.delivery) || L('delivery');
        if (amount) amount.textContent = unknown ? L('deliveryPending') : L('free');
      }
      const total = overview.querySelector('[data-overview-total]');
      if (total) total.textContent = money.format(itemsTotal);
    }

    // --- review -------------------------------------------------------------

    function paintReview() {
      const fiscal =
        state.type === 'private'
          ? value('codiceFiscale')
          : state.type === 'company'
            ? value('partitaIva')
            : '';
      const typeLabel = TYPE_LABELS.get(state.type) ?? '';

      const detail =
        state.delivery === 'homeDelivery'
          ? /* Newlines become separators: the review line is one line. */
            value('address').split('\n').map((part) => part.trim()).filter(Boolean).join(' · ')
          : state.delivery === 'storePickup'
            ? L('collectedAtBranch').replace('{city}', state.pickup)
            : '';

      /* Only when it differs. "Collected from the delivery address" is what the
         review already says by not saying anything. */
      const returnDetail = returnSame && !returnSame.checked ? value('returnAddress') : '';

      const fill = (key: string, text: string) => {
        const node = root.querySelector(`[data-review="${key}"]`);
        if (node) node.textContent = text || '—';
      };

      fill('name', `${value('firstName')} ${value('lastName')}`.trim());
      fill('email', value('email'));
      fill('phone', value('phone'));
      fill('type', fiscal ? `${typeLabel} · ${fiscal}` : typeLabel);
      fill('delivery', NAMES.get(state.delivery) ?? '');
      fill(
        'deliveryDetail',
        returnDetail ? `${detail} · ${L('returnStage')}: ${returnDetail}` : detail,
      );
    }

    // --- handover -----------------------------------------------------------

    const placeOrder = root.querySelector<HTMLAnchorElement>('[data-place-order]');
    const pending = root.querySelector<HTMLElement>('[data-confirm-pending]');
    const placedPanel = root.querySelector<HTMLElement>('[data-confirm-placed]');
    const errorPanel = root.querySelector<HTMLElement>('[data-confirm-error]');

    /**
     * The handover message: the server-built line items, then what the customer
     * typed into steps 1 and 2, then the order number once there is one.
     *
     * Rebuilt at hand-over time rather than on every keystroke — it is only ever
     * read once, and the server-built base is already a valid message if none of
     * this runs.
     */
    function handoverMessage(orderNumber: string | null): string {
      const base = placeOrder?.dataset.waBase ?? '';
      const lines = [
        ...(orderNumber ? [`${L('requestNumberPrefix')} ${orderNumber}`, ''] : []),
        base,
        '',
        `${L('name')}: ${value('firstName')} ${value('lastName')}`.trim(),
        `${L('email')}: ${value('email')}`,
        `${L('phone')}: ${value('phone')}`,
        `${L('customerType')}: ${TYPE_LABELS.get(state.type) ?? ''}`,
        ...(state.type === 'private' ? [`${L('codiceFiscale')}: ${value('codiceFiscale')}`] : []),
        ...(state.type === 'company'
          ? [
              `${L('partitaIva')}: ${value('partitaIva')}`,
              `${L('codiceFiscale')}: ${value('companyCodiceFiscale')}`,
            ]
          : []),
        `${L('deliveryLine')}: ${NAMES.get(state.delivery) ?? L('toBeArranged')}`,
        /* Gated on the CHOSEN option, not merely on the fields having values: a
           customer who fills the address and then switches to collection would
           otherwise send both, and the agent cannot tell which is real. */
        ...(state.delivery === 'homeDelivery' && value('address')
          ? [`${L('deliveryAddress')}: ${value('address')}`]
          : []),
        ...(state.delivery === 'storePickup' ? [`${L('pickupBranch')}: ${state.pickup}`] : []),
        /* Only when it is somewhere else — otherwise the agent already knows, and a
           line saying "the same address" is a line they have to read to learn
           nothing. */
        ...(returnSame && !returnSame.checked && value('returnAddress')
          ? [`${L('returnStage')}: ${value('returnAddress')}`]
          : []),
        /* Says the delivery cost is still open, so the conversation starts on the
           thing that is actually unresolved — which, for a home delivery, it now
           always is. */
        ...(state.delivery === 'homeDelivery'
          ? [`${L('deliveryLine')}: ${L('deliveryPending')}`]
          : []),
        ...(value('comments') ? [`${L('notes')}: ${value('comments')}`] : []),
      ];
      return lines.join('\n');
    }

    /** Points a `wa.me` link at the current message. */
    function setHandover(link: HTMLAnchorElement | null, orderNumber: string | null) {
      if (!link) return;
      const url = new URL(link.href);
      url.searchParams.set('text', handoverMessage(orderNumber));
      link.href = url.toString();
    }

    /**
     * The order body.
     *
     * Choices and contact details only. The line items come from the JSON island
     * the server rendered, and only the fields belonging to the CHOSEN delivery
     * option are sent — the same reasoning as the WhatsApp message above, and the
     * server drops the others anyway.
     */
    function orderBody() {
      const delivery: Record<string, unknown> = { method: state.delivery };
      if (state.delivery === 'homeDelivery') {
        // The address belongs to the delivery, and only to this one: the API
        // refuses it on a collection, which is exactly the mix-up that used to be
        // possible when it was asked for in step 1.
        delivery.address = { line1: value('address') };
      } else if (state.delivery === 'storePickup') {
        delivery.pickupCity = state.pickup;
      }
      /* Sent only when the order HAS a return leg. On a purchase the fields do not
         exist, and the API refuses a return address for something never returned. */
      if (returnSame) {
        delivery.returnToSameAddress = returnSame.checked;
        if (!returnSame.checked) delivery.returnAddress = value('returnAddress');
      }

      const customer: Record<string, unknown> = {
        firstName: value('firstName'),
        lastName: value('lastName'),
        email: value('email'),
        phone: value('phone'),
        customerType: state.type,
      };
      if (state.type === 'private') customer.codiceFiscale = value('codiceFiscale');
      if (state.type === 'company') {
        customer.partitaIva = value('partitaIva');
        customer.codiceFiscale = value('companyCodiceFiscale');
      }

      const body: Record<string, unknown> = { items: ORDER_ITEMS, customer, delivery };
      if (value('comments')) body.notes = value('comments');
      return body;
    }

    interface PlacedOrder {
      number: string;
      totals: { total: string; currency: string };
    }

    async function submitOrder(): Promise<PlacedOrder> {
      const response = await fetch(`${API_BASE}/api/orders`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        // The API is a different origin, so without this the customer session
        // cookie never arrives and a signed-in order links as `unverified` — the
        // one thing being signed in is supposed to settle. Checkout stays usable
        // without a session; this only matters when there is one.
        credentials: 'include',
        body: JSON.stringify(orderBody()),
      });
      if (!response.ok) throw new Error(`orders responded ${response.status}`);
      const payload = (await response.json()) as { data: PlacedOrder };
      return payload.data;
    }

    function showPlaced(order: PlacedOrder) {
      state.placed = true;
      if (pending) pending.hidden = true;
      if (errorPanel) errorPanel.hidden = true;
      if (!placedPanel) return;

      placedPanel.hidden = false;

      const card = placedPanel.querySelector<HTMLElement>('[data-placed-number-card]');
      const number = placedPanel.querySelector<HTMLElement>('[data-placed-number]');
      if (card) card.hidden = false;
      if (number) number.textContent = order.number;

      /* The figure the SERVER computed, not the one this page added up. They agree
         — both run @mia/pricing over the same choices — and showing the stored one
         means the customer reads what the order actually says. */
      const totalRow = placedPanel.querySelector<HTMLElement>('[data-placed-total-row]');
      const total = placedPanel.querySelector<HTMLElement>('[data-placed-total]');
      if (totalRow && total && order.totals) {
        total.textContent = new Intl.NumberFormat('it-IT', {
          style: 'currency',
          currency: order.totals.currency || 'EUR',
        }).format(Number(order.totals.total));
        totalRow.hidden = false;
      }

      const greeting = placedPanel.querySelector<HTMLElement>('[data-placed-greeting]');
      const first = value('firstName');
      if (greeting && first) {
        greeting.textContent = (greeting.dataset.greetingTemplate ?? '').replace('{name}', first);
      }

      setHandover(
        placedPanel.querySelector<HTMLAnchorElement>('[data-placed-whatsapp]'),
        order.number,
      );
    }

    function showError() {
      if (!errorPanel) return;
      errorPanel.hidden = false;
      // The request is not lost: the handover still carries all of it, minus a
      // number that was never issued.
      setHandover(errorPanel.querySelector<HTMLAnchorElement>('[data-error-whatsapp]'), null);
      errorPanel.scrollIntoView({ block: 'nearest' });
    }

    async function place() {
      if (state.placed || state.sending || !placeOrder) return;

      state.sending = true;
      const original = placeOrder.textContent;
      placeOrder.textContent = L('sendingRequest');
      placeOrder.setAttribute('aria-busy', 'true');

      try {
        showPlaced(await submitOrder());
      } catch {
        showError();
      } finally {
        state.sending = false;
        placeOrder.removeAttribute('aria-busy');
        placeOrder.textContent = original;
      }
    }

    /* The CTA is an <a> so that it works with no JavaScript. With JavaScript it
       records the order instead, and the handover moves to the panel that appears
       afterwards — so the navigation is cancelled rather than followed. */
    placeOrder?.addEventListener('click', (event) => {
      event.preventDefault();
      void place();
    });

    root.querySelector<HTMLButtonElement>('[data-confirm-retry]')?.addEventListener('click', () => {
      if (errorPanel) errorPanel.hidden = true;
      void place();
    });

    // --- line-item accordion -------------------------------------------------

    for (const toggle of overview.querySelectorAll<HTMLButtonElement>('[data-item-toggle]')) {
      toggle.addEventListener('click', () => {
        const panel = overview.querySelector<HTMLElement>(
          `[data-item-panel="${toggle.dataset.itemToggle}"]`,
        );
        if (!panel) return;
        const open = panel.hidden;
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
      });
    }

    // --- keyboard ------------------------------------------------------------

    /*
     * A `role="radio"` group has to answer to the arrow keys, or it announces
     * itself as a radio group and then behaves like a row of buttons. Native
     * radios would give this for free, but the reference design's options are
     * whole cards with panels inside them, which an <input> cannot be.
     */
    for (const group of root.querySelectorAll<HTMLElement>('[role="radiogroup"]')) {
      group.addEventListener('keydown', (event) => {
        const keys = ['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'];
        if (!keys.includes(event.key)) return;
        const radios = [...group.querySelectorAll<HTMLElement>('[role="radio"]')];
        const current = radios.indexOf(event.target as HTMLElement);
        if (current === -1) return;
        event.preventDefault();
        const forward = event.key === 'ArrowDown' || event.key === 'ArrowRight';
        const next = radios[(current + (forward ? 1 : -1) + radios.length) % radios.length];
        next?.focus();
        next?.click();
      });
    }

    // --- go ------------------------------------------------------------------

    root.addEventListener('input', paintCtas);
    root.addEventListener('change', paintCtas);

    selectType(state.type);
    paintSteps();
    paintTotal();
    paintCtas();
  }
</script>
