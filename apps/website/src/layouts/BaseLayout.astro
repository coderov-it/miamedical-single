---
/**
 * The single document shell for every page.
 *
 * Owns `<html lang>`, the head and the global chrome. The storefront is
 * Italian-first, so `it-IT` is the default — a missing `lang` fails WCAG 3.1.1
 * at Level A, and a screen reader would read Italian copy with English
 * pronunciation rules.
 */
import MobileNav from '~/components/global/MobileNav.astro';
import SiteFooter from '~/components/global/SiteFooter.astro';
import SiteHeader from '~/components/global/SiteHeader.astro';
import { serializeJsonLd } from '~/lib/json-ld';
import '~/styles/app.css';

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL. Defaults to the current path on `Astro.site`. */
  canonical?: string | undefined;
  /** Absolute URL of the social preview image. */
  ogImage?: string | undefined;
  /** Set only on pages that must not be indexed (cart, search results). */
  noindex?: boolean | undefined;
  /** JSON-LD blocks built from API facts. Never hand-authored marketing copy. */
  jsonLd?: Record<string, unknown>[] | undefined;
  /** Hides the footer and bottom navigation for focused flows. */
  bare?: boolean | undefined;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  bare = false,
} = Astro.props;

const canonicalHref = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="it-IT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mia Medical Italia" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lexend-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={serializeJsonLd(block)} />
      ))
    }

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>

    <div class="flex min-h-screen flex-col bg-white">
      <SiteHeader />

      <main id="contenuto" class="flex-1">
        <slot />
      </main>

      {!bare && <SiteFooter />}

      <slot name="after-body" />
      {!bare && <MobileNav />}
    </div>
  </body>
</html>
