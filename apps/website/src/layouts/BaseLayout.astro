---
/**
 * The single document shell for every page.
 *
 * Owns `<html lang>`, the head and the global chrome. The storefront is
 * Italian-first, so `it-IT` is the default — a missing `lang` fails WCAG 3.1.1
 * at Level A, and a screen reader would read Italian copy with English
 * pronunciation rules.
 */
import MobileNav from '~/components/global/MobileNav.astro';
import SiteFooter from '~/components/global/SiteFooter.astro';
import SiteHeader from '~/components/global/SiteHeader.astro';
import SupportLauncher from '~/components/global/SupportLauncher.astro';
import {
  localeFromLocals,
  localeTag,
  openGraphLocale,
  publicPathForRequest,
  translate,
  type SiteLocale,
} from '~/lib/i18n';
import { serializeJsonLd } from '~/lib/json-ld';
import { routePaths, type RouteKey } from '~/lib/routes';
import '~/styles/app.css';

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL. Defaults to the current path on `Astro.site`. */
  canonical?: string | undefined;
  /** Absolute URL of the social preview image. */
  ogImage?: string | undefined;
  /** Set only on pages that must not be indexed (cart, search results). */
  noindex?: boolean | undefined;
  /** JSON-LD blocks built from API facts. Never hand-authored marketing copy. */
  jsonLd?: Record<string, unknown>[] | undefined;
  /** Hides the footer and bottom navigation for focused flows. */
  bare?: boolean | undefined;
  /**
   * The page ground. `muted` is the default and the norm: content is raised in
   * white on a soft field. `white` is for the home page alone, whose editorial
   * bands paint their own grounds.
   */
  ground?: 'muted' | 'white' | undefined;
  /** Exact public URLs for the language selector on dynamic content. */
  languagePaths?: Partial<Record<SiteLocale, string>> | undefined;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  bare = false,
  ground = 'muted',
  languagePaths: suppliedLanguagePaths,
} = Astro.props;

const locale = localeFromLocals(Astro.locals);
const publicPath = Astro.locals.publicPath ?? publicPathForRequest() ?? Astro.url.pathname;
const staticRouteKey = (Object.keys(routePaths.it) as RouteKey[]).find(
  (key) => routePaths.it[key] === Astro.url.pathname,
);
const languagePaths =
  suppliedLanguagePaths ??
  (staticRouteKey
    ? { it: routePaths.it[staticRouteKey], en: routePaths.en[staticRouteKey] }
    : { [locale]: publicPath });
const canonicalHref = canonical ?? new URL(publicPath, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang={localeTag(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={translate(locale, 'layout.siteName')} />
    <meta property="og:locale" content={openGraphLocale(locale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {
      /*
        TWO preloads, for the two faces that both paint above the fold on every
        page (see theme.css § fonts): Lexend dresses the sticky header and every
        heading — including the h1, which is the LCP element on most pages and
        the one place a late swap reflows something large — and Atkinson sets the
        lede and the card blurbs directly under it.

        Only Atkinson's REGULAR is preloaded. Its bold sets short data labels
        ("Disponibile") that start below the fold on most pages, and its italic
        is rarer still; a third and fourth preload would spend the connection's
        first round trip on the files that need it least. Inter is not preloaded
        at all — nothing has referenced it since 2026-08-31, and an unreferenced
        face downloads nothing.
      */
    }
    <link
      rel="preload"
      href="/fonts/lexend-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={serializeJsonLd(block)} />
      ))
    }

    <slot name="head" />
  </head>

  <body
    class:list={[
      ground === 'muted' &&
        'bg-page [&_.rounded-card.bg-tint]:border-hair [&_.rounded-card.bg-tint]:border [&_.rounded-card.bg-tint]:bg-white',
    ]}
  >
    <a
      class="absolute top-0 left-0 z-100 -translate-y-full bg-accent px-4 py-3 text-white focus:translate-y-0"
      href="#contenuto"
    >
      {translate(locale, 'layout.skip')}
    </a>

    <div class="flex min-h-screen flex-col bg-white">
      <SiteHeader {locale} {languagePaths} />

      <main id="contenuto" class="flex-1">
        <slot />
      </main>

      {!bare && <SiteFooter {locale} />}

      <slot name="after-body" />
      {!bare && <SupportLauncher />}
      {!bare && <MobileNav {locale} />}
    </div>
  </body>
</html>
