---
/**
 * The single document shell for every page.
 *
 * Owns `<html lang>`, the head and the global chrome. The storefront is
 * Italian-first, so `it-IT` is the default — a missing `lang` fails WCAG 3.1.1
 * at Level A, and a screen reader would read Italian copy with English
 * pronunciation rules.
 */
import MobileNav from '~/components/global/MobileNav.astro';
import SiteFooter from '~/components/global/SiteFooter.astro';
import SiteHeader from '~/components/global/SiteHeader.astro';
import {
  localeFromLocals,
  localeTag,
  openGraphLocale,
  publicPathForRequest,
  translate,
  type SiteLocale,
} from '~/lib/i18n';
import { serializeJsonLd } from '~/lib/json-ld';
import { routePaths, type RouteKey } from '~/lib/routes';
import '~/styles/app.css';

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL. Defaults to the current path on `Astro.site`. */
  canonical?: string | undefined;
  /** Absolute URL of the social preview image. */
  ogImage?: string | undefined;
  /** Set only on pages that must not be indexed (cart, search results). */
  noindex?: boolean | undefined;
  /** JSON-LD blocks built from API facts. Never hand-authored marketing copy. */
  jsonLd?: Record<string, unknown>[] | undefined;
  /** Hides the footer and bottom navigation for focused flows. */
  bare?: boolean | undefined;
  /** Exact public URLs for the language selector on dynamic content. */
  languagePaths?: Partial<Record<SiteLocale, string>> | undefined;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  bare = false,
  languagePaths: suppliedLanguagePaths,
} = Astro.props;

const locale = localeFromLocals(Astro.locals);
const publicPath = Astro.locals.publicPath ?? publicPathForRequest() ?? Astro.url.pathname;
const staticRouteKey = (Object.keys(routePaths.it) as RouteKey[]).find(
  (key) => routePaths.it[key] === Astro.url.pathname,
);
const languagePaths =
  suppliedLanguagePaths ??
  (staticRouteKey
    ? { it: routePaths.it[staticRouteKey], en: routePaths.en[staticRouteKey] }
    : { [locale]: publicPath });
const canonicalHref = canonical ?? new URL(publicPath, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang={localeTag(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={translate(locale, 'layout.siteName')} />
    <meta property="og:locale" content={openGraphLocale(locale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {
      /*
        ONE preload, and it is Inter: the editorial design system's face, which
        every page paints first (the sticky header) and the home page uses
        throughout. Instrument Sans still dresses the body of the not-yet-
        restyled pages and loads with `font-display: swap` — a brief fallback
        paint there beats a double preload on every first visit. See app.css
        § fonts.
      */
    }
    <link
      rel="preload"
      href="/fonts/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={serializeJsonLd(block)} />
      ))
    }

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#contenuto">{translate(locale, 'layout.skip')}</a>

    <div class="flex min-h-screen flex-col bg-white">
      <SiteHeader {locale} {languagePaths} />

      <main id="contenuto" class="flex-1">
        <slot />
      </main>

      {!bare && <SiteFooter {locale} />}

      <slot name="after-body" />
      {!bare && <MobileNav {locale} />}
    </div>
  </body>
</html>
