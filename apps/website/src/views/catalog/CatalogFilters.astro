---
/**
 * The one filter row, identical on all three catalogue surfaces: four fixed
 * pills, then every category in a select — one 46px row with a 9px gutter and
 * 26px of air under it, the reference site's row (miamedicalitalia.it, measured
 * 2026-08-31) at its measured widths.
 *
 * A SEARCH FIELD LEADS THE ROW ON A PHONE, and only on a phone. The reference
 * puts one at the top of its mobile catalogue (measured 2026-08-31) and the
 * reason is the viewport: on desktop the pills, the category select and the
 * header's "Cerca" link are all on screen together, so a fourth way in would be
 * clutter — on a phone the header's search is a 21px glyph and the customer
 * arriving on a 24-product list has no visible way to name what they came for.
 *
 * It narrows THIS surface rather than bouncing to /cerca/: it is the same GET
 * form the category select uses, pointed at the same place, and `q` is already
 * part of the catalogue query (see readCatalogQuery). So typing "carrozzina" on
 * /catalogo-noleggio/ keeps you in the rental catalogue, which is what the pill
 * above it just promised.
 *
 * Fills, not borders (CLAUDE.md § controls): on the page's grey ground an
 * unselected pill is a WHITE fill with accent ink and the selected one is the
 * accent fill. The reference outlines its unselected pills instead; that is the
 * one thing here we do our way.
 *
 * THE FILL INVERTS ON A PHONE, because the ground does. Below `mid` this row
 * sits on the white masthead toolbar, and a white fill on a white ground is no
 * control at all — the category dropdown vanished entirely the first time. So
 * the unselected fill is `bg-tint` there: grey-on-white below `mid`,
 * white-on-grey above it, which is one rule read from both sides. The selected
 * pill stays the accent fill at every width, and the dropdown takes the same
 * inversion through its `class` prop, because its `pill` variant hard-codes
 * white for the grey-ground case it was written for.
 *
 * BELOW `mid` THE PILLS AND THE CATEGORY SELECT ARE ONE ROW, and that is the
 * organising move, not a saving one. They were two: a scrolling pill row and a
 * full-width select under it, in two different shapes on the same grey ground,
 * with the search field above them in a third. Three control rows that all
 * narrow the same list read as three unrelated things — "messy, spread out
 * rather than organised" (owner, 2026-08-31).
 *
 * So the select joins the pills in the same scroller, first, because "which
 * category" is the coarser cut and the pills refine it. `display: contents` on
 * their wrapper takes the wrapper back out of the box tree above `mid`, which
 * is what leaves the desktop row exactly as it was — pills, then a 428px select
 * on the right — from markup a phone reads as one strip. `order` puts them back
 * in the desktop sequence; without it the select would lead there too.
 *
 * BELOW `mid` THE PILLS SCROLL, THEY DO NOT WRAP. Four of them wrapped onto two
 * rows on a 390px phone and the block stood 182px before a single product —
 * the reference site puts them in one sideways-scrolling row instead
 * (miamedicalitalia.it at 390px, measured 2026-08-31), and the row bleeds to
 * both screen edges so the last pill clips at the viewport rather than at a
 * margin. That clip IS the affordance; pull the `-mx-gutter` and the row still
 * scrolls but stops looking like it does.
 *
 * The explicit `w-[calc(100% + 2 * gutter)]` is load-bearing and not belt and
 * braces. This row's parent is a WRAPPING COLUMN flex container, and a wrapping
 * flex container sizes its line to its content — so an `overflow-x:auto` child
 * with `width:auto` was resolving to the width of all four pills laid out flat
 * (472px on a 390px phone) instead of to the viewport, and the whole document
 * scrolled sideways rather than the row. Stating the width pins the scroll port
 * back to the screen.
 *
 * The select is a GET form pointed at the surface it sits on, so choosing a
 * category narrows the page you are already on rather than throwing you back to
 * the whole catalogue. It submits on change once the script runs; the `noscript`
 * button is the same submit for a customer who never gets it — a select that
 * only works with JavaScript is the silent block CLAUDE.md forbids.
 */
import Dropdown from '~/components/primitives/Dropdown.astro';
import type { CatalogPill, CatalogQuery } from '~/lib/catalog-page';
import { localeForRequest, translate } from '~/lib/i18n';
import { catalogRoot } from '~/lib/routes';

interface Props {
  pills: CatalogPill[];
  categories: { value: string; label: string }[];
  query: CatalogQuery;
}

const { pills, categories, query } = Astro.props;
const locale = localeForRequest();

/*
 * A CHOSEN CATEGORY IS A SELECTED CONTROL AND HAS TO LOOK LIKE ONE. It kept its
 * resting fill whatever was picked, so "Carrozzine elettriche e scooter" sat in
 * the row at exactly the weight of an untouched control while the pill beside it
 * was a solid accent — two controls claiming the same row, one of them lying
 * (owner, 2026-08-31).
 *
 * `accent-tint` is the project's quiet-selected fill (CLAUDE.md § controls), so
 * this is the pills' own marker one step down: the pill that IS the page takes
 * the accent fill, the category that narrows it takes the tint. Fills, never
 * borders, and at both widths — the resting fill is the one that flips with the
 * ground.
 *
 * IT TARGETS THE CONTROL, NOT EVERY BUTTON IN THE DROPDOWN. `[&_button]` also
 * matches the 17 options inside the listbox, which is how the phone modal's
 * rows came out accent-tinted, 44px tall and pill-cornered while their own
 * classes said otherwise.
 */
const categoryFill = query.category
  ? '[&_[data-dropdown-trigger]]:bg-accent-tint [&_select]:bg-accent-tint'
  : 'mid:[&_[data-dropdown-trigger]]:bg-white mid:[&_select]:bg-white ' +
    'max-mid:[&_[data-dropdown-trigger]]:bg-tint max-mid:[&_select]:bg-tint';

/* 46px paint, 48px target: the invisible overlay is what a finger hits, and it
   overhangs the pill by a single pixel per side, so the 9px gutter never lets
   two targets touch.

   `rounded-field` AT EVERY WIDTH, not just below `mid` (owner, 2026-08-31). The
   filter row was the last place on the catalogue still wearing the full pill on
   a desktop, next to a header whose own buttons are 12px, and the owner wants
   the header's shape. So this is no longer a phone step over a desktop pill —
   it is one radius, and the `mid:` half is gone rather than made to agree. */
const pillClass =
  'relative inline-flex mid:min-h-11.5 max-mid:min-h-11 items-center ' +
  'rounded-field mid:px-4.75 max-mid:px-4 font-display ' +
  'text-[0.9688rem] font-bold no-underline after:absolute after:top-1/2 after:left-1/2 ' +
  'after:size-full after:min-h-12 after:min-w-12 after:-translate-x-1/2 ' +
  "after:-translate-y-1/2 after:content-['']";
---

<div
  class="mid:flex-row mid:items-center mid:pb-6.5 max-mid:gap-2 max-mid:pb-3 flex flex-col flex-wrap gap-2.25"
>
  {/* Phones only — see the note above. */}
  <form
    class="mid:hidden relative w-full"
    method="get"
    action={catalogRoot(query.view, locale)}
    role="search"
  >
    {query.category && <input type="hidden" name="category" value={query.category} />}
    {query.context.area && <input type="hidden" name="area" value={query.context.area} />}
    {query.context.from && <input type="hidden" name="from" value={query.context.from} />}
    {query.context.for && <input type="hidden" name="for" value={query.context.for} />}

    <label class="sr-only" for="catalog-search">{translate(locale, 'catalog.searchLabel')}</label>
    <svg
      class="text-ink-2 mid:start-4 mid:size-5.5 max-mid:start-3.5 max-mid:size-5 pointer-events-none absolute top-1/2 -translate-y-1/2"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m20 20-4.2-4.2"></path>
    </svg>
    <input
      class="bg-tint placeholder:text-ink-placeholder rounded-field mid:min-h-13.5 mid:ps-12 mid:text-[1.0625rem] max-mid:min-h-12 max-mid:ps-11 max-mid:text-(length:--text-phone-lead) w-full border-0 pe-4 font-semibold"
      id="catalog-search"
      name="q"
      type="search"
      value={query.q ?? ''}
      autocomplete="off"
      placeholder={translate(locale, 'catalog.searchPlaceholder')}
    />
    {
      /*
       * NO SUBMIT BUTTON, and the glyph on the left is this field's ONLY icon
       * (owner, 2026-08-31). It used to carry a round accent submit as well,
       * and two magnifiers on one 350px field is one magnifier too many.
       *
       * Removing it strands nobody. `q` is the form's only submittable text
       * field — everything else here is `type="hidden"`, which does not block
       * implicit submission — so Enter submits, and on a phone the OS labels
       * that key "Search". That is the affordance every mobile search field on
       * the platform uses, so it is not the silent block CLAUDE.md forbids:
       * nothing is disabled and nothing returns early.
       *
       * If a submit ever comes back it REPLACES the left glyph, never joins it.
       */
    }
  </form>

  {
    /* One strip on a phone, two flex items of the row above it on desktop —
       `display: contents` is what makes the same markup do both. */
  }
  <div
    class="mid:contents max-mid:-mx-gutter max-mid:w-[calc(100%+2*var(--spacing-gutter))] max-mid:px-gutter max-mid:flex max-mid:gap-2.25 max-mid:overflow-x-auto max-mid:[scrollbar-width:none] max-mid:[&::-webkit-scrollbar]:hidden"
  >
    <ul
      class="mid:order-1 mid:flex-wrap mid:overflow-visible mid:px-0 max-mid:flex-none max-mid:flex-nowrap flex items-center gap-2.25"
    >
      {
        pills.map((pill) => (
          <li class="flex-none">
            <a
              class:list={[
                pillClass,
                pill.isActive
                  ? 'hover:bg-accent-deep bg-accent text-white'
                  : 'hover:bg-accent-tint mid:bg-white max-mid:bg-tint text-accent',
              ]}
              href={pill.href}
              aria-current={pill.isActive ? 'true' : undefined}
            >
              {pill.label}
            </a>
          </li>
        ))
      }
    </ul>

    <form
      class="mid:order-2 mid:w-107 max-mid:order-first max-mid:w-auto max-mid:flex-none flex w-full items-center gap-2.25"
      method="get"
      action={catalogRoot(query.view, locale)}
      data-catalog-category-form
      data-selected-category={query.category}
    >
      {query.q && <input type="hidden" name="q" value={query.q} />}
      {query.context.area && <input type="hidden" name="area" value={query.context.area} />}
      {query.context.from && <input type="hidden" name="from" value={query.context.from} />}
      {query.context.for && <input type="hidden" name="for" value={query.context.for} />}

      <Dropdown
        id="catalog-category"
        name="category"
        label={translate(locale, 'catalog.categoryFilter')}
        options={categories}
        value={query.category}
        placeholder={translate(locale, 'catalog.allCategories')}
        hideLabel
        variant="pill"
        class={`mid:flex-1 max-mid:w-auto max-mid:flex-none min-w-0 ${categoryFill}`}
      />

      <noscript>
        <button
          class="font-display text-ui-strong hover:bg-accent-deep rounded-field relative inline-flex min-h-11.5 flex-none items-center justify-center border-0 bg-accent px-5 font-semibold text-white after:absolute after:top-1/2 after:left-1/2 after:size-full after:min-h-12 after:min-w-12 after:-translate-x-1/2 after:-translate-y-1/2 after:content-['']"
          type="submit"
        >
          {translate(locale, 'catalog.apply')}
        </button>
      </noscript>
    </form>
  </div>
</div>

<script>
  /**
   * Choosing a category IS the navigation — there is no "apply" to press.
   * Bound to the native select, which the Dropdown primitive writes every
   * choice through, so the enhanced listbox and the bare control behave alike.
   *
   * The value guard is not belt and braces. A browser restores form state when
   * you come BACK to a page, and a restored value fires `change` like a click
   * does — an unguarded submit would bounce the customer straight forward
   * again, and the back button would stop working on this page.
   */
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-catalog-category-form]')) {
    const rendered = form.dataset.selectedCategory ?? '';
    form.querySelector('select')?.addEventListener('change', (event) => {
      if ((event.target as HTMLSelectElement).value === rendered) return;
      form.submit();
    });
  }
</script>
