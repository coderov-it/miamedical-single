---
/**
 * The catalogue masthead: what this surface is, and nothing else.
 *
 * Matched to the reference site (miamedicalitalia.it, measured 2026-08-31):
 * a 34px/800 title, 6px of air, a 18.5px soft lede, 20px of air, then the
 * filter row. No search field — the reference puts typed search behind its own
 * "Cerca" destination, and so does our header, so a second search box here
 * would give the customer two fields that answer differently.
 */
interface Props {
  heading: string;
  lede: string;
}

const { heading, lede } = Astro.props;
---

<header class="pb-5">
  <h1 class="text-[clamp(1.75rem,2.36vw,2.125rem)]/[1.26] font-extrabold">{heading}</h1>
  <p class="text-ink-2 mt-1.5 max-w-[56ch] text-[1.15625rem]/[1.25]">{lede}</p>
</header>
