---
/**
 * The catalogue, in its three forms — see `CatalogView` in lib/routes.ts.
 *
 * `all` is a category directory until something narrows it; `rental` and `sale`
 * are always product listings. All three share one masthead and one pill row,
 * so moving between them never changes the furniture, only the body.
 *
 * Matched section for section to the owner's reference (miamedicalitalia.it,
 * measured 2026-08-31), which is also where the page's grey ground and white
 * cards come from — the same pattern as the home page below its hero.
 *
 * Rendered on demand: search, the category filter and stock are always live,
 * and a deep link like `?category=carrozzine&page=2` is a real URL.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import {
  buildCategoryTiles,
  buildPills,
  catalogCopy,
  categoryOptions,
  MODE_FOR_VIEW,
  readCatalogQuery,
  type CatalogView,
} from '~/lib/catalog-page';
import { listCategories, listProducts, safely } from '~/lib/catalog';
import { localeFromLocals, translate } from '~/lib/i18n';
import { catalogPath, routePath } from '~/lib/routes';
import CatalogFilters from './CatalogFilters.astro';
import CatalogHead from './CatalogHead.astro';
import CatalogListing from './CatalogListing.astro';
import CategoryDirectory from './CategoryDirectory.astro';

interface Props {
  view: CatalogView;
}

const PER_PAGE = 24;
const { view } = Astro.props;
const locale = localeFromLocals(Astro.locals);
const query = readCatalogQuery(Astro.url, view);

/*
 * The whole catalogue leads with the directory, then lists everything under it —
 * the reference site's shape (owner, 2026-08-30). The tiles are the fast way in
 * for someone who knows what kind of thing they want; the grid below is for
 * someone who would rather just look.
 *
 * The tiles drop away once anything narrows the page — a category, a typed
 * query — because a grid of category tiles is no answer to "show me the
 * wheelchairs". They drop on page 2 as well: they are a landing device, and
 * repeating them above every page of results is furniture, not navigation.
 */
const showDirectory = view === 'all' && !query.isNarrowed && query.page === 1;

const mode = MODE_FOR_VIEW[view];
const emptyResult = {
  data: [],
  meta: { page: query.page, perPage: PER_PAGE, total: 0, pageCount: 1 },
  facets: { specs: [] },
};

const [categories, result] = await Promise.all([
  safely(() => listCategories(locale), [], 'listCategories'),
  safely(
    () =>
      listProducts(
        {
          page: query.page,
          perPage: PER_PAGE,
          sort: query.sort,
          ...(query.q ? { q: query.q } : {}),
          ...(query.category ? { category: query.category } : {}),
          ...(mode ? { mode } : {}),
        },
        locale,
      ),
    emptyResult,
    'listProducts',
  ),
]);

const activeCategory = categories.find((candidate) => candidate.code === query.category);
const copy = catalogCopy(view, activeCategory?.name ?? null, locale);
const pills = buildPills(query, categories, locale);
const tiles = showDirectory
  ? buildCategoryTiles(categories, { locale, context: query.context })
  : [];

const isFirstPage = result.meta.page <= 1;
const title = isFirstPage
  ? `${copy.heading} | Roma e Firenze — Mia Medical Italia`
  : `${copy.heading} — ${translate(locale, 'blog.pageTitle', { page: result.meta.page })} | Mia Medical Italia`;

/* One page-link builder for the head's rel=prev/next and the listing's pager. */
const pageLink = (page: number) =>
  catalogPath(
    { view, q: query.q, category: query.category, sort: query.sort, page, ...query.context },
    locale,
  );
const prevUrl = result.meta.page > 1 ? pageLink(result.meta.page - 1) : null;
const nextUrl = result.meta.page < result.meta.pageCount ? pageLink(result.meta.page + 1) : null;
---

<BaseLayout
  {title}
  description={translate(locale, 'catalog.description')}
  canonical={new URL(copy.canonical, Astro.site ?? Astro.url.origin).href}
  noindex={query.isNarrowed || !isFirstPage}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  {
    /* ONE grey ground with white cards on it, the reference's page and the home
       page's — which is why nothing inside paints a ground of its own. The
       wrapper's air is theirs too: 34px above the title, 60px under the last
       row before the footer. */
  }
  <div class="bg-page">
    <div
      class="max-w-page px-gutter mx-auto w-full pt-[clamp(22px,2.4vw,34px)] pb-[clamp(40px,4.2vw,60px)]"
    >
      {
        /* The masthead is the whole crumb trail on the bare surfaces — a single
           "Home › Catalogo" row above an h1 that says the same word twice is
           noise. It earns its place once a category is the page's real subject. */
      }
      {
        activeCategory && (
          <Breadcrumbs
            items={[
              { label: translate(locale, 'home'), href: routePath(locale, 'home') },
              { label: translate(locale, 'catalog.title'), href: routePath(locale, 'catalog') },
              { label: activeCategory.name },
            ]}
          />
        )
      }

      <CatalogHead heading={copy.heading} lede={copy.lede} />

      <CatalogFilters {pills} categories={categoryOptions(categories)} {query} />

      {showDirectory && <CategoryDirectory {tiles} />}

      <CatalogListing
        products={result.data}
        meta={result.meta}
        heading={showDirectory ? translate(locale, 'catalog.allProducts') : undefined}
        context={query.context}
        pageHref={pageLink}
      />
    </div>
  </div>
</BaseLayout>
