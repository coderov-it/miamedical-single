---
/**
 * The product body of a listing: the grid, and plain `<a>` pagination with
 * rel=prev/next so the whole thing works with no JavaScript and stays
 * crawlable.
 *
 * Three across at full width with a 16px gutter, dropping to two at `mid` and
 * one on a phone — the reference site's grid (miamedicalitalia.it, measured
 * 2026-08-31) with our reflow, because theirs keeps three columns down to
 * 390px and the cards there are unreadable.
 *
 * The count is always the section's heading for assistive tech, and `showCount`
 * decides whether it is painted. The catalogue surfaces leave it unpainted: the
 * reference listings put nothing between the filter row and the first card, and
 * a "55 ausili disponibili" line there is the one row that would push
 * everything below it out of step with theirs. Search paints it, because on a
 * page whose whole subject is a query, how many answers came back is the first
 * thing to say.
 *
 * Shared by the catalogue surfaces and the search page — they differ only in
 * the URL a page number resolves to, which is why that arrives as `pageHref`
 * rather than being rebuilt from a query this component would have to know the
 * shape of.
 */
import ProductCard from '~/components/catalog/ProductCard.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import type { CatalogLayout } from '~/lib/catalog-page';
import type { PageMeta, ProductSummary } from '~/lib/catalog';
import { localeForRequest, translate } from '~/lib/i18n';
import type { BrowseContext } from '~/lib/routes';

interface Props {
  products: ProductSummary[];
  meta: PageMeta;
  /**
   * A visible title for the grid, when it is not the only thing on the page —
   * "Tutti i prodotti" under the category directory. Without one the count
   * carries the section for assistive tech alone.
   */
  heading?: string | undefined;
  /** Paint the count above the grid. Off on the catalogue, on for search. */
  showCount?: boolean | undefined;
  /**
   * "Griglia" or "Lista", the catalogue toolbar's switch. A list is one column
   * of the card's row layout at every width — which is the phone treatment, and
   * that is the point: someone asking for a list is asking to see more products
   * and less of each one.
   */
  layout?: CatalogLayout | undefined;
  /** Carried, never a filter — handed on to every card so the funnel remembers. */
  context?: BrowseContext;
  pageHref: (page: number) => string;
}

const {
  products,
  meta,
  heading,
  showCount = false,
  layout = 'grid',
  context = {},
  pageHref,
} = Astro.props;
const asRow = layout === 'list';
const locale = localeForRequest();

const countLabel =
  `${meta.total} ${translate(locale, meta.total === 1 ? 'catalog.available.one' : 'catalog.available.many')}` +
  (meta.pageCount > 1
    ? ` · ${translate(locale, 'catalog.page', { page: meta.page, total: meta.pageCount })}`
    : '');

const prevUrl = meta.page > 1 ? pageHref(meta.page - 1) : null;
const nextUrl = meta.page < meta.pageCount ? pageHref(meta.page + 1) : null;

/* The reference's pager, in our fills: a quiet tint control either side of the
   page count, and a disabled end renders as the same control at rest. Takes the
   filter row's radius at every width — it sits directly under it, and a pill
   below a 12px row reads as two unrelated decisions. */
const pagerClass =
  'font-ui bg-tint text-ink hover:bg-tint-2 inline-flex min-h-13 items-center justify-center ' +
  'rounded-field px-7 text-[1.0313rem] font-semibold no-underline';

/* 14px under a painted title, nothing under an `sr-only` one — a screen-reader
   heading is out of flow, so a margin here would open a gap the reference's
   listings do not have. */
const bodyGap = heading || showCount ? 'mt-3.5' : '';
---

<section aria-labelledby="products-title">
  {
    heading ? (
      <Fragment>
        <h2 class="text-[1.375rem]/[1.28] font-bold" id="products-title">
          {heading}
        </h2>
        <span class="sr-only">{countLabel}</span>
      </Fragment>
    ) : (
      <h2 class:list={[showCount ? 'text-ink-2 font-semibold' : 'sr-only']} id="products-title">
        {countLabel}
      </h2>
    )
  }

  {
    products.length === 0 ? (
      <div
        class:list={[
          'rounded-card border-hair mid:p-8 grid justify-items-start gap-4 border bg-white p-6',
          bodyGap,
        ]}
      >
        <p class="text-[1.1875rem] font-bold">{translate(locale, 'catalog.empty')}</p>
        <p class="text-ink-2">{translate(locale, 'catalog.helpDetail')}</p>
        <PhoneCta variant="primary" />
      </div>
    ) : (
      <ul
        class:list={[
          'mid:gap-4 max-mid:gap-3 grid grid-cols-1',
          !asRow && 'wide:grid-cols-3 mid:grid-cols-2',
          bodyGap,
        ]}
      >
        {products.map((product, index) => (
          <li class="flex">
            <ProductCard
              {product}
              priority={meta.page === 1 && index === 0}
              headingLevel={3}
              row={asRow}
              {context}
            />
          </li>
        ))}
      </ul>
    )
  }
</section>

{
  meta.pageCount > 1 && (
    <nav
      class="mt-8 flex flex-wrap items-center justify-between gap-4"
      aria-label={translate(locale, 'catalog.pagination')}
    >
      {prevUrl ? (
        <a class={pagerClass} href={prevUrl} rel="prev">
          {translate(locale, 'catalog.previous')}
        </a>
      ) : (
        <span class:list={[pagerClass, 'text-ink-2 opacity-60']} aria-hidden="true">
          {translate(locale, 'catalog.previous')}
        </span>
      )}

      <p class="text-ink-2 font-semibold">
        {translate(locale, 'catalog.page', { page: meta.page, total: meta.pageCount })}
      </p>

      {nextUrl ? (
        <a class={pagerClass} href={nextUrl} rel="next">
          {translate(locale, 'catalog.next')}
        </a>
      ) : (
        <span class:list={[pagerClass, 'text-ink-2 opacity-60']} aria-hidden="true">
          {translate(locale, 'catalog.next')}
        </span>
      )}
    </nav>
  )
}
