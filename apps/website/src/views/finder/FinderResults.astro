---
/**
 * The guided selector's answer: what the three replies matched.
 *
 * The shortlist is the SAME product card the catalogue and the home rails use,
 * so a card found this way and a card found by browsing are the same object —
 * card on a desktop grid, list row on a phone, both from one component.
 *
 * Twelve cards, then a link that lists the rest on this same page. The live
 * site shows six and hands off to a catalogue narrowed the way the wizard
 * narrowed it; ours cannot, because our catalogue filters one category at a
 * time and an activity spans several. Listing them here is the honest version:
 * the count above the grid and the products under it are the same set.
 *
 * When the fallback ladder had to drop an answer (see `matchProducts`) the
 * results say which one. Showing a customer wheelchairs for the whole house
 * after they asked for outdoors is fine; not telling them is not.
 */
import ProductCard from '~/components/catalog/ProductCard.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import type { ProductSummary } from '~/lib/catalog';
import { localeForRequest, translate } from '~/lib/i18n';
import type { FinderMatch } from '~/lib/product-finder';

interface Props {
  match: FinderMatch;
  /** The three answers, already localized — printed as the page's receipt. */
  summary: string[];
  /** Every match, or the first page of them. */
  showAll: boolean;
  /** URL that reveals the rest. Absent when nothing is held back. */
  seeAllHref?: string | undefined;
  catalogHref: string;
}

const PAGE_SIZE = 12;

const { match, summary, showAll, seeAllHref, catalogHref } = Astro.props;
const locale = localeForRequest();
const text = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const total = match.items.length;
const shown = showAll ? match.items : match.items.slice(0, PAGE_SIZE);
const countLabel = text(total === 1 ? 'finder.results.count.one' : 'finder.results.count.many', {
  count: total,
});
---

<section aria-labelledby="finder-results">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="font-ui text-[clamp(1.25rem,2vw,1.4375rem)]/[1.3] font-bold" id="finder-results">
      {text('finder.results.title')}
    </h2>
    {
      summary.length > 0 && (
        <p class="text-ink-2 text-base/[1.4]">
          <span class="sr-only">{text('finder.results.summary')}: </span>
          {summary.join(' · ')}
        </p>
      )
    }
  </div>

  {
    /* `aria-live` so changing an answer and coming back announces the new
       count — the heading above it does not change between two results. */
  }
  <p class="font-ui text-ink mt-2 text-[1.0625rem] font-bold" aria-live="polite">{countLabel}</p>

  {
    match.relaxed && (
      <p class="rounded-field border-hair text-ink-2 mt-3.5 border bg-white px-4 py-3 text-base/[1.5]">
        {text(`finder.results.relaxed.${match.relaxed}`)}
      </p>
    )
  }

  {
    total === 0 ? (
      <div class="rounded-card border-hair mid:p-8 mt-4 grid justify-items-start gap-4 border bg-white p-6">
        <p class="font-ui text-[1.1875rem] font-bold">{text('finder.results.empty')}</p>
        <p class="text-ink-2">{text('finder.results.emptyDetail')}</p>
        <PhoneCta variant="primary" srHint={text('finder.helpHint')} />
      </div>
    ) : (
      <ul class="wide:grid-cols-3 mid:grid-cols-2 mid:gap-4 max-mid:gap-3 mt-4 grid list-none grid-cols-1 p-0">
        {shown.map((product: ProductSummary, index: number) => (
          <li class="flex">
            <ProductCard {product} priority={index === 0} headingLevel={3} />
          </li>
        ))}
      </ul>
    )
  }

  {
    /* The two ways on from a shortlist, on one row: the rest of THIS answer,
       and the whole catalogue. The first is the louder of the two because it
       is still an answer to the question the customer asked. */
  }
  <div class="mid:gap-5 mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
    {
      seeAllHref && (
        <a
          class="font-ui bg-tint text-ink hover:bg-tint-2 rounded-field max-mid:w-full inline-flex min-h-13 items-center justify-center px-7 text-[1.0313rem] font-semibold no-underline"
          href={seeAllHref}
        >
          {text('finder.seeAll', { count: total })}
        </a>
      )
    }
    <a class="font-ui text-[1.0313rem] font-semibold text-accent" href={catalogHref}>
      {text('finder.browseCatalog')} →
    </a>
  </div>
</section>
