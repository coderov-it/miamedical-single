---
/**
 * The product page's body: breadcrumbs, the two columns, and the mobile price
 * bar.
 *
 * Layout and visual language follow the owner-authored reference design (Claude
 * Design project "Product details page design", file "Product Details.dc.html"):
 * hero with gallery and identity side by side, numbered sections 01 Configura /
 * 02 Extra / 03 Per la consegna / 04 Scheda tecnica, information tabs, and one
 * sticky order panel. Rationale and the few deliberate deviations:
 * docs/code/storefront-design-system.md § Product detail page.
 *
 * ONE NATIVE GET FORM wraps both columns, and its target is the CHECKOUT:
 * "Richiedi il noleggio" is a book-now and goes straight to confirmation with
 * this one product. The panel's second button overrides that with
 * `formaction={routes.cart}` to add to the cart instead, and the page script
 * upgrades it to write the store without leaving the page. Both paths send the
 * SAME field names — `resolveCheckout()` reads the un-prefixed single-item form
 * directly — so neither needs a second vocabulary. See docs/code/storefront-cart.md.
 *
 * OUT OF STOCK renders the same left column with no form around it. There is
 * nothing to configure and nothing to submit, so the panel becomes a phone
 * number; the page script finds no form and does nothing.
 */
import Breadcrumbs from '~/components/global/Breadcrumbs.astro';
import PhoneCta from '~/components/global/PhoneCta.astro';
import PdpAddons from '~/components/product/PdpAddons.astro';
import PdpHero from '~/components/product/PdpHero.astro';
import PdpInfoTabs from '~/components/product/PdpInfoTabs.astro';
import PdpOrderPanel from '~/components/product/PdpOrderPanel.astro';
import PdpQuestions from '~/components/product/PdpQuestions.astro';
import PdpSpecs from '~/components/product/PdpSpecs.astro';
import { cardPrice } from '~/lib/api';
import type { ProductDetail } from '~/lib/catalog';
import { localeForRequest, translate } from '~/lib/i18n';
import type { BrowseAnswers, ProductImages } from '~/lib/product-page';
import { FIELD } from '~/lib/request-config';
import { routePath } from '~/lib/routes';

interface Props {
  product: ProductDetail;
  images: ProductImages['images'];
  answers: BrowseAnswers;
  inStock: boolean;
}

const { product, images, answers, inStock } = Astro.props;
const locale = localeForRequest();

const isRental = product.pricing.mode === 'rental';

/* The mobile bar carries the same line as the hero: on a rental that is the
   marketing rate, which advertises rather than quotes. */
const barPrice = cardPrice(product.pricing, locale);

const columns = 'flex flex-wrap items-start gap-x-12 gap-y-10 pt-3';
const leftColumn = 'flex min-w-0 flex-[1_1_540px] flex-col gap-13';
---

{
  /*
    The bottom padding clears BOTH fixed bars on phones: the price bar and the
    persistent navigation under it.
  */
}
<div
  class="pdp px-gutter mid:pb-20 max-w-page mx-auto w-full pb-[calc(var(--spacing-mobile-bar)+var(--spacing-mobile-nav)+1.25rem)]"
>
  <Breadcrumbs
    items={[
      { label: translate(locale, 'home'), href: routePath(locale, 'home') },
      { label: translate(locale, 'catalog.title'), href: routePath(locale, 'catalog') },
      { label: product.title },
    ]}
  />

  {
    inStock ? (
      <form
        id="quote-form"
        method="get"
        action={routePath(locale, 'checkout')}
        class={columns}
        data-est-base={product.pricing.price ?? ''}
        data-est-mode={product.pricing.mode}
        data-est-currency={product.pricing.currency}
      >
        <input type="hidden" name={FIELD.product} value={product.slug} />

        <main class={leftColumn}>
          <PdpHero {product} {images} />
          {product.addons.length > 0 && <PdpAddons addons={product.addons} />}
          {product.questions.length > 0 && <PdpQuestions questions={product.questions} />}
          {product.specifications.length > 0 && (
            <PdpSpecs specifications={product.specifications} />
          )}
          <PdpInfoTabs {product} />
        </main>

        <PdpOrderPanel
          {product}
          deliveryCity={answers.deliveryCity}
          startDate={answers.startDate}
          today={answers.today}
        />
      </form>
    ) : (
      <div class={columns}>
        <main class={leftColumn}>
          <PdpHero {product} {images} />
          {product.specifications.length > 0 && (
            <PdpSpecs specifications={product.specifications} />
          )}
          <PdpInfoTabs {product} />
        </main>

        <aside
          id="order"
          class="bg-tint flex max-w-100 min-w-0 flex-[1_1_320px] scroll-mt-24 flex-col gap-4 rounded-2xl p-6"
        >
          <p class="m-0">
            Questo ausilio è momentaneamente esaurito. Chiamaci: spesso abbiamo un modello
            equivalente disponibile subito.
          </p>
          <PhoneCta variant="primary" />
        </aside>
      </div>
    )
  }
</div>

{
  /*
    The mobile price bar sits directly ABOVE the persistent bottom navigation
    rather than fighting it for `bottom: 0` — two overlapping bars means one of
    them is unusable, and the navigation already reserves the safe-area inset.
  */
}
<div
  class="bg-ink mid:hidden px-gutter fixed inset-x-0 bottom-[calc(var(--spacing-mobile-nav)+env(safe-area-inset-bottom,0px))] z-65 py-4"
  data-pdp-price-bar
>
  <div class="max-w-page mx-auto flex items-center justify-between gap-4">
    <p class="m-0 flex items-baseline gap-2 text-white">
      {barPrice?.prefix && <span class="text-[14px] opacity-70">{barPrice.prefix}</span>}
      <span class="text-[18px] font-bold tabular-nums">{barPrice?.text ?? ''}</span>
    </p>
    <a
      class="font-display text-ui-strong hover:bg-accent-deep inline-flex min-h-12 cursor-pointer items-center justify-center gap-2.5 rounded-full bg-accent px-6 font-semibold text-white no-underline"
      href="#order"
    >
      {inStock ? (isRental ? 'Noleggia ora' : 'Richiedi') : 'Contattaci'}
    </a>
  </div>
</div>
