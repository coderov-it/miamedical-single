---
/**
 * The playground's page shell: a crumb back to the index, a title, and the
 * demo below. Never indexed, never cached — the URL carries a token.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { playgroundHref } from '~/lib/playground';

interface Props {
  title: string;
  summary?: string;
}

const { title, summary } = Astro.props;

Astro.response.headers.set('cache-control', 'no-store, max-age=0');
---

<BaseLayout title={`${title} · Playground`} description={summary ?? title} noindex bare fillGround>
  <div class="max-w-page px-gutter mx-auto w-full pt-6 pb-20">
    <nav class="text-ink-2 text-[14px]">
      <a class="hover:text-ink no-underline" href={playgroundHref(Astro.url, '')}>
        Playground
      </a>
    </nav>
    <h1 class="mid:text-[34px]/[1.1] mt-2 text-[26px]/[1.15]">{title}</h1>
    {summary && <p class="text-ink-2 mt-1.5">{summary}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</BaseLayout>
